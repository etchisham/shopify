[
  {
    "name": "theme_info",
    "theme_name": "Formelune",
    "theme_version": "1.0.1",
    "theme_author": "Formelune",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_display_font",
        "default": "newsreader_n4",
        "label": "Display font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Body font"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          { "value": "80rem", "label": "Standard — 1280px" },
          { "value": "90rem", "label": "Wide — 1440px" }
        ],
        "default": "80rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 16,
        "max": 48,
        "step": 4,
        "unit": "px",
        "label": "Desktop page margin",
        "default": 32
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 8,
        "step": 1,
        "unit": "px",
        "label": "Control corner radius",
        "default": 2
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "canvas_color", "default": "#F4F0E8", "label": "Canvas" },
      { "type": "color", "id": "surface_color", "default": "#FFFDF8", "label": "Surface" },
      { "type": "color", "id": "ink_color", "default": "#1B1B18", "label": "Text" },
      { "type": "color", "id": "muted_color", "default": "#706A61", "label": "Muted text" },
      { "type": "color", "id": "line_color", "default": "#D8D0C4", "label": "Borders" },
      { "type": "color", "id": "brand_color", "default": "#6F2F2A", "label": "Primary action" },
      { "type": "color", "id": "secondary_color", "default": "#4F5B4B", "label": "Secondary accent" }
    ]
  },
  {
    "name": "Commerce facts",
    "settings": [
      { "type": "text", "id": "support_email", "label": "Support email" },
      { "type": "text", "id": "delivery_message", "label": "Delivery summary", "default": "Estimated delivery shown at checkout" },
      { "type": "range", "id": "return_window_days", "label": "Return window", "min": 7, "max": 60, "step": 1, "unit": "days", "default": 30 },
      { "type": "text", "id": "warranty_message", "label": "Damage or warranty summary", "default": "Damaged on arrival? We will make it right." },
      { "type": "url", "id": "shipping_policy_url", "label": "Shipping policy link" },
      { "type": "url", "id": "return_policy_url", "label": "Return policy link" }
    ]
  },
  {
    "name": "Merchant structured data",
    "settings": [
      { "type": "checkbox", "id": "enable_merchant_schema", "label": "Enable shipping and returns schema", "default": false, "info": "Enable only after every value below matches live policies." },
      { "type": "text", "id": "schema_country", "label": "Shipping country code", "info": "Use a two-letter ISO country code. Active market is used when blank." },
      { "type": "select", "id": "schema_return_fees", "label": "Return fees", "options": [
        { "value": "FreeReturn", "label": "Free returns" },
        { "value": "ReturnShippingFees", "label": "Customer pays return shipping" },
        { "value": "ReturnFeesCustomerResponsibility", "label": "Other customer-paid fees" }
      ], "default": "ReturnShippingFees" },
      { "type": "text", "id": "schema_return_fee", "label": "Fixed return shipping fee", "info": "Required when return fees are charged by your store. Enter a number only, such as 8.50." },
      { "type": "text", "id": "schema_currency", "label": "Fee currency code", "info": "Three-letter ISO code. Store currency is used when blank." },
      { "type": "range", "id": "handling_days_min", "label": "Minimum handling days", "min": 0, "max": 30, "step": 1, "default": 1 },
      { "type": "range", "id": "handling_days_max", "label": "Maximum handling days", "min": 0, "max": 30, "step": 1, "default": 3 },
      { "type": "range", "id": "transit_days_min", "label": "Minimum transit days", "min": 1, "max": 30, "step": 1, "default": 2 },
      { "type": "range", "id": "transit_days_max", "label": "Maximum transit days", "min": 1, "max": 30, "step": 1, "default": 7 }
    ]
  },
  {
    "name": "Policy pages",
    "settings": [
      { "type": "color", "id": "policy_background_color", "default": "#FAF8F5", "label": "Policy background" },
      { "type": "color", "id": "policy_text_color", "default": "#312B36", "label": "Policy text" },
      { "type": "color", "id": "policy_link_color", "default": "#222222", "label": "Policy links" },
      { "type": "color", "id": "policy_border_color", "default": "#DEDAD5", "label": "Policy borders" },
      {
        "type": "select",
        "id": "policy_heading_style",
        "label": "Policy heading style",
        "options": [
          { "value": "serif", "label": "Serif" },
          { "value": "sans", "label": "Sans serif" }
        ],
        "default": "serif"
      },
      { "type": "range", "id": "policy_content_width", "min": 520, "max": 900, "step": 20, "unit": "px", "label": "Content width", "default": 620 },
      { "type": "range", "id": "policy_title_size", "min": 32, "max": 64, "step": 2, "unit": "px", "label": "Title size", "default": 42 },
      { "type": "range", "id": "policy_body_size", "min": 14, "max": 20, "step": 1, "unit": "px", "label": "Body size", "default": 16 },
      { "type": "range", "id": "policy_section_spacing", "min": 32, "max": 96, "step": 4, "unit": "px", "label": "Section spacing", "default": 48 },
      { "type": "checkbox", "id": "show_policy_navigation", "label": "Show policy navigation", "default": true },
      { "type": "checkbox", "id": "show_policy_mark", "label": "Show brand mark", "default": true }
    ]
  }
]
