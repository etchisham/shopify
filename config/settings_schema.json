[
  {
    "name": "theme_info",
    "theme_name": "Main Theme",
    "theme_version": "0.1.0",
    "theme_author": "etchisham",
    "theme_documentation_url": "https://github.com/etchisham/shopify#readme",
    "theme_support_url": "https://github.com/etchisham/shopify/issues"
  },
  {
    "name": "t:general.brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n7",
        "label": "t:labels.heading_font"
      },
      {
        "type": "range",
        "id": "type_base_size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16,
        "label": "t:labels.base_font_size"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          { "value": "80rem", "label": "t:options.page_width.narrow" },
          { "value": "90rem", "label": "t:options.page_width.standard" },
          { "value": "110rem", "label": "t:options.page_width.wide" }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 16,
        "max": 64,
        "step": 4,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      { "type": "color", "id": "background_color", "default": "#FFFCF7", "label": "t:labels.background" },
      { "type": "color", "id": "foreground_color", "default": "#171714", "label": "t:labels.foreground" },
      { "type": "color", "id": "muted_color", "default": "#625F58", "label": "t:labels.muted" },
      { "type": "color", "id": "surface_color", "default": "#F4F0E8", "label": "t:labels.surface" },
      { "type": "color", "id": "border_color", "default": "#D8D3C8", "label": "t:labels.border" },
      { "type": "color", "id": "accent_color", "default": "#244C3A", "label": "t:labels.accent" },
      { "type": "color", "id": "accent_contrast_color", "default": "#FFFFFF", "label": "t:labels.accent_contrast" }
    ]
  },
  {
    "name": "t:general.components",
    "settings": [
      {
        "type": "range",
        "id": "radius_small",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "t:labels.small_corner_radius",
        "default": 6
      },
      {
        "type": "range",
        "id": "radius_large",
        "min": 0,
        "max": 40,
        "step": 4,
        "unit": "px",
        "label": "t:labels.large_corner_radius",
        "default": 16
      }
    ]
  },
  {
    "name": "t:general.product_cards",
    "settings": [
      {
        "type": "range",
        "id": "catalog_columns",
        "min": 3,
        "max": 5,
        "step": 1,
        "label": "t:labels.catalog_columns",
        "default": 4
      },
      {
        "type": "range",
        "id": "card_image_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "t:labels.card_image_radius",
        "default": 10
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "t:labels.card_show_vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "t:labels.card_show_rating",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_discount",
        "label": "t:labels.card_show_discount",
        "default": true
      }
    ]
  }
]
