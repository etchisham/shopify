            "metafield_key_ar": "",
            "content_en": "<p>Product options may change the price and availability. Select your preferred options to see the current details.</p>",
            "content_ar": "<p>قد تتغير الأسعار وتوافر المنتج حسب الخيارات. حدد خياراتك المفضلة للاطلاع على التفاصيل الحالية.</p>",
            "open_by_default": false,
            "truncate_content": false,
            "show_highlights": false
          }
        },
