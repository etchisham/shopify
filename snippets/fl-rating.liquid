{%- liquid
  assign rating_value = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign rating_scale = product.metafields.reviews.rating.value.scale_max | default: 5
-%}
{%- if rating_value != blank and rating_count > 0 -%}
  <a
    class="fl-rating"
    href="{{ product.url }}#ProductReviews"
    aria-label="Rated {{ rating_value }} out of {{ rating_scale }} from {{ rating_count }} verified reviews"
  >
    <span class="fl-rating__stars" aria-hidden="true">★★★★★</span>
    <span>{{ rating_value }} · {{ rating_count }} verified</span>
  </a>
{%- endif -%}
