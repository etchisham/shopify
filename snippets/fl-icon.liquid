{%- case name -%}
  {%- when 'menu' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 17h16"/></svg>
  {%- when 'close' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18"/></svg>
  {%- when 'search' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
  {%- when 'account' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-4 3.1-6 7-6s6.2 2 7 6"/></svg>
  {%- when 'cart' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h2l2 10h9l2-7H7"/><circle cx="9" cy="19" r="1"/><circle cx="17" cy="19" r="1"/></svg>
  {%- when 'truck' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
  {%- when 'return' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 7H4v-4M4.5 7.5A8 8 0 1 1 4 16"/></svg>
  {%- when 'shield' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 5 6v5c0 4.5 2.5 7.5 7 10 4.5-2.5 7-5.5 7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
  {%- when 'support' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 15v-4a7 7 0 0 1 14 0v4M5 13H3v5h4v-5zM19 13h2v5h-4v-5zM17 19c-1 1-2.5 1.5-5 1.5"/></svg>
  {%- when 'plus' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14"/></svg>
  {%- when 'arrow' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
  {%- when 'check' -%}
    <svg class="fl-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12 4 4L19 6"/></svg>
{%- endcase -%}
