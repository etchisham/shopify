{%- liquid
  assign schema_can_render = settings.enable_merchant_schema
  if settings.schema_return_fees == 'ReturnShippingFees' and settings.schema_return_fee == blank
    assign schema_can_render = false
  endif
-%}
{%- if schema_can_render and request.page_type == 'index' -%}
  {%- assign organization_id = request.origin | append: '#organization' -%}
  {%- assign return_policy_id = request.origin | append: '#return-policy' -%}
  {%- assign schema_country = settings.schema_country | default: localization.country.iso_code -%}
  {%- assign schema_currency = settings.schema_currency | default: cart.currency.iso_code -%}
  {%- assign schema_return_link = settings.return_policy_url | default: '/policies/refund-policy' -%}
  {%- unless schema_return_link contains '://' -%}
    {%- assign schema_return_link = request.origin | append: schema_return_link -%}
  {%- endunless -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "OnlineStore",
      "@id": {{ organization_id | json }},
      "name": {{ shop.name | json }},
      "url": {{ request.origin | json }},
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "@id": {{ return_policy_id | json }},
        "applicableCountry": {{ schema_country | json }},
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": {{ settings.return_window_days | default: 30 | json }},
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/{{ settings.schema_return_fees }}",
        "merchantReturnLink": {{ schema_return_link | json }}{% if settings.schema_return_fees == 'ReturnShippingFees' %},
        "returnShippingFeesAmount": {
          "@type": "MonetaryAmount",
          "value": {{ settings.schema_return_fee | json }},
          "currency": {{ schema_currency | json }}
        }{% endif %}
      },
      "hasShippingService": {
        "@type": "ShippingService",
        "name": "Standard delivery",
        "fulfillmentType": "https://schema.org/FulfillmentTypeDelivery",
        "handlingTime": {
          "@type": "ServicePeriod",
          "duration": {
            "@type": "QuantitativeValue",
            "minValue": {{ settings.handling_days_min | default: 1 | json }},
            "maxValue": {{ settings.handling_days_max | default: 3 | json }},
            "unitCode": "DAY"
          }
        },
        "shippingConditions": {
          "@type": "ShippingConditions",
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": {{ schema_country | json }}
          },
          "transitTime": {
            "@type": "ServicePeriod",
            "duration": {
              "@type": "QuantitativeValue",
              "minValue": {{ settings.transit_days_min | default: 2 | json }},
              "maxValue": {{ settings.transit_days_max | default: 7 | json }},
              "unitCode": "DAY"
            }
          }
        }
      }
    }
  </script>
{%- endif -%}
