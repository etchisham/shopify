{% doc %}
  One product card wrapped with the data the Hilya filters need.
  Used by the collection page and the search page.

  @param {product} product - Product object.
{% enddoc %}

{% liquid
  assign product_colors = ''
  assign product_available = product.available

  for option in product.options_with_values
    if option.name == 'Color'
      for value in option.values
        assign product_colors = product_colors | append: value.name | append: '|'
      endfor
    endif
  endfor
%}

<div
  class="catalog-product-item"
  data-product-item
  data-product-type="{{ product.type | escape }}"
  data-product-price="{{ product.price | divided_by: 100.0 }}"
  data-product-available="{{ product_available }}"
  data-product-colors="{{ product_colors | escape }}"
>

  <script type="application/json" data-variant-data>
    [
      {% for variant in product.variants %}
        {
          "id": {{ variant.id | json }},
          "color": {{ variant.option1 | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "compare_at_price": {% if variant.compare_at_price %}{{ variant.compare_at_price | divided_by: 100.0 | json }}{% else %}null{% endif %},
          "available": {{ variant.available | json }},
          "url": {{ variant.url | json }},
          "image": {% if variant.featured_image %}{ "src": {{ variant.featured_image | image_url: width: 1200 | json }}, "alt": {{ variant.featured_image.alt | default: product.title | json }} }{% else %}null{% endif %},
          "images": [
            {%- assign variant_color = variant.option1 | downcase | strip -%}
            {%- assign matched_image_count = 0 -%}
            {%- for image in product.images -%}
              {%- assign image_alt = image.alt | default: '' | downcase -%}
              {%- if image_alt contains variant_color -%}
                {%- if matched_image_count > 0 -%},{%- endif -%}
                { "src": {{ image | image_url: width: 1200 | json }}, "alt": {{ image.alt | default: product.title | json }} }
                {%- assign matched_image_count = matched_image_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>

  {% render 'product-card',
    product: product,
    heading_level: 'h2',
    sizes: '(min-width: 1024px) 25vw, (min-width: 750px) 33vw, 50vw'
  %}

</div>

{% stylesheet %}

/* =========================================
   COLLECTION PAGE
========================================= */

.catalog-page__inner {
  width: 100%;
  padding-inline: clamp(1rem, 5vw, 5.5rem);
}


/* =========================================
   COLLECTION HEADER
========================================= */

.catalog-page__header {
  width: 100%;
  margin-inline: auto;
  margin-block-end: .9rem;
  text-align: center;
}

.catalog-page__title {
  margin: 0;
  color: var(--color-foreground);
  font-family: var(--font-heading-family, Georgia, serif);
  font-size: clamp(1.55rem, 2.15vw, 1.95rem);
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: .015em;
  text-transform: none;
}

.catalog-page__title::after {
  content: "";
  display: block;
  width: 2.1rem;
  height: 1px;
  margin: .65rem auto 0;
  background: #b18a51;
}


.catalog-page__description {
  max-width: 36rem;
  margin: .65rem auto 0;
  color: var(--color-muted);
  font-size: .78rem;
  line-height: 1.7;
}


/* =========================================
   TOOLBAR
========================================= */

.catalog-page__toolbar {
  width: 100%;
  margin: 0;
}


/* =========================================
   PRODUCT GRID
========================================= */

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: clamp(.7rem, 1.5vw, 1.5rem);
  row-gap: clamp(2.5rem, 4vw, 4.25rem);
  grid-area: products;
  align-self: start;
}

.catalog-product-item.is-filtered-out {
  display: none;
}


/* =========================================
   PAGINATION
   (server-rendered pages + the filtered
   pagination created by facets-toolbar.liquid
   share the same look)
========================================= */

.catalog-page__pagination {
  grid-area: pagination;
  display: flex;
  justify-content: center;
  margin-block-start: 4.5rem;
}

.hilya-pagination {
  display: inline-flex;
  max-width: 100%;
  margin: 0;
  padding: 0;
  list-style: none;
  border: 1px solid rgb(0 0 0 / 14%);
  border-radius: .6rem;
  overflow: hidden;
}

.hilya-pagination > li {
  display: flex;
  margin: 0;
  padding: 0;
}

.hilya-pagination > li + li {
  border-inline-start: 1px solid rgb(0 0 0 / 14%);
}

.hilya-pagination__item {
  display: grid;
  min-width: 3rem;
  height: 3rem;
  place-items: center;
  margin: 0;
  padding: 0 .7rem;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--color-foreground);
  font: inherit;
  font-size: .78rem;
  font-weight: 600;
  line-height: 1;
  text-decoration: none;
  cursor: pointer;
  transition: background 160ms ease;
}

a.hilya-pagination__item:hover,
button.hilya-pagination__item:hover:not(:disabled) {
  background: rgb(0 0 0 / 4%);
}

.hilya-pagination__item:focus-visible {
  outline-offset: -.2rem;
}

.hilya-pagination__item.is-current {
  outline: 2px solid var(--color-foreground);
  outline-offset: -2px;
  cursor: default;
}

.hilya-pagination__item.is-ellipsis {
  cursor: default;
}

.hilya-pagination__item.is-disabled,
.hilya-pagination__item:disabled {
  opacity: .3;
  cursor: default;
  pointer-events: none;
}

.hilya-pagination__item svg {
  width: 1rem;
  height: 1rem;
}

[dir='rtl'] .hilya-pagination__item--arrow svg {
  transform: scaleX(-1);
}


/* =========================================
   EMPTY COLLECTION
========================================= */

.catalog-page__empty {
  max-width: 36rem;
  margin: 3rem auto;
  padding: 3rem 1.5rem;
  border: 1px solid rgb(0 0 0 / 8%);
  text-align: center;
  color: var(--color-muted);
}


/* =========================================
   DESKTOP
========================================= */

@media (min-width: 40.001rem) {

  .catalog-page {
    margin-top: -3rem;
  }

  .catalog-page__inner {
    display: grid;
    grid-template-columns:
      minmax(10rem, 11.25rem)
      minmax(0, 1fr);

    grid-template-areas:
      "header header"
      "sidebar toolbar"
      "sidebar products"
      "sidebar pagination";

    column-gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .catalog-page__header {
    grid-area: header;
  }

  .catalog-page__toolbar {
    display: contents;
  }

  .hilya-filters {
    display: contents;
  }

  .catalog-page__pagination {
    margin-block-start: 4rem;
  }

}


/* =========================================
   3 COLUMNS
========================================= */

@media (min-width: 46.875rem) {

  .catalog-grid {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

}


/* =========================================
   4 COLUMNS
========================================= */

@media (min-width: 64rem) {

  .catalog-grid {
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
  }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 40rem) {

  .catalog-page {
    margin-top: -2rem;
  }
  .catalog-page__inner {
    padding-inline: 1rem;
  }

  .catalog-page__header {
    margin-block-end: .55rem;
  }

  .catalog-page__title {
    font-size: clamp(1.4rem, 7vw, 1.85rem);
    letter-spacing: .045em;
  }

  .catalog-page__description {
    margin-top: .6rem;
    font-size: .74rem;
  }

  .catalog-page__toolbar {
    margin-block-end: .65rem;
  }

  .catalog-grid {
    column-gap: .7rem;
    row-gap: 2.75rem;
  }

  .catalog-page__pagination {
    margin-block-start: 3.5rem;
  }

  .hilya-pagination__item {
    min-width: 2.5rem;
    height: 2.6rem;
    padding: 0 .45rem;
    font-size: .72rem;
  }

}


/* =========================================
   SMALL MOBILE
========================================= */

@media (max-width: 27rem) {

  .catalog-page__inner {
    padding-inline: .8rem;
  }

  .catalog-grid {
    column-gap: .6rem;
  }

  .hilya-pagination__item {
    min-width: 2.15rem;
    padding: 0 .3rem;
  }

}


/* =========================================
   REDUCED MOTION
========================================= */

@media (prefers-reduced-motion: reduce) {

  .hilya-pagination__item {
    transition: none;
  }

}

{% endstylesheet %}
