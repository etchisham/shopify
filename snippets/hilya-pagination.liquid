{%- comment -%}
  Hilya editorial pagination (draggable).
  Usage: {% render 'hilya-pagination', paginate: paginate %}
  Keeps the active filters/sort in every link.

  The line shows 5 numbers at most:
    1 page   -> one number above a dot, no line
    2 pages  -> one at each end
    3-5      -> evenly spaced
    6+       -> [first] [prev] [CURRENT] [next] [last]
                (first page always at the start, last page always at the end,
                 the middle three follow the page you are on)

  Rounded box under the line: opens ALL pages in a row of 5; with more than 5
  pages it scrolls (drag with mouse / touch, or small rose-gold arrows that
  hide at the ends).
  Without JavaScript every tick on the line is a normal link.
  Arabic: Arabic-Indic digits, no leading zero.
{%- endcomment -%}

{%- if paginate.pages >= 1 -%}
  {%- liquid
    assign total = paginate.pages
    assign current = paginate.current_page

    assign url_prefix = ''
    assign url_rest = ''

    if total > 1
      if paginate.next.is_link
        assign ref_url = paginate.next.url
        assign ref_page = current | plus: 1
      else
        assign ref_url = paginate.previous.url
        assign ref_page = current | minus: 1
      endif

      assign ref_page_str = ref_page | append: ''
      assign ref_split = ref_url | split: 'page='
      assign url_prefix = ref_split.first
      assign url_rest = ref_split.last | remove_first: ref_page_str
    endif

    assign is_ar = false
    if request.locale.iso_code contains 'ar'
      assign is_ar = true
    endif
    assign ar_digits = '٠,١,٢,٣,٤,٥,٦,٧,٨,٩' | split: ','

    assign label_string = ''
    for i in (1..total)
      assign s = i | append: ''
      if is_ar
        for d in (0..9)
          assign d_str = d | append: ''
          assign s = s | replace: d_str, ar_digits[d]
        endfor
      elsif i < 10
        assign s = '0' | append: s
      endif
      assign label_string = label_string | append: s | append: '|'
    endfor
    assign labels = label_string | split: '|'

    assign cur_idx = current | minus: 1
    assign cur_label = labels[cur_idx]

    comment
      Which pages are drawn on the line (5 at most).
    endcomment
    assign slot_str = ''
    if total <= 5
      for i in (1..total)
        assign s = i | append: ','
        assign slot_str = slot_str | append: s
      endfor
    else
      assign hi = total | minus: 2
      assign c = current
      if c < 3
        assign c = 3
      endif
      if c > hi
        assign c = hi
      endif
      assign cm = c | minus: 1
      assign cp = c | plus: 1
      assign slot_str = '1,' | append: cm | append: ',' | append: c | append: ',' | append: cp | append: ',' | append: total | append: ','
    endif
    assign slots = slot_str | split: ','
    assign n_slots = slots.size
    assign last_slot = n_slots | minus: 1

    assign active_idx = 0
    for sl in slots
      assign sp = sl | plus: 0
      if sp == current
        assign active_idx = forloop.index0
      endif
    endfor

    if last_slot > 0
      assign pct = active_idx | times: 100.0 | divided_by: last_slot | round: 2
    else
      assign pct = 50
    endif
  -%}

  <div class="catalog-page__pagination">
    {%- if total == 1 -%}
      <nav class="hp hp--single" aria-label="{{ 'collections.pagination' | t | escape }}">
        <div class="hp__single">
          <span class="hp__n hp__n--single">{{ cur_label }}</span>
          <span class="hp__dot hp__dot--static" aria-hidden="true"></span>
        </div>
      </nav>
    {%- else -%}
    <nav class="hp hp--ticks" aria-label="{{ 'collections.pagination' | t | escape }}">

      <div class="hp__bar">

        {%- comment %} PREVIOUS {% endcomment -%}
        {%- if paginate.previous.is_link -%}
          <a class="hp__arrow hp__arrow--prev" href="{{ paginate.previous.url }}" aria-label="{{ 'collections.previous_page' | t | escape }}">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          </a>
        {%- else -%}
          <span class="hp__arrow hp__arrow--prev is-disabled" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          </span>
        {%- endif -%}

        {%- comment %} LINE: ticks are real links (with their number); the dot is the draggable handle {% endcomment -%}
        <div class="hp__track" style="--hp-p: {{ pct }}%">
          <span class="hp__fill" aria-hidden="true"></span>

          {%- for sl in slots -%}
            {%- assign sp = sl | plus: 0 -%}
            {%- assign seg_pct = forloop.index0 | times: 100.0 | divided_by: last_slot | round: 2 -%}
            {%- assign lbl_idx = sp | minus: 1 -%}
            {%- assign lbl = labels[lbl_idx] -%}
            <a class="hp__seg{% if sp == current %} is-on{% endif %}" style="--hp-s: {{ seg_pct }}%" href="{{ url_prefix }}page={{ sp }}{{ url_rest }}" data-n="{{ lbl }}" aria-label="{{ 'meta.page' | t: number: sp | escape }}"{% if sp == current %} aria-current="page"{% endif %}><span class="hp__n" aria-hidden="true">{{ lbl }}</span></a>
          {%- endfor -%}

          <span class="hp__dot" role="slider" tabindex="0" aria-orientation="horizontal" aria-label="{{ 'collections.pagination' | t | escape }}" aria-valuemin="1" aria-valuemax="{{ total }}" aria-valuenow="{{ current }}"></span>
        </div>

        {%- comment %} NEXT {% endcomment -%}
        {%- if paginate.next.is_link -%}
          <a class="hp__arrow hp__arrow--next" href="{{ paginate.next.url }}" aria-label="{{ 'collections.next_page' | t | escape }}">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- else -%}
          <span class="hp__arrow hp__arrow--next is-disabled" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        {%- endif -%}

      </div>

      {%- comment %} CURRENT PAGE: rounded box in the middle, opens the row of all pages {% endcomment -%}
      <div class="hp__foot">
        <details class="hp__jump">
          <summary class="hp__badge" aria-label="{{ 'meta.page' | t: number: current | escape }}">
            <span class="hp__badge-num">{{ cur_label }}</span>
          </summary>
          <div class="hp__grid">
            {%- if total > 5 -%}
              <button type="button" class="hp__sarrow hp__sarrow--prev" aria-label="{{ 'collections.previous_page' | t | escape }}">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
              </button>
            {%- endif -%}
            <div class="hp__strip">
              {%- for i in (1..total) -%}
                <a href="{{ url_prefix }}page={{ i }}{{ url_rest }}"{% if i == current %} aria-current="page" class="is-current"{% endif %}>{{ labels[forloop.index0] }}</a>
              {%- endfor -%}
            </div>
            {%- if total > 5 -%}
              <button type="button" class="hp__sarrow hp__sarrow--next" aria-label="{{ 'collections.next_page' | t | escape }}">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
              </button>
            {%- endif -%}
          </div>
        </details>
      </div>

    </nav>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .hp {
    --hp-accent: #b87f6f;       /* rose gold */
    --hp-accent-deep: #8f5a4b;  /* text on the rose box */
    --hp-line: #e6dccb;
    --hp-muted: #9a948a;
    --hp-y: 70%;                /* height of the line inside the track */
    --hp-font: Georgia, 'Times New Roman', Times, serif;
    --hp-dir: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    padding: 0.5rem 1rem 0.6rem;
    color: var(--color-foreground, #1c1b19);
    -webkit-user-select: none;
    user-select: none;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  [dir='rtl'] .hp {
    --hp-dir: -1;
    --hp-font: inherit;
  }

  .hp__bar {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    width: 100%;
  }

  :where(.hp) button {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }

  /* Arrows */
  .hp__arrow {
    display: inline-grid;
    place-items: center;
    padding: 0.4rem;
    color: inherit;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .hp__arrow:is(a, button):not(:disabled):hover,
  .hp__arrow:is(a, button):not(:disabled):focus-visible {
    color: var(--hp-accent);
  }

  .hp__arrow--prev:is(a, button):not(:disabled):hover {
    transform: translateX(calc(-4px * var(--hp-dir)));
  }

  .hp__arrow--next:is(a, button):not(:disabled):hover {
    transform: translateX(calc(4px * var(--hp-dir)));
  }

  .hp__arrow.is-disabled,
  .hp__arrow:disabled {
    opacity: 0.25;
  }

  [dir='rtl'] .hp__arrow svg {
    transform: scaleX(-1);
  }

  /* Line */
  .hp__track {
    position: relative;
    display: block;
    flex: 1;
    min-width: 0;
    height: 3.4rem;
    touch-action: pan-y;
  }

  .hp--js .hp__track {
    cursor: pointer;
  }

  .hp__track::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: var(--hp-y);
    height: 1px;
    background: var(--hp-line);
  }

  .hp__fill {
    position: absolute;
    inset-inline-start: 0;
    top: var(--hp-y);
    width: var(--hp-p);
    height: 1px;
    background: var(--hp-accent);
    transition: width 0.2s ease;
    animation: hp-grow 0.6s ease both;
  }

  /* One tick per drawn page (5 at most). Each is a real link (works without JavaScript) */
  .hp .hp__seg {
    position: absolute;
    inset-inline-start: var(--hp-s);
    top: 0;
    bottom: 0;
    z-index: 1;
    display: block;
    width: 2.5rem;
    min-width: 0;
    min-height: 0;
    padding: 0;
    transform: translateX(calc(-50% * var(--hp-dir)));
  }

  .hp--ticks .hp__seg::before {
    content: '';
    position: absolute;
    top: var(--hp-y);
    left: 50%;
    width: 1px;
    height: 7px;
    background: var(--hp-line);
    transform: translate(-50%, -50%);
  }

  /* Small dim page number above each tick; lights up when the dot is on it.
     Same style on phone and computer. */
  .hp .hp__n {
    position: absolute;
    left: 50%;
    bottom: calc(100% - var(--hp-y) + 0.75rem);
    transform: translateX(-50%);
    font-family: var(--hp-font);
    font-size: 0.78rem;
    font-weight: 400;
    font-style: normal;
    font-variant-numeric: oldstyle-nums;
    line-height: 1;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--hp-muted);
    opacity: 0.55;
    transform-origin: 50% 100%;
    transition: color 0.15s ease, opacity 0.15s ease, transform 0.15s ease;
  }

  .hp .hp__seg.is-on .hp__n {
    color: var(--hp-accent);
    opacity: 1;
    transform: translateX(-50%) translateY(-0.3rem) scale(1.45);
  }

  /* With JavaScript the whole line is the drag area */
  .hp--js .hp__seg {
    pointer-events: none;
  }

  /* The handle */
  .hp__dot {
    position: absolute;
    inset-inline-start: var(--hp-p);
    top: var(--hp-y);
    z-index: 3;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--hp-accent);
    transform: translate(calc(-50% * var(--hp-dir)), -50%);
    transition: inset-inline-start 0.2s ease, box-shadow 0.2s ease;
    animation: hp-slide 0.6s ease both;
  }

  .hp--js .hp__dot {
    cursor: grab;
  }

  /* While dragging it sticks to the pointer: no easing at all */
  .hp.is-dragging .hp__dot,
  .hp.is-dragging .hp__fill {
    transition: none;
    animation: none;
  }

  .hp.is-dragging,
  .hp.is-dragging .hp__track,
  .hp.is-dragging .hp__dot {
    cursor: grabbing;
  }

  .hp.is-dragging .hp__dot {
    box-shadow: 0 0 0 7px rgb(184 127 111 / 18%);
  }

  .hp__dot:focus-visible {
    outline: 1px solid var(--hp-accent);
    outline-offset: 5px;
  }

  /* Only one page: the number sits above a dot, no line */
  .hp__single {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 0 0.2rem;
  }

  .hp .hp__n--single {
    position: static;
    transform: none;
    color: var(--hp-accent);
    opacity: 1;
    font-size: 1.1rem;
  }

  .hp__dot--static {
    position: static;
    transform: none;
    animation: none;
  }

  @keyframes hp-grow {
    from { width: 0; }
  }

  @keyframes hp-slide {
    from { inset-inline-start: 0; }
  }

  /* Current page: rounded box in the middle, under the line */
  .hp__foot {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .hp__jump {
    position: relative;
  }

  /* The number in the box: plain site font (not the serif of the line) */
  .hp__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 3.3rem;
    padding: 0.36rem 0.7rem;
    border: 1px solid rgb(184 127 111 / 30%);
    border-radius: 0.75rem;
    background: rgb(184 127 111 / 11%);
    color: var(--hp-accent-deep);
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 400;
    font-variant-numeric: normal;
    line-height: 1;
    letter-spacing: 0;
    cursor: pointer;
    list-style: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .hp__badge::-webkit-details-marker {
    display: none;
  }

  .hp__badge::after {
    content: '';
    width: 0.36rem;
    height: 0.36rem;
    margin-top: -0.18rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease, margin 0.2s ease;
  }

  .hp__badge:hover,
  .hp__jump[open] .hp__badge {
    background: rgb(184 127 111 / 18%);
    border-color: rgb(184 127 111 / 50%);
  }

  .hp__jump[open] .hp__badge::after {
    margin-top: 0.18rem;
    transform: rotate(-135deg);
  }

  .hp__badge:focus-visible {
    outline: 1px solid var(--hp-accent);
    outline-offset: 3px;
  }

  /* All pages: a row of 5 numbers (opens under the box) */
  .hp__grid {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    z-index: 10;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--hp-line);
    border-radius: 0.9rem;
    background: var(--color-background, #fffcf7);
    box-shadow: 0 10px 28px rgb(60 40 30 / 10%);
    transform: translateX(calc(-50% + var(--hp-shift, 0px)));
  }

  .hp__strip {
    display: flex;
    gap: 0.2rem;
    max-width: calc(5 * 2.6rem + 4 * 0.2rem); /* never more than 5 numbers visible */
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    touch-action: pan-x;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    position: relative;
  }

  .hp__strip::-webkit-scrollbar {
    display: none;
  }

  .hp__strip.is-grabbing {
    cursor: grabbing;
  }

  .hp__strip a {
    flex: 0 0 2.6rem;
    display: grid;
    place-items: center;
    height: 2.4rem;
    border-bottom: 1px solid transparent;
    font-family: var(--hp-font);
    font-variant-numeric: oldstyle-nums;
    font-size: 0.95rem;
    color: var(--hp-muted);
    -webkit-user-drag: none;
    user-select: none;
  }

  .hp__strip a:hover {
    color: var(--color-foreground, #1c1b19);
    border-color: var(--hp-line);
  }

  .hp__strip .is-current {
    color: var(--hp-accent-deep);
    border-color: var(--hp-accent);
  }

  /* Small rose-gold circles, half inside the box and half outside */
  .hp .hp__sarrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    min-width: 0;
    min-height: 0;
    padding: 0;
    border-radius: 50%;
    background: var(--hp-accent);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 2px 8px rgb(60 40 30 / 18%);
    transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }

  .hp .hp__sarrow--prev {
    left: 0;
    transform: translate(-50%, -50%);
  }

  .hp .hp__sarrow--next {
    right: 0;
    transform: translate(50%, -50%);
  }

  .hp .hp__sarrow:hover {
    background: var(--hp-accent-deep);
  }

  .hp .hp__sarrow.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .hp a:focus-visible,
  .hp button:focus-visible {
    outline: 1px solid var(--hp-accent);
    outline-offset: 3px;
  }

  @media (max-width: 40rem) {
    .hp {
      padding-inline: 0.75rem;
    }

    .hp__bar {
      gap: 0.7rem;
    }

    .hp .hp__n {
      font-size: 0.78rem;
      opacity: 0.55;
    }

    .hp .hp__seg.is-on .hp__n {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp__fill,
    .hp__dot {
      animation: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function markReady() {
      document.querySelectorAll('.hp').forEach(function (nav) {
        nav.classList.add('hp--js');
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', markReady);
    } else {
      markReady();
    }

    /* the filtered pagination is drawn later by the filters script */
    document.addEventListener('hp:rendered', markReady);


    /* ---------- box with all pages ---------- */

    document.addEventListener('click', function (e) {
      document.querySelectorAll('.hp__jump[open]').forEach(function (d) {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
    });

    /* 0 at the physical left edge ... max at the physical right edge (also in RTL) */
    function stripPos(strip) {
      var max = strip.scrollWidth - strip.clientWidth;
      var rtl = window.getComputedStyle(strip).direction === 'rtl';
      return { pos: rtl ? max + strip.scrollLeft : strip.scrollLeft, max: max };
    }

    function updateStripArrows(grid) {
      var strip = grid.querySelector('.hp__strip');
      if (!strip) return;

      var s = stripPos(strip);
      var prev = grid.querySelector('.hp__sarrow--prev');
      var next = grid.querySelector('.hp__sarrow--next');

      if (prev) prev.classList.toggle('is-hidden', s.pos <= 1);
      if (next) next.classList.toggle('is-hidden', s.pos >= s.max - 1);
    }

    document.addEventListener('toggle', function (e) {
      var d = e.target;
      if (!d.classList || !d.classList.contains('hp__jump') || !d.open) return;

      var grid = d.querySelector('.hp__grid');
      if (!grid) return;

      /* keep the box inside the screen (the arrows stick out a little) */
      grid.style.setProperty('--hp-shift', '0px');
      var r = grid.getBoundingClientRect();
      var m = 20;
      var shift = 0;
      if (r.left < m) shift = m - r.left;
      else if (r.right > window.innerWidth - m) shift = window.innerWidth - m - r.right;
      grid.style.setProperty('--hp-shift', shift + 'px');

      /* bring the current page to the middle of the row */
      var strip = grid.querySelector('.hp__strip');
      var cur = strip && strip.querySelector('.is-current');
      if (strip && cur) {
        var a = cur.getBoundingClientRect();
        var b = strip.getBoundingClientRect();
        strip.scrollLeft += (a.left + a.width / 2) - (b.left + b.width / 2);
      }

      updateStripArrows(grid);
    }, true);

    /* the row scrolled (drag, touch, arrows) */
    document.addEventListener('scroll', function (e) {
      var strip = e.target;
      if (!strip || !strip.classList || !strip.classList.contains('hp__strip')) return;
      updateStripArrows(strip.closest('.hp__grid'));
    }, true);

    /* small arrows: move the row by 3 numbers */
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.hp__sarrow');
      if (!btn) return;

      var grid = btn.closest('.hp__grid');
      var strip = grid && grid.querySelector('.hp__strip');
      if (!strip) return;

      var dir = btn.classList.contains('hp__sarrow--next') ? 1 : -1;
      strip.scrollBy({ left: dir * 3 * 2.8 * 16, behavior: 'smooth' });
    });

    /* mouse: hold the left button and drag the row (touch scrolls by itself) */
    var rowDrag = null;
    var blockClick = false;

    document.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;

      var strip = e.target.closest && e.target.closest('.hp__strip');
      if (!strip) return;

      rowDrag = { strip: strip, x: e.clientX, left: strip.scrollLeft, moved: false };
    });

    document.addEventListener('pointermove', function (e) {
      if (!rowDrag) return;

      var dx = e.clientX - rowDrag.x;

      if (!rowDrag.moved && Math.abs(dx) > 4) {
        rowDrag.moved = true;
        rowDrag.strip.classList.add('is-grabbing');
      }

      if (rowDrag.moved) {
        rowDrag.strip.scrollLeft = rowDrag.left - dx;
        e.preventDefault();
      }
    });

    function endRowDrag() {
      if (!rowDrag) return;

      rowDrag.strip.classList.remove('is-grabbing');
      if (rowDrag.moved) {
        blockClick = true;
        setTimeout(function () { blockClick = false; }, 0);
      }
      rowDrag = null;
    }

    document.addEventListener('pointerup', endRowDrag);
    document.addEventListener('pointercancel', endRowDrag);

    /* a drag must not open the page under the mouse */
    document.addEventListener('click', function (e) {
      if (blockClick && e.target.closest && e.target.closest('.hp__strip')) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    document.addEventListener('dragstart', function (e) {
      if (e.target.closest && e.target.closest('.hp__strip')) e.preventDefault();
    });


    /* ---------- dragging the dot on the line ---------- */

    var drag = null;
    var settleTimer = null;

    function ticksOf(track) {
      return track.querySelectorAll('.hp__seg');
    }

    function currentIndex(ticks) {
      for (var i = 0; i < ticks.length; i++) {
        if (ticks[i].getAttribute('aria-current') === 'page') return i;
      }
      return 0;
    }

    function isRtl(track) {
      return window.getComputedStyle(track).direction === 'rtl';
    }

    /* 0 (first drawn page) ... 1 (last drawn page), straight from the pointer position */
    function fractionFromPointer(track, clientX, offset) {
      var rect = track.getBoundingClientRect();
      var x = clientX + offset;
      var fraction = isRtl(track)
        ? (rect.right - x) / rect.width
        : (x - rect.left) / rect.width;
      return Math.min(1, Math.max(0, fraction));
    }

    /* Move the dot and light up the number it is nearest to */
    function show(track, ticks, fraction) {
      track.style.setProperty('--hp-p', fraction * 100 + '%');

      var index = Math.round(fraction * (ticks.length - 1));

      for (var i = 0; i < ticks.length; i++) {
        ticks[i].classList.toggle('is-on', i === index);
      }

      var nav = track.closest('.hp');
      var badge = nav && nav.querySelector('.hp__badge-num');
      if (badge) badge.textContent = ticks[index].getAttribute('data-n');

      var dot = track.querySelector('.hp__dot');
      if (dot) dot.setAttribute('aria-valuenow', ticks[index].getAttribute('data-page') || index + 1);

      return index;
    }

    function finish(commit) {
      if (!drag) return;

      var state = drag;
      drag = null;

      state.nav.classList.remove('is-dragging');

      var target = commit ? state.index : state.start;
      show(state.track, state.ticks, target / (state.ticks.length - 1));

      if (commit && target !== state.start) {
        settleTimer = setTimeout(function () {
          state.ticks[target].click();
        }, 170);
      }
    }

    document.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'mouse' && e.button !== 0) return;

      var track = e.target.closest && e.target.closest('.hp__track');
      if (!track) return;

      var ticks = ticksOf(track);
      if (ticks.length < 2) return;

      clearTimeout(settleTimer);

      /* grabbing the dot off-centre must not make it jump */
      var offset = 0;
      var dot = e.target.closest('.hp__dot');

      if (dot) {
        var box = dot.getBoundingClientRect();
        offset = (box.left + box.right) / 2 - e.clientX;
      }

      var fraction = fractionFromPointer(track, e.clientX, offset);

      drag = {
        track: track,
        nav: track.closest('.hp'),
        ticks: ticks,
        start: currentIndex(ticks),
        index: 0,
        offset: offset,
        pointerId: e.pointerId
      };

      try {
        track.setPointerCapture(e.pointerId);
      } catch (error) {}

      drag.nav.classList.add('is-dragging');
      drag.index = show(track, ticks, fraction);
      e.preventDefault();
    });

    document.addEventListener('pointermove', function (e) {
      if (!drag || e.pointerId !== drag.pointerId) return;

      drag.index = show(
        drag.track,
        drag.ticks,
        fractionFromPointer(drag.track, e.clientX, drag.offset)
      );
    });

    document.addEventListener('pointerup', function (e) {
      if (drag && e.pointerId === drag.pointerId) finish(true);
    });

    document.addEventListener('pointercancel', function (e) {
      if (drag && e.pointerId === drag.pointerId) finish(false);
    });

    /* Keyboard: arrows move one drawn page, Home / End jump to the first / last */
    document.addEventListener('keydown', function (e) {
      var dot = e.target.closest && e.target.closest('.hp__dot');
      if (!dot || !dot.closest('.hp__track')) return;

      var track = dot.closest('.hp__track');
      var ticks = ticksOf(track);
      var current = currentIndex(ticks);
      var rtl = isRtl(track);
      var next = current;

      if (e.key === 'ArrowRight') next = current + (rtl ? -1 : 1);
      else if (e.key === 'ArrowLeft') next = current + (rtl ? 1 : -1);
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = ticks.length - 1;
      else return;

      next = Math.min(ticks.length - 1, Math.max(0, next));
      e.preventDefault();

      if (next !== current) ticks[next].click();
    });
  })();
{% endjavascript %}
