{%- comment -%}
  Hilya editorial pagination.
  Usage: {% render 'hilya-pagination', paginate: paginate %}
  Works for any number of pages. Keeps the active filters/sort in every link.

  Layout:  <  01  ────────●────────  15  >
                           07
  The current page number sits under the dot on the line.
  Arabic: Arabic-Indic digits, no leading zero.
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
  {%- liquid
    assign total = paginate.pages
    assign current = paginate.current_page
    assign current_idx = current | minus: 1

    if paginate.next.is_link
      assign ref_url = paginate.next.url
      assign ref_page = current | plus: 1
    else
      assign ref_url = paginate.previous.url
      assign ref_page = current | minus: 1
    endif

    assign ref_page_str = ref_page | append: ''
    assign ref_split = ref_url | split: 'page='
    assign url_prefix = ref_split.first
    assign url_rest = ref_split.last | remove_first: ref_page_str

    assign is_ar = false
    if request.locale.iso_code contains 'ar'
      assign is_ar = true
    endif
    assign ar_digits = '٠,١,٢,٣,٤,٥,٦,٧,٨,٩' | split: ','

    assign label_string = ''
    for i in (1..total)
      assign s = i | append: ''
      if is_ar
        for d in (0..9)
          assign d_str = d | append: ''
          assign s = s | replace: d_str, ar_digits[d]
        endfor
      elsif i < 10
        assign s = '0' | append: s
      endif
      assign label_string = label_string | append: s | append: '|'
    endfor
    assign labels = label_string | split: '|'

    assign cur_label = labels[current_idx]
    assign first_label = labels.first
    assign last_label = labels.last

    assign pct = current | minus: 0.5 | times: 100.0 | divided_by: total | round: 2
  -%}

  <div class="catalog-page__pagination">
    <nav class="hp" aria-label="{{ 'collections.pagination' | t | escape }}">

      {%- comment %} PREVIOUS {% endcomment -%}
      {%- if paginate.previous.is_link -%}
        <a class="hp__arrow hp__arrow--prev" href="{{ paginate.previous.url }}" aria-label="{{ 'collections.previous_page' | t | escape }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        </a>
      {%- else -%}
        <span class="hp__arrow hp__arrow--prev is-disabled" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        </span>
      {%- endif -%}

      {%- comment %} FIRST PAGE {% endcomment -%}
      {%- if current == 1 -%}
        <span class="hp__num">{{ first_label }}</span>
      {%- else -%}
        <a class="hp__num" href="{{ url_prefix }}page=1{{ url_rest }}" aria-label="{{ 'meta.page' | t: number: 1 | escape }}">{{ first_label }}</a>
      {%- endif -%}

      {%- comment %} LINE: every segment is a real link to a page {% endcomment -%}
      <div class="hp__track" style="--hp-p: {{ pct }}%">
        <span class="hp__fill" aria-hidden="true"></span>
        <span class="hp__dot" aria-hidden="true"></span>

        {%- for i in (1..total) -%}
          <a class="hp__seg" href="{{ url_prefix }}page={{ i }}{{ url_rest }}" data-n="{{ labels[forloop.index0] }}" aria-label="{{ 'meta.page' | t: number: i | escape }}"{% if i == current %} aria-current="page"{% endif %}></a>
        {%- endfor -%}

        {%- comment %} CURRENT PAGE under the dot (opens a jump grid when there are 3+ pages) {% endcomment -%}
        {%- if total > 2 -%}
          <details class="hp__marker hp__jump">
            <summary class="hp__current" aria-label="{{ 'meta.page' | t: number: current | escape }}">{{ cur_label }}</summary>
            <div class="hp__grid">
              {%- for i in (1..total) -%}
                <a href="{{ url_prefix }}page={{ i }}{{ url_rest }}"{% if i == current %} aria-current="page" class="is-current"{% endif %}>{{ labels[forloop.index0] }}</a>
              {%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <div class="hp__marker">
            <span class="hp__current" aria-current="page">{{ cur_label }}</span>
          </div>
        {%- endif -%}
      </div>

      {%- comment %} LAST PAGE {% endcomment -%}
      {%- if current == total -%}
        <span class="hp__num">{{ last_label }}</span>
      {%- else -%}
        <a class="hp__num" href="{{ url_prefix }}page={{ total }}{{ url_rest }}" aria-label="{{ 'meta.page' | t: number: total | escape }}">{{ last_label }}</a>
      {%- endif -%}

      {%- comment %} NEXT {% endcomment -%}
      {%- if paginate.next.is_link -%}
        <a class="hp__arrow hp__arrow--next" href="{{ paginate.next.url }}" aria-label="{{ 'collections.next_page' | t | escape }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- else -%}
        <span class="hp__arrow hp__arrow--next is-disabled" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      {%- endif -%}

    </nav>
  </div>
{%- endif -%}

{% stylesheet %}
  .hp {
    --hp-accent: #b87f6f; /* rose gold */
    --hp-line: #e6dccb;
    --hp-muted: #9a948a;
    --hp-font: Georgia, 'Times New Roman', serif;
    --hp-dir: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    width: 100%;
    max-width: 36rem;
    margin: 0 auto;
    padding: 0 1rem 2.2rem;
    color: var(--color-foreground, #1c1b19);
  }

  [dir='rtl'] .hp {
    --hp-dir: -1;
    --hp-font: inherit;
  }

  :where(.hp) button {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }

  /* Arrows */
  .hp__arrow {
    display: inline-grid;
    place-items: center;
    padding: 0.4rem;
    color: inherit;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .hp__arrow:is(a, button):not(:disabled):hover,
  .hp__arrow:is(a, button):not(:disabled):focus-visible {
    color: var(--hp-accent);
  }

  .hp__arrow--prev:is(a, button):not(:disabled):hover {
    transform: translateX(calc(-4px * var(--hp-dir)));
  }

  .hp__arrow--next:is(a, button):not(:disabled):hover {
    transform: translateX(calc(4px * var(--hp-dir)));
  }

  .hp__arrow.is-disabled,
  .hp__arrow:disabled {
    opacity: 0.25;
  }

  [dir='rtl'] .hp__arrow svg {
    transform: scaleX(-1);
  }

  /* Edge numbers (first / last page) */
  .hp__num {
    font-family: var(--hp-font);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    line-height: 1;
    padding: 0;
    color: var(--hp-muted);
    transition: color 0.25s ease;
  }

  .hp__num:is(a, button) {
    cursor: pointer;
  }

  .hp__num:is(a, button):hover {
    color: var(--hp-accent);
  }

  [dir='rtl'] .hp__num {
    font-size: 1.05rem;
    letter-spacing: 0;
  }

  /* Line */
  .hp__track {
    position: relative;
    display: flex;
    flex: 1;
    min-width: 0;
    height: 1.75rem;
  }

  .hp__track::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 50%;
    height: 1px;
    background: var(--hp-line);
  }

  .hp__fill {
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    width: var(--hp-p);
    height: 1px;
    background: var(--hp-accent);
    animation: hp-grow 0.6s ease both;
  }

  .hp__dot {
    position: absolute;
    inset-inline-start: var(--hp-p);
    top: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--hp-accent);
    transform: translate(calc(-50% * var(--hp-dir)), -50%);
    animation: hp-slide 0.6s ease both;
  }

  @keyframes hp-grow {
    from { width: 0; }
  }

  @keyframes hp-slide {
    from { inset-inline-start: 0; }
  }

  .hp__seg {
    display: block;
    position: relative;
    z-index: 1;
    flex: 1;
    min-width: 0;
    padding: 0;
  }

  .hp__seg:hover::before,
  .hp__seg:focus-visible::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 50%;
    height: 1px;
    background: var(--hp-accent);
    opacity: 0.55;
  }

  .hp__seg:hover::after,
  .hp__seg:focus-visible::after {
    content: attr(data-n);
    position: absolute;
    top: -0.35rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--hp-font);
    font-size: 0.75rem;
    color: var(--hp-accent);
  }

  /* Current page: zero-size anchor on the dot, number hangs under it */
  .hp__marker {
    position: absolute;
    top: 50%;
    inset-inline-start: var(--hp-p);
    z-index: 2;
    width: 0;
    height: 0;
    animation: hp-slide 0.6s ease both;
  }

  .hp__current {
    position: absolute;
    top: 0.95rem;
    inset-inline-start: 0;
    transform: translateX(calc(-50% * var(--hp-dir)));
    font-family: var(--hp-font);
    font-size: 1.2rem;
    letter-spacing: 0.05em;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-foreground, #1c1b19);
    list-style: none;
  }

  [dir='rtl'] .hp__current {
    font-size: 1.35rem;
    letter-spacing: 0;
  }

  summary.hp__current {
    cursor: pointer;
    transition: color 0.25s ease;
  }

  summary.hp__current::-webkit-details-marker {
    display: none;
  }

  summary.hp__current:hover,
  .hp__jump[open] summary.hp__current {
    color: var(--hp-accent);
  }

  /* Jump grid (opens under the number) */
  .hp__grid {
    position: absolute;
    top: 2.9rem;
    inset-inline-start: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: repeat(5, 2.6rem);
    gap: 0.2rem;
    padding: 0.75rem;
    border: 1px solid var(--hp-line);
    border-radius: 0.75rem;
    background: var(--color-background, #fffcf7);
    transform: translateX(calc(-50% * var(--hp-dir) + var(--hp-shift, 0px)));
  }

  .hp__grid :is(a, button) {
    display: grid;
    place-items: center;
    height: 2.4rem;
    border-bottom: 1px solid transparent;
    font-family: var(--hp-font);
    font-size: 0.95rem;
    color: var(--hp-muted);
    cursor: pointer;
  }

  .hp__grid :is(a, button):hover {
    color: var(--color-foreground, #1c1b19);
    border-color: var(--hp-line);
  }

  .hp__grid .is-current {
    color: var(--color-foreground, #1c1b19);
    border-color: var(--hp-accent);
  }

  .hp a:focus-visible,
  .hp button:focus-visible,
  .hp summary:focus-visible {
    outline: 1px solid var(--hp-accent);
    outline-offset: 3px;
  }

  @media (max-width: 40rem) {
    .hp {
      gap: 0.7rem;
      padding-inline: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp__fill,
    .hp__dot,
    .hp__marker {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    /* Close the jump grid when clicking outside of it */
    document.addEventListener('click', function (e) {
      document.querySelectorAll('.hp__jump[open]').forEach(function (d) {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
    });

    /* Keep the jump grid inside the screen (page 1 and the last page sit near the edges) */
    document.addEventListener('toggle', function (e) {
      var d = e.target;
      if (!d.classList || !d.classList.contains('hp__jump') || !d.open) return;
      var grid = d.querySelector('.hp__grid');
      if (!grid) return;
      grid.style.setProperty('--hp-shift', '0px');
      var r = grid.getBoundingClientRect();
      var m = 8;
      var shift = 0;
      if (r.left < m) shift = m - r.left;
      else if (r.right > window.innerWidth - m) shift = window.innerWidth - m - r.right;
      grid.style.setProperty('--hp-shift', shift + 'px');
    }, true);
  })();
{% endjavascript %}
