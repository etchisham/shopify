{%- comment -%}
  Hilya editorial pagination (draggable).
  Usage: {% render 'hilya-pagination', paginate: paginate %}
  Works for any number of pages. Keeps the active filters/sort in every link.

  Layout:  <  01  ●────────────────  15  >      (page 1 = very start of the line,
                                                  last page = very end)
  The current page number sits above the dot. Drag the dot (mouse or touch):
  the number above it shows the page under it, and letting go opens that page.
  Without JavaScript every tick on the line is a normal link.
  Arabic: Arabic-Indic digits, no leading zero.
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
  {%- liquid
    assign total = paginate.pages
    assign current = paginate.current_page
    assign current_idx = current | minus: 1
    assign last_idx = total | minus: 1

    if paginate.next.is_link
      assign ref_url = paginate.next.url
      assign ref_page = current | plus: 1
    else
      assign ref_url = paginate.previous.url
      assign ref_page = current | minus: 1
    endif

    assign ref_page_str = ref_page | append: ''
    assign ref_split = ref_url | split: 'page='
    assign url_prefix = ref_split.first
    assign url_rest = ref_split.last | remove_first: ref_page_str

    assign is_ar = false
    if request.locale.iso_code contains 'ar'
      assign is_ar = true
    endif
    assign ar_digits = '٠,١,٢,٣,٤,٥,٦,٧,٨,٩' | split: ','

    assign label_string = ''
    for i in (1..total)
      assign s = i | append: ''
      if is_ar
        for d in (0..9)
          assign d_str = d | append: ''
          assign s = s | replace: d_str, ar_digits[d]
        endfor
      elsif i < 10
        assign s = '0' | append: s
      endif
      assign label_string = label_string | append: s | append: '|'
    endfor
    assign labels = label_string | split: '|'

    assign cur_label = labels[current_idx]
    assign first_label = labels.first
    assign last_label = labels.last

    assign pct = current_idx | times: 100.0 | divided_by: last_idx | round: 2
  -%}

  <div class="catalog-page__pagination">
    <nav class="hp{% if total <= 20 %} hp--ticks{% endif %}" aria-label="{{ 'collections.pagination' | t | escape }}">

      {%- comment %} PREVIOUS {% endcomment -%}
      {%- if paginate.previous.is_link -%}
        <a class="hp__arrow hp__arrow--prev" href="{{ paginate.previous.url }}" aria-label="{{ 'collections.previous_page' | t | escape }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        </a>
      {%- else -%}
        <span class="hp__arrow hp__arrow--prev is-disabled" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        </span>
      {%- endif -%}

      {%- comment %} FIRST PAGE {% endcomment -%}
      {%- if current == 1 -%}
        <span class="hp__num">{{ first_label }}</span>
      {%- else -%}
        <a class="hp__num" href="{{ url_prefix }}page=1{{ url_rest }}" aria-label="{{ 'meta.page' | t: number: 1 | escape }}">{{ first_label }}</a>
      {%- endif -%}

      {%- comment %} LINE: ticks are real links; the dot is the draggable handle {% endcomment -%}
      <div class="hp__track" style="--hp-p: {{ pct }}%">
        <span class="hp__fill" aria-hidden="true"></span>

        {%- for i in (1..total) -%}
          {%- assign seg_pct = forloop.index0 | times: 100.0 | divided_by: last_idx | round: 2 -%}
          <a class="hp__seg" style="--hp-s: {{ seg_pct }}%" href="{{ url_prefix }}page={{ i }}{{ url_rest }}" data-n="{{ labels[forloop.index0] }}" aria-label="{{ 'meta.page' | t: number: i | escape }}"{% if i == current %} aria-current="page"{% endif %}></a>
        {%- endfor -%}

        <span class="hp__dot" role="slider" tabindex="0" aria-orientation="horizontal" aria-label="{{ 'collections.pagination' | t | escape }}" aria-valuemin="1" aria-valuemax="{{ total }}" aria-valuenow="{{ current }}">
          <span class="hp__label" aria-hidden="true">{{ cur_label }}</span>
        </span>
      </div>

      {%- comment %} LAST PAGE {% endcomment -%}
      {%- if current == total -%}
        <span class="hp__num">{{ last_label }}</span>
      {%- else -%}
        <a class="hp__num" href="{{ url_prefix }}page={{ total }}{{ url_rest }}" aria-label="{{ 'meta.page' | t: number: total | escape }}">{{ last_label }}</a>
      {%- endif -%}

      {%- comment %} NEXT {% endcomment -%}
      {%- if paginate.next.is_link -%}
        <a class="hp__arrow hp__arrow--next" href="{{ paginate.next.url }}" aria-label="{{ 'collections.next_page' | t | escape }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- else -%}
        <span class="hp__arrow hp__arrow--next is-disabled" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      {%- endif -%}

    </nav>
  </div>
{%- endif -%}

{% stylesheet %}
  .hp {
    --hp-accent: #b87f6f; /* rose gold */
    --hp-line: #e6dccb;
    --hp-muted: #9a948a;
    --hp-font: Georgia, 'Times New Roman', serif;
    --hp-dir: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    width: 100%;
    max-width: 36rem;
    margin: 0 auto;
    padding: 2.4rem 1rem 0.4rem;
    color: var(--color-foreground, #1c1b19);
    -webkit-user-select: none;
    user-select: none;
  }

  [dir='rtl'] .hp {
    --hp-dir: -1;
    --hp-font: inherit;
  }

  :where(.hp) button {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }

  /* Arrows */
  .hp__arrow {
    display: inline-grid;
    place-items: center;
    padding: 0.4rem;
    color: inherit;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .hp__arrow:is(a, button):not(:disabled):hover,
  .hp__arrow:is(a, button):not(:disabled):focus-visible {
    color: var(--hp-accent);
  }

  .hp__arrow--prev:is(a, button):not(:disabled):hover {
    transform: translateX(calc(-4px * var(--hp-dir)));
  }

  .hp__arrow--next:is(a, button):not(:disabled):hover {
    transform: translateX(calc(4px * var(--hp-dir)));
  }

  .hp__arrow.is-disabled,
  .hp__arrow:disabled {
    opacity: 0.25;
  }

  [dir='rtl'] .hp__arrow svg {
    transform: scaleX(-1);
  }

  /* First / last page numbers */
  .hp__num {
    font-family: var(--hp-font);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    line-height: 1;
    padding: 0;
    color: var(--hp-muted);
    transition: color 0.25s ease;
  }

  .hp__num:is(a, button) {
    cursor: pointer;
  }

  .hp__num:is(a, button):hover {
    color: var(--hp-accent);
  }

  [dir='rtl'] .hp__num {
    font-size: 1.05rem;
    letter-spacing: 0;
  }

  /* Line */
  .hp__track {
    position: relative;
    display: block;
    flex: 1;
    min-width: 0;
    height: 2.75rem;
    touch-action: pan-y;
  }

  .hp--js .hp__track {
    cursor: pointer;
  }

  .hp__track::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 50%;
    height: 1px;
    background: var(--hp-line);
  }

  .hp__fill {
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    width: var(--hp-p);
    height: 1px;
    background: var(--hp-accent);
    transition: width 0.18s ease;
    animation: hp-grow 0.6s ease both;
  }

  /* Ticks: one per page, each one a real link (works without JavaScript) */
  .hp__seg {
    position: absolute;
    inset-inline-start: var(--hp-s);
    top: 0;
    bottom: 0;
    z-index: 1;
    display: block;
    width: 1.4rem;
    padding: 0;
    transform: translateX(calc(-50% * var(--hp-dir)));
  }

  .hp--ticks .hp__seg::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1px;
    height: 7px;
    background: var(--hp-line);
    transform: translate(-50%, -50%);
  }

  /* With JavaScript the whole line is the drag area */
  .hp--js .hp__seg {
    pointer-events: none;
  }

  /* The handle */
  .hp__dot {
    position: absolute;
    inset-inline-start: var(--hp-p);
    top: 50%;
    z-index: 3;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--hp-accent);
    transform: translate(calc(-50% * var(--hp-dir)), -50%);
    transition: inset-inline-start 0.18s ease, box-shadow 0.2s ease;
    animation: hp-slide 0.6s ease both;
  }

  .hp--js .hp__dot {
    cursor: grab;
  }

  .hp.is-dragging,
  .hp.is-dragging .hp__track,
  .hp.is-dragging .hp__dot {
    cursor: grabbing;
  }

  .hp.is-dragging .hp__dot {
    box-shadow: 0 0 0 7px rgb(184 127 111 / 18%);
  }

  .hp__dot:focus-visible {
    outline: 1px solid var(--hp-accent);
    outline-offset: 5px;
  }

  /* Page number above the handle */
  .hp__label {
    position: absolute;
    bottom: calc(100% + 0.6rem);
    left: 50%;
    transform: translateX(-50%);
    transform-origin: 50% 100%;
    font-family: var(--hp-font);
    font-size: 1.2rem;
    letter-spacing: 0.05em;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-foreground, #1c1b19);
    pointer-events: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  [dir='rtl'] .hp__label {
    font-size: 1.35rem;
    letter-spacing: 0;
  }

  .hp.is-dragging .hp__label {
    color: var(--hp-accent);
    transform: translateX(-50%) scale(1.3);
  }

  @keyframes hp-grow {
    from { width: 0; }
  }

  @keyframes hp-slide {
    from { inset-inline-start: 0; }
  }

  .hp a:focus-visible,
  .hp button:focus-visible {
    outline: 1px solid var(--hp-accent);
    outline-offset: 3px;
  }

  @media (max-width: 40rem) {
    .hp {
      gap: 0.7rem;
      padding-inline: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp__fill,
    .hp__dot {
      animation: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    /* Turn the line into a drag area (the tick links stay as the no-JS fallback) */
    function markReady() {
      document.querySelectorAll('.hp').forEach(function (nav) {
        nav.classList.add('hp--js');
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', markReady);
    } else {
      markReady();
    }

    var drag = null;

    function ticksOf(track) {
      return track.querySelectorAll('.hp__seg');
    }

    function currentIndex(ticks) {
      for (var i = 0; i < ticks.length; i++) {
        if (ticks[i].getAttribute('aria-current') === 'page') return i;
      }
      return 0;
    }

    function isRtl(track) {
      return window.getComputedStyle(track).direction === 'rtl';
    }

    function indexFromPointer(track, ticks, clientX) {
      var rect = track.getBoundingClientRect();
      var fraction = isRtl(track)
        ? (rect.right - clientX) / rect.width
        : (clientX - rect.left) / rect.width;
      fraction = Math.min(1, Math.max(0, fraction));
      return Math.round(fraction * (ticks.length - 1));
    }

    function show(track, ticks, index) {
      track.style.setProperty('--hp-p', (index / (ticks.length - 1)) * 100 + '%');

      var label = track.querySelector('.hp__label');
      if (label) label.textContent = ticks[index].getAttribute('data-n');

      var dot = track.querySelector('.hp__dot');
      if (dot) dot.setAttribute('aria-valuenow', index + 1);
    }

    function finish(commit) {
      if (!drag) return;

      var state = drag;
      drag = null;

      state.nav.classList.remove('is-dragging');

      if (commit && state.index !== state.start) {
        state.ticks[state.index].click();
      } else {
        show(state.track, state.ticks, state.start);
      }
    }

    document.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'mouse' && e.button !== 0) return;

      var track = e.target.closest && e.target.closest('.hp__track');
      if (!track) return;

      var ticks = ticksOf(track);
      if (ticks.length < 2) return;

      var start = currentIndex(ticks);

      drag = {
        track: track,
        nav: track.closest('.hp'),
        ticks: ticks,
        start: start,
        index: indexFromPointer(track, ticks, e.clientX),
        pointerId: e.pointerId
      };

      try {
        track.setPointerCapture(e.pointerId);
      } catch (error) {}

      drag.nav.classList.add('is-dragging');
      show(track, ticks, drag.index);
      e.preventDefault();
    });

    document.addEventListener('pointermove', function (e) {
      if (!drag || e.pointerId !== drag.pointerId) return;

      var index = indexFromPointer(drag.track, drag.ticks, e.clientX);

      if (index !== drag.index) {
        drag.index = index;
        show(drag.track, drag.ticks, index);
      }
    });

    document.addEventListener('pointerup', function (e) {
      if (drag && e.pointerId === drag.pointerId) finish(true);
    });

    document.addEventListener('pointercancel', function (e) {
      if (drag && e.pointerId === drag.pointerId) finish(false);
    });

    /* Keyboard: arrows move one page, Home / End jump to the first / last page */
    document.addEventListener('keydown', function (e) {
      var dot = e.target.closest && e.target.closest('.hp__dot');
      if (!dot) return;

      var track = dot.closest('.hp__track');
      var ticks = ticksOf(track);
      var current = currentIndex(ticks);
      var rtl = isRtl(track);
      var next = current;

      if (e.key === 'ArrowRight') next = current + (rtl ? -1 : 1);
      else if (e.key === 'ArrowLeft') next = current + (rtl ? 1 : -1);
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = ticks.length - 1;
      else return;

      next = Math.min(ticks.length - 1, Math.max(0, next));
      e.preventDefault();

      if (next !== current) ticks[next].click();
    });
  })();
{% endjavascript %}
