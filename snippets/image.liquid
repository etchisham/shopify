{% doc %}
  Renders a responsive Shopify-hosted image, optionally wrapped in a link.

  @param {image} image - Image object.
  @param {string} [url] - Optional link destination.
  @param {string} [class] - Wrapper class.
  @param {number} [width] - Maximum requested width.
  @param {number} [height] - Optional fixed height.
  @param {string} [crop] - Crop position.
  @param {string} [widths] - Responsive source widths.
  @param {string} [sizes] - Responsive sizes attribute.
  @param {string} [loading] - Image loading behavior.
  @param {string} [fetchpriority] - Browser fetch priority.
  @param {string} [alt] - Accessible alt override.
{% enddoc %}

{% liquid
  assign image_width = width | default: image.width
  assign image_widths = widths | default: '320, 480, 640, 800, 1200, 1600'
  assign image_sizes = sizes | default: '100vw'
  assign image_loading = loading | default: 'lazy'
  assign image_alt = alt | default: image.alt
%}

{% if url != blank %}<a class="image {{ class }}" href="{{ url }}">{% else %}<div class="image {{ class }}">{% endif %}
  {{ image | image_url: width: image_width, height: height, crop: crop | image_tag: widths: image_widths, sizes: image_sizes, loading: image_loading, fetchpriority: fetchpriority, alt: image_alt }}
{% if url != blank %}</a>{% else %}</div>{% endif %}

{% stylesheet %}
  .image {
    display: block;
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .image > img {
    width: 100%;
    height: auto;
  }
{% endstylesheet %}
