{%- liquid
  assign card_variant = card_product.selected_or_first_available_variant
  assign card_image = card_product.featured_image
  assign image_alt = card_image.alt | default: card_product.title
-%}
<article class="fl-product-card">
  <a class="fl-product-card__media" href="{{ card_product.url }}">
    {%- unless card_product.available -%}
      <span class="fl-product-card__badge">Sold out</span>
    {%- else -%}
      {%- if card_variant.compare_at_price > card_variant.price -%}
        <span class="fl-product-card__badge">Sale</span>
      {%- endif -%}
    {%- endunless -%}
    {%- if card_image != blank -%}
      {{ card_image
        | image_url: width: 900
        | image_tag:
          widths: '320, 480, 640, 900',
          sizes: '(min-width: 1024px) 25vw, 50vw',
          loading: 'lazy',
          alt: image_alt
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </a>
  {%- if card_product.vendor != blank -%}
    <span class="fl-product-card__maker">{{ card_product.vendor }}</span>
  {%- endif -%}
  <h3 class="fl-product-card__title"><a href="{{ card_product.url }}">{{ card_product.title }}</a></h3>
  {% render 'fl-price', item: card_variant %}
  {% render 'fl-rating', product: card_product %}
</article>
