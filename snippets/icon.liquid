{% doc %}
  Renders a decorative interface or social icon.

  @param {string} name - Icon name.
{% enddoc %}

{% case name %}
  {% when 'account' %}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="7.25" r="4.25"/><path d="M3.5 21c.7-4.35 3.53-6.5 8.5-6.5s7.8 2.15 8.5 6.5"/></svg>
  {% when 'arrow' %}
    <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M4 16h23M19 7l9 9-9 9"/></svg>
  {% when 'cart' %}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 3h2l2.25 11.25a2 2 0 0 0 1.96 1.6h7.88a2 2 0 0 0 1.96-1.6L20.5 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
  {% when 'chevron' %}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m7 9.5 5 5 5-5"/></svg>
  {% when 'close' %}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 5 14 14M19 5 5 19"/></svg>
  {% when 'facebook' %}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.03 1.8-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.96h-1.51c-1.49 0-1.96.93-1.96 1.89v2.27h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z"/></svg>
