  {% when 'search' %}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.75" cy="10.75" r="7.25"/><path d="m16.1 16.1 4.4 4.4"/></svg>
  {% when 'theme' %}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3a9 9 0 1 0 9 9c0-.4 0-.8-.1-1.2A6 6 0 0 1 12 3Z"/></svg>
  {% when 'tiktok' %}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.6 2c.2 1.7 1.18 3.1 2.68 3.93A6.8 6.8 0 0 0 22 6.7v3.58a10.2 10.2 0 0 1-5.32-1.56v7.13A6.15 6.15 0 1 1 11.36 9.76v3.61a2.64 2.64 0 1 0 1.74 2.48V2h3.5Z"/></svg>
