{% doc %}
  Renders product or selected-variant price with sale semantics.

  @param {product} product - Product object.
  @param {variant} [variant] - Specific variant to price. Takes priority over use_variant.
  @param {boolean} [use_variant] - Use selected or first available variant pricing.
  @param {boolean} [card_layout] - Use compact product-card price order.
  @param {boolean} [show_discount] - Show calculated percentage discount.
{% enddoc %}

{% liquid
  assign is_variant_price = false

  if variant != blank
    assign target = variant
    assign is_variant_price = true
  elsif use_variant
    assign target = product.selected_or_first_available_variant
    assign is_variant_price = true
  else
    assign target = product
  endif

  assign price = target.price
  assign compare_at_price = target.compare_at_price

  comment
    Product-level fallback only: never mix product min/max values into a single variant's price.
  endcomment
  if is_variant_price == false and compare_at_price == blank and product.compare_at_price_min > product.price
    assign compare_at_price = product.compare_at_price_min
  endif

  assign available = target.available | default: false

  assign discount_percent = 0

  if compare_at_price > price
    assign discount_percent = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round
  endif
%}

<div class="price{% unless available %} price--sold-out{% endunless %}{% if compare_at_price > price %} price--sale{% endif %}">

  {% if card_layout %}

    {% if compare_at_price > price %}
      <span class="visually-hidden">
        {{ 'products.product.sale_price' | t }}
      </span>
    {% endif %}

    <span class="price__current">
      EGP {{ price | money_without_currency | strip }}
    </span>

  {% endif %}


  {% if compare_at_price > price %}

    <span class="visually-hidden">
      {{ 'products.product.regular_price' | t }}
    </span>

    <s class="price__compare">
      EGP {{ compare_at_price | money_without_currency | strip }}
    </s>

    {% unless card_layout %}
      <span class="visually-hidden">
        {{ 'products.product.sale_price' | t }}
      </span>
    {% endunless %}

  {% endif %}


  {% unless card_layout %}

    <span class="price__current">
      EGP {{ price | money_without_currency | strip }}
    </span>

  {% endunless %}


  {% if show_discount and discount_percent > 0 %}

    <span class="price__discount">
      {{ 'products.product.discount' | t: percent: discount_percent }}
    </span>

  {% endif %}


  {% if target.unit_price_measurement %}

    <small class="price__unit">

      EGP {{ target.unit_price | money_without_currency | strip }} /

      {% if target.unit_price_measurement.reference_value != 1 %}
        {{ target.unit_price_measurement.reference_value }}
      {% endif %}

      {{ target.unit_price_measurement.reference_unit }}

    </small>

  {% endif %}

</div>


{% stylesheet %}

.price {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--space-2);

  font-weight: 400;
}

.price__current {
  color: var(--color-foreground);

  font-size: 0.88rem;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.price__compare {
  position: relative;

  color: var(--color-muted);

  font-size: 0.74rem;
  font-weight: 400;
  line-height: 1;

  text-decoration: none;
}

.price__compare::after {
  content: "";

  position: absolute;
  inset-inline: 0;
  top: 45%;

  border-top: 1px solid currentColor;

  pointer-events: none;
}

.price__discount {
  color: var(--color-muted);

  font-size: 0.75rem;
  font-weight: 400;
}

.price__unit {
  width: 100%;

  color: var(--color-muted);

  font-size: 0.72rem;
  font-weight: 400;
}

{% endstylesheet %}