{% doc %}
  Renders product or selected-variant price with sale semantics.

  @param {product} product - Product object.
  @param {boolean} [use_variant] - Use selected or first available variant pricing.
  @param {boolean} [card_layout] - Use compact product-card price order.
  @param {boolean} [show_discount] - Show calculated percentage discount.
{% enddoc %}

{% liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif

  assign price = target.price
  assign compare_at_price = target.compare_at_price
  if compare_at_price == blank and product.compare_at_price_min > product.price
    assign compare_at_price = product.compare_at_price_min
  endif
  assign available = target.available | default: false

  assign discount_percent = 0
  if compare_at_price > price
    assign discount_percent = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round
  endif
%}

<div class="price{% unless available %} price--sold-out{% endunless %}{% if compare_at_price > price %} price--sale{% endif %}">
  {% if card_layout %}
    {% if compare_at_price > price %}<span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>{% endif %}
    <span class="price__current">{{ price | money }}</span>
  {% endif %}

  {% if compare_at_price > price %}
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <s class="price__compare">{{ compare_at_price | money }}</s>
    {% unless card_layout %}<span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>{% endunless %}
  {% endif %}

  {% unless card_layout %}<span class="price__current">{{ price | money }}</span>{% endunless %}

  {% if show_discount and discount_percent > 0 %}
    <span class="price__discount">{{ 'products.product.discount' | t: percent: discount_percent }}</span>
  {% endif %}

  {% if target.unit_price_measurement %}
    <small class="price__unit">
      {{ target.unit_price | money }} /
      {% if target.unit_price_measurement.reference_value != 1 %}{{ target.unit_price_measurement.reference_value }}{% endif %}
      {{ target.unit_price_measurement.reference_unit }}
    </small>
  {% endif %}
</div>

{% stylesheet %}
  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-weight: 700;
  }

  .price__compare {
    color: var(--color-muted);
    font-weight: 500;
  }

  .price__discount {
    color: var(--color-muted);
    font-size: 0.82em;
    font-weight: 500;
  }

  .price__unit {
    width: 100%;
    color: var(--color-muted);
    font-weight: 400;
  }
{% endstylesheet %}
