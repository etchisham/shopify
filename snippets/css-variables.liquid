{% style %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_display_font | font_face: font_display: 'swap' }}

  @layer tokens {
  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-display--family: {{ settings.type_display_font.family }}, {{ settings.type_display_font.fallback_families }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.canvas_color }};
    --color-foreground: {{ settings.ink_color }};
    --fl-canvas: {{ settings.canvas_color }};
    --fl-surface: {{ settings.surface_color }};
    --fl-ink: {{ settings.ink_color }};
    --fl-muted: {{ settings.muted_color }};
    --fl-line: {{ settings.line_color }};
    --fl-brand: {{ settings.brand_color }};
    --fl-brand-hover: color-mix(in srgb, {{ settings.brand_color }} 86%, black);
    --fl-olive: {{ settings.secondary_color }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --policy-background: {{ settings.policy_background_color }};
    --policy-foreground: {{ settings.policy_text_color }};
    --policy-link: {{ settings.policy_link_color }};
    --policy-border: {{ settings.policy_border_color }};
    --policy-content-width: {{ settings.policy_content_width }}px;
    --policy-title-size: {{ settings.policy_title_size }}px;
    --policy-body-size: {{ settings.policy_body_size }}px;
    --policy-section-spacing: {{ settings.policy_section_spacing }}px;
    --policy-mark-display: {% if settings.show_policy_mark %}grid{% else %}none{% endif %};
  }
  }
{% endstyle %}
