{%- comment -%}
  Arabic font (Cairo). Loaded only on Arabic pages, so English pages stay as fast as before.
{%- endcomment -%}
{%- assign css_locale = request.locale.iso_code | split: '-' | first -%}
{%- if css_locale == 'ar' -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&display=swap">
{%- endif -%}

{% style %}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}

  :root {
    color-scheme: light;
    --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body-style: {{ settings.type_body_font.style }};
    --font-body-weight: {{ settings.type_body_font.weight }};
    --font-heading-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading-style: {{ settings.type_heading_font.style }};
    --font-heading-weight: {{ settings.type_heading_font.weight }};
    --font-size-base: {{ settings.type_base_size | divided_by: 16.0 }}rem;

    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --grid-gap: clamp(1rem, 2vw, 2rem);

    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.5rem;
    --space-6: 2rem;
    --space-7: 3rem;
    --space-8: 4.5rem;

    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-muted: {{ settings.muted_color }};
    --color-surface: {{ settings.surface_color }};
    --color-border: {{ settings.border_color }};
    --color-accent: {{ settings.accent_color }};
    --color-accent-contrast: {{ settings.accent_contrast_color }};
    --color-error: #b42318;
    --color-success: #067647;

    --radius-small: {{ settings.radius_small }}px;
    --radius-large: {{ settings.radius_large }}px;
    --product-card-radius: {{ settings.card_image_radius }}px;
    --catalog-columns: {{ settings.catalog_columns }};
    --shadow-card: 0 0.75rem 2rem rgb(17 24 39 / 8%);
    --transition-fast: 160ms ease;
  }

  /*
    Arabic / RTL typography.
    - Letter-spacing breaks the joined Arabic letters, so it is always 0.
    - Arabic has no italic: browsers fake a slant that looks broken.
  */
  html[dir="rtl"] *,
  html[dir="rtl"] *::before,
  html[dir="rtl"] *::after {
    letter-spacing: 0 !important;
    font-style: normal !important;
  }

  /* One Arabic font everywhere (the brand wordmark keeps its own font) */
  html[lang|="ar"] {
    --font-body-family: "Cairo", "Segoe UI", Tahoma, sans-serif;
    --font-heading-family: "Cairo", "Segoe UI", Tahoma, sans-serif;
  }

  html[lang|="ar"] body,
  html[lang|="ar"] body *:not(.site-header__brand) {
    font-family: "Cairo", "Segoe UI", Tahoma, sans-serif !important;
  }

{% endstyle %}
