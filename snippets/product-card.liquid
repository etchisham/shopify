{% doc %}
  Renders the canonical store-wide product card.

  @param {product} product - Product object.
  @param {string} [sizes] - Responsive image sizes.
  @param {string} [heading_level] - Card title heading level; h2 or h3.
{% enddoc %}

{% liquid
  assign card_image_alt = product.featured_image.alt | default: product.title
  assign secondary_image = product.images[1]
  assign secondary_image_alt = secondary_image.alt | default: product.title

  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign rating_value = rating.rating | default: rating
  assign rating_maximum = rating.scale_max | default: 5
  assign rating_percentage = 0

  if rating_value != blank and rating_maximum > 0
    assign rating_percentage = rating_value | times: 100.0 | divided_by: rating_maximum
  endif

  assign compare_price = product.compare_at_price_max
  assign current_price = product.price
  assign discount_percentage = 0

  if compare_price > current_price and compare_price > 0
    assign discount_amount = compare_price | minus: current_price
    assign discount_percentage = discount_amount | times: 100.0 | divided_by: compare_price | round
  endif
%}


<article class="product-card{% if secondary_image %} product-card--has-secondary{% endif %}">

  <a
    class="product-card__media"
    href="{{ product.url }}"
    tabindex="-1"
    aria-hidden="true"
  >

    {% if product.featured_image %}

      <div class="product-card__image-layer product-card__image-layer--primary">

        {% render 'image',
          image: product.featured_image,
          width: 1200,
          widths: '240, 360, 480, 640, 800, 1000, 1200',
          sizes: sizes,
          alt: card_image_alt
        %}

      </div>


      {% if secondary_image %}

        <div class="product-card__image-layer product-card__image-layer--secondary">

          {% render 'image',
            image: secondary_image,
            width: 1200,
            widths: '240, 360, 480, 640, 800, 1000, 1200',
            sizes: sizes,
            alt: secondary_image_alt
          %}

        </div>

      {% endif %}

    {% else %}

      {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}

    {% endif %}


    {% if discount_percentage > 0 %}

      <span class="product-card__discount">
        {{ discount_percentage }}% OFF
      </span>

    {% endif %}


    {% unless product.available %}

      <span class="product-card__badge">
        {{ 'products.product.sold_out' | t }}
      </span>

    {% endunless %}

  </a>


  <div class="product-card__content">

    {% if heading_level == 'h2' %}

      <h2 class="product-card__title">
        <a href="{{ product.url }}">
          {{ product.title | escape }}
        </a>
      </h2>

    {% else %}

      <h3 class="product-card__title">
        <a href="{{ product.url }}">
          {{ product.title | escape }}
        </a>
      </h3>

    {% endif %}


    {% if settings.card_show_rating and rating_value != blank %}

      <div class="product-card__rating">

        <span
          class="product-card__stars"
          style="--rating-percentage: {{ rating_percentage }}%;"
          role="img"
          aria-label="{{ 'products.product.rating' | t: rating: rating_value, maximum: rating_maximum | escape }}"
        >
          <span aria-hidden="true">★★★★★</span>
        </span>


        {% if rating_count > 0 %}

          <span class="product-card__rating-count">
            ({{ rating_count }})
          </span>

          <span class="visually-hidden">
            {{ 'products.product.rating_count' | t: count: rating_count }}
          </span>

        {% endif %}

      </div>

    {% endif %}


    <div class="product-card__price">

      {% render 'price',
        product: product,
        card_layout: true,
        show_discount: false
      %}

    </div>


    {% if settings.card_show_vendor and product.vendor != blank %}

      <p class="product-card__vendor">
        {{ product.vendor | escape }}
      </p>

    {% endif %}

  </div>

</article>


{% stylesheet %}


/* ================================
   PRODUCT CARD
================================ */

.product-card {
  position: relative;

  display: grid;

  min-width: 0;

  align-content: start;

  color: var(--color-foreground);
}


/* ================================
   MEDIA
================================ */

.product-card__media {
  position: relative;

  display: block;

  overflow: hidden;

  aspect-ratio: 5 / 4;

  border-radius: var(--product-card-radius);

  background: var(--color-surface);

  text-decoration: none;
}


/* IMAGE LAYERS */

.product-card__image-layer {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  opacity: 1;

  transition:
    opacity 420ms ease;
}


.product-card__image-layer--secondary {
  opacity: 0;
}


/* IMAGE */

.product-card__image-layer .image,
.product-card__image-layer img,
.product-card__placeholder {
  display: block;

  width: 100%;
  height: 100%;

  aspect-ratio: auto;

  object-fit: cover;
}


/* ================================
   SECOND IMAGE HOVER
================================ */

@media (hover: hover) and (pointer: fine) {

  .product-card--has-secondary:hover
  .product-card__image-layer--primary {
    opacity: 0;
  }

  .product-card--has-secondary:hover
  .product-card__image-layer--secondary {
    opacity: 1;
  }

}


/* ================================
   DISCOUNT
================================ */

.product-card__discount {
  position: absolute;

  top: 12px;
  left: 12px;

  z-index: 3;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 52px;
  height: 24px;

  padding: 0 9px;

  background: #E8DCC7;
  color: #4A4033;

  font-size: 8px;

  line-height: 1;

  font-weight: 500;

  letter-spacing: .08em;

  text-transform: uppercase;

  border-radius: 2px;
}


/* ================================
   SOLD OUT
================================ */

.product-card__badge {
  position: absolute;

  top: 12px;
  left: 12px;

  z-index: 3;

  border: 1px solid rgb(0 0 0 / 10%);

  border-radius: 999px;

  background: var(--color-background);

  color: var(--color-foreground);

  font-size: 0.72rem;

  font-weight: 700;

  line-height: 1;

  padding: 0.45rem 0.65rem;
}


/* ================================
   CONTENT
================================ */

.product-card__content {
  display: grid;

  justify-items: center;

  gap: 5px;

  padding-block-start: 12px;

  text-align: center;
}


/* ================================
   TITLE
================================ */

.product-card__title {
  min-width: 0;

  width: 100%;

  margin: 0;

  overflow: hidden;

  font-family: var(--font-body-family);

  font-size: clamp(.78rem, .82vw, .92rem);

  font-weight: 400;

  letter-spacing: .02em;

  line-height: 1.35;

  text-align: center;

  text-overflow: ellipsis;

  white-space: nowrap;
}


.product-card__title a {
  position: relative;

  z-index: 2;

  color: inherit;

  text-decoration: none;
}


/* ================================
   RATING
================================ */

.product-card__rating {
  display: flex;

  min-height: 1.35rem;

  align-items: center;

  justify-content: center;

  gap: 0.3rem;

  line-height: 1;
}


.product-card__stars {
  position: relative;

  display: inline-block;

  direction: ltr;

  color: color-mix(
    in srgb,
    var(--color-foreground) 18%,
    transparent
  );

  font-size: 1.05rem;

  letter-spacing: -0.08em;

  line-height: 1;

  unicode-bidi: isolate;
}


.product-card__stars::after {
  content: '★★★★★';

  position: absolute;

  inset-block-start: 0;

  inset-inline-start: 0;

  width: var(--rating-percentage);

  overflow: hidden;

  color: var(--color-foreground);

  white-space: nowrap;
}


.product-card__rating-count {
  color: var(--color-muted);

  font-size: 0.875rem;
}


/* ================================
   PRICE
================================ */

.product-card__price {
  display: flex;

  justify-content: center;

  width: 100%;

  text-align: center;
}


.product-card .price {
  display: flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  width: 100%;

  font-size: .8rem;

  line-height: 1.25;

  text-align: center;
}


.product-card .price__current {
  color: var(--color-foreground);

  font-size: .88rem;

  font-weight: 500;

  letter-spacing: .02em;
}


.product-card .price__compare {
  color: var(--color-muted);

  font-size: .74rem;

  text-decoration: line-through;
}


/* ================================
   VENDOR
================================ */

.product-card__vendor {
  margin: 0;

  overflow: hidden;

  color: var(--color-muted);

  font-size: 0.8rem;

  line-height: 1.35;

  text-overflow: ellipsis;

  white-space: nowrap;

  text-align: center;
}


/* ================================
   CATALOG GRID
================================ */

.catalog-grid {
  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap:
    clamp(1.75rem, 2.2vw, 2.5rem)
    clamp(0.8rem, 1.2vw, 1.4rem);
}


/* ================================
   TABLET
================================ */

@media (min-width: 46.875rem) {

  .catalog-grid {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

}


/* ================================
   DESKTOP
================================ */

@media (min-width: 64rem) {

  .catalog-grid {
    grid-template-columns:
      repeat(var(--catalog-columns), minmax(0, 1fr));
  }

}


/* ================================
   SMALL MOBILE
================================ */

@media (max-width: 27rem) {

  .product-card__content {
    padding-block-start: 9px;

    gap: 4px;
  }


  .product-card__title {
    font-size: .78rem;
  }


  .product-card .price__current {
    font-size: .82rem;
  }


  .product-card .price__compare {
    font-size: .68rem;
  }


  .product-card__discount {
    top: 8px;

    left: 8px;

    min-width: 48px;

    height: 22px;

    padding: 0 7px;

    font-size: 7px;
  }


  .product-card__stars {
    font-size: .92rem;
  }


  .product-card .price__discount,
  .product-card__rating-count,
  .product-card__vendor {
    font-size: .72rem;
  }

}


/* ================================
   REDUCED MOTION
================================ */

@media (prefers-reduced-motion: reduce) {

  .product-card__image-layer {
    transition: none;
  }

}


{% endstylesheet %}