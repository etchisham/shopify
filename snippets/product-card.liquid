{% doc %}
  Renders the canonical store-wide product card.

  @param {product} product - Product object.
  @param {string} [sizes] - Responsive image sizes.
  @param {string} [heading_level] - Card title heading level; h2 or h3.
{% enddoc %}

{% liquid
  assign card_image_alt = product.featured_image.alt | default: product.title
  assign secondary_image = product.images[1]
  assign secondary_image_alt = secondary_image.alt | default: product.title

  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign rating_value = rating.rating | default: rating
  assign rating_maximum = rating.scale_max | default: 5

  assign rating_display = rating_value | round: 1 | append: '' | remove: '.0'
  assign review_word = 'review'
  if rating_count != 1
    assign review_word = 'reviews'
  endif

  assign compare_price = product.compare_at_price_max
  assign current_price = product.price
  assign discount_percentage = 0

  if compare_price > current_price and compare_price > 0
    assign discount_amount = compare_price | minus: current_price
    assign discount_percentage = discount_amount | times: 100.0 | divided_by: compare_price | round
  endif

  comment
    Add to cart / Select options on the image, variant dropdown under the title
  endcomment
  assign card_variant = product.selected_or_first_available_variant
  assign card_min_quantity = card_variant.quantity_rule.min | default: 1

  assign locale_root = request.locale.iso_code | split: '-' | first
  assign card_add_label = 'products.product.add_to_cart' | t
  assign card_sold_out_label = 'products.product.sold_out' | t
  assign card_options_label = 'Select options'
  if locale_root == 'ar'
    assign card_options_label = 'اختر الخيارات'
  endif

  assign card_needs_options = false
  if product.tags contains 'Name' or product.tags contains 'Date' or product.tags contains 'Letter' or product.requires_selling_plan or product.metafields.custom.personalization_required.value == true
    assign card_needs_options = true
  endif

  assign card_show_select = false
  if product.variants.size > 1 and card_needs_options == false and product.available
    assign card_show_select = true
  endif
%}


<article
  class="product-card{% if secondary_image %} product-card--has-secondary{% endif %}"
  data-product-card
>

  <div class="product-card__media-wrap">

  <a
    class="product-card__media"
    href="{{ product.url }}"
    tabindex="-1"
    aria-hidden="true"
    data-product-media
  >

    {% if product.featured_image %}

      <div
        class="product-card__image-layer product-card__image-layer--primary"
        data-product-image-primary
      >

        {% render 'image',
          image: product.featured_image,
          width: 1200,
          widths: '240, 360, 480, 640, 800, 1000, 1200',
          sizes: sizes,
          alt: card_image_alt
        %}

      </div>


      {% if secondary_image %}

        <div
          class="product-card__image-layer product-card__image-layer--secondary"
          data-product-image-secondary
        >

          {% render 'image',
            image: secondary_image,
            width: 1200,
            widths: '240, 360, 480, 640, 800, 1000, 1200',
            sizes: sizes,
            alt: secondary_image_alt
          %}

        </div>

      {% else %}

        <div
          class="product-card__image-layer product-card__image-layer--secondary"
          data-product-image-secondary
          hidden
        ></div>

      {% endif %}

    {% else %}

      {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}

    {% endif %}


    {% if discount_percentage > 0 %}

      <span class="product-card__discount">
        {{ discount_percentage }}% OFF
      </span>

    {% endif %}


    {% unless product.available %}

      <span class="product-card__badge">
        {{ 'products.product.sold_out' | t }}
      </span>

    {% endunless %}

  </a>


    <div class="product-card__quick-wrap">

      {%- if card_needs_options -%}

        <a class="product-card__quick" href="{{ product.url }}" data-quick-view>
          <svg class="product-card__quick-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg>
          <span class="product-card__quick-text">{{ card_options_label }}</span>
        </a>

      {%- elsif product.available -%}

        <button
          type="button"
          class="product-card__quick"
          data-card-add
          data-variant-id="{{ card_variant.id }}"
          data-quantity="{{ card_min_quantity }}"
          data-product-title="{{ product.title | escape }}"
          data-add-label="{{ card_add_label | escape }}"
          data-sold-out-label="{{ card_sold_out_label | escape }}"
        >
          <svg class="product-card__quick-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 7H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
          <span class="product-card__quick-text">+ {{ card_add_label }}</span>
        </button>

      {%- endif -%}

    </div>

  </div>


  <div class="product-card__content">

    {% if heading_level == 'h2' %}

      <h2 class="product-card__title">

        <a href="{{ product.url }}" data-product-link>
          {{ product.title | escape }}
        </a>

      </h2>

    {% else %}

      <h3 class="product-card__title">

        <a href="{{ product.url }}" data-product-link>
          {{ product.title | escape }}
        </a>

      </h3>

    {% endif %}


    {%- if card_show_select -%}

      <div class="product-card__variant">

        <select
          class="product-card__select"
          aria-label="{{ product.title | escape }}"
          data-card-variant-select
        >
          {%- for v in product.variants -%}
            <option
              value="{{ v.id }}"
              {% if v.id == card_variant.id %}selected{% endif %}
              data-label="{{ v.title | escape }}"
              data-available="{{ v.available }}"
              data-price-cents="{{ v.price }}"
              data-compare-cents="{{ v.compare_at_price | default: 0 }}"
              data-url="{{ v.url }}"
              data-image="{% if v.featured_image %}{{ v.featured_image | image_url: width: 1200 }}{% endif %}"
            >
              {{- v.title | escape -}}
              {%- unless v.available %} · {{ card_sold_out_label }}{% endunless -%}
            </option>
          {%- endfor -%}
        </select>

        <span class="product-card__chevron" aria-hidden="true"></span>

      </div>

    {%- endif -%}


    {% if settings.card_show_rating and rating_value != blank and rating_count > 0 %}

      <div
        class="product-card__rating"
        role="img"
        aria-label="{{ rating_display }} / {{ rating_maximum }} ({{ rating_count }} {{ review_word }})"
      >

        <span class="product-card__rating-star" aria-hidden="true">★</span>

        <span class="product-card__rating-value">{{ rating_display }}</span>

        <span class="product-card__rating-count">
          ({{ rating_count }} {{ review_word }})
        </span>

      </div>

    {% endif %}


    <div
      class="product-card__price"
      data-product-price
    >

      {% render 'price',
        product: product,
        card_layout: true,
        show_discount: false
      %}

    </div>


    {% if settings.card_show_vendor and product.vendor != blank %}

      <p class="product-card__vendor">
        {{ product.vendor | escape }}
      </p>

    {% endif %}

  </div>

</article>


{% stylesheet %}

/* ================================
   PRODUCT CARD
================================ */

.product-card {
  position: relative;
  display: grid;
  min-width: 0;
  align-content: start;
  color: var(--color-foreground);
}


/* ================================
   MEDIA
================================ */

.product-card__media {
  position: relative;
  display: block;
  overflow: hidden;
  aspect-ratio: 5 / 4;
  border-radius: var(--product-card-radius);
  background: var(--color-surface);
  text-decoration: none;
}


/* ================================
   IMAGE LAYERS
================================ */

.product-card__image-layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 1;
  transition: opacity 420ms ease;
}

.product-card__image-layer--secondary {
  opacity: 0;
}

.product-card__image-layer[hidden] {
  display: none;
}


/* ================================
   IMAGE
================================ */

.product-card__image-layer .image,
.product-card__image-layer img,
.product-card__placeholder {
  display: block;
  width: 100%;
  height: 100%;
  aspect-ratio: auto;
  object-fit: cover;
}


/* ================================
   SECOND IMAGE HOVER
================================ */

@media (hover: hover) and (pointer: fine) {

  .product-card--has-secondary:hover
  .product-card__image-layer--primary {
    opacity: 0;
  }

  .product-card--has-secondary:hover
  .product-card__image-layer--secondary {
    opacity: 1;
  }

}


/* ================================
   DISCOUNT
================================ */

.product-card__discount {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 52px;
  height: 24px;
  padding: 0 9px;
  background: #E8DCC7;
  color: #4A4033;
  font-size: 8px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: .08em;
  text-transform: uppercase;
  border-radius: 2px;
}


/* ================================
   SOLD OUT
================================ */

.product-card__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 3;
  border: 1px solid rgb(0 0 0 / 10%);
  border-radius: 999px;
  background: var(--color-background);
  color: var(--color-foreground);
  font-size: 0.72rem;
  font-weight: 700;
  line-height: 1;
  padding: 0.45rem 0.65rem;
}


/* ================================
   CONTENT
================================ */

.product-card__content {
  display: grid;
  justify-items: center;
  gap: 5px;
  padding-block-start: 12px;
  text-align: center;
}


/* ================================
   TITLE
================================ */

.product-card__title {
  min-width: 0;
  width: 100%;
  margin: 0;
  overflow: hidden;
  font-family: var(--font-body-family);
  font-size: clamp(.78rem, .82vw, .92rem);
  font-weight: 400;
  letter-spacing: .02em;
  line-height: 1.35;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-card__title a {
  position: relative;
  z-index: 2;
  color: inherit;
  text-decoration: none;
}


/* ================================
   RATING
================================ */

.product-card__rating {
  display: flex;
  min-height: 1.35rem;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.3rem;
  line-height: 1;
}

.product-card__rating-star {
  color: #f5b301;
  font-size: 1.05rem;
  line-height: 1;
}

.product-card__rating-value {
  font-size: 0.875rem;
  font-weight: 600;
}

.product-card__rating-count {
  color: var(--color-muted);
  font-size: 0.8rem;
  white-space: nowrap;
}


/* ================================
   PRICE
================================ */

.product-card__price {
  display: flex;
  justify-content: center;
  width: 100%;
  text-align: center;
}

.product-card .price {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  width: 100%;
  font-size: .8rem;
  line-height: 1.25;
  text-align: center;
}

.product-card .price__current {
  color: var(--color-foreground);
  font-size: .88rem;
  font-weight: 500;
  letter-spacing: .02em;
}

.product-card .price__compare {
  color: var(--color-muted);
  font-size: .74rem;
  text-decoration: line-through;
}


/* ================================
   VENDOR
================================ */

.product-card__vendor {
  margin: 0;
  overflow: hidden;
  color: var(--color-muted);
  font-size: 0.8rem;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}


/* ================================
   QUICK ADD / SELECT OPTIONS
================================ */

.product-card__media-wrap {
  position: relative;
}

.product-card__quick-wrap {
  position: absolute;
  inset-inline: 0.75rem;
  bottom: 0.75rem;
  z-index: 4;
  opacity: 0;
  pointer-events: none;
  transform: translateY(0.5rem);
  transition:
    opacity 220ms ease,
    transform 220ms ease;
}

.product-card__media-wrap:hover .product-card__quick-wrap {
  opacity: 1;
  pointer-events: auto;
  transform: none;
}

/* Keyboard focus only (a mouse click must not keep the button visible) */
.product-card__media-wrap:has(:focus-visible) .product-card__quick-wrap {
  opacity: 1;
  pointer-events: auto;
  transform: none;
}

.product-card__quick {
  display: flex;
  width: 100%;
  min-height: 3.1rem;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 1rem;
  border: 0;
  border-radius: 0.85rem;
  background: var(--color-background, #fffcf7);
  color: #222;
  font: inherit;
  font-size: 0.9rem;
  line-height: 1.2;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.08);
  transition:
    background-color 160ms ease,
    color 160ms ease;
}

.product-card__quick:hover {
  background: #222;
  color: var(--color-background, #fffcf7);
}

.product-card__quick:disabled,
.product-card__quick.is-sold-out {
  opacity: 0.7;
  cursor: not-allowed;
}

.product-card__quick:disabled:hover {
  background: var(--color-background, #fffcf7);
  color: #222;
}

/* The icon is only used on mobile */
.product-card__quick-icon {
  display: none;
}

/* Touch screens: no hover, so the small button stays visible */
@media (hover: none) {
  .product-card__quick-wrap {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
}

@media (max-width: 749px) {
  .product-card__quick-wrap {
    inset-inline-start: auto;
    inset-inline-end: 0.6rem;
    bottom: 0.6rem;
  }

  .product-card__quick {
    width: 2.4rem;
    height: 2.4rem;
    min-height: 0;
    padding: 0;
    border: 1px solid rgb(34 34 34 / 85%);
    border-radius: 0.35rem;
    box-shadow: none;
  }

  .product-card__quick-icon {
    display: block;
    width: 1.3rem;
    height: 1.3rem;
  }

  /* The words stay for screen readers only */
  .product-card__quick-text {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .product-card__quick.is-sold-out {
    width: auto;
    height: auto;
    min-height: 2rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.72rem;
  }

  .product-card__quick.is-sold-out .product-card__quick-icon {
    display: none;
  }

  .product-card__quick.is-sold-out .product-card__quick-text {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip-path: none;
  }
}


/* ================================
   VARIANT DROPDOWN (Gold Plated / Silver Plated ...)
================================ */

.product-card__variant {
  position: relative;
  display: inline-block;
  max-width: 100%;
  margin-block: 2px;
}

.product-card__select {
  min-width: 8.5rem;
  max-width: 100%;
  padding: 0.5rem 2.1rem;
  border: 1px solid #d8d8d8;
  border-radius: 999px;
  background: transparent;
  color: var(--color-foreground);
  font: inherit;
  font-size: 0.8rem;
  line-height: 1.2;
  text-align: center;
  text-align-last: center;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
}

.product-card__select:hover {
  border-color: #222;
}

.product-card__chevron {
  position: absolute;
  top: 50%;
  inset-inline-end: 0.95rem;
  width: 0.4rem;
  height: 0.4rem;
  border-right: 1px solid currentColor;
  border-bottom: 1px solid currentColor;
  transform: translateY(-70%) rotate(45deg);
  pointer-events: none;
}


/* ================================
   CATALOG GRID
================================ */

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap:
    clamp(1.75rem, 2.2vw, 2.5rem)
    clamp(0.8rem, 1.2vw, 1.4rem);
}


/* ================================
   TABLET
================================ */

@media (min-width: 46.875rem) {

  .catalog-grid {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

}


/* ================================
   DESKTOP
================================ */

@media (min-width: 64rem) {

  .catalog-grid {
    grid-template-columns:
      repeat(var(--catalog-columns), minmax(0, 1fr));
  }

}


/* ================================
   SMALL MOBILE
================================ */

@media (max-width: 27rem) {

  .product-card__content {
    padding-block-start: 9px;
    gap: 4px;
  }

  .product-card__title {
    font-size: .78rem;
  }

  .product-card .price__current {
    font-size: .82rem;
  }

  .product-card .price__compare {
    font-size: .68rem;
  }

  .product-card__discount {
    top: 8px;
    left: 8px;
    min-width: 48px;
    height: 22px;
    padding: 0 7px;
    font-size: 7px;
  }

  .product-card__rating-star {
    font-size: .92rem;
  }

  .product-card .price__discount,
  .product-card__rating-count,
  .product-card__vendor {
    font-size: .72rem;
  }

}


/* ================================
   REDUCED MOTION
================================ */

@media (prefers-reduced-motion: reduce) {

  .product-card__image-layer {
    transition: none;
  }

}

{% endstylesheet %}
