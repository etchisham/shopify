<style>
/* =========================================================
   HILYA STYLE
   Shared colors and sizes, and the rules used by many sections.
   A rule that belongs to one section lives in that section's file.
   ========================================================= */

:root {
  /* colors */
  --hilya-rose: #A9705F;        /* lines, borders, small details */
  --hilya-rose-deep: #8f5a4b;   /* small text, backgrounds behind white text */
  --hilya-rose-light: #b87f6f65;  /* soft accents (never behind white text) */
  --hilya-rose-rgb: 169 112 95;  /* the same rose gold, for see-through shades */
  --hilya-ink: #151515;         /* big titles, black buttons */
  --hilya-muted: #6b6560;       /* small gray text */
  --hilya-cream: var(--color-background, #fffcf7);  /* page background */
  --hilya-beige: #F7F4EE;       /* alternating sections */
  --hilya-line: #e5e1d8;        /* thin borders */
  --hilya-metal-gold: #dcc06a;    /* Gold Plated dot */
  --hilya-metal-silver: #aeb4b9;  /* Silver Plated dot */
  --hilya-ink-soft: #272524;
  --hilya-button-depth:
    inset 0 1px 0 rgb(255 255 255 / 22%),
    inset 0 -2px 0 rgb(0 0 0 / 8%),
    0 1px 2px rgb(0 0 0 / 14%),
    0 5px 12px -6px rgb(0 0 0 / 28%);


  /* shapes */
  --hilya-radius: 12px;         /* corners of pictures */

  /* the small word above a title */
  --hilya-eyebrow-size: 10px;
  --hilya-eyebrow-spacing: .28em;
}

@media (max-width: 749px) {
  :root {
    --hilya-eyebrow-spacing: .16em;
  }
}

html[dir="rtl"] {
  --hilya-eyebrow-size: 13px;
  --hilya-eyebrow-spacing: 0;
}

@media (max-width: 749px) {
  html[dir="rtl"] {
    --hilya-eyebrow-size: 12px;
  }
}


/* =========================================================
   SMALL WORD ABOVE TITLES
   best sellers, new arrivals, categories, customize, instagram, special offer
   ========================================================= */

.featured-collection__eyebrow,
.collection-list__heading,
.custom-order__eyebrow,
.hilya-social__eyebrow,
.sales__eyebrow {
  font-family: Arial, Helvetica, sans-serif;
  font-size: var(--hilya-eyebrow-size);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: var(--hilya-eyebrow-spacing);
  text-transform: uppercase;
  color: var(--hilya-rose-deep);
}


/* =========================================================
   PAGE TRANSITION: a soft fade between pages of the site
   ========================================================= */

@view-transition {
  navigation: auto;
}

::view-transition-old(root),
::view-transition-new(root) {
  animation-duration: .45s;
  animation-timing-function: ease;
}

@media (prefers-reduced-motion: reduce) {
  ::view-transition-group(*),
  ::view-transition-old(*),
  ::view-transition-new(*) {
    animation: none;
  }
}
</style>