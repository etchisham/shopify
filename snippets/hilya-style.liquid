<style>
/* =========================================================
   HILYA STYLE - one place for the look of the site
   ========================================================= */

:root {
  /* colors */
  --hilya-rose: #A9705F;        /* lines, borders, details */
  --hilya-rose-deep: #8f5a4b;   /* small text, button hover backgrounds */
  --hilya-rose-light: #b87f6f;  /* soft accents (never behind white text) */
  --hilya-ink: #151515;         /* big titles */
  --hilya-muted: #6b6560;       /* small gray text */
  --hilya-cream: var(--color-background, #fffcf7);  /* page background */
  --hilya-beige: #F7F4EE;                           /* alternating sections */

  /* the small word above a title */
  --hilya-eyebrow-size: 10px;
  --hilya-eyebrow-spacing: .28em;
  --hilya-radius: 12px;
}

html[dir="rtl"] {
  --hilya-eyebrow-size: 13px;
}

@media (max-width: 749px) {
  :root {
    --hilya-eyebrow-spacing: .16em;
  }

  html[dir="rtl"] {
    --hilya-eyebrow-size: 12px;
  }
}


/* =========================================================
   SMALL WORD ABOVE TITLES
   (best sellers, new arrivals, categories, customize, instagram)
   ========================================================= */

body .featured-collection__eyebrow,
body .collection-list__heading,
body .custom-order__eyebrow,
body .hilya-social__eyebrow,
body .story-section__eyebrow {
  font-family: Arial, Helvetica, sans-serif;
  font-size: var(--hilya-eyebrow-size);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: var(--hilya-eyebrow-spacing);
  text-transform: uppercase;
  color: var(--hilya-rose-deep);
}

html[dir="rtl"] body .featured-collection__eyebrow,
html[dir="rtl"] body .collection-list__heading,
html[dir="rtl"] body .custom-order__eyebrow,
html[dir="rtl"] body .hilya-social__eyebrow,
html[dir="rtl"] body .story-section__eyebrow {
  line-height: 1.3;
  letter-spacing: 0;
  text-transform: none;
}


/* =========================================================
   BIG TITLES: the same italic serif everywhere
   (Arabic keeps its normal letters)
   ========================================================= */

html[dir="ltr"] body .custom-order__heading,
html[dir="ltr"] body .hilya-social__brand {
  font-style: italic;
  font-weight: 500;
}
html[dir="ltr"] body .story-section__heading {
  font-style: italic;
}


/* TEXT LINKS: the word turns rose gold on hover */

body .story-section__link,
body .featured-collection__view-all {
  transition: color .3s ease, border-color .3s ease;
}

body .story-section__link:hover {
  color: var(--hilya-rose-deep);
}

@media (min-width: 750px) {
  body .featured-collection__view-all:hover {
    color: var(--hilya-rose-deep);
  }
}

</style>