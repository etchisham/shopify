{% doc %}
  Product variant options, shown as selectable pills.
  A hidden native <select> per option is kept in sync by product.js
  (it is what the variant logic and the no-JS fallback rely on).
  @param {product} product - Current product.
  @param {string} section_id - Owning section ID.
{% enddoc %}

{% unless product.has_only_default_variant %}

  <div
    class="product-options"
    data-product-options
  >

    {% for option in product.options_with_values %}

      {% assign option_index = option.position | minus: 1 %}

      {%- assign option_name_down = option.name | downcase -%}
      {%- if option_name_down == 'color' or option.name == 'لون' or option.name == 'اللون' -%}
        {%- assign option_label = 'products.option_names.color' | t -%}
      {%- elsif option_name_down == 'size' or option.name == 'مقاس' or option.name == 'المقاس' -%}
        {%- assign option_label = 'products.option_names.size' | t -%}
      {%- elsif option_name_down == 'material' or option.name == 'خامة' or option.name == 'الخامة' -%}
        {%- assign option_label = 'products.option_names.material' | t -%}
      {%- else -%}
        {%- assign option_label = option.name -%}
      {%- endif -%}

      <div class="product-form__field product-option-field">

        <span
          class="product-option-label"
          id="ProductOptionLabel-{{ section_id }}-{{ option.position }}"
        >
          {{ option_label | escape }}
        </span>

        <div
          class="product-option-pills"
          role="radiogroup"
          aria-labelledby="ProductOptionLabel-{{ section_id }}-{{ option.position }}"
          data-option-pills
          data-option-position="{{ option.position }}"
        >

          {% for value in option.values %}

            {%- assign value_available = false -%}

            {%- for variant in product.variants -%}
              {%- if variant.options[option_index] == value.name and variant.available -%}
                {%- assign value_available = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- assign value_key = value.name | handleize | replace: '-', '_' -%}
            {%- capture value_label_key -%}products.option_values.{{ value_key }}{%- endcapture -%}
            {%- assign value_label = value_label_key | t: default: value.name -%}

            <button
              type="button"
              role="radio"
              class="product-option-pill{% unless value_available %} is-soldout{% endunless %}"
              data-option-value="{{ value.name | escape }}"
              aria-checked="{{ value.selected }}"
              tabindex="{% if value.selected %}0{% else %}-1{% endif %}"
              {% unless value_available %}
                title="{{ 'products.product.sold_out' | t | escape }}"
              {% endunless %}
            >
              {{ value_label | escape }}
            </button>

          {% endfor %}

        </div>

        <select
          hidden
          class="product-option-select"
          aria-hidden="true"
          tabindex="-1"
          data-product-option
          data-option-position="{{ option.position }}"
          autocomplete="off"
        >
          {% for value in option.values %}
            {%- assign value_key = value.name | handleize | replace: '-', '_' -%}
            {%- capture value_label_key -%}products.option_values.{{ value_key }}{%- endcapture -%}
            {%- assign value_label = value_label_key | t: default: value.name -%}
            <option
              value="{{ value.name | escape }}"
              {% if value.selected %}selected{% endif %}
            >
              {{ value_label | escape }}
            </option>
          {% endfor %}
        </select>

      </div>

    {% endfor %}

  </div>

  <noscript>

    <div class="product-options-native">

      {% for option in product.options_with_values %}

        {%- assign option_name_down = option.name | downcase -%}
        {%- if option_name_down == 'color' or option.name == 'لون' or option.name == 'اللون' -%}
          {%- assign option_label = 'products.option_names.color' | t -%}
        {%- elsif option_name_down == 'size' or option.name == 'مقاس' or option.name == 'المقاس' -%}
          {%- assign option_label = 'products.option_names.size' | t -%}
        {%- elsif option_name_down == 'material' or option.name == 'خامة' or option.name == 'الخامة' -%}
          {%- assign option_label = 'products.option_names.material' | t -%}
        {%- else -%}
          {%- assign option_label = option.name -%}
        {%- endif -%}

        <p>{{ option_label | escape }}</p>

        {% for value in option.values %}

          {%- assign value_key = value.name | handleize | replace: '-', '_' -%}
          {%- capture value_label_key -%}products.option_values.{{ value_key }}{%- endcapture -%}

          {%- capture option_ids -%}
            {%- for other_option in product.options_with_values -%}
              {%- unless forloop.first -%},{%- endunless -%}

              {%- if other_option.position == option.position -%}
                {{- value.id -}}
              {%- else -%}
                {%- for other_value in other_option.values -%}
                  {%- if other_value.selected -%}{{- other_value.id -}}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}

          <a
            href="{{ value.product_url | default: product.url }}?option_values={{ option_ids | strip | url_encode }}"
            {% if value.selected %}
              aria-current="true"
            {% endif %}
          >
            {{ value_label_key | t: default: value.name | escape }}
          </a>

        {% endfor %}

      {% endfor %}

    </div>

  </noscript>

{% endunless %}
