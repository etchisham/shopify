{% doc %}
  Product variant options.
  @param {product} product - Current product.
  @param {string} section_id - Owning section ID.
{% enddoc %}

{% unless product.has_only_default_variant %}

  <div
    class="product-options"
    data-product-options
  >

    {% for option in product.options_with_values %}

      {% assign option_index = option.position | minus: 1 %}

      <div class="product-form__field product-option-field">

        <label
          for="ProductOption-{{ section_id }}-{{ option.position }}"
        >
          {{ option.name | escape }}
        </label>

        <div class="product-option-select-wrap">

          <select
            id="ProductOption-{{ section_id }}-{{ option.position }}"
            class="product-option-select"
            data-product-option
            data-option-position="{{ option.position }}"
            autocomplete="off"
          >

            {% for value in option.values %}

              {%- comment -%}
                Options are never disabled: the script switches to the
                closest existing variant when a combination is missing.
                An option is only labelled "sold out" when no variant
                with that value is available at all.
              {%- endcomment -%}
              {%- assign value_available = false -%}

              {%- for variant in product.variants -%}
                {%- if variant.options[option_index] == value.name and variant.available -%}
                  {%- assign value_available = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              <option
                value="{{ value.name | escape }}"
                {% if value.selected %}
                  selected
                  data-selected
                {% endif %}
              >
                {{ value.name | escape }}
                {%- unless value_available %} — {{ 'products.product.sold_out' | t }}{% endunless -%}
              </option>

            {% endfor %}

          </select>

          <span class="product-option-select__chevron" aria-hidden="true">
            {% render 'icon', name: 'chevron' %}
          </span>

        </div>

      </div>

    {% endfor %}

  </div>

  <noscript>

    <div class="product-options-native">

      {% for option in product.options_with_values %}

        <p>{{ option.name | escape }}</p>

        {% for value in option.values %}

          {%- capture option_ids -%}
            {%- for other_option in product.options_with_values -%}
              {%- unless forloop.first -%},{%- endunless -%}

              {%- if other_option.position == option.position -%}
                {{- value.id -}}
              {%- else -%}
                {%- for other_value in other_option.values -%}
                  {%- if other_value.selected -%}{{- other_value.id -}}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}

          <a
            href="{{ value.product_url | default: product.url }}?option_values={{ option_ids | strip | url_encode }}"
            {% if value.selected %}
              aria-current="true"
            {% endif %}
          >
            {{ value.name | escape }}
          </a>

        {% endfor %}

      {% endfor %}

    </div>

  </noscript>

{% endunless %}
