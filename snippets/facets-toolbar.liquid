/* =========================================
   MOBILE
========================================= */

@media (max-width: 40rem) {

  .hilya-filter-sidebar {
    display: none;
  }


  /* =======================================
     MOBILE TOP BAR
  ======================================= */

  .hilya-filters {
    position: relative;
  }

  .hilya-filters__mobile-bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    width: 100%;
    min-height: 3rem;
    border-top: 1px solid rgb(0 0 0 / 9%);
    border-bottom: 1px solid rgb(0 0 0 / 9%);
  }


  /* FILTERS LEFT */

  .hilya-filters__mobile-button {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: .55rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-size: .63rem;
    font-weight: 500;
    letter-spacing: .1em;
    cursor: pointer;
  }


  /* FILTER ICON */

  .hilya-filters__filter-icon {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    justify-content: space-between;
    width: .7rem;
    height: .40rem;
    flex-basis: .7rem;
  }

  .hilya-filters__filter-icon span {
    position: relative;
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
  }

  .hilya-filters__filter-icon span::after {
    content: "";
    position: absolute;
    top: 50%;
    width: .23rem;
    height: .23rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: var(--color-background);
    transform: translateY(-50%);
  }

  .hilya-filters__filter-icon span:first-child::after {
    left: 18%;
  }

  .hilya-filters__filter-icon span:last-child::after {
    left: 58%;
  }

  .hilya-filters__filter-text {
    display: inline-block;
  }


  /* PRODUCTS CENTER */

  .hilya-filters__mobile-results {
    display: block;
    justify-self: center;
    color: var(--color-foreground);
    font-size: .58rem;
    letter-spacing: .075em;
    text-align: center;
    white-space: nowrap;
    text-transform: uppercase;
  }


  /* SORT RIGHT */

  .hilya-filters__sort--mobile {
    position: relative;
    display: flex;
    align-items: center;
    justify-self: end;
    gap: .45rem;
    white-space: nowrap;
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-label {
    display: inline;
    color: var(--color-muted);
    font-size: .58rem;
    font-weight: 400;
    letter-spacing: .02em;
    white-space: nowrap;
    text-transform: none;
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: .55rem;
    min-width: auto;
    min-height: auto;
    padding: .15rem 0 .18rem;
    border: 0 !important;
    border-bottom: 0 !important;
    border-radius: 0;
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-size: .58rem;
    font-weight: 400;
    text-align: left;
    cursor: pointer;
    box-shadow: none;
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-trigger:hover {
    border: 0 !important;
    border-bottom: 0 !important;
    background: transparent;
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-chevron {
    width: .38rem;
    height: .38rem;
    margin-top: -.15rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
  }

  .hilya-filters__sort--mobile.is-open .hilya-filters__sort-chevron {
    transform: rotate(225deg);
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-menu {
    top: calc(100% + .45rem);
    right: 0;
    width: 11rem;
  }


  /* HIDE OLD MOBILE TOOLBAR */

  .hilya-filters__products-toolbar {
    display: none;
  }


  /* =======================================
     MOBILE DRAWER
  ======================================= */

  .hilya-filter-drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    right: auto;

    z-index: 100001;

    width: min(28rem, 92vw);

    height: 100dvh;
    max-height: 100dvh;

    overflow: hidden;

    display: flex;
    flex-direction: column;

    background: var(--color-background);

    transform: translateX(-100%);

    transition: transform 320ms cubic-bezier(.22,.61,.36,1);

    overscroll-behavior: none;
  }

  .hilya-filter-drawer.is-open {
    transform: translateX(0);
  }


  /* =======================================
     MOBILE DRAWER HEADER

     FILTERS + FILTERED BY
     STAY TOGETHER
  ======================================= */

  .hilya-filter-drawer__header {
    display: flex;
    align-items: flex-start;
