  }

}


/* =========================================
   REDUCED MOTION
========================================= */

@media (prefers-reduced-motion: reduce) {

  .hilya-filter-overlay,
  .hilya-filter-drawer,
  .hilya-filter-chevron,
  .hilya-filters__sort-chevron {
    transition: none;
  }

}

/* =========================================
   ARABIC / RTL
========================================= */

/* Price slider and the two price boxes stay left-to-right (min on the left) */
[dir="rtl"] .hilya-price-slider,
[dir="rtl"] .hilya-price-values {
  direction: ltr;
}

[dir="rtl"] .hilya-filter-group__toggle,
[dir="rtl"] .hilya-filters__sort-trigger,
[dir="rtl"] .hilya-filters__sort-option {
  text-align: right;
}

/* The sort menu opens toward the inside of the page */
[dir="rtl"] .hilya-filters__sort-menu {
  right: auto;
  left: 0;
}

/* Filter drawer on phones slides in from the right in Arabic */
[dir="rtl"] .hilya-filter-drawer {
  right: 0;
  left: auto;
  transform: translateX(100%);
}

[dir="rtl"] .hilya-filter-drawer.is-open {
  transform: translateX(0);
}

/* Arabic needs bigger letters than these very small English sizes */
html[dir="rtl"] .hilya-filter-sidebar__heading h2 { font-size: 1.15rem; }
html[dir="rtl"] .hilya-filters__active-label { font-size: .75rem; }
html[dir="rtl"] .hilya-filter-chip { font-size: .8rem; }
html[dir="rtl"] .hilya-filter-chip__remove { font-size: .95rem; }
html[dir="rtl"] .hilya-filters__clear { font-size: .8rem; }
html[dir="rtl"] .hilya-filter-group__toggle { font-size: .95rem; }
html[dir="rtl"] .hilya-filter-option { font-size: .92rem; }
html[dir="rtl"] .hilya-price-values { font-size: .85rem; }
html[dir="rtl"] .hilya-price-input span { font-size: .75rem; }
html[dir="rtl"] .hilya-price-input input { font-size: .85rem; }
html[dir="rtl"] .hilya-price-values__to { font-size: .8rem; }
html[dir="rtl"] .hilya-filters__results { font-size: .85rem; }
html[dir="rtl"] .hilya-filters__sort-label { font-size: .82rem; }
html[dir="rtl"] .hilya-filters__sort-trigger { font-size: .85rem; }
html[dir="rtl"] .hilya-filters__sort-option { font-size: .85rem; }
html[dir="rtl"] .hilya-filter-drawer__eyebrow { font-size: .75rem; }
html[dir="rtl"] .hilya-filter-drawer__header h2 { font-size: 1.3rem; }

@media (max-width: 40rem) {
  html[dir="rtl"] .hilya-filters__mobile-button { font-size: .8rem; }
  html[dir="rtl"] .hilya-filters__mobile-results { font-size: .78rem; }
  html[dir="rtl"] .hilya-filters__sort--mobile .hilya-filters__sort-label,
  html[dir="rtl"] .hilya-filters__sort--mobile .hilya-filters__sort-trigger { font-size: .75rem; }
  html[dir="rtl"] .hilya-filter-drawer__header .hilya-filters__active-label { font-size: .72rem; }
  html[dir="rtl"] .hilya-filter-drawer__header .hilya-filter-chip { font-size: .78rem; }
  html[dir="rtl"] .hilya-filter-drawer__header .hilya-filters__clear { font-size: .78rem; }
}

@media (max-width: 27rem) {
  html[dir="rtl"] .hilya-filters__mobile-button { font-size: .75rem; }
  html[dir="rtl"] .hilya-filters__mobile-results { font-size: .72rem; }
  html[dir="rtl"] .hilya-filters__sort--mobile .hilya-filters__sort-label,
  html[dir="rtl"] .hilya-filters__sort--mobile .hilya-filters__sort-trigger { font-size: .7rem; }
}

/* =========================================
   HILYA PRICE FILTER REFINEMENT
   --hilya-rose below is the accent colour of the price filter (black now).
========================================= */

.hilya-filters {
  --hilya-rose: #B87F6F;
  --hilya-rose-soft: rgb(184 127 111 / 18%);
  --hilya-slider-h: 22px;
  --hilya-thumb: 14px;
}


/* ---------- SLIDER: the line + the dots on the same axis ---------- */

.hilya-filters .hilya-price-slider {
  height: var(--hilya-slider-h);
  margin: .35rem 0 .7rem;
}

/* grey line (thin) */
.hilya-filters .hilya-price-slider__track {
  height: 1px;
  background: rgb(0 0 0 / 14%) !important;
}

/* selected part (rose gold) */
.hilya-filters .hilya-price-slider__range {
  height: 2px;
  background: var(--hilya-rose) !important;
  border-radius: 2px;
}

/* the two real inputs: same height as the wrapper, thumb centered by math */
.hilya-filters .hilya-price-slider input[type="range"] {
  height: var(--hilya-slider-h) !important;
}

.hilya-filters .hilya-price-slider input[type="range"]::-webkit-slider-runnable-track {
  height: var(--hilya-slider-h);
  background: transparent !important;
}

.hilya-filters .hilya-price-slider input[type="range"]::-webkit-slider-thumb {
  width: var(--hilya-thumb);
  height: var(--hilya-thumb);
  margin-top: calc((var(--hilya-slider-h) - var(--hilya-thumb)) / 2);
  border: 2px solid #fff !important;
  border-radius: 50%;
  background: var(--hilya-rose) !important;
  box-shadow: 0 0 0 1px var(--hilya-rose), 0 1px 3px rgb(0 0 0 / 18%) !important;
  transition: box-shadow 160ms ease, transform 160ms ease;
}

.hilya-filters .hilya-price-slider input[type="range"]::-moz-range-track {
  height: var(--hilya-slider-h);
  background: transparent !important;
}

.hilya-filters .hilya-price-slider input[type="range"]::-moz-range-thumb {
  box-sizing: border-box;
  width: var(--hilya-thumb);
  height: var(--hilya-thumb);
  border: 2px solid #fff !important;
  border-radius: 50%;
  background: var(--hilya-rose) !important;
  box-shadow: 0 0 0 1px var(--hilya-rose), 0 1px 3px rgb(0 0 0 / 18%) !important;
}

.hilya-filters .hilya-price-slider input[type="range"]:hover::-webkit-slider-thumb,
.hilya-filters .hilya-price-slider input[type="range"]:focus-visible::-webkit-slider-thumb {
  box-shadow: 0 0 0 1px var(--hilya-rose), 0 0 0 6px var(--hilya-rose-soft) !important;
}

.hilya-filters .hilya-price-slider input[type="range"]:hover::-moz-range-thumb,
.hilya-filters .hilya-price-slider input[type="range"]:focus-visible::-moz-range-thumb {
  box-shadow: 0 0 0 1px var(--hilya-rose), 0 0 0 6px var(--hilya-rose-soft) !important;
}


/* ---------- PRICE FIELDS: no boxes, just a thin underline ---------- */

.hilya-filters .hilya-price-values {
  gap: .9rem;
  align-items: end;
}

.hilya-filters .hilya-price-input {
  display: flex;
  align-items: baseline;
  gap: .45rem;
  height: auto;
  padding: 0 0 .4rem !important;
  border: 0 !important;
  border-bottom: 1px solid rgb(0 0 0 / 20%) !important;
  border-radius: 0;
  background: transparent !important;
  box-shadow: none !important;
  transition: border-color 180ms ease;
}

.hilya-filters .hilya-price-input:hover {
  border-bottom-color: rgb(0 0 0 / 45%) !important;
}

.hilya-filters .hilya-price-input:focus-within {
