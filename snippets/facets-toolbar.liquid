{% doc %}
  Hilya custom collection filters.
  Client-side filtering without Shopify Search & Discovery.
{% enddoc %}

<div class="hilya-filters">

  <!-- MOBILE FILTER BUTTON -->
  <div class="hilya-filters__mobile-bar">

    <button
      type="button"
      class="hilya-filters__mobile-button"
      data-filter-open
      aria-expanded="false"
      aria-controls="HilyaFilterDrawer"
    >
      FILTER
      <span
        class="hilya-filters__count"
        data-filter-count
        hidden
      >
        0
      </span>
    </button>

    <span class="hilya-filters__mobile-results">
      <span data-filter-results>
        {{ collection.products_count }}
      </span>
      PRODUCTS
    </span>

  </div>


  <!-- DESKTOP SIDEBAR -->
  <aside class="hilya-filter-sidebar">

    <div class="hilya-filter-sidebar__heading">
      <h2>Filters</h2>
    </div>


    <!-- ACTIVE FILTERS -->

    <div
      class="hilya-filters__active"
      data-active-filters
      hidden
    >
    </div>


    <form
      class="hilya-filter-form"
      data-hilya-filter-form
    >

      <!-- AVAILABILITY -->

      <details
        class="hilya-filter-group"
        open
      >

        <summary>
          <span>Availability</span>

          <span class="hilya-filter-chevron">
            +
          </span>
        </summary>


        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="availability"
              value="in_stock"
            >

            <span>In stock</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="availability"
              value="out_of_stock"
            >

            <span>Out of stock</span>

          </label>

        </div>

      </details>


      <!-- PRICE -->

      <details
        class="hilya-filter-group"
        open
      >

        <summary>
          <span>Price</span>

          <span class="hilya-filter-chevron">
            +
          </span>
        </summary>


        <div class="hilya-filter-group__content">

          <div class="hilya-price-slider">

            <div class="hilya-price-slider__track"></div>

            <div
              class="hilya-price-slider__range"
              data-price-range
            ></div>


            <input
              type="range"
              name="price_min"
              min="0"
              max="1000"
              value="0"
              step="1"
              data-price-min
              aria-label="Minimum price"
            >

            <input
              type="range"
              name="price_max"
              min="0"
              max="1000"
              value="1000"
              step="1"
              data-price-max
              aria-label="Maximum price"
            >

          </div>


          <div class="hilya-price-values">

            <div>
              <span>EGP</span>
              <strong data-price-min-value>0</strong>
            </div>

            <span class="hilya-price-values__to">
              to
            </span>

            <div>
              <span>EGP</span>
              <strong data-price-max-value>1000</strong>
            </div>

          </div>

        </div>

      </details>


      <!-- COLOR -->

      <details
        class="hilya-filter-group"
        open
      >

        <summary>
          <span>Color</span>

          <span class="hilya-filter-chevron">
            +
          </span>
        </summary>


        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="color"
              value="Gold Plated"
            >

            <span>Gold Plated</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="color"
              value="Silver Plated"
            >

            <span>Silver Plated</span>

          </label>

        </div>

      </details>


      <!-- PRODUCT TYPE -->

      <details
        class="hilya-filter-group"
        open
      >

        <summary>
          <span>Product Type</span>

          <span class="hilya-filter-chevron">
            +
          </span>
        </summary>


        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="product_type"
              value="Necklaces"
            >

            <span>Necklaces</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="product_type"
              value="Rings"
            >

            <span>Rings</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="product_type"
              value="Pendants"
            >

            <span>Pendants</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="product_type"
              value="Bracelets"
            >

            <span>Bracelets</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="product_type"
              value="Keychains"
            >

            <span>Keychains</span>

          </label>

        </div>

      </details>

    </form>

  </aside>


  <!-- MOBILE DRAWER -->

  <div
    class="hilya-filter-overlay"
    data-filter-overlay
  ></div>


  <aside
    id="HilyaFilterDrawer"
    class="hilya-filter-drawer"
    data-filter-drawer
    aria-hidden="true"
  >

    <div class="hilya-filter-drawer__header">

      <div>

        <span class="hilya-filter-drawer__eyebrow">
          COLLECTION
        </span>

        <h2>
          FILTERS
        </h2>

      </div>


      <button
        type="button"
        class="hilya-filter-drawer__close"
        data-filter-close
        aria-label="Close filters"
      >
        ×
      </button>

    </div>


    <div class="hilya-filter-drawer__content">

      <div
        class="hilya-filters__active"
        data-active-filters-mobile
        hidden
      >
      </div>

      <div data-mobile-filter-content></div>

    </div>

  </aside>


  <!-- TOP PRODUCTS / SORT -->

  <div class="hilya-filters__products-toolbar">

    <span class="hilya-filters__results">
      <span data-filter-results>
        {{ collection.products_count }}
      </span>
      PRODUCTS
    </span>


    <div class="hilya-filters__sort">

      <label for="HilyaSortMobile">
        SORT BY
      </label>

      <select
        id="HilyaSortMobile"
        data-hilya-sort
      >

        {% for option in collection.sort_options %}

          <option
            value="{{ option.value }}"
            {% if option.value == collection.sort_by %}
              selected
            {% endif %}
          >
            {{ option.name }}
          </option>

        {% endfor %}

      </select>

    </div>

  </div>

</div>


{% javascript %}

document.addEventListener('DOMContentLoaded', function () {

  const openButton =
    document.querySelector('[data-filter-open]');

  const closeButton =
    document.querySelector('[data-filter-close]');

  const drawer =
    document.querySelector('[data-filter-drawer]');

  const overlay =
    document.querySelector('[data-filter-overlay]');

  const form =
    document.querySelector('[data-hilya-filter-form]');

  const items =
    Array.from(
      document.querySelectorAll('[data-product-item]')
    );

  const resultsElements =
    document.querySelectorAll('[data-filter-results]');

  const countBadge =
    document.querySelector('[data-filter-count]');

  const activeFilters =
    document.querySelector('[data-active-filters]');

  const activeFiltersMobile =
    document.querySelector('[data-active-filters-mobile]');

  const mobileContent =
    document.querySelector('[data-mobile-filter-content]');


  if (!form) {
    return;
  }


  /* =========================================
     MOBILE DRAWER
  ========================================= */

  function openDrawer() {

    if (!drawer) {
      return;
    }

    drawer.classList.add('is-open');

    if (overlay) {
      overlay.classList.add('is-visible');
    }

    drawer.setAttribute(
      'aria-hidden',
      'false'
    );

    if (openButton) {
      openButton.setAttribute(
        'aria-expanded',
        'true'
      );
    }

    document.documentElement.classList.add(
      'hilya-filter-lock'
    );

  }


  function closeDrawer() {

    if (!drawer) {
      return;
    }

    drawer.classList.remove('is-open');

    if (overlay) {
      overlay.classList.remove('is-visible');
    }

    drawer.setAttribute(
      'aria-hidden',
      'true'
    );

    if (openButton) {
      openButton.setAttribute(
        'aria-expanded',
        'false'
      );
    }

    document.documentElement.classList.remove(
      'hilya-filter-lock'
    );

  }


  if (openButton) {
    openButton.addEventListener(
      'click',
      openDrawer
    );
  }


  if (closeButton) {
    closeButton.addEventListener(
      'click',
      closeDrawer
    );
  }


  if (overlay) {
    overlay.addEventListener(
      'click',
      closeDrawer
    );
  }


  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {
        closeDrawer();
      }

    }
  );


  /* =========================================
     MOVE FILTER CONTENT TO MOBILE
  ========================================= */

  if (mobileContent) {

    const filterGroups =
      form.querySelectorAll(
        '.hilya-filter-group'
      );

    filterGroups.forEach(function (group) {

      mobileContent.appendChild(
        group.cloneNode(true)
      );

    });


    mobileContent.addEventListener(
      'change',
      function (event) {

        if (
          event.target.matches(
            'input[type="checkbox"]'
          )
        ) {

          const name =
            event.target.name;

          const value =
            event.target.value;

          const desktopInput =
            form.querySelector(
              'input[name="' +
              name +
              '"][value="' +
              value +
              '"]'
            );

          if (desktopInput) {
            desktopInput.checked =
              event.target.checked;
          }

          applyFilters();

        }

      }
    );

  }


  /* =========================================
     VARIANT IMAGE + PRICE
  ========================================= */

  function updateProductCard(item, color) {

    const dataElement =
      item.querySelector(
        '[data-variant-data]'
      );

    const card =
      item.querySelector(
        '[data-product-card]'
      );

    if (!dataElement || !card) {
      return;
    }


    let variants = [];

    try {

      variants =
        JSON.parse(
          dataElement.textContent
        );

    } catch (error) {

      return;

    }


    if (!color || color === 'all') {

      resetProductCard(item);

      return;

    }


    const wantedColor =
      color.trim().toLowerCase();


    const variant =
      variants.find(function (entry) {

        return (
          String(entry.color || '')
            .trim()
            .toLowerCase() ===
          wantedColor
        );

      });


    if (!variant) {

      resetProductCard(item);

      return;

    }


    /* PRICE */

    const priceElement =
      card.querySelector(
        '[data-product-price]'
      );


    if (
      priceElement &&
      variant.price !== undefined
    ) {

      priceElement.innerHTML =
        '<span class="price">' +
          '<span class="price__current">' +
            'EGP ' +
            Number(
              variant.price
            ).toLocaleString('en-US') +
          '</span>' +
        '</span>';

    }


    /* PRODUCT URL */

    const productLinks =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    productLinks.forEach(function (link) {

      if (variant.url) {

        link.setAttribute(
          'href',
          variant.url
        );

      }

    });


    /* IMAGES */

    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    const colorImages =
      Array.isArray(variant.images)
        ? variant.images
        : [];


    let primaryImage =
      null;

    let secondaryImage =
      null;


    if (
      variant.image &&
      variant.image.src
    ) {

      primaryImage =
        variant.image;

    }


    if (
      !primaryImage &&
      colorImages.length > 0
    ) {

      primaryImage =
        colorImages[0];

    }


    if (colorImages.length > 1) {

      const firstImageSrc =
        primaryImage
          ? primaryImage.src
          : null;


      secondaryImage =
        colorImages.find(function (image) {

          return (
            !firstImageSrc ||
            image.src !== firstImageSrc
          );

        });

    }


    if (
      !secondaryImage &&
      colorImages.length > 1
    ) {

      secondaryImage =
        colorImages[1];

    }


    if (primaryImage) {

      setLayerImage(
        primaryLayer,
        primaryImage
      );

    }


    if (secondaryImage) {

      setLayerImage(
        secondaryLayer,
        secondaryImage
      );

      if (secondaryLayer) {
        secondaryLayer.hidden = false;
      }

      card.classList.add(
        'product-card--has-secondary'
      );

    } else {

      if (secondaryLayer) {

        secondaryLayer.hidden = true;

        secondaryLayer.innerHTML = '';

      }

      card.classList.remove(
        'product-card--has-secondary'
      );

    }


    updateAvailabilityBadge(
      card,
      variant.available
    );

  }


  /* =========================================
     SET IMAGE
  ========================================= */

  function setLayerImage(layer, image) {

    if (
      !layer ||
      !image ||
      !image.src
    ) {
      return;
    }


    layer.innerHTML =
      '<img' +
      ' src="' +
      escapeAttribute(image.src) +
      '"' +
      ' alt="' +
      escapeAttribute(
        image.alt || ''
      ) +
      '"' +
      ' loading="lazy"' +
      ' width="1200"' +
      ' height="960"' +
      '>';

  }


  /* =========================================
     AVAILABILITY
  ========================================= */

  function updateAvailabilityBadge(
    card,
    available
  ) {

    const media =
      card.querySelector(
        '[data-product-media]'
      );

    if (!media) {
      return;
    }


    let badge =
      media.querySelector(
        '[data-variant-sold-out]'
      );


    if (available) {

      if (badge) {
        badge.remove();
      }

      return;

    }


    if (!badge) {

      badge =
        document.createElement(
          'span'
        );

      badge.className =
        'product-card__badge';

      badge.dataset.variantSoldOut =
        '';

      badge.textContent =
        'Sold out';

      media.appendChild(
        badge
      );

    }

  }


  /* =========================================
     RESET CARD
  ========================================= */

  function resetProductCard(item) {

    const card =
      item.querySelector(
        '[data-product-card]'
      );

    if (!card) {
      return;
    }


    const productPrice =
      item.dataset.productPrice;


    const priceElement =
      card.querySelector(
        '[data-product-price]'
      );


    if (
      priceElement &&
      productPrice !== undefined
    ) {

      priceElement.innerHTML =
        '<span class="price">' +
          '<span class="price__current">' +
            'EGP ' +
            Number(
              productPrice
            ).toLocaleString('en-US') +
          '</span>' +
        '</span>';

    }


    const links =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    links.forEach(function (link) {

      const originalUrl =
        link.dataset.originalUrl;

      if (originalUrl) {

        link.setAttribute(
          'href',
          originalUrl
        );

      }

    });


    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    if (primaryLayer) {

      const originalImage =
        primaryLayer.dataset.originalHtml;

      if (originalImage) {

        primaryLayer.innerHTML =
          originalImage;

      }

    }


    if (secondaryLayer) {

      const originalImage =
        secondaryLayer.dataset.originalHtml;

      if (originalImage) {

        secondaryLayer.innerHTML =
          originalImage;

        secondaryLayer.hidden =
          false;

      }

    }


    if (
      secondaryLayer &&
      !secondaryLayer.innerHTML.trim()
    ) {

      card.classList.remove(
        'product-card--has-secondary'
      );

    } else {

      card.classList.add(
        'product-card--has-secondary'
      );

    }


    const variantBadge =
      card.querySelector(
        '[data-variant-sold-out]'
      );


    if (variantBadge) {
      variantBadge.remove();
    }

  }


  /* =========================================
     ESCAPE
  ========================================= */

  function escapeAttribute(value) {

    return String(value)
      .replace(
        /&/g,
        '&amp;'
      )
      .replace(
        /"/g,
        '&quot;'
      )
      .replace(
        /</g,
        '&lt;'
      )
      .replace(
        />/g,
        '&gt;'
      );

  }


  /* =========================================
     STORE ORIGINAL CARD STATE
  ========================================= */

  items.forEach(function (item) {

    const card =
      item.querySelector(
        '[data-product-card]'
      );

    if (!card) {
      return;
    }


    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    const links =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    links.forEach(function (link) {

      link.dataset.originalUrl =
        link.getAttribute('href') || '';

    });


    if (primaryLayer) {

      primaryLayer.dataset.originalHtml =
        primaryLayer.innerHTML;

    }


    if (secondaryLayer) {

      secondaryLayer.dataset.originalHtml =
        secondaryLayer.innerHTML;

    }

  });


  /* =========================================
     PRICE SLIDER
  ========================================= */

  const priceMin =
    form.querySelector(
      '[data-price-min]'
    );

  const priceMax =
    form.querySelector(
      '[data-price-max]'
    );

  const priceMinValue =
    form.querySelector(
      '[data-price-min-value]'
    );

  const priceMaxValue =
    form.querySelector(
      '[data-price-max-value]'
    );

  const priceRange =
    form.querySelector(
      '[data-price-range]'
    );


  function updatePriceSlider(
    shouldApply
  ) {

    if (
      !priceMin ||
      !priceMax
    ) {
      return;
    }


    let min =
      Number(priceMin.value);

    let max =
      Number(priceMax.value);


    if (min > max) {

      if (
        document.activeElement ===
        priceMin
      ) {

        max = min;
        priceMax.value = max;

      } else {

        min = max;
        priceMin.value = min;

      }

    }


    if (priceMinValue) {
      priceMinValue.textContent =
        min.toLocaleString('en-US');
    }


    if (priceMaxValue) {
      priceMaxValue.textContent =
        max.toLocaleString('en-US');
    }


    if (priceRange) {

      const left =
        (min / 1000) * 100;

      const right =
        100 -
        ((max / 1000) * 100);

      priceRange.style.left =
        left + '%';

      priceRange.style.right =
        right + '%';

    }


    if (shouldApply) {
      applyFilters();
    }

  }


  if (priceMin) {

    priceMin.addEventListener(
      'input',
      function () {
        updatePriceSlider(true);
      }
    );

  }


  if (priceMax) {

    priceMax.addEventListener(
      'input',
      function () {
        updatePriceSlider(true);
      }
    );

  }


  updatePriceSlider(false);


  /* =========================================
     FILTER
  ========================================= */

  function getCheckedValues(name) {

    return Array.from(
      form.querySelectorAll(
        'input[name="' +
        name +
        '"]:checked'
      )
    ).map(function (input) {

      return input.value
        .trim()
        .toLowerCase();

    });

  }


  function applyFilters() {

    const availability =
      getCheckedValues(
        'availability'
      );

    const colors =
      getCheckedValues(
        'color'
      );

    const productTypes =
      getCheckedValues(
        'product_type'
      );


    const minPrice =
      priceMin
        ? Number(priceMin.value)
        : 0;

    const maxPrice =
      priceMax
        ? Number(priceMax.value)
        : 1000;


    let visibleCount = 0;


    items.forEach(function (item) {

      const itemType =
        (
          item.dataset.productType ||
          ''
        )
          .trim()
          .toLowerCase();


      const itemPrice =
        Number(
          item.dataset.productPrice ||
          0
        );


      const itemAvailable =
        item.dataset.productAvailable ===
        'true';


      const itemColors =
        (
          item.dataset.productColors ||
          ''
        )
          .toLowerCase()
          .split('|')
          .map(function (value) {
            return value.trim();
          })
          .filter(Boolean);


      let matches =
        true;


      /* AVAILABILITY */

      if (
        availability.length > 0
      ) {

        const matchesAvailability =
          availability.some(
            function (value) {

              if (
                value === 'in_stock'
              ) {

                return itemAvailable;

              }

              if (
                value === 'out_of_stock'
              ) {

                return !itemAvailable;

              }

              return false;

            }
          );


        if (
          !matchesAvailability
        ) {
          matches = false;
        }

      }


      /* COLOR */

      if (
        matches &&
        colors.length > 0
      ) {

        const matchesColor =
          colors.some(
            function (color) {

              return itemColors.includes(
                color
              );

            }
          );


        if (!matchesColor) {
          matches = false;
        }

      }


      /* PRODUCT TYPE */

      if (
        matches &&
        productTypes.length > 0
      ) {

        const matchesType =
          productTypes.includes(
            itemType
          );


        if (!matchesType) {
          matches = false;
        }

      }


      /* PRICE */

      let effectivePrice =
        itemPrice;


      if (
        colors.length === 1
      ) {

        const dataElement =
          item.querySelector(
            '[data-variant-data]'
          );


        if (dataElement) {

          try {

            const variants =
              JSON.parse(
                dataElement.textContent
              );


            const selectedVariant =
              variants.find(
                function (variant) {

                  return (
                    String(
                      variant.color || ''
                    )
                      .trim()
                      .toLowerCase() ===
                    colors[0]
                  );

                }
              );


            if (
              selectedVariant &&
              selectedVariant.price !==
              undefined
            ) {

              effectivePrice =
                Number(
                  selectedVariant.price
                );

            }

          } catch (error) {}

        }

      }


      if (
        effectivePrice <
        minPrice ||
        effectivePrice >
        maxPrice
      ) {

        matches = false;

      }


      /* DISPLAY */

      if (matches) {

        item.classList.remove(
          'is-filtered-out'
        );

        visibleCount++;


        /*
          Only swap the card to a specific
          variant when ONE color is selected.
        */

        if (
          colors.length === 1
        ) {

          updateProductCard(
            item,
            colors[0]
          );

        } else {

          resetProductCard(
            item
          );

        }

      } else {

        item.classList.add(
          'is-filtered-out'
        );

      }

    });


    /* RESULTS */

    resultsElements.forEach(
      function (element) {

        element.textContent =
          visibleCount;

      }
    );


    /* ACTIVE FILTER COUNT */

    const activeCount =
      availability.length +
      colors.length +
      productTypes.length +
      (
        minPrice > 0
          ? 1
          : 0
      ) +
      (
        maxPrice < 1000
          ? 1
          : 0
      );


    if (countBadge) {

      countBadge.textContent =
        activeCount;

      countBadge.hidden =
        activeCount === 0;

    }


    /* ACTIVE CHIPS */

    renderActiveFilters(
      availability,
      colors,
      productTypes,
      minPrice,
      maxPrice
    );

  }


  /* =========================================
     ACTIVE FILTER CHIPS
  ========================================= */

  function renderActiveFilters(
    availability,
    colors,
    productTypes,
    minPrice,
    maxPrice
  ) {

    const containers =
      [
        activeFilters,
        activeFiltersMobile
      ].filter(Boolean);


    containers.forEach(
      function (container) {

        container.innerHTML =
          '';


        const hasFilters =
          availability.length > 0 ||
          colors.length > 0 ||
          productTypes.length > 0 ||
          minPrice > 0 ||
          maxPrice < 1000;


        if (!hasFilters) {

          container.hidden =
            true;

          return;

        }


        container.hidden =
          false;


        const title =
          document.createElement(
            'span'
          );

        title.className =
          'hilya-filters__active-label';

        title.textContent =
          'FILTERED BY';

        container.appendChild(
          title
        );


        availability.forEach(
          function (value) {

            addChip(
              container,
              value === 'in_stock'
                ? 'In stock'
                : 'Out of stock'
            );

          }
        );


        colors.forEach(
          function (value) {

            addChip(
              container,
              value
            );

          }
        );


        productTypes.forEach(
          function (value) {

            addChip(
              container,
              value
                .charAt(0)
                .toUpperCase() +
              value.slice(1)
            );

          }
        );


        if (minPrice > 0) {

          addChip(
            container,
            'From EGP ' +
            minPrice.toLocaleString(
              'en-US'
            )
          );

        }


        if (maxPrice < 1000) {

          addChip(
            container,
            'To EGP ' +
            maxPrice.toLocaleString(
              'en-US'
            )
          );

        }


        const clear =
          document.createElement(
            'button'
          );

        clear.type =
          'button';

        clear.className =
          'hilya-filters__clear';

        clear.textContent =
          'CLEAR ALL';

        clear.addEventListener(
          'click',
          clearFilters
        );

        container.appendChild(
          clear
        );

      }
    );

  }


  function addChip(
    container,
    label
  ) {

    const chip =
      document.createElement(
        'span'
      );

    chip.className =
      'hilya-filter-chip';

    chip.innerHTML =
      '<span>' +
      escapeAttribute(label) +
      '</span>';


    container.appendChild(
      chip
    );

  }


  /* =========================================
     CLEAR
  ========================================= */

  function clearFilters() {

    form
      .querySelectorAll(
        'input[type="checkbox"]'
      )
      .forEach(
        function (input) {

          input.checked =
            false;

        }
      );


    if (priceMin) {
      priceMin.value =
        0;
    }


    if (priceMax) {
      priceMax.value =
        1000;
    }


    if (mobileContent) {

      mobileContent
        .querySelectorAll(
          'input[type="checkbox"]'
        )
        .forEach(
          function (input) {

            input.checked =
              false;

          }
        );

    }


    updatePriceSlider(
      false
    );

    applyFilters();

  }


  /* =========================================
     CHECKBOX EVENTS
  ========================================= */

  form.addEventListener(
    'change',
    function (event) {

      if (
        event.target.matches(
          'input[type="checkbox"]'
        )
      ) {

        /*
          Keep mobile cloned controls
          synchronized with desktop controls.
        */

        if (mobileContent) {

          const matching =
            mobileContent.querySelector(
              'input[name="' +
              event.target.name +
              '"][value="' +
              event.target.value +
              '"]'
            );

          if (matching) {

            matching.checked =
              event.target.checked;

          }

        }


        applyFilters();

      }

    }
  );


  /* =========================================
     SORT
  ========================================= */

  const sortSelects =
    document.querySelectorAll(
      '[data-hilya-sort]'
    );


  sortSelects.forEach(
    function (sortSelect) {

      sortSelect.addEventListener(
        'change',
        function () {

          sortSelects.forEach(
            function (otherSelect) {

              otherSelect.value =
                sortSelect.value;

            }
          );


          const url =
            new URL(
              window.location.href
            );


          url.searchParams.set(
            'sort_by',
            this.value
          );


          window.location.href =
            url.toString();

        }
      );

    }
  );


  /* =========================================
     INITIAL FILTER
  ========================================= */

  applyFilters();

});


{% endjavascript %}


{% stylesheet %}

/* =========================================
   MAIN
========================================= */

.hilya-filters {
  width: 100%;
}


/* =========================================
   MOBILE BAR
========================================= */

.hilya-filters__mobile-bar {
  display: none;
}


/* =========================================
   SIDEBAR
========================================= */

.hilya-filter-sidebar {
  width: 100%;
}


.hilya-filter-sidebar__heading {
  margin-bottom: 1.35rem;
}


.hilya-filter-sidebar__heading h2 {
  margin: 0;

  color: var(--color-foreground);

  font-size: 1rem;
  font-weight: 400;

  letter-spacing: .01em;
}


/* =========================================
   ACTIVE FILTERS
========================================= */

.hilya-filters__active {
  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: .5rem;

  margin-bottom: 1.35rem;
}


.hilya-filters__active-label {
  width: 100%;

  margin-bottom: .15rem;

  color: var(--color-muted);

  font-size: .58rem;

  letter-spacing: .12em;

  text-transform: uppercase;
}


.hilya-filter-chip {
  display: inline-flex;

  align-items: center;

  padding: .5rem .65rem;

  border: 1px solid
    rgb(0 0 0 / 10%);

  background:
    rgb(0 0 0 / 3%);

  color: var(--color-foreground);

  font-size: .68rem;

  line-height: 1;
}


.hilya-filters__clear {
  padding: 0;

  border: 0;

  background: transparent;

  color: var(--color-muted);

  font: inherit;

  font-size: .66rem;

  text-decoration: underline;

  text-underline-offset: .22rem;

  cursor: pointer;
}


/* =========================================
   FILTER GROUPS
========================================= */

.hilya-filter-group {
  border-top:
    1px solid
    rgb(0 0 0 / 9%);
}


.hilya-filter-group:last-child {
  border-bottom:
    1px solid
    rgb(0 0 0 / 9%);
}


.hilya-filter-group summary {
  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 1rem 0;

  color: var(--color-foreground);

  font-size: .69rem;

  font-weight: 500;

  letter-spacing: .1em;

  text-transform: uppercase;

  cursor: pointer;

  list-style: none;
}


.hilya-filter-group summary::-webkit-details-marker {
  display: none;
}


.hilya-filter-chevron {
  font-size: 1rem;

  font-weight: 300;

  line-height: 1;

  transition:
    transform 180ms ease;
}


.hilya-filter-group[open]
.hilya-filter-chevron {
  transform: rotate(45deg);
}


.hilya-filter-group__content {
  padding:
    0 0 1rem;
}


/* =========================================
   OPTIONS
========================================= */

.hilya-filter-option {
  display: flex;

  align-items: center;

  gap: .65rem;

  min-height: 2.25rem;

  color: var(--color-foreground);

  font-size: .76rem;

  cursor: pointer;
}


.hilya-filter-option input {
  width: .95rem;

  height: .95rem;

  margin: 0;

  accent-color: #111;

  cursor: pointer;
}


/* =========================================
   PRICE SLIDER
========================================= */

.hilya-price-slider {
  position: relative;

  width: 100%;

  height: 1.8rem;

  margin:
    .2rem 0 .55rem;
}


.hilya-price-slider__track,
.hilya-price-slider__range {
  position: absolute;

  top: 50%;

  height: 2px;

  transform:
    translateY(-50%);
}


.hilya-price-slider__track {
  right: 0;
  left: 0;

  background:
    rgb(0 0 0 / 16%);
}


.hilya-price-slider__range {
  background:
    var(--color-foreground);

  z-index: 1;
}


.hilya-price-slider input[type="range"] {
  position: absolute;

  inset: 0;

  width: 100%;

  height: 1.8rem;

  margin: 0;

  padding: 0;

  background: transparent;

  appearance: none;

  pointer-events: none;
}


.hilya-price-slider
input[type="range"]::-webkit-slider-thumb {
  width: 13px;

  height: 13px;

  border: 1px solid
    var(--color-foreground);

  border-radius: 50%;

  background:
    var(--color-background);

  appearance: none;

  cursor: pointer;

  pointer-events: auto;
}


.hilya-price-slider
input[type="range"]::-moz-range-thumb {
  width: 13px;

  height: 13px;

  border: 1px solid
    var(--color-foreground);

  border-radius: 50%;

  background:
    var(--color-background);

  cursor: pointer;

  pointer-events: auto;
}


.hilya-price-values {
  display: grid;

  grid-template-columns:
    1fr auto 1fr;

  align-items: center;

  gap: .5rem;

  font-size: .67rem;
}


.hilya-price-values > div {
  display: flex;

  align-items: center;

  gap: .25rem;
}


.hilya-price-values > div:last-child {
  justify-content: flex-end;
}


.hilya-price-values span {
  color: var(--color-muted);
}


.hilya-price-values strong {
  color: var(--color-foreground);

  font-weight: 400;
}


.hilya-price-values__to {
  color: var(--color-muted);

  font-size: .62rem;
}


/* =========================================
   SORT
========================================= */

.hilya-filter-sidebar__sort {
  display: none;
}


.hilya-filters__products-toolbar {
  display: flex;

  align-items: center;

  justify-content: space-between;

  width: 100%;

  min-height: 3.5rem;

  margin-bottom: 1.5rem;

  border-bottom:
    1px solid
    rgb(0 0 0 / 9%);
}


.hilya-filters__results {
  color: var(--color-foreground);

  font-size: .68rem;

  letter-spacing: .08em;

  text-transform: uppercase;
}


.hilya-filters__sort {
  display: flex;

  align-items: center;

  gap: .45rem;
}


.hilya-filters__sort label {
  color: var(--color-muted);

  font-size: .66rem;

  letter-spacing: .04em;
}


.hilya-filters__sort select {
  min-width: 8.5rem;

  padding:
    .35rem 1.4rem .35rem 0;

  border: 0;

  outline: 0;

  background:
    transparent;

  color: var(--color-foreground);

  font: inherit;

  font-size: .68rem;

  cursor: pointer;
}


/* =========================================
   MOBILE DRAWER
========================================= */

.hilya-filter-overlay {
  position: fixed;

  inset: 0;

  z-index: 9998;

  background:
    rgb(0 0 0 / 35%);

  opacity: 0;

  visibility: hidden;

  transition:
    opacity 260ms ease,
    visibility 260ms ease;
}


.hilya-filter-overlay.is-visible {
  opacity: 1;

  visibility: visible;
}


.hilya-filter-drawer {
