}

.hilya-filters .hilya-price-input span {
  flex: 0 0 auto;
  font-size: .5rem;
  font-weight: 400;
  letter-spacing: .08em;
  line-height: 1;
  color: rgb(255 255 255 / 78%);
}

.hilya-filters .hilya-price-input input[type="number"] {
  flex: 0 1 auto;
  width: 4.6ch !important;
  min-width: 0;
  font-size: .74rem !important;
  font-weight: 500 !important;
  line-height: 1.2;
  text-align: center !important;
  color: #fff !important;
}

/* browsers that can size a field to its text keep EGP + number truly centered */
@supports (field-sizing: content) {
  .hilya-filters .hilya-price-input input[type="number"] {
    field-sizing: content;
    width: auto !important;
