  .hilya-filters .hilya-price-input span {
    font-size: .58rem;
  }

  .hilya-filters .hilya-price-input input[type="number"] {
    font-size: .9rem !important;
  }

  .hilya-filters .hilya-price-values__to {
    font-size: .72rem;
  }

}


/* ---------- COLOR PASS: deeper rose gold + matching checkboxes ---------- */

.hilya-filters {
  --hilya-rose: #A9705F;
  --hilya-rose-soft: rgb(169 112 95 / 18%);
}

/* checked boxes use the same rose gold */
.hilya-filters .hilya-filter-option input {
