    flex: 0 0 auto;

    padding: 2rem 1.5rem 1.35rem;

    background: var(--color-background);

    /*
      IMPORTANT:
      No line under FILTERS.
      The line will start at Availability.
    */
    border-bottom: 0;

    position: relative;
    z-index: 2;
  }

  .hilya-filter-drawer__header-main {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hilya-filter-drawer__title {
    display: block;
  }

  .hilya-filter-drawer__eyebrow {
    display: none;
  }

  .hilya-filter-drawer__header h2 {
    margin: 0;
    color: var(--color-foreground);
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: .08em;
  }


  /* =======================================
     FILTERED BY
     INSIDE FIXED HEADER
  ======================================= */

  .hilya-filter-drawer__header .hilya-filters__active {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    width: 100%;

    margin-top: .7rem;
    margin-bottom: 0;

    gap: .3rem;
  }

  .hilya-filter-drawer__header .hilya-filters__active-label {
    width: 100%;
    margin: 0 0 .08rem;

