{% doc %}
  Hilya custom collection filters.
  Client-side filtering without Shopify Search & Discovery.

  @param {number} [results_count] - Total number of products/results
  @param {object} [sort_options] - Available sort options
  @param {string} [sort_by] - Current sort value
  @param {string} [default_sort_by] - Default sort value
{% enddoc %}

{%- comment -%}
  Price filter scale — controlled from Theme settings > Price filter
  (config/settings_schema.json). Falls back to 0 / 5000 / 1.
{%- endcomment -%}
{%- assign hilya_price_min = settings.hilya_price_filter_min | default: 0 | plus: 0 -%}
{%- assign hilya_price_max = settings.hilya_price_filter_max | default: 5000 | plus: 0 -%}
{%- assign hilya_price_step = settings.hilya_price_filter_step | default: 1 | plus: 0 -%}
{%- if hilya_price_step < 1 -%}{%- assign hilya_price_step = 1 -%}{%- endif -%}
{%- if hilya_price_max <= hilya_price_min -%}{%- assign hilya_price_max = hilya_price_min | plus: hilya_price_step -%}{%- endif -%}

<div
  class="hilya-filters"
  data-hilya-filters-text
  data-price-min-limit="{{ hilya_price_min }}"
  data-price-max-limit="{{ hilya_price_max }}"
  data-price-step="{{ hilya_price_step }}"
  data-regular-price="{{ 'products.product.regular_price' | t | escape }}"
  data-percent-off="{{ 'products.product.discount' | t: percent: '__PERCENT__' | escape }}"
  data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
  data-previous-page="{{ 'collections.previous_page' | t | escape }}"
  data-next-page="{{ 'collections.next_page' | t | escape }}"
  data-page="{{ 'meta.page' | t: number: '__NUMBER__' | escape }}"
  data-filtered-by="{{ 'facets.filtered_by' | t | escape }}"
  data-clear-all="{{ 'facets.clear_all_caps' | t | escape }}"
  data-remove-filter="{{ 'facets.remove_filter' | t: label: '__LABEL__' | escape }}"
  data-from="{{ 'facets.from' | t | escape }}"
  data-to="{{ 'facets.to' | t | escape }}"
>

  <!-- =========================================
       MOBILE FILTER / PRODUCTS / SORT BAR
  ========================================== -->

  <div class="hilya-filters__mobile-bar">

    <button
      type="button"
      class="hilya-filters__mobile-button"
      data-filter-open
      aria-expanded="false"
      aria-controls="HilyaFilterDrawer"
    >
      <span class="hilya-filters__filter-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>

      <span class="hilya-filters__filter-text">
        {{ 'facets.filters_caps' | t }}
      </span>

      <span class="hilya-filters__count" data-filter-count hidden>
        0
      </span>
    </button>

    <span class="hilya-filters__mobile-results">
      <span data-filter-results>
        {{ results_count }}
      </span>
      {{ 'facets.products_caps' | t }}
    </span>

    <div
      class="hilya-filters__sort hilya-filters__sort--mobile"
      data-hilya-sort-wrap
    >

      <span class="hilya-filters__sort-label">
        {{ 'collections.sort_by' | t }}
      </span>

      {% assign current_sort = sort_by | default: default_sort_by | default: 'manual' %}

      <button
        type="button"
        class="hilya-filters__sort-trigger"
        data-hilya-sort-trigger
        aria-expanded="false"
        aria-haspopup="listbox"
      >
        <span data-hilya-sort-current>
          {% for option in sort_options %}
            {% if option.value == current_sort %}
              {%- assign sort_key = 'collections.sort_options.' | append: option.value | replace: '-', '_' -%}{%- assign sort_label = sort_key | t -%}{%- if sort_label contains 'translation missing' -%}{%- assign sort_label = option.name -%}{%- endif -%}{{ sort_label }}
            {% endif %}
          {% endfor %}
        </span>

        <span class="hilya-filters__sort-chevron" aria-hidden="true"></span>
      </button>

      <div
        class="hilya-filters__sort-menu"
        data-hilya-sort-menu
        role="listbox"
        hidden
      >
        {% for option in sort_options %}
          <button
            type="button"
            class="hilya-filters__sort-option{% if option.value == current_sort %} is-selected{% endif %}"
            data-sort-value="{{ option.value | escape }}"
            role="option"
            aria-selected="{% if option.value == current_sort %}true{% else %}false{% endif %}"
          >
            <span>
              {%- assign sort_key = 'collections.sort_options.' | append: option.value | replace: '-', '_' -%}{%- assign sort_label = sort_key | t -%}{%- if sort_label contains 'translation missing' -%}{%- assign sort_label = option.name -%}{%- endif -%}{{ sort_label }}
            </span>

            <span class="hilya-filters__sort-check" aria-hidden="true">
              ✓
            </span>
          </button>
        {% endfor %}
      </div>

    </div>

  </div>


  <!-- =========================================
       DESKTOP SIDEBAR
  ========================================== -->

  <aside class="hilya-filter-sidebar">

    <div class="hilya-filter-sidebar__heading">
      <h2>{{ 'facets.filters' | t }}</h2>
    </div>

    <div class="hilya-filters__active" data-active-filters hidden></div>

    <form class="hilya-filter-form" data-hilya-filter-form>

      <!-- AVAILABILITY -->

      <div class="hilya-filter-group is-open">

        <button type="button" class="hilya-filter-group__toggle" data-filter-toggle>
          <span>{{ 'facets.availability' | t }}</span>
          <span class="hilya-filter-chevron" aria-hidden="true"></span>
        </button>

        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">
            <input type="checkbox" name="availability" value="in_stock">
            <span>{{ 'facets.in_stock' | t }}</span>
          </label>

          <label class="hilya-filter-option">
            <input type="checkbox" name="availability" value="out_of_stock">
            <span>{{ 'facets.out_of_stock' | t }}</span>
          </label>

        </div>

      </div>


      <!-- PRICE -->

      <div class="hilya-filter-group is-open">

        <button type="button" class="hilya-filter-group__toggle" data-filter-toggle>
          <span>{{ 'facets.price' | t }}</span>
          <span class="hilya-filter-chevron" aria-hidden="true"></span>
        </button>

        <div class="hilya-filter-group__content">

          <div class="hilya-price-slider">

            <div class="hilya-price-slider__track"></div>

            <div class="hilya-price-slider__range" data-price-range></div>

            <input
              type="range"
              name="price_min"
              min="{{ hilya_price_min }}"
              max="{{ hilya_price_max }}"
              value="{{ hilya_price_min }}"
              step="{{ hilya_price_step }}"
              data-price-min
              aria-label="{{ 'facets.minimum_price' | t | escape }}"
            >

            <input
              type="range"
              name="price_max"
              min="{{ hilya_price_min }}"
              max="{{ hilya_price_max }}"
              value="{{ hilya_price_max }}"
              step="{{ hilya_price_step }}"
              data-price-max
              aria-label="{{ 'facets.maximum_price' | t | escape }}"
            >

          </div>

          <div class="hilya-price-values">

            <label class="hilya-price-input">
              <span>EGP</span>

              <input
                type="number"
                min="{{ hilya_price_min }}"
                max="{{ hilya_price_max }}"
                step="{{ hilya_price_step }}"
                value="{{ hilya_price_min }}"
                inputmode="numeric"
                data-price-min-input
                aria-label="{{ 'facets.minimum_price' | t | escape }}"
              >
            </label>

            <span class="hilya-price-values__to">
              {{ 'facets.price_to' | t }}
            </span>

            <label class="hilya-price-input hilya-price-input--max">
              <span>EGP</span>

              <input
                type="number"
                min="{{ hilya_price_min }}"
                max="{{ hilya_price_max }}"
                step="{{ hilya_price_step }}"
                value="{{ hilya_price_max }}"
                inputmode="numeric"
                data-price-max-input
                aria-label="{{ 'facets.maximum_price' | t | escape }}"
              >
            </label>

          </div>

        </div>

      </div>


      <!-- COLOR -->

      <div class="hilya-filter-group is-open">

        <button type="button" class="hilya-filter-group__toggle" data-filter-toggle>
          <span>{{ 'facets.color' | t }}</span>
          <span class="hilya-filter-chevron" aria-hidden="true"></span>
        </button>

        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">
            <input type="checkbox" name="color" value="Gold Plated">
            <span>{{ 'facets.gold_plated' | t }}</span>
          </label>

          <label class="hilya-filter-option">
            <input type="checkbox" name="color" value="Silver Plated">
            <span>{{ 'facets.silver_plated' | t }}</span>
          </label>

        </div>

      </div>


      <!-- PRODUCT TYPE -->

      <div class="hilya-filter-group is-open">

        <button type="button" class="hilya-filter-group__toggle" data-filter-toggle>
          <span>{{ 'facets.product_type' | t }}</span>
          <span class="hilya-filter-chevron" aria-hidden="true"></span>
        </button>

        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">
            <input type="checkbox" name="product_type" value="Necklaces">
            <span>{{ 'navigation.necklaces' | t }}</span>
          </label>

          <label class="hilya-filter-option">
            <input type="checkbox" name="product_type" value="Rings">
            <span>{{ 'navigation.rings' | t }}</span>
          </label>

          <label class="hilya-filter-option">
            <input type="checkbox" name="product_type" value="Pendants">
            <span>{{ 'navigation.pendants' | t }}</span>
          </label>

          <label class="hilya-filter-option">
            <input type="checkbox" name="product_type" value="Bracelets">
            <span>{{ 'navigation.bracelets' | t }}</span>
          </label>

          <label class="hilya-filter-option">
            <input type="checkbox" name="product_type" value="Keychains">
            <span>{{ 'navigation.keychains' | t }}</span>
          </label>

          <label class="hilya-filter-option">
            <input type="checkbox" name="product_type" value="Collections">
            <span>{{ 'navigation.collections' | t }}</span>
          </label>

        </div>

      </div>

    </form>

  </aside>


  <!-- =========================================
       MOBILE DRAWER
  ========================================== -->

  <div class="hilya-filter-overlay" data-filter-overlay></div>


  <aside
    id="HilyaFilterDrawer"
    class="hilya-filter-drawer"
    data-filter-drawer
    aria-hidden="true"
  >

    <!-- MOBILE HEADER -->

    <div class="hilya-filter-drawer__header">

      <div class="hilya-filter-drawer__header-main">

        <div class="hilya-filter-drawer__title">

          <span class="hilya-filter-drawer__eyebrow">
            {{ 'facets.collection_eyebrow' | t }}
          </span>

          <h2>
            {{ 'facets.filters_caps' | t }}
          </h2>

        </div>

      </div>

      <button
        type="button"
        class="hilya-filter-drawer__close"
        data-filter-close
        aria-label="{{ 'accessibility.close_filters' | t | escape }}"
      >
        ×
      </button>

    </div>


    <!-- ONLY THIS AREA SCROLLS -->

    <div class="hilya-filter-drawer__content">

      <div class="hilya-filters__active" data-active-filters-mobile hidden></div>

      <div data-mobile-filter-content></div>

    </div>

  </aside>


  <!-- =========================================
       DESKTOP PRODUCTS / SORT TOOLBAR
  ========================================== -->

  <div class="hilya-filters__products-toolbar">

    <span class="hilya-filters__results">

      <span data-filter-results>
        {{ results_count }}
      </span>

      {{ 'facets.products_caps' | t }}

    </span>

    <div
      class="hilya-filters__sort hilya-filters__sort--desktop"
      data-hilya-sort-wrap
    >

      <span class="hilya-filters__sort-label">
        {{ 'collections.sort_by' | t }}
      </span>

      {% assign current_sort = sort_by | default: default_sort_by | default: 'manual' %}

      <button
        type="button"
        class="hilya-filters__sort-trigger"
        data-hilya-sort-trigger
        aria-expanded="false"
        aria-haspopup="listbox"
      >

        <span data-hilya-sort-current>

          {% for option in sort_options %}

            {% if option.value == current_sort %}
              {%- assign sort_key = 'collections.sort_options.' | append: option.value | replace: '-', '_' -%}{%- assign sort_label = sort_key | t -%}{%- if sort_label contains 'translation missing' -%}{%- assign sort_label = option.name -%}{%- endif -%}{{ sort_label }}
            {% endif %}

          {% endfor %}

        </span>

        <span class="hilya-filters__sort-chevron" aria-hidden="true"></span>

      </button>

      <div
        class="hilya-filters__sort-menu"
        data-hilya-sort-menu
        role="listbox"
        hidden
      >

        {% for option in sort_options %}

          <button
            type="button"
            class="hilya-filters__sort-option{% if option.value == current_sort %} is-selected{% endif %}"
            data-sort-value="{{ option.value | escape }}"
            role="option"
            aria-selected="{% if option.value == current_sort %}true{% else %}false{% endif %}"
          >

            <span>
              {%- assign sort_key = 'collections.sort_options.' | append: option.value | replace: '-', '_' -%}{%- assign sort_label = sort_key | t -%}{%- if sort_label contains 'translation missing' -%}{%- assign sort_label = option.name -%}{%- endif -%}{{ sort_label }}
            </span>

            <span class="hilya-filters__sort-check" aria-hidden="true">
              ✓
            </span>

          </button>

        {% endfor %}

      </div>

    </div>

  </div>

</div>


{% javascript %}

document.addEventListener('DOMContentLoaded', function () {

  const openButton = document.querySelector('[data-filter-open]');
  const closeButton = document.querySelector('[data-filter-close]');
  const drawer = document.querySelector('[data-filter-drawer]');
  const overlay = document.querySelector('[data-filter-overlay]');
  const form = document.querySelector('[data-hilya-filter-form]');

  /* "let" because products from other pages are added later */
  let items = Array.from(document.querySelectorAll('[data-product-item]'));

  const resultsElements = document.querySelectorAll('[data-filter-results]');
  const countBadge = document.querySelector('[data-filter-count]');
  const activeFilters = document.querySelector('[data-active-filters]');
  const activeFiltersMobile = document.querySelector('[data-active-filters-mobile]');
  const mobileContent = document.querySelector('[data-mobile-filter-content]');
  const mobileHeaderMain = document.querySelector('.hilya-filter-drawer__header-main');


  if (!form) {
    return;
  }

  /* =========================================
     TEXTS (translated in Liquid, read from the page)
  ========================================= */

  const textRoot = document.querySelector('[data-hilya-filters-text]');
  const textData = textRoot ? textRoot.dataset : {};

  const T = {
    regularPrice: textData.regularPrice || 'Regular price',
    percentOff: textData.percentOff || '__PERCENT__% OFF',
    soldOut: textData.soldOut || 'Sold out',
    previousPage: textData.previousPage || 'Previous page',
    nextPage: textData.nextPage || 'Next page',
    page: textData.page || 'Page __NUMBER__',
    filteredBy: textData.filteredBy || 'FILTERED BY',
    clearAll: textData.clearAll || 'CLEAR ALL',
    removeFilter: textData.removeFilter || 'Remove __LABEL__',
    from: textData.from || 'From',
    to: textData.to || 'To'
  };

  /* Label of a filter option as shown on the page (so chips use the translated text) */
  function labelFor(inputName, value, fallback) {
    const wanted = String(value || '').trim().toLowerCase();
    const input = Array.from(
      form.querySelectorAll('input[name="' + inputName + '"]')
    ).find(function (candidate) {
      return String(candidate.value || '').trim().toLowerCase() === wanted;
    });
    const span = input && input.parentElement
      ? input.parentElement.querySelector('span')
      : null;

    return (span && span.textContent.trim()) || fallback;
  }



  /* =========================================
     MOBILE DRAWER
  ========================================= */

  function openDrawer() {

    if (!drawer) {
      return;
    }

    drawer.classList.add('is-open');

    if (overlay) {
      overlay.classList.add('is-visible');
    }

    drawer.setAttribute('aria-hidden', 'false');

    if (openButton) {
      openButton.setAttribute('aria-expanded', 'true');
    }

    document.documentElement.classList.add('hilya-filter-lock');
    document.body.classList.add('hilya-filter-lock');

  }


  function closeDrawer() {

    if (!drawer) {
      return;
    }

    drawer.classList.remove('is-open');

    if (overlay) {
      overlay.classList.remove('is-visible');
    }

    drawer.setAttribute('aria-hidden', 'true');

    if (openButton) {
      openButton.setAttribute('aria-expanded', 'false');
    }

    document.documentElement.classList.remove('hilya-filter-lock');
    document.body.classList.remove('hilya-filter-lock');

  }


  if (openButton) {
    openButton.addEventListener('click', openDrawer);
  }

  if (closeButton) {
    closeButton.addEventListener('click', closeDrawer);
  }

  if (overlay) {
    overlay.addEventListener('click', closeDrawer);
  }

  document.addEventListener('keydown', function (event) {

    if (event.key === 'Escape') {
      closeDrawer();
    }

  });


  /* =========================================
     MOBILE FILTERED BY
  ========================================= */

  if (
    mobileHeaderMain &&
    activeFiltersMobile &&
    window.matchMedia('(max-width: 40rem)').matches
  ) {

    mobileHeaderMain.appendChild(activeFiltersMobile);

  }


  /* =========================================
     MOVE FILTER CONTENT TO MOBILE
  ========================================= */

  if (mobileContent) {

    const filterGroups = form.querySelectorAll('.hilya-filter-group');

    filterGroups.forEach(function (group) {

      mobileContent.appendChild(group.cloneNode(true));

    });

  }


  /* =========================================
     HELPERS
  ========================================= */

  function normalize(value) {

    return String(value || '').trim().toLowerCase();

  }


  function escapeAttribute(value) {

    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

  }


  function getVariantData(item) {

    const dataElement = item.querySelector('[data-variant-data]');

    if (!dataElement) {
      return [];
    }

    try {

      const parsed = JSON.parse(dataElement.textContent);

      return Array.isArray(parsed) ? parsed : [];

    } catch (error) {

      return [];

    }

  }


  function getVariantByColor(item, color) {

    const wantedColor = normalize(color);

    return getVariantData(item).find(function (variant) {

      return normalize(variant.color) === wantedColor;

    }) || null;

  }


  /* =========================================
     ORIGINAL CARD STATE
     (a function, so products loaded from
     other pages can use it too)
  ========================================= */

  function initItem(item) {

    const card = item.querySelector('[data-product-card]');

    if (!card) {
      return;
    }


    const priceElement = card.querySelector('[data-product-price]');

    const primaryLayer = card.querySelector('[data-product-image-primary]');

    const secondaryLayer = card.querySelector('[data-product-image-secondary]');

    const links = card.querySelectorAll('[data-product-link], [data-product-media]');


    /* ORIGINAL PRICE */

    if (priceElement) {

      priceElement.dataset.originalHtml = priceElement.innerHTML;

    }


    /* ORIGINAL LINKS */

    links.forEach(function (link) {

      link.dataset.originalUrl = link.getAttribute('href') || '';

    });


    /* ORIGINAL IMAGES */

    if (primaryLayer) {

      primaryLayer.dataset.originalHtml = primaryLayer.innerHTML;

    }

    if (secondaryLayer) {

      secondaryLayer.dataset.originalHtml = secondaryLayer.innerHTML;

    }


    /* ORIGINAL SECONDARY STATE */

    card.dataset.originalHasSecondary =
      card.classList.contains('product-card--has-secondary')
        ? 'true'
        : 'false';

  }

  items.forEach(initItem);


  /* =========================================
     IMAGE SELECTION BY ALT TEXT

     GOLD:
     Gold Plated Front
     Gold Plated Detail
     Gold Plated Lifestyle

     SILVER:
     Silver Plated Front
     Silver Plated Detail
     Silver Plated Lifestyle
  ========================================= */

  function getColorImage(images, color, type) {

    if (!Array.isArray(images)) {
      return null;
    }

    const wantedColor = normalize(color);
    const wantedType = normalize(type);

    return images.find(function (image) {

      const alt = normalize(image && image.alt);

      return (
        alt.includes(wantedColor) &&
        alt.includes(wantedType)
      );

    }) || null;

  }


  function getImagesForColor(variant, color) {

    const images = Array.isArray(variant.images) ? variant.images : [];


    /*
      IMPORTANT:
      Image selection is based on ALT TEXT,
      not on image order.
    */

    let primaryImage = getColorImage(images, color, 'front');

    let secondaryImage = getColorImage(images, color, 'detail');


    /* If there is no Detail image, use Lifestyle. */

    if (!secondaryImage) {

      secondaryImage = getColorImage(images, color, 'lifestyle');

    }


    /* Fallback if the exact ALT naming is missing. */

    if (!primaryImage) {

      primaryImage = images.find(function (image) {

        return normalize(image && image.alt).includes(normalize(color));

      }) || null;

    }


    /* Last fallback: variant.image. */

    if (!primaryImage && variant.image && variant.image.src) {

      primaryImage = variant.image;

    }


    /* If there is still no secondary image, use another image of the same color. */

    if (!secondaryImage) {

      const primarySrc = primaryImage ? primaryImage.src : null;

      secondaryImage = images.find(function (image) {

        if (!image || !image.src) {
          return false;
        }

        const alt = normalize(image.alt);

        return (
          image.src !== primarySrc &&
          alt.includes(normalize(color))
        );

      }) || null;

    }


    return {
      primary: primaryImage,
      secondary: secondaryImage
    };

  }


  /* =========================================
     SET IMAGE
  ========================================= */

  function setLayerImage(layer, image) {

    if (!layer || !image || !image.src) {
      return;
    }

    layer.innerHTML =
      '<img' +
        ' src="' + escapeAttribute(image.src) + '"' +
        ' alt="' + escapeAttribute(image.alt || '') + '"' +
        ' loading="lazy"' +
        ' width="1200"' +
        ' height="960"' +
      '>';

  }


  /* =========================================
     PRICE HTML FOR SELECTED VARIANT
  ========================================= */

  function buildVariantPriceHtml(variant) {

    if (
      !variant ||
      variant.price === undefined ||
      variant.price === null
    ) {
      return '';
    }

    const price = Number(variant.price);

    if (!Number.isFinite(price)) {
      return '';
    }

    const compareAt = Number(variant.compare_at_price);

    const hasSale = Number.isFinite(compareAt) && compareAt > price;

    let html =
      '<div class="price' +
        (variant.available === false ? ' price--sold-out' : '') +
        (hasSale ? ' price--sale' : '') +
      '">';

    html +=
      '<span class="price__current">' +
        'EGP ' + price.toLocaleString('en-US') +
      '</span>';

    if (hasSale) {

      html +=
        '<span class="visually-hidden">' +
          T.regularPrice +
        '</span>' +

        '<s class="price__compare">' +
          'EGP ' + compareAt.toLocaleString('en-US') +
        '</s>';

    }

    html += '</div>';

    return html;

  }


  /* =========================================
     DISCOUNT BADGE
  ========================================= */

  function updateDiscountBadge(card, variant) {

    const media = card.querySelector('[data-product-media]');

    if (!media) {
      return;
    }

    const existing = media.querySelector('[data-variant-discount]');

    if (existing) {
      existing.remove();
    }

    if (
      !variant ||
      variant.price === undefined ||
      variant.compare_at_price === undefined ||
      variant.compare_at_price === null
    ) {
      return;
    }

    const price = Number(variant.price);
    const compareAt = Number(variant.compare_at_price);

    if (
      !Number.isFinite(price) ||
      !Number.isFinite(compareAt) ||
      compareAt <= price
    ) {
      return;
    }

    const percentage = Math.round(((compareAt - price) / compareAt) * 100);

    if (percentage <= 0) {
      return;
    }

    const badge = document.createElement('span');

    badge.className = 'product-card__discount';

    badge.dataset.variantDiscount = '';

    badge.textContent = T.percentOff.replace('__PERCENT__', percentage);

    media.appendChild(badge);

  }


  /* =========================================
     AVAILABILITY
  ========================================= */

  function updateAvailabilityBadge(card, available) {

    const media = card.querySelector('[data-product-media]');

    if (!media) {
      return;
    }

    const existingVariantBadge = media.querySelector('[data-variant-sold-out]');

    if (available) {

      if (existingVariantBadge) {
        existingVariantBadge.remove();
      }

      return;

    }

    if (!existingVariantBadge) {

      const badge = document.createElement('span');

      badge.className = 'product-card__badge';

      badge.dataset.variantSoldOut = '';

      badge.textContent = T.soldOut;

      media.appendChild(badge);

    }

  }


  /* =========================================
     UPDATE CARD FOR COLOR
  ========================================= */

  function updateProductCard(item, color) {

    const card = item.querySelector('[data-product-card]');

    if (!card) {
      return;
    }

    const variant = getVariantByColor(item, color);

    if (!variant) {

      resetProductCard(item);

      return;

    }


    /* PRICE */

    const priceElement = card.querySelector('[data-product-price]');

    if (priceElement) {

      const priceHtml = buildVariantPriceHtml(variant);

      if (priceHtml) {

        priceElement.innerHTML = priceHtml;

      }

    }


    /* LINKS */

    const productLinks = card.querySelectorAll('[data-product-link], [data-product-media]');

    productLinks.forEach(function (link) {

      if (variant.url) {

        link.setAttribute('href', variant.url);

      }

    });


    /* IMAGES */

    const primaryLayer = card.querySelector('[data-product-image-primary]');

    const secondaryLayer = card.querySelector('[data-product-image-secondary]');

    const selectedImages = getImagesForColor(variant, color);

    if (selectedImages.primary) {

      setLayerImage(primaryLayer, selectedImages.primary);

    }

    if (selectedImages.secondary) {

      setLayerImage(secondaryLayer, selectedImages.secondary);

      if (secondaryLayer) {

        secondaryLayer.hidden = false;

      }

      card.classList.add('product-card--has-secondary');

    } else {

      if (secondaryLayer) {

        secondaryLayer.hidden = true;

        secondaryLayer.innerHTML = '';

      }

      card.classList.remove('product-card--has-secondary');

    }


    /* AVAILABILITY */

    updateAvailabilityBadge(card, variant.available !== false);


    /* DISCOUNT */

    updateDiscountBadge(card, variant);

  }


  /* =========================================
     RESET CARD
  ========================================= */

  function resetProductCard(item) {

    const card = item.querySelector('[data-product-card]');

    if (!card) {
      return;
    }


    /* RESTORE ORIGINAL PRICE HTML */

    const priceElement = card.querySelector('[data-product-price]');

    if (priceElement) {

      const originalPrice = priceElement.dataset.originalHtml;

      if (originalPrice !== undefined) {

        priceElement.innerHTML = originalPrice;

      }

    }


    /* RESTORE ORIGINAL LINKS */

    const links = card.querySelectorAll('[data-product-link], [data-product-media]');

    links.forEach(function (link) {

      const originalUrl = link.dataset.originalUrl;

      if (originalUrl !== undefined) {

        link.setAttribute('href', originalUrl);

      }

    });


    /* RESTORE PRIMARY IMAGE */

    const primaryLayer = card.querySelector('[data-product-image-primary]');

    if (primaryLayer) {

      const originalImage = primaryLayer.dataset.originalHtml;

      if (originalImage !== undefined) {

        primaryLayer.innerHTML = originalImage;

      }

    }


    /* RESTORE SECONDARY IMAGE */

    const secondaryLayer = card.querySelector('[data-product-image-secondary]');

    if (secondaryLayer) {

      const originalImage = secondaryLayer.dataset.originalHtml;

      if (originalImage !== undefined) {

        secondaryLayer.innerHTML = originalImage;

        secondaryLayer.hidden = false;

      }

    }


    /* RESTORE SECONDARY CLASS */

    if (card.dataset.originalHasSecondary === 'true') {

      card.classList.add('product-card--has-secondary');

    } else {

      card.classList.remove('product-card--has-secondary');

    }


    /* REMOVE VARIANT SOLD OUT */

    const variantBadge = card.querySelector('[data-variant-sold-out]');

    if (variantBadge) {
      variantBadge.remove();
    }


    /* REMOVE VARIANT DISCOUNT */

    const variantDiscount = card.querySelector('[data-variant-discount]');

    if (variantDiscount) {
      variantDiscount.remove();
    }

  }


  /* =========================================
     PRICE CONTROLS
  ========================================= */

  const desktopPriceMin = form.querySelector('[data-price-min]');
  const desktopPriceMax = form.querySelector('[data-price-max]');
  const desktopPriceMinInput = form.querySelector('[data-price-min-input]');
  const desktopPriceMaxInput = form.querySelector('[data-price-max-input]');
  const desktopPriceRange = form.querySelector('[data-price-range]');

  const mobilePriceMin = mobileContent ? mobileContent.querySelector('[data-price-min]') : null;
  const mobilePriceMax = mobileContent ? mobileContent.querySelector('[data-price-max]') : null;
  const mobilePriceMinInput = mobileContent ? mobileContent.querySelector('[data-price-min-input]') : null;
  const mobilePriceMaxInput = mobileContent ? mobileContent.querySelector('[data-price-max-input]') : null;
  const mobilePriceRange = mobileContent ? mobileContent.querySelector('[data-price-range]') : null;


  /* =========================================
     CALCULATE REAL PRICE MAX
  ========================================= */

  /* Scale comes from the theme settings (read from data attributes) */

  const priceLimits = textRoot ? textRoot.dataset : {};

  const filterPriceMin = Number(priceLimits.priceMinLimit) || 0;

  let filterPriceMax = Number(priceLimits.priceMaxLimit) || 5000;

  const filterPriceStep = Math.max(1, Number(priceLimits.priceStep) || 1);

  if (filterPriceMax <= filterPriceMin) {
    filterPriceMax = filterPriceMin + filterPriceStep;
  }


  /* Kept so the "load all pages" code below keeps working:
     the scale is manual now, so it never changes. */

  function calculatePriceMaximum() {

    return filterPriceMax;

  }


  filterPriceMax = calculatePriceMaximum();


  /* =========================================
     UPDATE PRICE INPUT LIMITS
  ========================================= */

  function updatePriceInputLimits() {

    const controls = [
      desktopPriceMin,
      desktopPriceMax,
      desktopPriceMinInput,
      desktopPriceMaxInput,
      mobilePriceMin,
      mobilePriceMax,
      mobilePriceMinInput,
      mobilePriceMaxInput
    ];

    controls.forEach(function (input) {

      if (!input) {
        return;
      }

      input.min = filterPriceMin;

      input.max = filterPriceMax;

      input.step = filterPriceStep;

    });

  }


  updatePriceInputLimits();


  /* =========================================
     PRICE STATE
  ========================================= */

  let currentMinPrice = filterPriceMin;

  let currentMaxPrice = filterPriceMax;


  function clampPrice(value, fallback) {

    const number = Number(value);

    if (!Number.isFinite(number)) {
      return fallback;
    }

    /* Snap to the step, counted from the minimum */

    const snapped =
      filterPriceMin +
      Math.round((number - filterPriceMin) / filterPriceStep) * filterPriceStep;

    return Math.min(filterPriceMax, Math.max(filterPriceMin, snapped));

  }


  function setPriceState(min, max, source) {

    min = clampPrice(min, filterPriceMin);

    max = clampPrice(max, filterPriceMax);

    if (min > max) {

      if (source === 'min') {

        max = min;

      } else {

        min = max;

      }

    }

    currentMinPrice = min;

    currentMaxPrice = max;

    syncPriceControls();

  }


  function syncPriceControls() {

    if (desktopPriceMin) {
      desktopPriceMin.value = currentMinPrice;
    }

    if (desktopPriceMax) {
      desktopPriceMax.value = currentMaxPrice;
    }

    if (desktopPriceMinInput) {
      desktopPriceMinInput.value = currentMinPrice;
    }

    if (desktopPriceMaxInput) {
      desktopPriceMaxInput.value = currentMaxPrice;
    }

    if (mobilePriceMin) {
      mobilePriceMin.value = currentMinPrice;
    }

    if (mobilePriceMax) {
      mobilePriceMax.value = currentMaxPrice;
    }

    if (mobilePriceMinInput) {
      mobilePriceMinInput.value = currentMinPrice;
    }

    if (mobilePriceMaxInput) {
      mobilePriceMaxInput.value = currentMaxPrice;
    }


    const priceSpan = filterPriceMax - filterPriceMin;

    const minPercent =
      priceSpan > 0
        ? ((currentMinPrice - filterPriceMin) / priceSpan) * 100
        : 0;

    const maxPercent =
      priceSpan > 0
        ? ((currentMaxPrice - filterPriceMin) / priceSpan) * 100
        : 100;


    if (desktopPriceRange) {

      desktopPriceRange.style.left = minPercent + '%';

      desktopPriceRange.style.right = (100 - maxPercent) + '%';

    }

    if (mobilePriceRange) {

      mobilePriceRange.style.left = minPercent + '%';

      mobilePriceRange.style.right = (100 - maxPercent) + '%';

    }

  }


  function handlePriceSliderChange(type, value) {

    if (type === 'min') {

      setPriceState(value, currentMaxPrice, 'min');

    } else {

      setPriceState(currentMinPrice, value, 'max');

    }

    applyFilters();

  }


  function handlePriceInputChange(type, value) {

    if (type === 'min') {

      let min = clampPrice(value, filterPriceMin);

      if (min > currentMaxPrice) {

        min = currentMaxPrice;

      }

      setPriceState(min, currentMaxPrice, 'min');

    } else {

      let max = clampPrice(value, filterPriceMax);

      if (max < currentMinPrice) {

        max = currentMinPrice;

      }

      setPriceState(currentMinPrice, max, 'max');

    }

    applyFilters();

  }


  /* =========================================
     PRICE EVENTS
  ========================================= */

  if (desktopPriceMin) {

    desktopPriceMin.addEventListener('input', function () {

      handlePriceSliderChange('min', this.value);

    });

  }

  if (desktopPriceMax) {

    desktopPriceMax.addEventListener('input', function () {

      handlePriceSliderChange('max', this.value);

    });

  }

  if (desktopPriceMinInput) {

    desktopPriceMinInput.addEventListener('input', function () {

      handlePriceInputChange('min', this.value);

    });

    desktopPriceMinInput.addEventListener('change', function () {

      handlePriceInputChange('min', this.value);

    });

  }

  if (desktopPriceMaxInput) {

    desktopPriceMaxInput.addEventListener('input', function () {

      handlePriceInputChange('max', this.value);

    });

    desktopPriceMaxInput.addEventListener('change', function () {

      handlePriceInputChange('max', this.value);

    });

  }

  if (mobilePriceMin) {

    mobilePriceMin.addEventListener('input', function () {

      handlePriceSliderChange('min', this.value);

    });

  }

  if (mobilePriceMax) {

    mobilePriceMax.addEventListener('input', function () {

      handlePriceSliderChange('max', this.value);

    });

  }

  if (mobilePriceMinInput) {

    mobilePriceMinInput.addEventListener('input', function () {

      handlePriceInputChange('min', this.value);

    });

    mobilePriceMinInput.addEventListener('change', function () {

      handlePriceInputChange('min', this.value);

    });

  }

  if (mobilePriceMaxInput) {

    mobilePriceMaxInput.addEventListener('input', function () {

      handlePriceInputChange('max', this.value);

    });

    mobilePriceMaxInput.addEventListener('change', function () {

      handlePriceInputChange('max', this.value);

    });

  }


  /* =========================================
     MOBILE PRICE ENTER
  ========================================= */

  function closeMobileKeyboardOnEnter(input) {

    if (!input) {
      return;
    }

    input.addEventListener('keydown', function (event) {

      if (event.key !== 'Enter') {
        return;
      }

      event.preventDefault();

      input.dispatchEvent(new Event('change', { bubbles: true }));

      input.blur();

    });

  }

  closeMobileKeyboardOnEnter(mobilePriceMinInput);

  closeMobileKeyboardOnEnter(mobilePriceMaxInput);


  /* =========================================
     INITIAL PRICE STATE
  ========================================= */

  setPriceState(filterPriceMin, filterPriceMax, 'initial');


  /* =========================================
     CHECKED VALUES
  ========================================= */

  function getCheckedValues(name) {

    return Array.from(
      form.querySelectorAll('input[name="' + name + '"]:checked')
    ).map(function (input) {

      return normalize(input.value);

    });

  }


  /* =========================================
     GET VARIANTS MATCHING COLORS
  ========================================= */

  function getSelectedVariants(item, colors) {

    if (!colors.length) {
      return [];
    }

    const variants = getVariantData(item);

    return variants.filter(function (variant) {

      return colors.includes(normalize(variant.color));

    });

  }


  /* =========================================
     AVAILABILITY MATCH
  ========================================= */

  function matchesAvailability(item, availability, colors) {

    if (!availability.length) {
      return true;
    }


    /*
      If a color is selected, availability
      is checked against those variants.
    */

    if (colors.length > 0) {

      const selectedVariants = getSelectedVariants(item, colors);

      return selectedVariants.some(function (variant) {

        const available = variant.available !== false;

        return availability.some(function (value) {

          if (value === 'in_stock') {

            return available;

          }

          if (value === 'out_of_stock') {

            return !available;

          }

          return false;

        });

      });

    }


    /*
      No color selected:
      use product-level availability.
    */

    const itemAvailable = item.dataset.productAvailable === 'true';

    return availability.some(function (value) {

      if (value === 'in_stock') {

        return itemAvailable;

      }

      if (value === 'out_of_stock') {

        return !itemAvailable;

      }

      return false;

    });

  }


  /* =========================================
     PRICE MATCH
  ========================================= */

  function matchesPrice(item, colors, minPrice, maxPrice) {

    /* At the very end of the scale = no limit on that side
       (so products above the max / below the min are not cut off). */

    if (minPrice <= filterPriceMin) {
      minPrice = -Infinity;
    }

    if (maxPrice >= filterPriceMax) {
      maxPrice = Infinity;
    }


    /*
      With selected colors:
      product matches if at least one
      selected-color variant is in range.
    */

    if (colors.length > 0) {

      const selectedVariants = getSelectedVariants(item, colors);

      if (!selectedVariants.length) {
        return false;
      }

      return selectedVariants.some(function (variant) {

        const price = Number(variant.price);

        return (
          Number.isFinite(price) &&
          price >= minPrice &&
          price <= maxPrice
        );

      });

    }


    /*
      No color selected:
      use product price.
    */

    const itemPrice = Number(item.dataset.productPrice || 0);

    return (
      Number.isFinite(itemPrice) &&
      itemPrice >= minPrice &&
      itemPrice <= maxPrice
    );

  }


  /* =========================================
     LOAD ALL PAGES
     Filters must work on every product, not
     only on the current page.
  ========================================= */

  const totalProducts =
    Number(
      (
        resultsElements[0]
          ? resultsElements[0].textContent
          : ''
      ).trim()
    ) || items.length;

  const currentPage =
    Number(
      new URL(window.location.href).searchParams.get('page')
    ) || 1;

  const initialItemCount = items.length;

  let allPagesLoaded = false;
  let loadingPages = false;
  let pagesLoadFailed = false;

  /* Page size of the collection (products per page) */
  let pageSize = 0;

  /* Pagination of the FILTERED results */
  let filteredPage = 1;
  let lastFilterSignature = '';


  function getItemKey(item) {

    const link = item.querySelector('[data-product-link], [data-product-media]');

    if (!link) {
      return '';
    }

    const href =
      link.dataset.originalUrl ||
      link.getAttribute('href') ||
      '';

    return href.split('#')[0].split('?')[0];

  }


  function getTotalPages() {

    let max = currentPage;

    document
      .querySelectorAll('.catalog-page__pagination a[href*="page="]')
      .forEach(function (link) {

        try {

          const page = Number(
            new URL(link.href, window.location.origin).searchParams.get('page')
          );

          if (Number.isFinite(page)) {
            max = Math.max(max, page);
          }

        } catch (error) {}

      });

    return max;

  }


  async function loadAllPages() {

    loadingPages = true;

    try {

      const grid = document.querySelector('.catalog-grid');

      const totalPages = Math.min(getTotalPages(), 30);

      if (grid && totalPages > 1) {

        const pageNumbers = [];

        for (let page = 1; page <= totalPages; page++) {

          if (page !== currentPage) {
            pageNumbers.push(page);
          }

        }

        const results = await Promise.all(
          pageNumbers.map(function (page) {

            const url = new URL(window.location.href);

            url.searchParams.set('page', page);

            return fetch(url.toString(), { credentials: 'same-origin' })
              .then(function (response) {

                if (!response.ok) {
                  throw new Error('Page failed');
                }

                return response.text();

              })
              .then(function (html) {

                return {
                  page: page,
                  doc: new DOMParser().parseFromString(html, 'text/html')
                };

              });

          })
        );

        /* How many products fit in one page */

        if (currentPage === 1) {

          pageSize = initialItemCount;

        } else {

          const firstPage = results.find(function (result) {

            return result.page === 1;

          });

          pageSize = firstPage
            ? firstPage.doc.querySelectorAll('[data-product-item]').length
            : 0;

        }


        const anchor = items[0] || null;

        const seen = new Set(items.map(getItemKey));

        const added = [];

        results.forEach(function (result) {

          result.doc
            .querySelectorAll('[data-product-item]')
            .forEach(function (node) {

              const item = document.importNode(node, true);

              const key = getItemKey(item);

              if (!key || seen.has(key)) {
                return;
              }

              seen.add(key);

              item.dataset.extraPage = 'true';

              item.classList.add('is-filtered-out');

              if (result.page < currentPage) {

                grid.insertBefore(item, anchor);

              } else {

                grid.appendChild(item);

              }

              added.push(item);

            });

        });

        added.forEach(initItem);

        /* Keep the real page order (important for pagination) */

        items = Array.from(document.querySelectorAll('[data-product-item]'));


        /* Price slider max may change now */

        const newMax = calculatePriceMaximum();

        if (newMax !== filterPriceMax) {

          const wasAtMax = currentMaxPrice === filterPriceMax;

          filterPriceMax = newMax;

          updatePriceInputLimits();

          setPriceState(
            currentMinPrice,
            wasAtMax ? newMax : currentMaxPrice,
            'initial'
          );

        }

      }

      allPagesLoaded = true;

    } catch (error) {

      pagesLoadFailed = true;

    }

    loadingPages = false;

    applyFilters();

  }


  /* =========================================
     FILTERED PAGINATION
     Same look as the normal pagination.
  ========================================= */

  const ARROW_LEFT =
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>';

  const ARROW_RIGHT =
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';


  function getPageList(current, total) {

    const pages = [];

    for (let page = 1; page <= total; page++) {

      if (
        total <= 7 ||
        page === 1 ||
        page === total ||
        Math.abs(page - current) <= 1
      ) {

        pages.push(page);

      } else if (pages[pages.length - 1] !== '…') {

        pages.push('…');

      }

    }

    return pages;

  }


  function buildPaginationHtml(current, total) {

    const arabic = document.documentElement.lang.indexOf('ar') === 0;

    /* English: 01, 02 ...   Arabic: ١، ٢ ... (no leading zero) */

    function label(number) {

      if (arabic) {

        return String(number).replace(/[0-9]/g, function (digit) {
          return '٠١٢٣٤٥٦٧٨٩'[digit];
        });

      }

      return (number < 10 ? '0' : '') + number;

    }

    /* Only one page: the number above a dot, no line */

    if (total <= 1) {

      return (
        '<div class="hp hp--js hp--single">' +
        '<div class="hp__single">' +
        '<span class="hp__n hp__n--single">' + label(1) + '</span>' +
        '<span class="hp__dot hp__dot--static" aria-hidden="true"></span>' +
        '</div></div>'
      );

    }

    /* Pages drawn on the line: 5 at most.
       Up to 5 pages: all of them.
       More: first page, the page before, the current page, the page after, last page. */

    let slots = [];

    if (total <= 5) {

      for (let page = 1; page <= total; page++) {
        slots.push(page);
      }

    } else {

      const center = Math.min(Math.max(current, 3), total - 2);

      slots = [1, center - 1, center, center + 1, total];

    }

    const lastSlot = slots.length - 1;

    const activeIndex = Math.max(0, slots.indexOf(current));

    function position(index) {

      return Math.round((index / lastSlot) * 10000) / 100;

    }

    const chevronLeft =
      '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>';

    const chevronRight =
      '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>';

    let html =
      '<div class="hp hp--js hp--ticks">' +
      '<div class="hp__bar">';


    /* PREVIOUS */

    html +=
      '<button type="button"' +
      ' class="hp__arrow hp__arrow--prev"' +
      ' data-page="' + (current - 1) + '"' +
      ' aria-label="' + T.previousPage + '"' +
      (current <= 1 ? ' disabled' : '') +
      '>' + ARROW_LEFT + '</button>';


    /* LINE: the ticks are the drawn pages, the dot is the draggable handle */

    html +=
      '<div class="hp__track" style="--hp-p: ' + position(activeIndex) + '%">' +
      '<span class="hp__fill" aria-hidden="true"></span>';

    slots.forEach(function (page, index) {

      html +=
        '<button type="button"' +
        ' class="hp__seg' + (page === current ? ' is-on' : '') + '"' +
        ' style="--hp-s: ' + position(index) + '%"' +
        ' data-page="' + page + '"' +
        ' data-n="' + label(page) + '"' +
        ' aria-label="' + T.page.replace('__NUMBER__', page) + '"' +
        (page === current ? ' aria-current="page"' : '') +
        '><span class="hp__n" aria-hidden="true">' + label(page) + '</span></button>';

    });

    html +=
      '<span class="hp__dot" role="slider" tabindex="0"' +
      ' aria-orientation="horizontal"' +
      ' aria-valuemin="1" aria-valuemax="' + total + '" aria-valuenow="' + current + '"></span>' +
      '</div>';


    /* NEXT */

    html +=
      '<button type="button"' +
      ' class="hp__arrow hp__arrow--next"' +
      ' data-page="' + (current + 1) + '"' +
      ' aria-label="' + T.nextPage + '"' +
      (current >= total ? ' disabled' : '') +
      '>' + ARROW_RIGHT + '</button>' +
      '</div>';


    /* CURRENT PAGE: rounded box in the middle, opens a row of all pages (5 visible) */

    html +=
      '<div class="hp__foot"><details class="hp__jump">' +
      '<summary class="hp__badge" aria-label="' + T.page.replace('__NUMBER__', current) + '">' +
      '<span class="hp__badge-num">' + label(current) + '</span>' +
      '</summary>' +
      '<div class="hp__grid">';

    if (total > 5) {

      html +=
        '<button type="button" class="hp__sarrow hp__sarrow--prev"' +
        ' aria-label="' + T.previousPage + '">' + chevronLeft + '</button>';

    }

    html += '<div class="hp__strip">';

    for (let page = 1; page <= total; page++) {

      html +=
        '<button type="button" data-page="' + page + '"' +
        (page === current ? ' class="is-current" aria-current="page"' : '') +
        '>' + label(page) + '</button>';

    }

    html += '</div>';

    if (total > 5) {

      html +=
        '<button type="button" class="hp__sarrow hp__sarrow--next"' +
        ' aria-label="' + T.nextPage + '">' + chevronRight + '</button>';

    }

    html += '</div></details></div>';

    html += '</div>';

    return html;

  }


  function updatePaginationUi(isFiltering, usePaging, totalFilteredPages) {

    const serverNav = document.querySelector(
      '.catalog-page__pagination:not([data-filtered-pagination])'
    );

    let filteredNav = document.querySelector('[data-filtered-pagination]');


    /* The normal pagination belongs to the unfiltered list */

    if (serverNav) {

      serverNav.style.display =
        isFiltering && !pagesLoadFailed
          ? 'none'
          : '';

    }


    if (!usePaging) {

      if (filteredNav) {
        filteredNav.remove();
      }

      return;

    }


    if (!filteredNav) {

      filteredNav = document.createElement('nav');

      filteredNav.className = 'catalog-page__pagination';

      filteredNav.setAttribute('data-filtered-pagination', '');

      filteredNav.setAttribute('aria-label', 'Pagination');

      filteredNav.addEventListener('click', function (event) {

        const button = event.target.closest('[data-page]');

        if (!button || button.disabled) {
          return;
        }

        filteredPage = Number(button.dataset.page) || 1;

        applyFilters();

        const grid = document.querySelector('.catalog-grid');

        if (grid) {

          const top =
            grid.getBoundingClientRect().top +
            window.scrollY -
            140;

          window.scrollTo({
            top: Math.max(0, top),
            behavior: 'smooth'
          });

        }

      });

      const anchorElement =
        serverNav ||
        document.querySelector('.catalog-grid');

      if (anchorElement) {

        anchorElement.insertAdjacentElement('afterend', filteredNav);

      }

    }

    filteredNav.innerHTML = buildPaginationHtml(
      filteredPage,
      totalFilteredPages
    );

    /* lets the pagination snippet finish setting up the new markup */

    document.dispatchEvent(new CustomEvent('hp:rendered'));

  }


  /* =========================================
     FILTER
  ========================================= */

  function applyFilters() {

    const availability = getCheckedValues('availability');

    const colors = getCheckedValues('color');

    const productTypes = getCheckedValues('product_type');

    const minPrice = currentMinPrice;

    const maxPrice = currentMaxPrice;


    const isFiltering =
      availability.length > 0 ||
      colors.length > 0 ||
      productTypes.length > 0 ||
      minPrice > filterPriceMin ||
      maxPrice < filterPriceMax;

    /* New filters => back to the first filtered page */

    const signature = [
      availability.join(','),
      colors.join(','),
      productTypes.join(','),
      minPrice,
      maxPrice
    ].join('|');

    if (signature !== lastFilterSignature) {

      lastFilterSignature = signature;

      filteredPage = 1;

    }


    if (
      isFiltering &&
      !allPagesLoaded &&
      !loadingPages &&
      !pagesLoadFailed
    ) {
      loadAllPages();
    }


    const matchedItems = [];


    items.forEach(function (item) {

      /* Products from other pages stay hidden when no filter is active */

      if (!isFiltering && item.dataset.extraPage === 'true') {

        item.classList.add('is-filtered-out');

        return;

      }


      const itemType = normalize(item.dataset.productType);

      const itemColors =
        normalize(item.dataset.productColors)
          .split('|')
          .map(function (value) {

            return value.trim();

          })
          .filter(Boolean);


      let matches = true;


      /* PRODUCT TYPE */

      if (matches && productTypes.length > 0) {

        if (!productTypes.includes(itemType)) {

          matches = false;

        }

      }


      /* COLOR */

      if (matches && colors.length > 0) {

        const matchesColor = colors.some(function (color) {

          return itemColors.includes(color);

        });


        /*
          If data-product-colors is not
          available/reliable, also inspect
          the actual variant data.
        */

        if (!matchesColor) {

          const hasVariantColor = getVariantData(item).some(function (variant) {

            return colors.includes(normalize(variant.color));

          });

          if (!hasVariantColor) {

            matches = false;

          }

        }

      }


      /* AVAILABILITY */

      if (matches && !matchesAvailability(item, availability, colors)) {

        matches = false;

      }


      /* PRICE */

      if (matches && !matchesPrice(item, colors, minPrice, maxPrice)) {

        matches = false;

      }


      /* DISPLAY */

      if (matches) {

        matchedItems.push(item);


        /*
          Only one color means there is
          one clear variant to display.
        */

        const wantedColor = colors.length === 1 ? colors[0] : '';

        if (item.dataset.appliedColor !== wantedColor) {

          item.dataset.appliedColor = wantedColor;

          if (wantedColor) {

            updateProductCard(item, wantedColor);

          } else {

            resetProductCard(item);

          }

        }

      } else {

        item.classList.add('is-filtered-out');

      }

    });


    /* PAGINATION OF THE RESULTS */

    const visibleCount = matchedItems.length;

    /* shown whenever there are results (a single page shows just "01" and a dot) */
    const usePaging =
      isFiltering &&
      allPagesLoaded &&
      pageSize > 0 &&
      visibleCount > 0;

    const totalFilteredPages =
      usePaging
        ? Math.ceil(visibleCount / pageSize)
        : 1;

    if (filteredPage > totalFilteredPages) {

      filteredPage = totalFilteredPages;

    }

    const startIndex = (filteredPage - 1) * pageSize;

    matchedItems.forEach(function (item, index) {

      const onThisPage =
        !usePaging ||
        (index >= startIndex && index < startIndex + pageSize);

      item.classList.toggle('is-filtered-out', !onThisPage);

    });


    /* RESULTS */

    const shownCount =
      !isFiltering
        ? totalProducts
        : loadingPages
          ? '…'
          : visibleCount;

    resultsElements.forEach(function (element) {

      element.textContent = shownCount;

    });


    /* PAGINATION UI */

    updatePaginationUi(isFiltering, usePaging, totalFilteredPages);


    /* ACTIVE FILTER COUNT */

    const activeCount =
      availability.length +
      colors.length +
      productTypes.length +
      (minPrice > filterPriceMin ? 1 : 0) +
      (maxPrice < filterPriceMax ? 1 : 0);

    if (countBadge) {

      countBadge.textContent = activeCount;

      countBadge.hidden = activeCount === 0;

    }

    renderActiveFilters(
      availability,
      colors,
      productTypes,
      minPrice,
      maxPrice
    );

  }


  /* =========================================
     ACTIVE FILTER CHIPS
  ========================================= */

  function renderActiveFilters(
    availability,
    colors,
    productTypes,
    minPrice,
    maxPrice
  ) {

    const containers = [activeFilters, activeFiltersMobile].filter(Boolean);

    containers.forEach(function (container) {

      container.innerHTML = '';

      const hasFilters =
        availability.length > 0 ||
        colors.length > 0 ||
        productTypes.length > 0 ||
        minPrice > filterPriceMin ||
        maxPrice < filterPriceMax;

      if (!hasFilters) {

        container.hidden = true;

        return;

      }

      container.hidden = false;


      const title = document.createElement('span');

      title.className = 'hilya-filters__active-label';

      title.textContent = T.filteredBy;

      container.appendChild(title);


      availability.forEach(function (value) {

        addChip(
          container,
          labelFor('availability', value, value === 'in_stock' ? 'In stock' : 'Out of stock'),
          'availability',
          value
        );

      });


      colors.forEach(function (value) {

        addChip(
          container,
          labelFor('color', value, value === 'gold plated' ? 'Gold Plated' : 'Silver Plated'),
          'color',
          value
        );

      });


      productTypes.forEach(function (value) {

        addChip(
          container,
          labelFor('product_type', value, value.charAt(0).toUpperCase() + value.slice(1)),
          'product_type',
          value
        );

      });


      if (minPrice > filterPriceMin) {

        addChip(
          container,
          T.from + ' EGP ' + minPrice.toLocaleString('en-US'),
          'price_min',
          String(filterPriceMin)
        );

      }


      if (maxPrice < filterPriceMax) {

        addChip(
          container,
          T.to + ' EGP ' + maxPrice.toLocaleString('en-US'),
          'price_max',
          String(filterPriceMax)
        );

      }


      const clear = document.createElement('button');

      clear.type = 'button';

      clear.className = 'hilya-filters__clear';

      clear.textContent = T.clearAll;

      clear.addEventListener('click', clearFilters);

      container.appendChild(clear);

    });

  }


  function addChip(container, label, inputName, inputValue) {

    const chip = document.createElement('button');

    chip.type = 'button';

    chip.className = 'hilya-filter-chip';


    const labelSpan = document.createElement('span');

    labelSpan.textContent = label;


    const removeSpan = document.createElement('span');

    removeSpan.className = 'hilya-filter-chip__remove';

    removeSpan.setAttribute('aria-hidden', 'true');

    removeSpan.textContent = '×';


    chip.appendChild(labelSpan);

    chip.appendChild(removeSpan);

    chip.setAttribute('aria-label', T.removeFilter.replace('__LABEL__', label));


    chip.addEventListener('click', function () {

      if (inputName === 'price_min') {

        setPriceState(filterPriceMin, currentMaxPrice, 'min');

      } else if (inputName === 'price_max') {

        setPriceState(currentMinPrice, filterPriceMax, 'max');

      } else {

        const inputs = form.querySelectorAll('input[name="' + inputName + '"]');

        inputs.forEach(function (input) {

          if (normalize(input.value) === normalize(inputValue)) {

            input.checked = false;

          }

        });

      }

      syncMobileFilters();

      applyFilters();

    });


    container.appendChild(chip);

  }


  /* =========================================
     SYNC MOBILE FILTERS
  ========================================= */

  function syncMobileFilters() {

    if (!mobileContent) {
      return;
    }

    form
      .querySelectorAll('input[type="checkbox"]')
      .forEach(function (input) {

        const matching = Array.from(
          mobileContent.querySelectorAll('input[type="checkbox"]')
        ).find(function (mobileInput) {

          return (
            mobileInput.name === input.name &&
            mobileInput.value === input.value
          );

        });

        if (matching) {

          matching.checked = input.checked;

        }

      });

    syncPriceControls();

  }


  /* =========================================
     CLEAR
  ========================================= */

  function clearFilters() {

    form
      .querySelectorAll('input[type="checkbox"]')
      .forEach(function (input) {

        input.checked = false;

      });

    if (mobileContent) {

      mobileContent
        .querySelectorAll('input[type="checkbox"]')
        .forEach(function (input) {

          input.checked = false;

        });

    }

    setPriceState(filterPriceMin, filterPriceMax, 'initial');

    applyFilters();

  }


  /* =========================================
     CHECKBOX EVENTS
  ========================================= */

  form.addEventListener('change', function (event) {

    if (!event.target.matches('input[type="checkbox"]')) {
      return;
    }

    if (mobileContent) {

      const matching = Array.from(
        mobileContent.querySelectorAll('input[type="checkbox"]')
      ).find(function (mobileInput) {

        return (
          mobileInput.name === event.target.name &&
          mobileInput.value === event.target.value
        );

      });

      if (matching) {

        matching.checked = event.target.checked;

      }

    }

    applyFilters();

  });


  /* =========================================
     MOBILE CHECKBOX EVENTS
  ========================================= */

  if (mobileContent) {

    mobileContent.addEventListener('change', function (event) {

      if (!event.target.matches('input[type="checkbox"]')) {
        return;
      }

      const name = event.target.name;

      const value = event.target.value;

      const desktopInput = Array.from(
        form.querySelectorAll('input[type="checkbox"]')
      ).find(function (input) {

        return input.name === name && input.value === value;

      });

      if (desktopInput) {

        desktopInput.checked = event.target.checked;

      }

      applyFilters();

    });

  }


  /* =========================================
     SORT
  ========================================= */

  const sortWraps = document.querySelectorAll('[data-hilya-sort-wrap]');

  const sortTriggers = document.querySelectorAll('[data-hilya-sort-trigger]');

  const sortMenus = document.querySelectorAll('[data-hilya-sort-menu]');

  const sortOptions = document.querySelectorAll('[data-sort-value]');


  function closeSortMenus() {

    sortWraps.forEach(function (wrap) {

      wrap.classList.remove('is-open');

    });

    sortTriggers.forEach(function (trigger) {

      trigger.setAttribute('aria-expanded', 'false');

    });

    sortMenus.forEach(function (menu) {

      menu.hidden = true;

    });

  }


  function openSortMenu(targetWrap) {

    closeSortMenus();

    const trigger = targetWrap.querySelector('[data-hilya-sort-trigger]');

    const menu = targetWrap.querySelector('[data-hilya-sort-menu]');

    if (!trigger || !menu) {
      return;
    }

    targetWrap.classList.add('is-open');

    trigger.setAttribute('aria-expanded', 'true');

    menu.hidden = false;

  }


  sortTriggers.forEach(function (trigger) {

    trigger.addEventListener('click', function (event) {

      event.stopPropagation();

      const wrap = trigger.closest('[data-hilya-sort-wrap]');

      const menu = wrap ? wrap.querySelector('[data-hilya-sort-menu]') : null;

      if (!wrap || !menu) {
        return;
      }

      if (menu.hidden) {

        openSortMenu(wrap);

      } else {

        closeSortMenus();

      }

    });

  });


  sortOptions.forEach(function (option) {

    option.addEventListener('click', function () {

      const value = option.getAttribute('data-sort-value');

      const url = new URL(window.location.href);

      url.searchParams.set('sort_by', value);
      
      url.searchParams.delete('page');

      window.location.href = url.toString();

    });

  });


  document.addEventListener('click', function (event) {

    const clickedSort = event.target.closest('[data-hilya-sort-wrap]');

    if (!clickedSort) {

      closeSortMenus();

    }

  });


  document.addEventListener('keydown', function (event) {

    if (event.key === 'Escape') {

      closeSortMenus();

    }

  });


  /* =========================================
     FILTER GROUP TOGGLES
  ========================================= */

  document.addEventListener('click', function (event) {

    const toggle = event.target.closest('[data-filter-toggle]');

    if (!toggle) {
      return;
    }

    const group = toggle.closest('.hilya-filter-group');

    if (!group) {
      return;
    }

    group.classList.toggle('is-open');

  });


  /* =========================================
     INITIAL FILTER
  ========================================= */

  syncPriceControls();

  applyFilters();

});

