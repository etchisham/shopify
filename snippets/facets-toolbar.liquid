    align-items: center;

    gap: .45rem;

    padding: 0;

    border: 0;

    background: transparent;

    color: var(--color-foreground);

    font: inherit;

    font-size: .67rem;

    font-weight: 500;

    letter-spacing: .12em;

    cursor: pointer;
  }


  .hilya-filters__mobile-results {
    color: var(--color-muted);

    font-size: .62rem;

    letter-spacing: .08em;
  }


  .hilya-filters__products-toolbar {
    min-height: 3.4rem;

    margin-bottom: 1.15rem;
  }


  .hilya-filters__results {
