{% liquid
  assign current_url = request.path
  assign filter_count = 0

  if request.query.filter.v.availability != blank
    assign filter_count = filter_count | plus: 1
  endif

  if request.query.filter.v.option.color != blank
    assign filter_count = filter_count | plus: 1
  endif

  if request.query.filter.p.product_type != blank
    assign filter_count = filter_count | plus: 1
  endif

  if request.query.filter.v.price.gte != blank
    assign filter_count = filter_count | plus: 1
  endif

  if request.query.filter.v.price.lte != blank
    assign filter_count = filter_count | plus: 1
  endif
%}

<div class="hilya-filters">

  <div class="hilya-filters__top">

    <button
      type="button"
      class="hilya-filters__button"
      data-filter-open
      aria-expanded="false"
      aria-controls="HilyaFilterDrawer"
    >
      <span>FILTER</span>

      {% if filter_count > 0 %}
        <span class="hilya-filters__count">
          {{ filter_count }}
        </span>
      {% endif %}
    </button>

    <span class="hilya-filters__results">
      {{ results_count }} PRODUCTS
    </span>

    <div class="hilya-filters__sort">
      <label for="HilyaSort-{{ section_id }}">
        SORT
      </label>

      <select id="HilyaSort-{{ section_id }}" data-hilya-sort>
        {% for option in sort_options %}
          <option
            value="{{ option.value }}"
            {% if option.value == sort_by %}
              selected
            {% endif %}
          >
            {{ option.name }}
          </option>
        {% endfor %}
      </select>
    </div>

  </div>


  {% if filter_count > 0 %}

    <div class="hilya-filters__active">

      <span class="hilya-filters__active-label">
        FILTERED BY
      </span>

      {% if request.query.filter.v.availability == '1' %}
        <a
          href="{{ current_url }}"
          class="hilya-filter-chip"
        >
          In stock
          <span>×</span>
        </a>
      {% endif %}

      {% if request.query.filter.v.availability == '0' %}
        <a
          href="{{ current_url }}"
          class="hilya-filter-chip"
        >
          Out of stock
          <span>×</span>
        </a>
      {% endif %}

      {% if request.query.filter.v.option.color != blank %}
        {% assign active_color = request.query.filter.v.option.color %}

        <a
          href="{{ current_url }}"
          class="hilya-filter-chip"
        >
          {{ active_color | capitalize }}
          <span>×</span>
        </a>
      {% endif %}

      {% if request.query.filter.p.product_type != blank %}
        {% assign active_type = request.query.filter.p.product_type %}

        <a
          href="{{ current_url }}"
          class="hilya-filter-chip"
        >
          {{ active_type | replace: '-', ' ' | capitalize }}
          <span>×</span>
        </a>
      {% endif %}

      {% if request.query.filter.v.price.gte != blank %}
        <span class="hilya-filter-chip">
          From EGP {{ request.query.filter.v.price.gte }}
        </span>
      {% endif %}

      {% if request.query.filter.v.price.lte != blank %}
        <span class="hilya-filter-chip">
          To EGP {{ request.query.filter.v.price.lte }}
        </span>
      {% endif %}

      <a
        href="{{ current_url }}"
        class="hilya-filters__clear"
      >
        CLEAR ALL
      </a>

    </div>

  {% endif %}

</div>


<div
  class="hilya-filter-overlay"
  data-filter-overlay
></div>


<aside
  id="HilyaFilterDrawer"
  class="hilya-filter-drawer"
  data-filter-drawer
  aria-hidden="true"
>

  <div class="hilya-filter-drawer__header">

    <div>
      <span class="hilya-filter-drawer__eyebrow">
        COLLECTION
      </span>

      <h2>
        FILTER
      </h2>
    </div>

    <button
      type="button"
      class="hilya-filter-drawer__close"
      data-filter-close
      aria-label="Close filters"
    >
      ×
    </button>

  </div>


  <form
    class="hilya-filter-form"
    data-hilya-filter-form
  >

    {% comment %}
      AVAILABILITY
    {% endcomment %}

    <details class="hilya-filter-group" open>

      <summary>
        <span>Availability</span>
        <span class="hilya-filter-chevron">+</span>
      </summary>

      <div class="hilya-filter-group__content">

        <label class="hilya-filter-option">

          <input
            type="radio"
            name="availability"
            value="1"
            {% if request.query.filter.v.availability == '1' %}
              checked
            {% endif %}
          >

          <span>In stock</span>

        </label>


        <label class="hilya-filter-option">

          <input
            type="radio"
            name="availability"
            value="0"
            {% if request.query.filter.v.availability == '0' %}
              checked
            {% endif %}
          >

          <span>Out of stock</span>

        </label>

      </div>

    </details>


    {% comment %}
      PRICE
    {% endcomment %}

    <details class="hilya-filter-group" open>

      <summary>
        <span>Price</span>
        <span class="hilya-filter-chevron">+</span>
      </summary>

      <div class="hilya-filter-group__content">

        <div class="hilya-price-fields">

          <label>
            <span>From</span>

            <div class="hilya-price-input">

              <span>EGP</span>

              <input
                type="number"
                name="price_gte"
                min="0"
                step="1"
                value="{{ request.query.filter.v.price.gte }}"
                placeholder="0"
              >

            </div>

          </label>


          <label>
            <span>To</span>

            <div class="hilya-price-input">

              <span>EGP</span>

              <input
                type="number"
                name="price_lte"
                min="0"
                step="1"
                value="{{ request.query.filter.v.price.lte }}"
                placeholder="5000"
              >

            </div>

          </label>

        </div>

      </div>

    </details>


    {% comment %}
      COLOR
    {% endcomment %}

    <details class="hilya-filter-group" open>

      <summary>
        <span>Color</span>
        <span class="hilya-filter-chevron">+</span>
      </summary>

      <div class="hilya-filter-group__content">

        <label class="hilya-filter-option">

          <input
            type="radio"
            name="color"
            value="Gold"
            {% if request.query.filter.v.option.color == 'Gold' %}
              checked
            {% endif %}
          >

          <span>Gold</span>

        </label>


        <label class="hilya-filter-option">

          <input
            type="radio"
            name="color"
            value="Silver"
            {% if request.query.filter.v.option.color == 'Silver' %}
              checked
            {% endif %}
          >

          <span>Silver</span>

        </label>

      </div>

    </details>


    {% comment %}
      PRODUCT TYPE
    {% endcomment %}

    <details class="hilya-filter-group" open>

      <summary>
        <span>Product Type</span>
        <span class="hilya-filter-chevron">+</span>
      </summary>

      <div class="hilya-filter-group__content">

        {% assign hilya_types = 'Necklaces|Rings|Pendants|Bracelets|Keychains' | split: '|' %}

        {% for type in hilya_types %}

          <label class="hilya-filter-option">

            <input
              type="radio"
              name="product_type"
              value="{{ type }}"
              {% if request.query.filter.p.product_type == type %}
                checked
              {% endif %}
            >

            <span>{{ type }}</span>

          </label>

        {% endfor %}

      </div>

    </details>


    <div class="hilya-filter-actions">

      <button
        type="submit"
        class="hilya-filter-actions__apply"
      >
        APPLY FILTERS
      </button>

      <a
        href="{{ current_url }}"
        class="hilya-filter-actions__clear"
      >
        CLEAR ALL
      </a>

    </div>

  </form>

</aside>


{% javascript %}

document.addEventListener('DOMContentLoaded', function () {

  const openButton = document.querySelector('[data-filter-open]');
  const closeButton = document.querySelector('[data-filter-close]');
  const drawer = document.querySelector('[data-filter-drawer]');
  const overlay = document.querySelector('[data-filter-overlay]');
  const form = document.querySelector('[data-hilya-filter-form]');
  const sortSelect = document.querySelector('[data-hilya-sort]');

  if (!drawer || !form) return;


  function openDrawer() {
    drawer.classList.add('is-open');

    if (overlay) {
      overlay.classList.add('is-visible');
    }

    drawer.setAttribute('aria-hidden', 'false');

    if (openButton) {
      openButton.setAttribute('aria-expanded', 'true');
    }

    document.documentElement.classList.add('hilya-filter-lock');
  }


  function closeDrawer() {
    drawer.classList.remove('is-open');

    if (overlay) {
      overlay.classList.remove('is-visible');
    }

    drawer.setAttribute('aria-hidden', 'true');

    if (openButton) {
      openButton.setAttribute('aria-expanded', 'false');
    }

    document.documentElement.classList.remove('hilya-filter-lock');
  }


  if (openButton) {
    openButton.addEventListener('click', openDrawer);
  }


  if (closeButton) {
    closeButton.addEventListener('click', closeDrawer);
  }


  if (overlay) {
    overlay.addEventListener('click', closeDrawer);
  }


  document.addEventListener('keydown', function (event) {

    if (event.key === 'Escape') {
      closeDrawer();
    }

  });


  form.addEventListener('submit', function (event) {

    event.preventDefault();

    const url = new URL(window.location.href);

    const availability = form.querySelector(
      'input[name="availability"]:checked'
    );

    const color = form.querySelector(
      'input[name="color"]:checked'
    );

    const productType = form.querySelector(
      'input[name="product_type"]:checked'
    );

    const priceFrom = form.querySelector(
      'input[name="price_gte"]'
    );

    const priceTo = form.querySelector(
      'input[name="price_lte"]'
    );


    /*
      Remove previous Hilya filters
    */

    url.searchParams.delete('filter.v.availability');
    url.searchParams.delete('filter.v.option.color');
    url.searchParams.delete('filter.p.product_type');
    url.searchParams.delete('filter.v.price.gte');
    url.searchParams.delete('filter.v.price.lte');


    /*
      Availability
    */

    if (availability) {
      url.searchParams.set(
        'filter.v.availability',
        availability.value
      );
    }


    /*
      Color
    */

    if (color) {
      url.searchParams.set(
        'filter.v.option.color',
        color.value
      );
    }


    /*
      Product Type
    */

    if (productType) {
      url.searchParams.set(
        'filter.p.product_type',
        productType.value
      );
    }


    /*
      Price From
    */

    if (priceFrom && priceFrom.value !== '') {
      url.searchParams.set(
        'filter.v.price.gte',
        priceFrom.value
      );
    }


    /*
      Price To
    */

    if (priceTo && priceTo.value !== '') {
      url.searchParams.set(
        'filter.v.price.lte',
        priceTo.value
      );
    }


    /*
      Reset pagination
    */

    url.searchParams.delete('page');


    window.location.href = url.toString();

  });


  /*
    SORT
  */

  if (sortSelect) {

    sortSelect.addEventListener('change', function () {

      const url = new URL(window.location.href);

      url.searchParams.set(
        'sort_by',
        this.value
      );

      url.searchParams.delete('page');

      window.location.href = url.toString();

    });

  }


});

{% endjavascript %}


{% stylesheet %}

/* =========================================
   FILTER BAR
========================================= */

.hilya-filters {
  width: 100%;
}


.hilya-filters__top {
  display: grid;
  grid-template-columns: 1fr auto 1fr;

  align-items: center;

  min-height: 4.25rem;
}


.hilya-filters__button {
  display: inline-flex;
  align-items: center;
  justify-self: start;

  gap: .55rem;

  padding: 0;

  border: 0;
  background: transparent;

  color: var(--color-foreground);

  font: inherit;
  font-size: .68rem;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;

  cursor: pointer;
}


.hilya-filters__count {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  width: 1.25rem;
  height: 1.25rem;

  border: 1px solid currentColor;
  border-radius: 50%;

  font-size: .58rem;
  letter-spacing: 0;
}


.hilya-filters__results {
  justify-self: center;

  color: var(--color-muted);

  font-size: .62rem;
  letter-spacing: .12em;
  text-transform: uppercase;
}


.hilya-filters__sort {
  display: flex;
  align-items: center;
  justify-self: end;

  gap: .6rem;
}


.hilya-filters__sort label {
  color: var(--color-muted);

  font-size: .62rem;
  letter-spacing: .12em;
  text-transform: uppercase;
}


.hilya-filters__sort select {
  min-width: 8rem;

  padding: .35rem 1.5rem .35rem 0;

  border: 0;
  background: transparent;

  color: var(--color-foreground);

  font: inherit;
  font-size: .68rem;

  cursor: pointer;
}


/* =========================================
   ACTIVE FILTERS
========================================= */

.hilya-filters__active {
  display: flex;
  flex-wrap: wrap;
  align-items: center;

  gap: .5rem;

  padding: 0 0 1rem;
}


.hilya-filters__active-label {
  margin-right: .25rem;

  color: var(--color-muted);

  font-size: .58rem;
  letter-spacing: .12em;
}


.hilya-filter-chip {
  display: inline-flex;
  align-items: center;

  gap: .4rem;

  padding: .45rem .7rem;

  border: 1px solid rgb(0 0 0 / 12%);

  color: var(--color-foreground);

  font-size: .65rem;

  text-decoration: none;
}


.hilya-filter-chip span {
  font-size: .9rem;
  line-height: 1;
}


.hilya-filters__clear {
  margin-left: .25rem;

  color: var(--color-muted);

  font-size: .6rem;
  letter-spacing: .1em;
  text-decoration: underline;
  text-underline-offset: .25rem;
}


/* =========================================
   OVERLAY
========================================= */

.hilya-filter-overlay {
  position: fixed;
  inset: 0;
  z-index: 9998;

  background: rgb(0 0 0 / 35%);

  opacity: 0;
  visibility: hidden;

  transition:
    opacity 260ms ease,
    visibility 260ms ease;
}


.hilya-filter-overlay.is-visible {
  opacity: 1;
  visibility: visible;
}


/* =========================================
   DRAWER
========================================= */

.hilya-filter-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;

  z-index: 9999;

  width: min(28rem, 92vw);

  background: var(--color-background);

  transform: translateX(100%);

  transition: transform 320ms cubic-bezier(.22, .61, .36, 1);

  overflow-y: auto;

  box-shadow: -12px 0 35px rgb(0 0 0 / 8%);
}


.hilya-filter-drawer.is-open {
  transform: translateX(0);
}


.hilya-filter-drawer__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  padding: 2rem 1.75rem 1.5rem;

  border-bottom: 1px solid rgb(0 0 0 / 8%);
}


.hilya-filter-drawer__eyebrow {
  display: block;

  margin-bottom: .55rem;

  color: var(--color-muted);

  font-size: .58rem;
  letter-spacing: .2em;
}


.hilya-filter-drawer__header h2 {
  margin: 0;

  font-size: 1.35rem;
  font-weight: 400;
  letter-spacing: .08em;
}


.hilya-filter-drawer__close {
  padding: 0;

  border: 0;
  background: transparent;

  color: var(--color-foreground);

  font-size: 1.8rem;
  font-weight: 300;
  line-height: 1;

  cursor: pointer;
}


/* =========================================
   FILTER GROUPS
========================================= */

.hilya-filter-group {
  border-bottom: 1px solid rgb(0 0 0 / 8%);
}


.hilya-filter-group summary {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 1.25rem 1.75rem;

  color: var(--color-foreground);

  font-size: .7rem;
  font-weight: 500;
  letter-spacing: .12em;
  text-transform: uppercase;

  cursor: pointer;

  list-style: none;
}


.hilya-filter-group summary::-webkit-details-marker {
  display: none;
}


.hilya-filter-chevron {
  font-size: 1rem;
  font-weight: 300;
}


.hilya-filter-group[open] .hilya-filter-chevron {
  transform: rotate(45deg);
}


.hilya-filter-group__content {
  padding: 0 1.75rem 1.4rem;
}


/* =========================================
   OPTIONS
========================================= */

.hilya-filter-option {
  display: flex;
  align-items: center;

  gap: .75rem;

  min-height: 2.4rem;

  color: var(--color-foreground);

  font-size: .78rem;

  cursor: pointer;
}


.hilya-filter-option input {
  width: 1rem;
  height: 1rem;

  margin: 0;

  accent-color: #111;

  cursor: pointer;
}


/* =========================================
   PRICE
========================================= */

.hilya-price-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;

  gap: .7rem;
}


.hilya-price-fields label {
  display: block;

  color: var(--color-muted);

  font-size: .62rem;
  letter-spacing: .08em;
  text-transform: uppercase;
}


.hilya-price-input {
  display: flex;
  align-items: center;

  margin-top: .45rem;

  border-bottom: 1px solid rgb(0 0 0 / 22%);
}


.hilya-price-input span {
  color: var(--color-muted);

  font-size: .65rem;
}


.hilya-price-input input {
  width: 100%;

  padding: .55rem .25rem;

  border: 0;
  outline: 0;
  background: transparent;

  color: var(--color-foreground);

  font: inherit;
  font-size: .78rem;
}


/* =========================================
   ACTIONS
========================================= */

.hilya-filter-actions {
  display: grid;

  gap: .7rem;

  padding: 1.75rem;
}


.hilya-filter-actions__apply {
  width: 100%;

  padding: .95rem 1rem;

  border: 1px solid #111;
  background: #111;

  color: #fff;

  font: inherit;
  font-size: .68rem;
  font-weight: 500;
  letter-spacing: .13em;

  cursor: pointer;
}


.hilya-filter-actions__clear {
  padding: .65rem;

  color: var(--color-muted);

  font-size: .65rem;
  text-align: center;
  text-decoration: underline;
  text-underline-offset: .25rem;
}


/* =========================================
   LOCK
========================================= */

.hilya-filter-lock {
  overflow: hidden;
}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 40rem) {

  .hilya-filters__top {
    grid-template-columns: 1fr auto;

    min-height: 3.75rem;
  }


  .hilya-filters__results {
    display: none;
  }


  .hilya-filters__sort label {
    display: none;
  }


  .hilya-filters__sort select {
    min-width: 6.5rem;
    font-size: .62rem;
  }


  .hilya-filter-drawer {
    width: 100%;
  }


  .hilya-filter-drawer__header {
    padding-inline: 1.25rem;
  }


  .hilya-filter-group summary {
    padding-inline: 1.25rem;
  }


  .hilya-filter-group__content {
    padding-inline: 1.25rem;
  }


  .hilya-filter-actions {
    padding-inline: 1.25rem;
  }

}


@media (prefers-reduced-motion: reduce) {

  .hilya-filter-overlay,
  .hilya-filter-drawer {
    transition: none;
  }

}

{% endstylesheet %}