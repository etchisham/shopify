}

.hilya-filters .hilya-price-input input[type="number"] {
  box-sizing: border-box !important;
  min-height: 0 !important;
  height: auto !important;
  padding: 0 !important;
  margin: 0 !important;
}

.hilya-filters .hilya-price-input {
  min-height: 0 !important;
}


/* ---------- FINAL LOOK: room for the dots + quiet number fields ---------- */

/* full-width line, starting exactly under the first letter of EGP */
.hilya-filters .hilya-price-slider {
  width: 100%;
  margin: .35rem 0 .7rem;
}

/* ONE small solid black dot, no ring, no halo */
.hilya-filters {
