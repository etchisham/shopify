{% doc %}
  Hilya custom collection filters.
  Client-side filtering without Shopify Search & Discovery.
{% enddoc %}

<div class="hilya-filters">

  <div class="hilya-filters__top">

    <button
      type="button"
      class="hilya-filters__button"
      data-filter-open
      aria-expanded="false"
      aria-controls="HilyaFilterDrawer"
    >
      <span>FILTER</span>

      <span
        class="hilya-filters__count"
        data-filter-count
        hidden
      >
        0
      </span>
    </button>


    <span class="hilya-filters__results">
      <span data-filter-results>
        {{ collection.products_count }}
      </span>
      PRODUCTS
    </span>


    <div class="hilya-filters__sort">

  <label for="HilyaSort">
    SORT
  </label>

  <select
    id="HilyaSort"
    data-hilya-sort
  >

    {% for option in sort_options %}

      <option
        value="{{ option.value }}"
        {% if option.value == sort_by %}
          selected
        {% endif %}
      >
        {{ option.name }}
      </option>

    {% endfor %}

  </select>

</div>

  </div>


  <div
    class="hilya-filters__active"
    data-active-filters
    hidden
  >

    <span class="hilya-filters__active-label">
      FILTERED BY
    </span>

  </div>

</div>


<div
  class="hilya-filter-overlay"
  data-filter-overlay
></div>


<aside
  id="HilyaFilterDrawer"
  class="hilya-filter-drawer"
  data-filter-drawer
  aria-hidden="true"
>

  <div class="hilya-filter-drawer__header">

    <div>

      <span class="hilya-filter-drawer__eyebrow">
        COLLECTION
      </span>

      <h2>
        FILTER
      </h2>

    </div>


    <button
      type="button"
      class="hilya-filter-drawer__close"
      data-filter-close
      aria-label="Close filters"
    >
      ×
    </button>

  </div>


  <form
    class="hilya-filter-form"
    data-hilya-filter-form
  >

    <!-- AVAILABILITY -->

    <details
      class="hilya-filter-group"
      open
    >

      <summary>

        <span>
          Availability
        </span>

        <span class="hilya-filter-chevron">
          +
        </span>

      </summary>


      <div class="hilya-filter-group__content">

        <label class="hilya-filter-option">

          <input
            type="radio"
            name="availability"
            value="all"
            checked
          >

          <span>
            All
          </span>

        </label>


        <label class="hilya-filter-option">

          <input
            type="radio"
            name="availability"
            value="in_stock"
          >

          <span>
            In stock
          </span>

        </label>


        <label class="hilya-filter-option">

          <input
            type="radio"
            name="availability"
            value="out_of_stock"
          >

          <span>
            Out of stock
          </span>

        </label>

      </div>

    </details>


    <!-- PRICE -->

    <details
      class="hilya-filter-group"
      open
    >

      <summary>

        <span>
          Price
        </span>

        <span class="hilya-filter-chevron">
          +
        </span>

      </summary>


      <div class="hilya-filter-group__content">

        <div class="hilya-price-fields">

          <label>

            <span>
              From
            </span>

            <div class="hilya-price-input">

              <span>
                EGP
              </span>

              <input
                type="number"
                name="price_from"
                min="0"
                step="1"
                placeholder="0"
              >

            </div>

          </label>


          <label>

            <span>
              To
            </span>

            <div class="hilya-price-input">

              <span>
                EGP
              </span>

              <input
                type="number"
                name="price_to"
                min="0"
                step="1"
                placeholder="5000"
              >

            </div>

          </label>

        </div>

      </div>

    </details>


    <!-- COLOR -->

    <details
      class="hilya-filter-group"
      open
    >

      <summary>

        <span>
          Color
        </span>

        <span class="hilya-filter-chevron">
          +
        </span>

      </summary>


      <div class="hilya-filter-group__content">

        <label class="hilya-filter-option">

          <input
            type="radio"
            name="color"
            value="all"
            checked
          >

          <span>
            All
          </span>

        </label>


        <label class="hilya-filter-option">

          <input
            type="radio"
            name="color"
            value="Gold Plated"
          >

          <span>
            Gold Plated
          </span>

        </label>


        <label class="hilya-filter-option">

          <input
            type="radio"
            name="color"
            value="Silver Plated"
          >

          <span>
            Silver Plated
          </span>

        </label>

      </div>

    </details>


    <!-- PRODUCT TYPE -->

    <details
      class="hilya-filter-group"
      open
    >

      <summary>

        <span>
          Product Type
        </span>

        <span class="hilya-filter-chevron">
          +
        </span>

      </summary>


      <div class="hilya-filter-group__content">

        <label class="hilya-filter-option">

          <input
            type="radio"
            name="product_type"
            value="all"
            checked
          >

          <span>
            All
          </span>

        </label>


        <label class="hilya-filter-option">

          <input
            type="radio"
            name="product_type"
            value="Necklaces"
          >

          <span>
            Necklaces
          </span>

        </label>


        <label class="hilya-filter-option">

          <input
            type="radio"
            name="product_type"
            value="Rings"
          >

          <span>
            Rings
          </span>

        </label>


        <label class="hilya-filter-option">

          <input
            type="radio"
            name="product_type"
            value="Pendants"
          >

          <span>
            Pendants
          </span>

        </label>


        <label class="hilya-filter-option">

          <input
            type="radio"
            name="product_type"
            value="Bracelets"
          >

          <span>
            Bracelets
          </span>

        </label>


        <label class="hilya-filter-option">

          <input
            type="radio"
            name="product_type"
            value="Keychains"
          >

          <span>
            Keychains
          </span>

        </label>

      </div>

    </details>


    <div class="hilya-filter-actions">

      <button
        type="submit"
        class="hilya-filter-actions__apply"
      >
        APPLY FILTERS
      </button>


      <button
        type="button"
        class="hilya-filter-actions__clear"
        data-clear-filters
      >
        CLEAR ALL
      </button>

    </div>


  </form>

</aside>


{% javascript %}

document.addEventListener('DOMContentLoaded', function () {

  const openButton = document.querySelector('[data-filter-open]');
  const closeButton = document.querySelector('[data-filter-close]');
  const drawer = document.querySelector('[data-filter-drawer]');
  const overlay = document.querySelector('[data-filter-overlay]');
  const form = document.querySelector('[data-hilya-filter-form]');
  const clearButton = document.querySelector('[data-clear-filters]');

  const items = Array.from(
    document.querySelectorAll('[data-product-item]')
  );

  const results = document.querySelector('[data-filter-results]');
  const countBadge = document.querySelector('[data-filter-count]');
  const activeFilters = document.querySelector('[data-active-filters]');


  if (!drawer || !form) {
    return;
  }


  /* =========================================
     DRAWER
  ========================================= */

  function openDrawer() {

    drawer.classList.add('is-open');

    if (overlay) {
      overlay.classList.add('is-visible');
    }

    drawer.setAttribute(
      'aria-hidden',
      'false'
    );

    if (openButton) {
      openButton.setAttribute(
        'aria-expanded',
        'true'
      );
    }

    document.documentElement.classList.add(
      'hilya-filter-lock'
    );

  }


  function closeDrawer() {

    drawer.classList.remove('is-open');

    if (overlay) {
      overlay.classList.remove('is-visible');
    }

    drawer.setAttribute(
      'aria-hidden',
      'true'
    );

    if (openButton) {
      openButton.setAttribute(
        'aria-expanded',
        'false'
      );
    }

    document.documentElement.classList.remove(
      'hilya-filter-lock'
    );

  }


  if (openButton) {

    openButton.addEventListener(
      'click',
      openDrawer
    );

  }


  if (closeButton) {

    closeButton.addEventListener(
      'click',
      closeDrawer
    );

  }


  if (overlay) {

    overlay.addEventListener(
      'click',
      closeDrawer
    );

  }


  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {
        closeDrawer();
      }

    }
  );


  /* =========================================
     VARIANT IMAGE + PRICE
  ========================================= */

  function updateProductCard(item, color) {

    const dataElement =
      item.querySelector('[data-variant-data]');

    const card =
      item.querySelector('[data-product-card]');

    if (!dataElement || !card) {
      return;
    }


    let variants = [];

    try {

      variants =
        JSON.parse(
          dataElement.textContent
        );

    } catch (error) {

      return;

    }


    if (!color || color === 'all') {

      resetProductCard(item);

      return;

    }


    const wantedColor =
      color.trim().toLowerCase();


    const variant =
      variants.find(function (entry) {

        return (
          String(entry.color || '')
            .trim()
            .toLowerCase() === wantedColor
        );

      });


    if (!variant) {

      resetProductCard(item);

      return;

    }


    /* =========================================
       PRICE
    ========================================= */

    const priceElement =
      card.querySelector('[data-product-price]');


    if (priceElement && variant.price !== undefined) {

      priceElement.innerHTML =
        '<span class="price">' +
          '<span class="price__current">' +
            'EGP ' +
            Number(variant.price).toLocaleString('en-US') +
          '</span>' +
        '</span>';

    }


    /* =========================================
       PRODUCT URL
    ========================================= */

    const productLinks =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    productLinks.forEach(function (link) {

      if (variant.url) {

        link.setAttribute(
          'href',
          variant.url
        );

      }

    });


    /* =========================================
       IMAGES
    ========================================= */

    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    const colorImages =
      Array.isArray(variant.images)
        ? variant.images
        : [];


    let primaryImage =
      null;


    let secondaryImage =
      null;


    /*
      Prefer the Variant's own Shopify image
      as the primary image.
    */

    if (variant.image && variant.image.src) {

      primaryImage =
        variant.image;

    }


    /*
      If the Variant image is not found inside
      the Alt Text group, use it anyway as primary.
    */

    if (!primaryImage && colorImages.length > 0) {

      primaryImage =
        colorImages[0];

    }


    /*
      Find the second image from the same color.
    */

    if (colorImages.length > 1) {

      const firstImageSrc =
        primaryImage
          ? primaryImage.src
          : null;


      secondaryImage =
        colorImages.find(function (image) {

          return (
            !firstImageSrc ||
            image.src !== firstImageSrc
          );

        });

    }


    /*
      If the Variant image itself is the first
      matching image, use the second matching image.
    */

    if (
      !secondaryImage &&
      colorImages.length > 1
    ) {

      secondaryImage =
        colorImages[1];

    }


    if (primaryImage) {

      setLayerImage(
        primaryLayer,
        primaryImage
      );

    }


    if (secondaryImage) {

      setLayerImage(
        secondaryLayer,
        secondaryImage
      );

      if (secondaryLayer) {
        secondaryLayer.hidden = false;
      }

      card.classList.add(
        'product-card--has-secondary'
      );

    } else {

      if (secondaryLayer) {

        secondaryLayer.hidden = true;

        secondaryLayer.innerHTML = '';

      }

      card.classList.remove(
        'product-card--has-secondary'
      );

    }


    /*
      Update availability badge.
    */

    updateAvailabilityBadge(
      card,
      variant.available
    );

  }


  /* =========================================
     SET IMAGE
  ========================================= */

  function setLayerImage(layer, image) {

    if (!layer || !image || !image.src) {
      return;
    }


    layer.innerHTML =
      '<img' +
      ' src="' + escapeAttribute(image.src) + '"' +
      ' alt="' + escapeAttribute(image.alt || '') + '"' +
      ' loading="lazy"' +
      ' width="1200"' +
      ' height="960"' +
      '>' ;

  }


  /* =========================================
     AVAILABILITY
  ========================================= */

  function updateAvailabilityBadge(card, available) {

    const media =
      card.querySelector('[data-product-media]');

    if (!media) {
      return;
    }


    let badge =
      media.querySelector(
        '[data-variant-sold-out]'
      );


    if (available) {

      if (badge) {
        badge.remove();
      }

      return;

    }


    if (!badge) {

      badge =
        document.createElement('span');

      badge.className =
        'product-card__badge';

      badge.dataset.variantSoldOut =
        '';

      badge.textContent =
        'Sold out';

      media.appendChild(
        badge
      );

    }

  }


  /* =========================================
     RESET CARD
  ========================================= */

  function resetProductCard(item) {

    const card =
      item.querySelector('[data-product-card]');

    if (!card) {
      return;
    }


    const productPrice =
      item.dataset.productPrice;


    const priceElement =
      card.querySelector('[data-product-price]');


    if (
      priceElement &&
      productPrice !== undefined
    ) {

      priceElement.innerHTML =
        '<span class="price">' +
          '<span class="price__current">' +
            'EGP ' +
            Number(productPrice).toLocaleString('en-US') +
          '</span>' +
        '</span>';

    }


    /*
      Restore the original product links.
      They are stored the first time reset runs.
    */

    const links =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    links.forEach(function (link) {

      const originalUrl =
        link.dataset.originalUrl;

      if (originalUrl) {

        link.setAttribute(
          'href',
          originalUrl
        );

      }

    });


    /*
      Restore original images from the
      server-rendered card.
    */

    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    if (primaryLayer) {

      const originalImage =
        primaryLayer.dataset.originalHtml;

      if (originalImage) {

        primaryLayer.innerHTML =
          originalImage;

      }

    }


    if (secondaryLayer) {

      const originalImage =
        secondaryLayer.dataset.originalHtml;


      if (originalImage) {

        secondaryLayer.innerHTML =
          originalImage;

        secondaryLayer.hidden =
          false;

      }

    }


    if (secondaryLayer && !secondaryLayer.innerHTML.trim()) {

      card.classList.remove(
        'product-card--has-secondary'
      );

    } else {

      card.classList.add(
        'product-card--has-secondary'
      );

    }


    const variantBadge =
      card.querySelector(
        '[data-variant-sold-out]'
      );


    if (variantBadge) {
      variantBadge.remove();
    }

  }


  /* =========================================
     ESCAPE
  ========================================= */

  function escapeAttribute(value) {

    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

  }


  /* =========================================
     STORE ORIGINAL CARD STATE
  ========================================= */

  items.forEach(function (item) {

    const card =
      item.querySelector('[data-product-card]');

    if (!card) {
      return;
    }


    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    const links =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    links.forEach(function (link) {

      link.dataset.originalUrl =
        link.getAttribute('href') || '';

    });


    if (primaryLayer) {

      primaryLayer.dataset.originalHtml =
        primaryLayer.innerHTML;

    }


    if (secondaryLayer) {

      secondaryLayer.dataset.originalHtml =
        secondaryLayer.innerHTML;

    }

  });


  /* =========================================
     FILTER
  ========================================= */

  function applyFilters() {

    const availabilityInput =
      form.querySelector(
        'input[name="availability"]:checked'
      );

    const colorInput =
      form.querySelector(
        'input[name="color"]:checked'
      );

    const productTypeInput =
      form.querySelector(
        'input[name="product_type"]:checked'
      );

    const priceFromInput =
      form.querySelector(
        'input[name="price_from"]'
      );

    const priceToInput =
      form.querySelector(
        'input[name="price_to"]'
      );


    const availability =
      availabilityInput
        ? availabilityInput.value
        : 'all';


    const color =
      colorInput
        ? colorInput.value
        : 'all';


    const productType =
      productTypeInput
        ? productTypeInput.value
        : 'all';


    const priceFrom =
      priceFromInput &&
      priceFromInput.value !== ''
        ? Number(priceFromInput.value)
        : null;


    const priceTo =
      priceToInput &&
      priceToInput.value !== ''
        ? Number(priceToInput.value)
        : null;


    let visibleCount = 0;


    items.forEach(function (item) {

      const itemType =
        (item.dataset.productType || '')
          .trim()
          .toLowerCase();


      const itemPrice =
        Number(item.dataset.productPrice || 0);


      const itemAvailable =
        item.dataset.productAvailable === 'true';


      const itemColors =
        (item.dataset.productColors || '')
          .toLowerCase()
          .split('|')
          .map(function (value) {
            return value.trim();
          })
          .filter(Boolean);


      let matches = true;


      /* Availability */

      if (availability === 'in_stock') {

        if (!itemAvailable) {
          matches = false;
        }

      }


      if (availability === 'out_of_stock') {

        if (itemAvailable) {
          matches = false;
        }

      }


      /* Price */

      let effectivePrice =
        itemPrice;


      if (color !== 'all') {

        const dataElement =
          item.querySelector('[data-variant-data]');


        if (dataElement) {

          try {

            const variants =
              JSON.parse(
                dataElement.textContent
              );


            const selectedVariant =
              variants.find(function (variant) {

                return (
                  String(variant.color || '')
                    .trim()
                    .toLowerCase() ===
                  color.trim().toLowerCase()
                );

              });


            if (selectedVariant) {

              effectivePrice =
                Number(
                  selectedVariant.price
                );

            }

          } catch (error) {}

        }

      }


      if (
        priceFrom !== null &&
        effectivePrice < priceFrom
      ) {
        matches = false;
      }


      if (
        priceTo !== null &&
        effectivePrice > priceTo
      ) {
        matches = false;
      }


      /* Color */

      if (
        color !== 'all' &&
        !itemColors.includes(
          color.toLowerCase()
        )
      ) {
        matches = false;
      }


      /* Product Type */

      if (
        productType !== 'all' &&
        itemType !== productType.toLowerCase()
      ) {
        matches = false;
      }


      if (matches) {

        item.classList.remove(
          'is-filtered-out'
        );

        visibleCount++;


        if (color !== 'all') {

          updateProductCard(
            item,
            color
          );

        } else {

          resetProductCard(
            item
          );

        }

      } else {

        item.classList.add(
          'is-filtered-out'
        );

      }

    });


    /* Results */

    if (results) {

      results.textContent =
        visibleCount;

    }


    /* Active count */

    let activeCount = 0;


    if (availability !== 'all') {
      activeCount++;
    }


    if (color !== 'all') {
      activeCount++;
    }


    if (productType !== 'all') {
      activeCount++;
    }


    if (priceFrom !== null) {
      activeCount++;
    }


    if (priceTo !== null) {
      activeCount++;
    }


    if (countBadge) {

      countBadge.textContent =
        activeCount;

      countBadge.hidden =
        activeCount === 0;

    }


    /* Active filter chips */

    if (activeFilters) {

      activeFilters.innerHTML = '';


      if (activeCount > 0) {

        activeFilters.hidden = false;


        const label =
          document.createElement('span');

        label.className =
          'hilya-filters__active-label';

        label.textContent =
          'FILTERED BY';

        activeFilters.appendChild(
          label
        );


        if (availability !== 'all') {

          addChip(
            availability === 'in_stock'
              ? 'In stock'
              : 'Out of stock'
          );

        }


        if (color !== 'all') {

          addChip(color);

        }


        if (productType !== 'all') {

          addChip(productType);

        }


        if (priceFrom !== null) {

          addChip(
            'From EGP ' + priceFrom
          );

        }


        if (priceTo !== null) {

          addChip(
            'To EGP ' + priceTo
          );

        }


        const clearLink =
          document.createElement('button');

        clearLink.type =
          'button';

        clearLink.className =
          'hilya-filters__clear';

        clearLink.textContent =
          'CLEAR ALL';

        clearLink.addEventListener(
          'click',
          clearFilters
        );

        activeFilters.appendChild(
          clearLink
        );

      } else {

        activeFilters.hidden =
          true;

      }

    }


    closeDrawer();

  }


  /* =========================================
     CHIP
  ========================================= */

  function addChip(label) {

    const chip =
      document.createElement('span');

    chip.className =
      'hilya-filter-chip';

    chip.textContent =
      label;

    activeFilters.appendChild(
      chip

    );

  }


  /* =========================================
     CLEAR
  ========================================= */

  function clearFilters() {

    form.reset();


    const allAvailability =
      form.querySelector(
        'input[name="availability"][value="all"]'
      );


    const allColor =
      form.querySelector(
        'input[name="color"][value="all"]'
      );


    const allProductType =
      form.querySelector(
        'input[name="product_type"][value="all"]'
      );


    if (allAvailability) {
      allAvailability.checked = true;
    }


    if (allColor) {
      allColor.checked = true;
    }


    if (allProductType) {
      allProductType.checked = true;
    }


    applyFilters();

  }


  /* =========================================
     SUBMIT
  ========================================= */

  form.addEventListener(
    'submit',
    function (event) {

      event.preventDefault();

      applyFilters();

    }
  );


  if (clearButton) {

    clearButton.addEventListener(
      'click',
      clearFilters
    );

  }


  /* =========================================
     SORT
  ========================================= */

  const sortSelect =
    document.querySelector(
      '[data-hilya-sort]'
    );


  if (sortSelect) {

    sortSelect.addEventListener(
      'change',
      function () {

        const url =
          new URL(
            window.location.href
          );


        url.searchParams.set(
          'sort_by',
          this.value
        );


        window.location.href =
          url.toString();

      }
    );

  }

});


{% endjavascript %}


{% stylesheet %}

/* =========================================
   FILTER BAR
========================================= */

.hilya-filters {
  width: 100%;
}

.hilya-filters__top {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  min-height: 4.25rem;
}

.hilya-filters__button {
  display: inline-flex;
  align-items: center;
  justify-self: start;
  gap: .55rem;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-foreground);
  font: inherit;
  font-size: .68rem;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;
  cursor: pointer;
}

.hilya-filters__count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  border: 1px solid currentColor;
  border-radius: 50%;
  font-size: .58rem;
  letter-spacing: 0;
}

.hilya-filters__results {
  justify-self: center;
  color: var(--color-muted);
  font-size: .62rem;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.hilya-filters__sort {
  display: flex;
  align-items: center;
  justify-self: end;
  gap: .6rem;
}

.hilya-filters__sort label {
  color: var(--color-muted);
  font-size: .62rem;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.hilya-filters__sort select {
  min-width: 8rem;
  padding: .35rem 1.5rem .35rem 0;
  border: 0;
  background: transparent;
  color: var(--color-foreground);
  font: inherit;
  font-size: .68rem;
  cursor: pointer;
}


/* =========================================
   ACTIVE FILTERS
========================================= */

.hilya-filters__active {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .5rem;
  padding: 0 0 1rem;
}

.hilya-filters__active-label {
  margin-right: .25rem;
  color: var(--color-muted);
  font-size: .58rem;
  letter-spacing: .12em;
}

.hilya-filter-chip {
  display: inline-flex;
  align-items: center;
  padding: .45rem .7rem;
  border: 1px solid rgb(0 0 0 / 12%);
  color: var(--color-foreground);
  font-size: .65rem;
}


/* =========================================
   OVERLAY
========================================= */

.hilya-filter-overlay {
  position: fixed;
  inset: 0;
  z-index: 9998;
  background: rgb(0 0 0 / 35%);
  opacity: 0;
  visibility: hidden;
  transition:
    opacity 260ms ease,
    visibility 260ms ease;
}

.hilya-filter-overlay.is-visible {
  opacity: 1;
  visibility: visible;
}


/* =========================================
   DRAWER
========================================= */

.hilya-filter-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  width: min(28rem, 92vw);
  background: var(--color-background);
  transform: translateX(100%);
  transition:
    transform 320ms
    cubic-bezier(.22, .61, .36, 1);
  overflow-y: auto;
  box-shadow:
    -12px 0 35px
    rgb(0 0 0 / 8%);
}

.hilya-filter-drawer.is-open {
  transform: translateX(0);
}

.hilya-filter-drawer__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 2rem 1.75rem 1.5rem;
  border-bottom:
    1px solid
    rgb(0 0 0 / 8%);
}

.hilya-filter-drawer__eyebrow {
  display: block;
  margin-bottom: .55rem;
  color: var(--color-muted);
  font-size: .58rem;
  letter-spacing: .2em;
}

.hilya-filter-drawer__header h2 {
  margin: 0;
  font-size: 1.35rem;
  font-weight: 400;
  letter-spacing: .08em;
}

.hilya-filter-drawer__close {
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-foreground);
  font-size: 1.8rem;
  font-weight: 300;
  line-height: 1;
  cursor: pointer;
}


/* =========================================
   GROUPS
========================================= */

.hilya-filter-group {
  border-bottom:
    1px solid
    rgb(0 0 0 / 8%);
}

.hilya-filter-group summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 1.75rem;
  color: var(--color-foreground);
  font-size: .7rem;
  font-weight: 500;
  letter-spacing: .12em;
  text-transform: uppercase;
  cursor: pointer;
  list-style: none;
}

.hilya-filter-group summary::-webkit-details-marker {
  display: none;
}

.hilya-filter-chevron {
  font-size: 1rem;
  font-weight: 300;
}

.hilya-filter-group[open]
.hilya-filter-chevron {
  transform: rotate(45deg);
}

.hilya-filter-group__content {
  padding:
    0 1.75rem 1.4rem;
}


/* =========================================
   OPTIONS
========================================= */

.hilya-filter-option {
  display: flex;
  align-items: center;
  gap: .75rem;
  min-height: 2.4rem;
  color: var(--color-foreground);
  font-size: .78rem;
  cursor: pointer;
}

.hilya-filter-option input {
  width: 1rem;
  height: 1rem;
  margin: 0;
  accent-color: #111;
  cursor: pointer;
}


/* =========================================
   PRICE
========================================= */

.hilya-price-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: .7rem;
}

.hilya-price-fields label {
  display: block;
  color: var(--color-muted);
  font-size: .62rem;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.hilya-price-input {
  display: flex;
  align-items: center;
  margin-top: .45rem;
  border-bottom:
    1px solid
    rgb(0 0 0 / 22%);
}

.hilya-price-input span {
  color: var(--color-muted);
  font-size: .65rem;
}

.hilya-price-input input {
  width: 100%;
  padding: .55rem .25rem;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--color-foreground);
  font: inherit;
  font-size: .78rem;
}


/* =========================================
   ACTIONS
========================================= */

.hilya-filter-actions {
  display: grid;
  gap: .7rem;
  padding: 1.75rem;
}

.hilya-filter-actions__apply {
  width: 100%;
  padding: .95rem 1rem;
  border: 1px solid #111;
  background: #111;
  color: #fff;
  font: inherit;
  font-size: .68rem;
  font-weight: 500;
  letter-spacing: .13em;
  cursor: pointer;
}

.hilya-filter-actions__clear {
  padding: .65rem;
  border: 0;
  background: transparent;
  color: var(--color-muted);
  font: inherit;
  font-size: .65rem;
  text-align: center;
  text-decoration: underline;
  text-underline-offset: .25rem;
  cursor: pointer;
}


/* =========================================
   LOCK
========================================= */

.hilya-filter-lock {
  overflow: hidden;
}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 40rem) {

  .hilya-filters__top {
    grid-template-columns: 1fr auto;
    min-height: 3.75rem;
  }

  .hilya-filters__results {
    display: none;
  }

  .hilya-filters__sort label {
    display: none;
  }

  .hilya-filters__sort select {
    min-width: 6.5rem;
    font-size: .62rem;
  }

  .hilya-filter-drawer {
    width: 100%;
  }

  .hilya-filter-drawer__header {
    padding-inline: 1.25rem;
  }

  .hilya-filter-group summary {
    padding-inline: 1.25rem;
  }

  .hilya-filter-group__content {
    padding-inline: 1.25rem;
  }

  .hilya-filter-actions {
    padding-inline: 1.25rem;
  }

}


@media (prefers-reduced-motion: reduce) {

  .hilya-filter-overlay,
  .hilya-filter-drawer {
    transition: none;
  }

}

{% endstylesheet %}