{% doc %}
  Hilya custom collection filters.
  Client-side filtering without Shopify Search & Discovery.
{% enddoc %}

<div class="hilya-filters">

  <!-- MOBILE FILTER BUTTON -->

  <div class="hilya-filters__mobile-bar">

    <button
      type="button"
      class="hilya-filters__mobile-button"
      data-filter-open
      aria-expanded="false"
      aria-controls="HilyaFilterDrawer"
    >
      FILTER

      <span
        class="hilya-filters__count"
        data-filter-count
        hidden
      >
        0
      </span>

    </button>

    <span class="hilya-filters__mobile-results">

      <span data-filter-results>
        {{ collection.products_count }}
      </span>

      PRODUCTS

    </span>

  </div>


  <!-- DESKTOP SIDEBAR -->

  <aside class="hilya-filter-sidebar">

    <div class="hilya-filter-sidebar__heading">
      <h2>Filters</h2>
    </div>


    <!-- ACTIVE FILTERS -->

    <div
      class="hilya-filters__active"
      data-active-filters
      hidden
    >
    </div>


    <form
      class="hilya-filter-form"
      data-hilya-filter-form
    >

      <!-- AVAILABILITY -->

      <div class="hilya-filter-group is-open">

        <button
          type="button"
          class="hilya-filter-group__toggle"
          data-filter-toggle
        >
          <span>Availability</span>
          <span class="hilya-filter-chevron" aria-hidden="true"></span>
        </button>


        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="availability"
              value="in_stock"
            >

            <span>In stock</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="availability"
              value="out_of_stock"
            >

            <span>Out of stock</span>

          </label>

        </div>

      </div>


      <!-- PRICE -->

      <div class="hilya-filter-group is-open">

        <button
          type="button"
          class="hilya-filter-group__toggle"
          data-filter-toggle
        >
          <span>Price</span>
          <span class="hilya-filter-chevron" aria-hidden="true"></span>
        </button>


        <div class="hilya-filter-group__content">

          <div class="hilya-price-slider">

            <div class="hilya-price-slider__track"></div>

            <div
              class="hilya-price-slider__range"
              data-price-range
            ></div>


            <input
              type="range"
              name="price_min"
              min="0"
              max="1000"
              value="0"
              step="1"
              data-price-min
              aria-label="Minimum price"
            >

            <input
              type="range"
              name="price_max"
              min="0"
              max="1000"
              value="1000"
              step="1"
              data-price-max
              aria-label="Maximum price"
            >

          </div>


          <div class="hilya-price-values">

            <label class="hilya-price-input">

              <span>EGP</span>

              <input
                type="number"
                min="0"
                max="1000"
                step="1"
                value="0"
                inputmode="numeric"
                data-price-min-input
                aria-label="Minimum price"
              >

            </label>


            <span class="hilya-price-values__to">
              to
            </span>


            <label class="hilya-price-input hilya-price-input--max">

              <span>EGP</span>

              <input
                type="number"
                min="0"
                max="1000"
                step="1"
                value="1000"
                inputmode="numeric"
                data-price-max-input
                aria-label="Maximum price"
              >

            </label>

          </div>

        </div>

      </div>


      <!-- COLOR -->

      <div class="hilya-filter-group is-open">

        <button
          type="button"
          class="hilya-filter-group__toggle"
          data-filter-toggle
        >
          <span>Color</span>
          <span class="hilya-filter-chevron" aria-hidden="true"></span>
        </button>


        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="color"
              value="Gold Plated"
            >

            <span>Gold Plated</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="color"
              value="Silver Plated"
            >

            <span>Silver Plated</span>

          </label>

        </div>

      </div>


      <!-- PRODUCT TYPE -->

      <div class="hilya-filter-group is-open">

        <button
          type="button"
          class="hilya-filter-group__toggle"
          data-filter-toggle
        >
          <span>Product Type</span>
          <span class="hilya-filter-chevron" aria-hidden="true"></span>
        </button>


        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">
            <input
              type="checkbox"
              name="product_type"
              value="Necklaces"
            >
            <span>Necklaces</span>
          </label>


          <label class="hilya-filter-option">
            <input
              type="checkbox"
              name="product_type"
              value="Rings"
            >
            <span>Rings</span>
          </label>


          <label class="hilya-filter-option">
            <input
              type="checkbox"
              name="product_type"
              value="Pendants"
            >
            <span>Pendants</span>
          </label>


          <label class="hilya-filter-option">
            <input
              type="checkbox"
              name="product_type"
              value="Bracelets"
            >
            <span>Bracelets</span>
          </label>


          <label class="hilya-filter-option">
            <input
              type="checkbox"
              name="product_type"
              value="Keychains"
            >
            <span>Keychains</span>
          </label>

        </div>

      </div>

    </form>

  </aside>


  <!-- MOBILE DRAWER -->

  <div
    class="hilya-filter-overlay"
    data-filter-overlay
  ></div>


  <aside
    id="HilyaFilterDrawer"
    class="hilya-filter-drawer"
    data-filter-drawer
    aria-hidden="true"
  >

    <div class="hilya-filter-drawer__header">

      <div>

        <span class="hilya-filter-drawer__eyebrow">
          COLLECTION
        </span>

        <h2>
          FILTERS
        </h2>

      </div>


      <button
        type="button"
        class="hilya-filter-drawer__close"
        data-filter-close
        aria-label="Close filters"
      >
        ×
      </button>

    </div>


    <div class="hilya-filter-drawer__content">

      <div
        class="hilya-filters__active"
        data-active-filters-mobile
        hidden
      >
      </div>

      <div data-mobile-filter-content></div>

    </div>

  </aside>


  <!-- TOP PRODUCTS / SORT -->

  <div class="hilya-filters__products-toolbar">

    <span class="hilya-filters__results">

      <span data-filter-results>
        {{ collection.products_count }}
      </span>

      PRODUCTS

    </span>


    <div
      class="hilya-filters__sort"
      data-hilya-sort-wrap
    >

      <span class="hilya-filters__sort-label">
        Sort by
      </span>


      <button
        type="button"
        class="hilya-filters__sort-trigger"
        data-hilya-sort-trigger
        aria-expanded="false"
        aria-haspopup="listbox"
      >

        <span data-hilya-sort-current>
          Featured
        </span>

        <span
          class="hilya-filters__sort-chevron"
          aria-hidden="true"
        ></span>

      </button>


      <div
        class="hilya-filters__sort-menu"
        data-hilya-sort-menu
        role="listbox"
        hidden
      >

        {% for option in collection.sort_options %}

          <button
            type="button"
            class="hilya-filters__sort-option{% if option.value == collection.sort_by %} is-selected{% endif %}"
            data-sort-value="{{ option.value | escape }}"
            role="option"
            aria-selected="{% if option.value == collection.sort_by %}true{% else %}false{% endif %}"
          >

            <span>
              {{ option.name }}
            </span>

            <span
              class="hilya-filters__sort-check"
              aria-hidden="true"
            >
              ✓
            </span>

          </button>

        {% endfor %}

      </div>

    </div>

  </div>

</div>


{% javascript %}

document.addEventListener('DOMContentLoaded', function () {

  const openButton =
    document.querySelector('[data-filter-open]');

  const closeButton =
    document.querySelector('[data-filter-close]');

  const drawer =
    document.querySelector('[data-filter-drawer]');

  const overlay =
    document.querySelector('[data-filter-overlay]');

  const form =
    document.querySelector('[data-hilya-filter-form]');

  const items =
    Array.from(
      document.querySelectorAll('[data-product-item]')
    );

  const resultsElements =
    document.querySelectorAll('[data-filter-results]');

  const countBadge =
    document.querySelector('[data-filter-count]');

  const activeFilters =
    document.querySelector('[data-active-filters]');

  const activeFiltersMobile =
    document.querySelector('[data-active-filters-mobile]');

  const mobileContent =
    document.querySelector('[data-mobile-filter-content]');


  if (!form) {
    return;
  }


  /* =========================================
     MOBILE DRAWER
  ========================================= */

  function openDrawer() {

    if (!drawer) {
      return;
    }

    drawer.classList.add('is-open');

    if (overlay) {
      overlay.classList.add('is-visible');
    }

    drawer.setAttribute(
      'aria-hidden',
      'false'
    );

    if (openButton) {
      openButton.setAttribute(
        'aria-expanded',
        'true'
      );
    }

    document.documentElement.classList.add(
      'hilya-filter-lock'
    );

  }


  function closeDrawer() {

    if (!drawer) {
      return;
    }

    drawer.classList.remove('is-open');

    if (overlay) {
      overlay.classList.remove('is-visible');
    }

    drawer.setAttribute(
      'aria-hidden',
      'true'
    );

    if (openButton) {
      openButton.setAttribute(
        'aria-expanded',
        'false'
      );
    }

    document.documentElement.classList.remove(
      'hilya-filter-lock'
    );

  }


  if (openButton) {
    openButton.addEventListener(
      'click',
      openDrawer
    );
  }


  if (closeButton) {
    closeButton.addEventListener(
      'click',
      closeDrawer
    );
  }


  if (overlay) {
    overlay.addEventListener(
      'click',
      closeDrawer
    );
  }


  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {
        closeDrawer();
      }

    }
  );


  /* =========================================
     MOVE FILTER CONTENT TO MOBILE
  ========================================= */

  if (mobileContent) {

    const filterGroups =
      form.querySelectorAll(
        '.hilya-filter-group'
      );

    filterGroups.forEach(function (group) {

      mobileContent.appendChild(
        group.cloneNode(true)
      );

    });


    mobileContent.addEventListener(
      'change',
      function (event) {

        if (
          event.target.matches(
            'input[type="checkbox"]'
          )
        ) {

          const name =
            event.target.name;

          const value =
            event.target.value;

          const desktopInput =
            form.querySelector(
              'input[name="' +
              name +
              '"][value="' +
              value +
              '"]'
            );

          if (desktopInput) {
            desktopInput.checked =
              event.target.checked;
          }

          applyFilters();

        }

      }
    );

  }


  /* =========================================
     VARIANT IMAGE + PRICE
  ========================================= */

  function updateProductCard(item, color) {

    const dataElement =
      item.querySelector(
        '[data-variant-data]'
      );

    const card =
      item.querySelector(
        '[data-product-card]'
      );

    if (!dataElement || !card) {
      return;
    }


    let variants = [];

    try {

      variants =
        JSON.parse(
          dataElement.textContent
        );

    } catch (error) {

      return;

    }


    if (!color || color === 'all') {

      resetProductCard(item);

      return;

    }


    const wantedColor =
      color.trim().toLowerCase();


    const variant =
      variants.find(function (entry) {

        return (
          String(entry.color || '')
            .trim()
            .toLowerCase() ===
          wantedColor
        );

      });


    if (!variant) {

      resetProductCard(item);

      return;

    }


    /* PRICE */

    const priceElement =
      card.querySelector(
        '[data-product-price]'
      );


    if (
      priceElement &&
      variant.price !== undefined
    ) {

      priceElement.innerHTML =
        '<span class="price">' +
          '<span class="price__current">' +
            'EGP ' +
            Number(
              variant.price
            ).toLocaleString('en-US') +
          '</span>' +
        '</span>';

    }


    /* PRODUCT URL */

    const productLinks =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    productLinks.forEach(function (link) {

      if (variant.url) {

        link.setAttribute(
          'href',
          variant.url
        );

      }

    });


    /* IMAGES */

    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    const colorImages =
      Array.isArray(variant.images)
        ? variant.images
        : [];


    let primaryImage =
      null;

    let secondaryImage =
      null;


    if (
      variant.image &&
      variant.image.src
    ) {

      primaryImage =
        variant.image;

    }


    if (
      !primaryImage &&
      colorImages.length > 0
    ) {

      primaryImage =
        colorImages[0];

    }


    if (colorImages.length > 1) {

      const firstImageSrc =
        primaryImage
          ? primaryImage.src
          : null;


      secondaryImage =
        colorImages.find(function (image) {

          return (
            !firstImageSrc ||
            image.src !== firstImageSrc
          );

        });

    }


    if (
      !secondaryImage &&
      colorImages.length > 1
    ) {

      secondaryImage =
        colorImages[1];

    }


    if (primaryImage) {

      setLayerImage(
        primaryLayer,
        primaryImage
      );

    }


    if (secondaryImage) {

      setLayerImage(
        secondaryLayer,
        secondaryImage
      );

      if (secondaryLayer) {
        secondaryLayer.hidden = false;
      }

      card.classList.add(
        'product-card--has-secondary'
      );

    } else {

      if (secondaryLayer) {

        secondaryLayer.hidden = true;

        secondaryLayer.innerHTML = '';

      }

      card.classList.remove(
        'product-card--has-secondary'
      );

    }


    updateAvailabilityBadge(
      card,
      variant.available
    );

  }


  /* =========================================
     SET IMAGE
  ========================================= */

  function setLayerImage(layer, image) {

    if (
      !layer ||
      !image ||
      !image.src
    ) {
      return;
    }


    layer.innerHTML =
      '<img' +
      ' src="' +
      escapeAttribute(image.src) +
      '"' +
      ' alt="' +
      escapeAttribute(
        image.alt || ''
      ) +
      '"' +
      ' loading="lazy"' +
      ' width="1200"' +
      ' height="960"' +
      '>';

  }


  /* =========================================
     AVAILABILITY
  ========================================= */

  function updateAvailabilityBadge(
    card,
    available
  ) {

    const media =
      card.querySelector(
        '[data-product-media]'
      );

    if (!media) {
      return;
    }


    let badge =
      media.querySelector(
        '[data-variant-sold-out]'
      );


    if (available) {

      if (badge) {
        badge.remove();
      }

      return;

    }


    if (!badge) {

      badge =
        document.createElement(
          'span'
        );

      badge.className =
        'product-card__badge';

      badge.dataset.variantSoldOut =
        '';

      badge.textContent =
        'Sold out';

      media.appendChild(
        badge
      );

    }

  }


  /* =========================================
     RESET CARD
  ========================================= */

  function resetProductCard(item) {

    const card =
      item.querySelector(
        '[data-product-card]'
      );

    if (!card) {
      return;
    }


    const productPrice =
      item.dataset.productPrice;


    const priceElement =
      card.querySelector(
        '[data-product-price]'
      );


    if (
      priceElement &&
      productPrice !== undefined
    ) {

      priceElement.innerHTML =
        '<span class="price">' +
          '<span class="price__current">' +
            'EGP ' +
            Number(
              productPrice
            ).toLocaleString('en-US') +
          '</span>' +
        '</span>';

    }


    const links =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    links.forEach(function (link) {

      const originalUrl =
        link.dataset.originalUrl;

      if (originalUrl) {

        link.setAttribute(
          'href',
          originalUrl
        );

      }

    });


    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    if (primaryLayer) {

      const originalImage =
        primaryLayer.dataset.originalHtml;

      if (originalImage) {

        primaryLayer.innerHTML =
          originalImage;

      }

    }


    if (secondaryLayer) {

      const originalImage =
        secondaryLayer.dataset.originalHtml;

      if (originalImage) {

        secondaryLayer.innerHTML =
          originalImage;

        secondaryLayer.hidden =
          false;

      }

    }


    if (
      secondaryLayer &&
      !secondaryLayer.innerHTML.trim()
    ) {

      card.classList.remove(
        'product-card--has-secondary'
      );

    } else {

      card.classList.add(
        'product-card--has-secondary'
      );

    }


    const variantBadge =
      card.querySelector(
        '[data-variant-sold-out]'
      );


    if (variantBadge) {
      variantBadge.remove();
    }

  }


  /* =========================================
     ESCAPE
  ========================================= */

  function escapeAttribute(value) {

    return String(value)
      .replace(
        /&/g,
        '&amp;'
      )
      .replace(
        /"/g,
        '&quot;'
      )
      .replace(
        /</g,
        '&lt;'
      )
      .replace(
        />/g,
        '&gt;'
      );

  }


  /* =========================================
     STORE ORIGINAL CARD STATE
  ========================================= */

  items.forEach(function (item) {

    const card =
      item.querySelector(
        '[data-product-card]'
      );

    if (!card) {
      return;
    }


    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    const links =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    links.forEach(function (link) {

      link.dataset.originalUrl =
        link.getAttribute('href') || '';

    });


    if (primaryLayer) {

      primaryLayer.dataset.originalHtml =
        primaryLayer.innerHTML;

    }


    if (secondaryLayer) {

      secondaryLayer.dataset.originalHtml =
        secondaryLayer.innerHTML;

    }

  });


  /* =========================================
     PRICE SLIDER + MANUAL INPUTS
  ========================================= */

  const priceMin =
    form.querySelector('[data-price-min]');

  const priceMax =
    form.querySelector('[data-price-max]');

  const priceMinInput =
    form.querySelector('[data-price-min-input]');

  const priceMaxInput =
    form.querySelector('[data-price-max-input]');

  const priceRange =
    form.querySelector('[data-price-range]');


  function clampPrice(value, fallback) {

    const number = Number(value);

    if (!Number.isFinite(number)) {
      return fallback;
    }

    return Math.min(
      1000,
      Math.max(
        0,
        Math.round(number)
      )
    );

  }


  function updatePriceSlider(shouldApply) {

    if (!priceMin || !priceMax) {
      return;
    }


    let min =
      clampPrice(
        priceMin.value,
        0
      );

    let max =
      clampPrice(
        priceMax.value,
        1000
      );


    if (min > max) {

      if (
        document.activeElement === priceMin ||
        document.activeElement === priceMinInput
      ) {

        max = min;

      } else {

        min = max;

      }

    }


    priceMin.value = min;
    priceMax.value = max;


    if (priceMinInput) {
      priceMinInput.value = min;
    }


    if (priceMaxInput) {
      priceMaxInput.value = max;
    }


    if (priceRange) {

      priceRange.style.left =
        ((min / 1000) * 100) + '%';

      priceRange.style.right =
        (
          100 -
          ((max / 1000) * 100)
        ) + '%';

    }


    if (shouldApply) {
      applyFilters();
    }

  }


  if (priceMin) {

    priceMin.addEventListener(
      'input',
      function () {
        updatePriceSlider(true);
      }
    );

  }


  if (priceMax) {

    priceMax.addEventListener(
      'input',
      function () {
        updatePriceSlider(true);
      }
    );

  }


  if (priceMinInput) {

    priceMinInput.addEventListener(
      'input',
      function () {

        let value =
          clampPrice(
            this.value,
            0
          );

        const currentMax =
          Number(
            priceMax.value
          );


        if (value > currentMax) {
          value = currentMax;
        }


        priceMin.value =
          value;

        this.value =
          value;

        updatePriceSlider(true);

      }
    );


    priceMinInput.addEventListener(
      'change',
      function () {
        updatePriceSlider(true);
      }
    );

  }


  if (priceMaxInput) {

    priceMaxInput.addEventListener(
      'input',
      function () {

        let value =
          clampPrice(
            this.value,
            1000
          );

        const currentMin =
          Number(
            priceMin.value
          );


        if (value < currentMin) {
          value = currentMin;
        }


        priceMax.value =
          value;

        this.value =
          value;

        updatePriceSlider(true);

      }
    );


    priceMaxInput.addEventListener(
      'change',
      function () {
        updatePriceSlider(true);
      }
    );

  }


  updatePriceSlider(false);


  /* =========================================
     FILTER
  ========================================= */

  function getCheckedValues(name) {

    return Array.from(
      form.querySelectorAll(
        'input[name="' +
        name +
        '"]:checked'
      )
    ).map(function (input) {

      return input.value
        .trim()
        .toLowerCase();

    });

  }


  function applyFilters() {

    const availability =
      getCheckedValues(
        'availability'
      );

    const colors =
      getCheckedValues(
        'color'
      );

    const productTypes =
      getCheckedValues(
        'product_type'
      );


    const minPrice =
      priceMin
        ? Number(priceMin.value)
        : 0;

    const maxPrice =
      priceMax
        ? Number(priceMax.value)
        : 1000;


    let visibleCount = 0;


    items.forEach(function (item) {

      const itemType =
        (
          item.dataset.productType ||
          ''
        )
          .trim()
          .toLowerCase();


      const itemPrice =
        Number(
          item.dataset.productPrice ||
          0
        );


      const itemAvailable =
        item.dataset.productAvailable ===
        'true';


      const itemColors =
        (
          item.dataset.productColors ||
          ''
        )
          .toLowerCase()
          .split('|')
          .map(function (value) {
            return value.trim();
          })
          .filter(Boolean);


      let matches =
        true;


      /* AVAILABILITY */

      if (
        availability.length > 0
      ) {

        const matchesAvailability =
          availability.some(
            function (value) {

              if (
                value === 'in_stock'
              ) {

                return itemAvailable;

              }


              if (
                value === 'out_of_stock'
              ) {

                return !itemAvailable;

              }


              return false;

            }
          );


        if (
          !matchesAvailability
        ) {

          matches =
            false;

        }

      }


      /* COLOR */

      if (
        matches &&
        colors.length > 0
      ) {

        const matchesColor =
          colors.some(
            function (color) {

              return itemColors.includes(
                color
              );

            }
          );


        if (!matchesColor) {
          matches = false;
        }

      }


      /* PRODUCT TYPE */

      if (
        matches &&
        productTypes.length > 0
      ) {

        const matchesType =
          productTypes.includes(
            itemType
          );


        if (!matchesType) {
          matches = false;
        }

      }


      /* PRICE */

      let effectivePrice =
        itemPrice;


      if (
        colors.length === 1
      ) {

        const dataElement =
          item.querySelector(
            '[data-variant-data]'
          );


        if (dataElement) {

          try {

            const variants =
              JSON.parse(
                dataElement.textContent
              );


            const selectedVariant =
              variants.find(
                function (variant) {

                  return (
                    String(
                      variant.color || ''
                    )
                      .trim()
                      .toLowerCase() ===
                    colors[0]
                  );

                }
              );


            if (
              selectedVariant &&
              selectedVariant.price !==
              undefined
            ) {

              effectivePrice =
                Number(
                  selectedVariant.price
                );

            }

          } catch (error) {}

        }

      }


      if (
        effectivePrice <
        minPrice ||
        effectivePrice >
        maxPrice
      ) {

        matches =
          false;

      }


      /* DISPLAY */

      if (matches) {

        item.classList.remove(
          'is-filtered-out'
        );

        visibleCount++;


        if (
          colors.length === 1
        ) {

          updateProductCard(
            item,
            colors[0]
          );

        } else {

          resetProductCard(
            item
          );

        }

      } else {

        item.classList.add(
          'is-filtered-out'
        );

      }

    });


    /* RESULTS */

    resultsElements.forEach(
      function (element) {

        element.textContent =
          visibleCount;

      }
    );


    /* ACTIVE FILTER COUNT */

    const activeCount =
      availability.length +
      colors.length +
      productTypes.length +
      (
        minPrice > 0
          ? 1
          : 0
      ) +
      (
        maxPrice < 1000
          ? 1
          : 0
      );


    if (countBadge) {

      countBadge.textContent =
        activeCount;

      countBadge.hidden =
        activeCount === 0;

    }


    /* ACTIVE CHIPS */

    renderActiveFilters(
      availability,
      colors,
      productTypes,
      minPrice,
      maxPrice
    );

  }


  /* =========================================
     ACTIVE FILTER CHIPS
  ========================================= */

  function renderActiveFilters(
    availability,
    colors,
    productTypes,
    minPrice,
    maxPrice
  ) {

    const containers =
      [
        activeFilters,
        activeFiltersMobile
      ].filter(Boolean);


    containers.forEach(
      function (container) {

        container.innerHTML =
          '';


        const hasFilters =
          availability.length > 0 ||
          colors.length > 0 ||
          productTypes.length > 0 ||
          minPrice > 0 ||
          maxPrice < 1000;


        if (!hasFilters) {

          container.hidden =
            true;

          return;

        }


        container.hidden =
          false;


        const title =
          document.createElement(
            'span'
          );

        title.className =
          'hilya-filters__active-label';

        title.textContent =
          'FILTERED BY';

        container.appendChild(
          title
        );


        availability.forEach(
          function (value) {

            addChip(
              container,
              value === 'in_stock'
                ? 'In stock'
                : 'Out of stock',
              'availability',
              value
            );

          }
        );


        colors.forEach(
          function (value) {

            addChip(
              container,
              value.charAt(0).toUpperCase() +
                value.slice(1),
              'color',
              value
            );

          }
        );


        productTypes.forEach(
          function (value) {

            addChip(
              container,
              value.charAt(0).toUpperCase() +
                value.slice(1),
              'product_type',
              value
            );

          }
        );


        if (minPrice > 0) {

          addChip(
            container,
            'From EGP ' +
              minPrice.toLocaleString('en-US'),
            'price_min',
            '0'
          );

        }


        if (maxPrice < 1000) {

          addChip(
            container,
            'To EGP ' +
              maxPrice.toLocaleString('en-US'),
            'price_max',
            '1000'
          );

        }


        const clear =
          document.createElement(
            'button'
          );


        clear.type =
          'button';

        clear.className =
          'hilya-filters__clear';

        clear.textContent =
          'CLEAR ALL';


        clear.addEventListener(
          'click',
          clearFilters
        );


        container.appendChild(
          clear
        );

      }
    );

  }


  function addChip(
    container,
    label,
    inputName,
    inputValue
  ) {

    const chip =
      document.createElement(
        'button'
      );


    chip.type =
      'button';

    chip.className =
      'hilya-filter-chip';


    chip.innerHTML =
      '<span>' +
        escapeAttribute(label) +
      '</span>' +
      '<span class="hilya-filter-chip__remove" aria-hidden="true">' +
        '×' +
      '</span>';


    chip.setAttribute(
      'aria-label',
      'Remove ' + label
    );


    chip.addEventListener(
      'click',
      function () {

        if (
          inputName ===
          'price_min'
        ) {

          if (priceMin) {
            priceMin.value = 0;
          }

          if (priceMinInput) {
            priceMinInput.value = 0;
          }

        } else if (
          inputName ===
          'price_max'
        ) {

          if (priceMax) {
            priceMax.value = 1000;
          }

          if (priceMaxInput) {
            priceMaxInput.value = 1000;
          }

        } else if (inputName) {

          const inputs =
            form.querySelectorAll(
              'input[name="' +
              inputName +
              '"]'
            );


          inputs.forEach(
            function (input) {

              if (
                input.value
                  .trim()
                  .toLowerCase() ===
                String(inputValue)
                  .trim()
                  .toLowerCase()
              ) {

                input.checked =
                  false;

              }

            }
          );

        }


        updatePriceSlider(false);

        syncMobileFilters();

        applyFilters();

      }
    );


    container.appendChild(
      chip
    );

  }


  function syncMobileFilters() {

    if (!mobileContent) {
      return;
    }


    form
      .querySelectorAll(
        'input[type="checkbox"]'
      )
      .forEach(
        function (input) {

          const matching =
            mobileContent.querySelector(
              'input[name="' +
              input.name +
              '"][value="' +
              input.value +
              '"]'
            );


          if (matching) {

            matching.checked =
              input.checked;

          }

        }
      );

  }


  /* =========================================
     CLEAR
  ========================================= */

  function clearFilters() {

    form
      .querySelectorAll(
        'input[type="checkbox"]'
      )
      .forEach(
        function (input) {

          input.checked =
            false;

        }
      );


    if (priceMin) {
      priceMin.value =
        0;
    }


    if (priceMax) {
      priceMax.value =
        1000;
    }


    if (priceMinInput) {
      priceMinInput.value =
        0;
    }


    if (priceMaxInput) {
      priceMaxInput.value =
        1000;
    }


    if (mobileContent) {

      mobileContent
        .querySelectorAll(
          'input[type="checkbox"]'
        )
        .forEach(
          function (input) {

            input.checked =
              false;

          }
        );

    }


    updatePriceSlider(false);

    applyFilters();

  }


  /* =========================================
     CHECKBOX EVENTS
  ========================================= */

  form.addEventListener(
    'change',
    function (event) {

      if (
        event.target.matches(
          'input[type="checkbox"]'
        )
      ) {

        if (mobileContent) {

          const matching =
            mobileContent.querySelector(
              'input[name="' +
              event.target.name +
              '"][value="' +
              event.target.value +
              '"]'
            );


          if (matching) {

            matching.checked =
              event.target.checked;

          }

        }


        applyFilters();

      }

    }
  );


  /* =========================================
     SORT
  ========================================= */

  const sortWrap =
    document.querySelector(
      '[data-hilya-sort-wrap]'
    );

  const sortTrigger =
    document.querySelector(
      '[data-hilya-sort-trigger]'
    );

  const sortMenu =
    document.querySelector(
      '[data-hilya-sort-menu]'
    );

  const sortCurrent =
    document.querySelector(
      '[data-hilya-sort-current]'
    );

  const sortOptions =
    document.querySelectorAll(
      '[data-sort-value]'
    );


  function closeSortMenu() {

    if (
      !sortWrap ||
      !sortTrigger ||
      !sortMenu
    ) {
      return;
    }


    sortWrap.classList.remove(
      'is-open'
    );


    sortTrigger.setAttribute(
      'aria-expanded',
      'false'
    );


    sortMenu.hidden =
      true;

  }


  function openSortMenu() {

    if (
      !sortWrap ||
      !sortTrigger ||
      !sortMenu
    ) {
      return;
    }


    sortWrap.classList.add(
      'is-open'
    );


    sortTrigger.setAttribute(
      'aria-expanded',
      'true'
    );


    sortMenu.hidden =
      false;

  }


  if (sortTrigger) {

    sortTrigger.addEventListener(
      'click',
      function () {

        if (
          sortMenu &&
          sortMenu.hidden
        ) {

          openSortMenu();

        } else {

          closeSortMenu();

        }

      }
    );

  }


  sortOptions.forEach(
    function (option) {

      option.addEventListener(
        'click',
        function () {

          const value =
            option.getAttribute(
              'data-sort-value'
            );

          const label =
            option.querySelector(
              'span'
            );


          if (
            sortCurrent &&
            label
          ) {

            sortCurrent.textContent =
              label.textContent.trim();

          }


          sortOptions.forEach(
            function (other) {

              const selected =
                other === option;


              other.classList.toggle(
                'is-selected',
                selected
              );


              other.setAttribute(
                'aria-selected',
                selected
                  ? 'true'
                  : 'false'
              );

            }
          );


          closeSortMenu();


          const url =
            new URL(
              window.location.href
            );


          url.searchParams.set(
            'sort_by',
            value
          );


          window.location.href =
            url.toString();

        }
      );

    }
  );


  document.addEventListener(
    'click',
    function (event) {

      if (
        sortWrap &&
        !sortWrap.contains(
          event.target
        )
      ) {

        closeSortMenu();

      }

    }
  );


  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {
        closeSortMenu();
      }

    }
  );


  /* =========================================
     FILTER GROUP TOGGLES
  ========================================= */

  document.addEventListener(
    'click',
    function (event) {

      const toggle =
        event.target.closest(
          '[data-filter-toggle]'
        );


      if (!toggle) {
        return;
      }


      const group =
        toggle.closest(
          '.hilya-filter-group'
        );


      if (!group) {
        return;
      }


      group.classList.toggle(
        'is-open'
      );

    }
  );


  /* =========================================
     INITIAL FILTER
  ========================================= */

  applyFilters();

});


{% endjavascript %}


