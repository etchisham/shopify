  height: 2px;
  margin: 0;
  padding: 0;
  transform: translateY(-50%);
  background: #d2d2d2 !important;
  border: 0 !important;
  border-radius: 0;
  box-shadow: none !important;
}

.hilya-price-slider__range {
  position: absolute;
  top: 50%;
  height: 2px;
  margin: 0;
  padding: 0;
  transform: translateY(-50%);
  background: #111 !important;
  border: 0 !important;
  border-radius: 0;
  z-index: 2;
  box-shadow: none !important;
}


/* =========================================
   RANGE CONTROLS
========================================= */

.hilya-price-slider input[type="range"] {
  position: absolute !important;
  top: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  left: 0 !important;

  width: 100% !important;
  height: 1.4rem !important;

  margin: 0 !important;
  padding: 0 !important;

  border: 0 !important;
  outline: 0 !important;
  background: transparent !important;
  box-shadow: none !important;

  appearance: none !important;
  -webkit-appearance: none !important;

  pointer-events: none;
  z-index: 4;
}


/* CHROME / EDGE */

.hilya-price-slider
input[type="range"]::-webkit-slider-runnable-track {
  width: 100%;
  height: 2px;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
}

.hilya-price-slider
input[type="range"]::-webkit-slider-thumb {
  width: 11px;
  height: 11px;

  margin-top: -4.5px;

  border: 0 !important;
  border-radius: 50%;

  background: #111 !important;

  appearance: none !important;
  -webkit-appearance: none !important;

  box-shadow: none !important;

  cursor: pointer;
  pointer-events: auto;
}


/* FIREFOX */

.hilya-price-slider
input[type="range"]::-moz-range-track {
  width: 100%;
  height: 2px;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
}

.hilya-price-slider
input[type="range"]::-moz-range-progress {
  background: transparent !important;
}

.hilya-price-slider
input[type="range"]::-moz-range-thumb {
  width: 11px;
  height: 11px;

  border: 0 !important;
  border-radius: 50%;

  background: #111 !important;

  box-shadow: none !important;

  cursor: pointer;
  pointer-events: auto;
}


/* =========================================
   PRICE NUMBER FIELDS
========================================= */

.hilya-price-values {
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    auto
    minmax(0, 1fr);

  align-items: center;
  gap: .4rem;

  width: 100%;
  margin: 0;
  padding: 0;

  font-size: .6rem;
}

.hilya-price-input {
  display: flex;
  align-items: center;

  width: 100%;
  min-width: 0;
  height: 1.85rem;

  margin: 0;
  padding: 0 .5rem;

  border: 1px solid rgb(0 0 0 / 16%) !important;
  border-radius: 0;

  background: var(--color-background) !important;

  box-shadow: none !important;
  outline: none;
}

.hilya-price-input span {
  flex: 0 0 auto;

  color: var(--color-muted);
  font-size: .52rem;
  line-height: 1;
}

.hilya-price-input input {
  display: block;

  width: 100%;
  min-width: 0;
  height: 100%;

  margin: 0;
  padding: 0;

  border: 0 !important;
  outline: 0 !important;

  background: transparent !important;

  color: var(--color-foreground);

  font: inherit;
  font-size: .6rem;
  line-height: 1;

  text-align: right;

  box-shadow: none !important;
}

.hilya-price-input input:focus {
  border: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
}

.hilya-price-input input::-webkit-inner-spin-button,
.hilya-price-input input::-webkit-outer-spin-button {
  margin: 0;
  appearance: none;
  -webkit-appearance: none;
}

.hilya-price-input input[type="number"] {
  appearance: textfield;
  -moz-appearance: textfield;
}

.hilya-price-values__to {
  color: var(--color-muted);
  font-size: .56rem;
  line-height: 1;
  white-space: nowrap;
}


/* =========================================
   PRODUCTS TOOLBAR
========================================= */

.hilya-filters__products-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;

  width: 100%;
  min-height: 2.55rem;

  margin: 0 0 .4rem;

  border-bottom: 1px solid rgb(0 0 0 / 9%);
}

.hilya-filters__results {
  color: var(--color-foreground);
  font-size: .68rem;
  letter-spacing: .075em;
  text-transform: uppercase;
}


/* =========================================
   SORT
========================================= */

.hilya-filters__sort {
  position: relative;
  display: flex;
  align-items: center;
  gap: .55rem;
  white-space: nowrap;
}

.hilya-filters__sort-label {
  color: var(--color-muted);
  font-size: .66rem;
  font-weight: 400;
  letter-spacing: .035em;
  white-space: nowrap;
  text-transform: none;
}

.hilya-filters__sort-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;

  gap: .9rem;

  min-width: auto;
  min-height: auto;

  padding: .15rem 0 .18rem;

  border: 0;
  border-bottom: 0 !important;
  border-radius: 0;

  background: transparent;

  color: var(--color-foreground);

  font: inherit;
  font-size: .68rem;
  font-weight: 400;

  text-align: left;

  cursor: pointer;

  box-shadow: none;
}

.hilya-filters__sort-trigger:hover {
  border-color: rgb(0 0 0 / 45%);
  border-bottom: 0 !important;
  background: transparent;
}

.hilya-filters__sort-chevron {
  position: relative;
  display: inline-block;

  width: .42rem;
  height: .42rem;

  flex: 0 0 auto;

  margin-top: -.18rem;

  border-right: 1px solid currentColor;
  border-bottom: 1px solid currentColor;

  transform: rotate(45deg);

  transition:
    transform 180ms ease;
}

.hilya-filters__sort.is-open
.hilya-filters__sort-chevron {
  transform: rotate(225deg);
}

.hilya-filters__sort-menu {
  position: absolute;

  top: calc(100% + .45rem);
  right: 0;

  z-index: 30;

  width: 11rem;

  padding: .3rem 0;

  border: 1px solid rgb(0 0 0 / 12%);
  border-radius: 0;

  background: var(--color-background);

  box-shadow:
    0 8px 24px rgb(0 0 0 / 8%);
}

.hilya-filters__sort-option {
  display: flex;
  align-items: center;
  justify-content: space-between;

  width: 100%;

  padding: .6rem .7rem;

  border: 0;

  background: transparent;

  color: var(--color-foreground);

  font: inherit;
  font-size: .64rem;

  text-align: left;

  cursor: pointer;
}

.hilya-filters__sort-option:hover {
  background: rgb(0 0 0 / 4%);
}

.hilya-filters__sort-check {
  visibility: hidden;
  font-size: .7rem;
}

.hilya-filters__sort-option.is-selected
.hilya-filters__sort-check {
  visibility: visible;
}


/* =========================================
   MOBILE DRAWER
========================================= */

.hilya-filter-overlay {
  position: fixed;
  inset: 0;

  z-index: 100000;

  background: rgb(0 0 0 / 35%);

  opacity: 0;
  visibility: hidden;

  transition:
    opacity 260ms ease,
    visibility 260ms ease;
}

.hilya-filter-overlay.is-visible {
  opacity: 1;
  visibility: visible;
}

.hilya-filter-drawer {
  position: fixed;

  top: 0;
  right: 0;
  bottom: 0;

  z-index: 100001;

  width: min(28rem, 92vw);

  overflow-y: auto;

  background: var(--color-background);

  transform: translateX(100%);

  transition:
    transform 320ms
    cubic-bezier(.22,.61,.36,1);
}

.hilya-filter-drawer.is-open {
  transform: translateX(0);
}

.hilya-filter-drawer__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  padding: 2rem 1.5rem 1.35rem;

  border-bottom: 1px solid rgb(0 0 0 / 8%);
}

.hilya-filter-drawer__eyebrow {
  display: block;

  margin-bottom: .45rem;

  color: var(--color-muted);

  font-size: .56rem;
  letter-spacing: .18em;
}

.hilya-filter-drawer__header h2 {
  margin: 0;

  font-size: 1.2rem;
  font-weight: 400;
  letter-spacing: .08em;
}

.hilya-filter-drawer__close {
  padding: 0;

  border: 0;

  background: transparent;

  color: var(--color-foreground);

  font-size: 1.8rem;
  font-weight: 300;
  line-height: 1;

  cursor: pointer;
}

.hilya-filter-drawer__content {
  padding: 0 1.5rem 2rem;
}

.hilya-filter-drawer .hilya-filter-group {
  border-top: 1px solid rgb(0 0 0 / 9%);
}

.hilya-filter-drawer .hilya-filter-group:last-child {
  border-bottom: 1px solid rgb(0 0 0 / 9%);
}

.hilya-filter-drawer
.hilya-filter-group__toggle,
.hilya-filter-drawer
.hilya-filter-group__content {
  padding-inline: 0;
}


/* =========================================
   DESKTOP
========================================= */

@media (min-width: 40.001rem) {

  .hilya-filter-sidebar {
    grid-area: sidebar;
    align-self: start;

    position: sticky;
    top: 96px;

    width: 100%;

    max-height: calc(100vh - 112px);

    overflow-y: auto;
    overflow-x: hidden;

    padding-right: .15rem;

    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
  }


  .hilya-filter-sidebar::-webkit-scrollbar {
    width: 2px;
  }

  .hilya-filter-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .hilya-filter-sidebar::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 999px;
  }

  .hilya-filter-sidebar:hover {
    scrollbar-color:
      rgb(0 0 0 / 14%)
      transparent;
  }

  .hilya-filter-sidebar:hover::-webkit-scrollbar-thumb {
    background: rgb(0 0 0 / 14%);
  }

  .hilya-filter-sidebar::-webkit-scrollbar-thumb:hover {
    background: rgb(0 0 0 / 22%);
  }


  .hilya-filter-sidebar__heading {
    margin: 0 0 .55rem;
  }

  .hilya-filter-sidebar__heading h2 {
    font-size: .96rem;
  }

  .hilya-filter-group__toggle {
    padding: .65rem 0;
    font-size: .72rem;
  }

  .hilya-filter-group__content {
    padding-bottom: .65rem;
  }

  .hilya-filter-option {
    min-height: 1.7rem;
    font-size: .70rem;
  }

  .hilya-price-slider {
    margin: .12rem 0 .38rem;
  }

  .hilya-price-input {
    height: 1.7rem;
    padding-inline: .38rem;
  }

  .hilya-filters__products-toolbar {
    grid-area: toolbar;

    min-height: 2.35rem;

    margin-bottom: .35rem;
  }

  .hilya-filters__results,
  .hilya-filters__sort-label,
  .hilya-filters__sort-trigger {
    line-height: 1.2;
  }

  .hilya-filters__mobile-bar,
  .hilya-filter-drawer,
  .hilya-filter-overlay {
    display: none !important;
  }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 40rem) {

  .hilya-filter-sidebar {
    display: none;
  }


  /* =======================================
     MOBILE TOP BAR

     FILTERS | PRODUCTS | SORT
  ======================================= */

  .hilya-filters {
    position: relative;
  }


  .hilya-filters__mobile-bar {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto
      minmax(0, 1fr);

    align-items: center;

    width: 100%;

    min-height: 3rem;

    border-top:
      1px solid rgb(0 0 0 / 9%);

    border-bottom:
      1px solid rgb(0 0 0 / 9%);
  }


  /* =======================================
     FILTERS LEFT
  ======================================= */

  .hilya-filters__mobile-button {
  display: inline-flex;
  align-items: center;

  justify-self: start;

  gap: .55rem;

  padding: 0;

  border: 0;

  background: transparent;

  color: var(--color-foreground);

  font: inherit;

  font-size: .63rem;
  font-weight: 500;

  letter-spacing: .1em;

  cursor: pointer;
}


/* =========================================
   FILTER ICON
========================================= */

.hilya-filters__filter-icon {
  position: relative;

  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;

  width: .7rem;
height: .40rem;
flex-basis: .7rem;
}


/* lines */

.hilya-filters__filter-icon span {
  position: relative;

  display: block;

  width: 100%;
  height: 1px;

  background: currentColor;
}


/* knobs */

.hilya-filters__filter-icon span::after {
  content: "";

  position: absolute;

  top: 50%;

  width: .23rem;
  height: .23rem;

  border: 1px solid currentColor;
  border-radius: 50%;

  background: var(--color-background);

  transform: translateY(-50%);
}


/* knob positions */

.hilya-filters__filter-icon span:first-child::after {
  left: 18%;
}

.hilya-filters__filter-icon span:last-child::after {
  left: 58%;
}



/* FILTER TEXT */

.hilya-filters__filter-text {
  display: inline-block;
}



  /* =======================================
     PRODUCTS CENTER
  ======================================= */

  .hilya-filters__mobile-results {
    display: block;

    justify-self: center;

    color: var(--color-foreground);

    font-size: .58rem;

    letter-spacing: .075em;

    text-align: center;

    white-space: nowrap;

    text-transform: uppercase;
  }


  /* =======================================
     SORT RIGHT
  ======================================= */

  .hilya-filters__sort--mobile {
    position: relative;

    display: flex;
    align-items: center;

    justify-self: end;

    gap: .45rem;

    white-space: nowrap;
  }


  .hilya-filters__sort--mobile
  .hilya-filters__sort-label {
    display: inline;

    color: var(--color-muted);

    font-size: .58rem;

    font-weight: 400;

    letter-spacing: .02em;

    white-space: nowrap;

    text-transform: none;
  }


  .hilya-filters__sort--mobile
  .hilya-filters__sort-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;

    gap: .55rem;

    min-width: auto;
    min-height: auto;

    padding: .15rem 0 .18rem;

    border: 0 !important;
    border-bottom: 0 !important;

    border-radius: 0;

    background: transparent;

    color: var(--color-foreground);

    font: inherit;

    font-size: .58rem;
    font-weight: 400;

    text-align: left;

    cursor: pointer;

    box-shadow: none;
  }


  .hilya-filters__sort--mobile
  .hilya-filters__sort-trigger:hover {
    border: 0 !important;
    border-bottom: 0 !important;

    background: transparent;
  }


  .hilya-filters__sort--mobile
  .hilya-filters__sort-chevron {
    width: .38rem;
    height: .38rem;

    margin-top: -.15rem;

    border-right:
      1px solid currentColor;

    border-bottom:
      1px solid currentColor;

    transform:
      rotate(45deg);
  }


  .hilya-filters__sort--mobile.is-open
  .hilya-filters__sort-chevron {
    transform:
      rotate(225deg);
  }


  .hilya-filters__sort--mobile
  .hilya-filters__sort-menu {
    top: calc(100% + .45rem);
    right: 0;

    width: 11rem;
  }


  /* =======================================
     HIDE OLD MOBILE PRODUCTS TOOLBAR

     The mobile bar above now contains
     FILTERS + PRODUCTS + SORT.
  ======================================= */

  .hilya-filters__products-toolbar {
    display: none;
  }


  /* =======================================
     MOBILE DRAWER
     OPEN FROM LEFT
  ======================================= */

  .hilya-filter-drawer {
    position: fixed;

    top: 0;
    bottom: 0;

    left: 0;
    right: auto;

    z-index: 100001;

    width: min(28rem, 92vw);

    overflow-y: auto;

    background: var(--color-background);

    transform:
      translateX(-100%);

    transition:
      transform 320ms
      cubic-bezier(.22,.61,.36,1);
  }


  .hilya-filter-drawer.is-open {
    transform:
      translateX(0);
  }


  /* =======================================
     DRAWER HEADER
  ======================================= */

  .hilya-filter-drawer__header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    padding:
      2rem
      1.5rem
      1.35rem;

    border-bottom: 0;
  }


  .hilya-filter-drawer__eyebrow {
    display: none;
  }


  .hilya-filter-drawer__header h2 {
    margin: 0;

    color: var(--color-foreground);

    font-size: 1.2rem;

    font-weight: 400;

    letter-spacing: .08em;
  }


  .hilya-filter-drawer__close {
    padding: 0;

    border: 0;

    background: transparent;

    color: var(--color-foreground);

    font-size: 1.8rem;

    font-weight: 300;

    line-height: 1;

    cursor: pointer;
  }


  .hilya-filter-drawer__content {
    padding:
      0
      1.5rem
      2rem;
  }


  .hilya-filter-drawer
  .hilya-filter-group {
    border-top:
      1px solid rgb(0 0 0 / 9%);
  }


  .hilya-filter-drawer
  .hilya-filter-group:last-child {
    border-bottom:
      1px solid rgb(0 0 0 / 9%);
  }


  .hilya-filter-drawer
  .hilya-filter-group__toggle,
  .hilya-filter-drawer
  .hilya-filter-group__content {
    padding-inline: 0;
  }


  /* =======================================
     FILTER CHIPS
  ======================================= */

  .hilya-filter-chip {
    font-size: .57rem;

    padding:
      .36rem
      .44rem;
  }

}


/* =========================================
   VERY SMALL MOBILE
========================================= */

@media (max-width: 27rem) {

  .hilya-filters__mobile-bar {
    grid-template-columns:
      minmax(0, 1fr)
      auto
      minmax(0, 1fr);
  }


  .hilya-filters__mobile-button {
    font-size: .58rem;
    letter-spacing: .07em;
  }


  .hilya-filters__mobile-results {
    font-size: .54rem;
  }


  .hilya-filters__sort--mobile {
    gap: .3rem;
  }


  .hilya-filters__sort--mobile
  .hilya-filters__sort-label {
    font-size: .52rem;
  }


  .hilya-filters__sort--mobile
  .hilya-filters__sort-trigger {
    gap: .4rem;
    font-size: .52rem;
  }

}


/* =========================================
   REDUCED MOTION
========================================= */

@media (prefers-reduced-motion: reduce) {

  .hilya-filter-overlay,
  .hilya-filter-drawer,
  .hilya-filter-chevron,
  .hilya-filters__sort-chevron {
    transition: none;
  }

}

{% endstylesheet %}
