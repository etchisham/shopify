}

.hilya-filters .hilya-price-slider input[type="range"]::-webkit-slider-thumb,
.hilya-filters .hilya-price-slider input[type="range"]:hover::-webkit-slider-thumb,
.hilya-filters .hilya-price-slider input[type="range"]:focus-visible::-webkit-slider-thumb {
  border: 0 !important;
  background: var(--hilya-rose) !important;
  box-shadow: none !important;
}

.hilya-filters .hilya-price-slider input[type="range"]::-moz-range-thumb,
.hilya-filters .hilya-price-slider input[type="range"]:hover::-moz-range-thumb,
.hilya-filters .hilya-price-slider input[type="range"]:focus-visible::-moz-range-thumb {
  border: 0 !important;
  background: var(--hilya-rose) !important;
  box-shadow: none !important;
}

.hilya-filters .hilya-price-values {
  align-items: center;
  gap: .6rem;
  margin-top: .15rem;
}

/* two soft raised fields, centered text, same width, under the line */

.hilya-filters .hilya-price-values {
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: .4rem;
  margin-top: .45rem;
}

.hilya-filters .hilya-price-input {
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: .28rem;
  box-sizing: border-box;
  width: 100%;
  height: 2.1rem !important;
  padding: 0 .3rem !important;
  border: 1px solid rgb(140 88 76 / 35%) !important;
  border-radius: 10px;
  background: linear-gradient(180deg, #BE8B7B 0%, #B87F6F 100%) !important;
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 28%),
    0 1px 2px rgb(120 70 58 / 22%),
    0 4px 10px rgb(184 127 111 / 28%) !important;
