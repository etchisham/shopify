    justify-self: end;
    gap: .45rem;
    white-space: nowrap;
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-label {
    display: inline;
    color: var(--color-muted);
    font-size: .58rem;
    font-weight: 400;
    letter-spacing: .02em;
    white-space: nowrap;
    text-transform: none;
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: .55rem;
    min-width: auto;
    min-height: auto;
    padding: .15rem 0 .18rem;
    border: 0 !important;
    border-bottom: 0 !important;
    border-radius: 0;
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-size: .58rem;
    font-weight: 400;
    text-align: left;
    cursor: pointer;
    box-shadow: none;
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-trigger:hover {
    border: 0 !important;
    border-bottom: 0 !important;
    background: transparent;
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-chevron {
    width: .38rem;
    height: .38rem;
    margin-top: -.15rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
  }

  .hilya-filters__sort--mobile.is-open .hilya-filters__sort-chevron {
    transform: rotate(225deg);
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-menu {
    top: calc(100% + .45rem);
    right: 0;
    width: 11rem;
  }


  /* HIDE OLD MOBILE TOOLBAR */

  .hilya-filters__products-toolbar {
    display: none;
  }


  /* =======================================
     MOBILE DRAWER
  ======================================= */

  .hilya-filter-drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    right: auto;

    z-index: 100001;

    width: min(28rem, 92vw);

    height: 100dvh;
    max-height: 100dvh;

    overflow: hidden;

    display: flex;
    flex-direction: column;

    background: var(--color-background);

    transform: translateX(-100%);

    transition: transform 320ms cubic-bezier(.22,.61,.36,1);

    overscroll-behavior: none;
  }

  .hilya-filter-drawer.is-open {
    transform: translateX(0);
  }


  /* =======================================
     MOBILE DRAWER HEADER

     FILTERS + FILTERED BY
     STAY TOGETHER
  ======================================= */

  .hilya-filter-drawer__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    flex: 0 0 auto;

    padding: 2rem 1.5rem 1.35rem;

    background: var(--color-background);

    /*
      IMPORTANT:
      No line under FILTERS.
      The line will start at Availability.
    */
    border-bottom: 0;

    position: relative;
    z-index: 2;
  }

  .hilya-filter-drawer__header-main {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hilya-filter-drawer__title {
    display: block;
  }

  .hilya-filter-drawer__eyebrow {
    display: none;
  }

  .hilya-filter-drawer__header h2 {
    margin: 0;
    color: var(--color-foreground);
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: .08em;
  }


  /* =======================================
     FILTERED BY
     INSIDE FIXED HEADER
  ======================================= */

  .hilya-filter-drawer__header .hilya-filters__active {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    width: 100%;

    margin-top: .7rem;
    margin-bottom: 0;

    gap: .3rem;
  }

  .hilya-filter-drawer__header .hilya-filters__active-label {
    width: 100%;
    margin: 0 0 .08rem;

    color: var(--color-muted);
    font-size: .52rem;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .hilya-filter-drawer__header .hilya-filter-chip {
    font-size: .57rem;
    padding: .36rem .44rem;
  }

  .hilya-filter-drawer__header .hilya-filters__clear {
    font-size: .55rem;
  }


  /* CLOSE */

  .hilya-filter-drawer__close {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    font-size: 1.8rem;
    font-weight: 300;
    line-height: 1;
    cursor: pointer;
    flex: 0 0 auto;
    margin-left: 1rem;
  }


  /* =======================================
     DRAWER CONTENT

     ONLY THIS AREA SCROLLS
  ======================================= */

  .hilya-filter-drawer__content {

    flex: 1 1 auto;

    min-height: 0;

    width: 100%;

    overflow-y: auto;
    overflow-x: hidden;

    overscroll-behavior-y: contain;

    -webkit-overflow-scrolling: touch;

    padding: 0 1.5rem 2rem;
  }


  /* =======================================
     FIRST FILTER LINE

     Starts UNDER FILTERED BY.
  ======================================= */

  .hilya-filter-drawer__content .hilya-filter-group:first-child {
    border-top: 1px solid rgb(0 0 0 / 9%);
  }


  /* =======================================
     MOBILE FILTER GROUPS
  ======================================= */

  .hilya-filter-drawer .hilya-filter-group {
    border-top: 1px solid rgb(0 0 0 / 9%);
  }

  .hilya-filter-drawer .hilya-filter-group:last-child {
    border-bottom: 1px solid rgb(0 0 0 / 9%);
  }

  .hilya-filter-drawer .hilya-filter-group__toggle,
  .hilya-filter-drawer .hilya-filter-group__content {
    padding-inline: 0;
  }

}

@media screen and (max-width: 749px) {
  .price {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .price__current,
  .price__compare {
    display: block;
  }

  .price__compare {
    text-decoration: line-through;
  }
}


/* =========================================
   VERY SMALL MOBILE
========================================= */

@media (max-width: 27rem) {

  .hilya-filters__mobile-bar {
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  }

  .hilya-filters__mobile-button {
    font-size: .58rem;
    letter-spacing: .07em;
  }

  .hilya-filters__mobile-results {
    font-size: .54rem;
  }

  .hilya-filters__sort--mobile {
    gap: .3rem;
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-label {
    font-size: .52rem;
  }

  .hilya-filters__sort--mobile .hilya-filters__sort-trigger {
    gap: .4rem;
    font-size: .52rem;
  }

}


/* =========================================
   REDUCED MOTION
========================================= */

@media (prefers-reduced-motion: reduce) {

  .hilya-filter-overlay,
  .hilya-filter-drawer,
  .hilya-filter-chevron,
  .hilya-filters__sort-chevron {
    transition: none;
  }

}

{% endstylesheet %}
