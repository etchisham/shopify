  transition:
    transform 320ms
    cubic-bezier(.22,.61,.36,1);
}


.hilya-filter-drawer.is-open {
  transform: translateX(0);
}


.hilya-filter-drawer__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 2rem 1.5rem 1.35rem;
  border-bottom: 1px solid rgb(0 0 0 / 8%);
}


.hilya-filter-drawer__eyebrow {
  display: block;
  margin-bottom: .45rem;
  color: var(--color-muted);
  font-size: .56rem;
  letter-spacing: .18em;
}


.hilya-filter-drawer__header h2 {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 400;
  letter-spacing: .08em;
}


.hilya-filter-drawer__close {
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-foreground);
  font-size: 1.8rem;
  font-weight: 300;
  line-height: 1;
  cursor: pointer;
}


.hilya-filter-drawer__content {
  padding: 0 1.5rem 2rem;
}


.hilya-filter-drawer .hilya-filter-group {
  border-top: 1px solid rgb(0 0 0 / 9%);
}


.hilya-filter-drawer .hilya-filter-group:last-child {
  border-bottom: 1px solid rgb(0 0 0 / 9%);
}


.hilya-filter-drawer
.hilya-filter-group__toggle,
.hilya-filter-drawer
.hilya-filter-group__content {
  padding-inline: 0;
}


.hilya-filter-lock {
  overflow: hidden;
}


/* =========================================
   DESKTOP
========================================= */

@media (min-width: 40.001rem) {

  .hilya-filter-sidebar {
    grid-area: sidebar;
    align-self: start;
    position: sticky;
    top: 96px;
  }


  .hilya-filters__products-toolbar {
    grid-area: toolbar;
  }


  .hilya-filters__mobile-bar,
  .hilya-filter-drawer,
  .hilya-filter-overlay {
    display: none !important;
  }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 40rem) {

  .hilya-filter-sidebar {
    display: none;
  }


  .hilya-filters__mobile-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    border-bottom: 1px solid rgb(0 0 0 / 9%);
  }


  .hilya-filters__mobile-button {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-size: .63rem;
    font-weight: 500;
    letter-spacing: .1em;
    cursor: pointer;
  }


  .hilya-filters__mobile-results {
    color: var(--color-muted);
    font-size: .58rem;
    letter-spacing: .07em;
  }


  .hilya-filters__products-toolbar {
    min-height: 2.85rem;
    margin-bottom: .65rem;
  }


  .hilya-filters__results {
    font-size: .58rem;
  }


  .hilya-filters__sort-label {
    display: none;
  }


  .hilya-filters__sort-trigger {
    min-width: 8.5rem;
    min-height: 2.2rem;
    font-size: .58rem;
  }


  .hilya-filters__sort-menu {
    width: 11rem;
  }


  .hilya-filter-chip {
    font-size: .57rem;
    padding: .36rem .44rem;
  }

}


/* =========================================
   REDUCED MOTION
========================================= */

@media (prefers-reduced-motion: reduce) {

  .hilya-filter-overlay,
  .hilya-filter-drawer,
  .hilya-filter-chevron,
  .hilya-filters__sort-chevron {
    transition: none;
  }

}

{% endstylesheet %}
