{% doc %}
  Hilya custom collection filters.
  Client-side filtering without Shopify Search & Discovery.
{% enddoc %}

<div class="hilya-filters">

  <!-- =========================================
       MOBILE FILTER / PRODUCTS / SORT BAR
  ========================================== -->

  <div class="hilya-filters__mobile-bar">

    <!-- FILTERS -->

    <button
  type="button"
  class="hilya-filters__mobile-button"
  data-filter-open
  aria-expanded="false"
  aria-controls="HilyaFilterDrawer"
>
  <span
    class="hilya-filters__filter-icon"
    aria-hidden="true"
  >
    <span></span>
    <span></span>
  </span>

  <span class="hilya-filters__filter-text">
    FILTERS
  </span>

  <span
    class="hilya-filters__count"
    data-filter-count
    hidden
  >
    0
  </span>
</button>



    <!-- PRODUCTS COUNT -->

    <span class="hilya-filters__mobile-results">

      <span data-filter-results>
        {{ collection.products_count }}
      </span>

      PRODUCTS

    </span>


    <!-- MOBILE SORT -->

    <div
      class="hilya-filters__sort hilya-filters__sort--mobile"
      data-hilya-sort-wrap
    >

      <span class="hilya-filters__sort-label">
        Sort by
      </span>


      {% assign current_sort = collection.sort_by | default: 'manual' %}


      <button
        type="button"
        class="hilya-filters__sort-trigger"
        data-hilya-sort-trigger
        aria-expanded="false"
        aria-haspopup="listbox"
      >

        <span data-hilya-sort-current>

          {% for option in collection.sort_options %}

            {% if option.value == current_sort %}

              {{ option.name }}

            {% endif %}

          {% endfor %}

        </span>


        <span
          class="hilya-filters__sort-chevron"
          aria-hidden="true"
        ></span>

      </button>


      <div
        class="hilya-filters__sort-menu"
        data-hilya-sort-menu
        role="listbox"
        hidden
      >

        {% for option in collection.sort_options %}

          <button
            type="button"
            class="hilya-filters__sort-option{% if option.value == current_sort %} is-selected{% endif %}"
            data-sort-value="{{ option.value | escape }}"
            role="option"
            aria-selected="{% if option.value == current_sort %}true{% else %}false{% endif %}"
          >

            <span>
              {{ option.name }}
            </span>

            <span
              class="hilya-filters__sort-check"
              aria-hidden="true"
            >
              ✓
            </span>

          </button>

        {% endfor %}

      </div>

    </div>

  </div>


  <!-- =========================================
       DESKTOP SIDEBAR
  ========================================== -->

  <aside class="hilya-filter-sidebar">

    <div class="hilya-filter-sidebar__heading">
      <h2>Filters</h2>
    </div>


    <!-- ACTIVE FILTERS -->

    <div
      class="hilya-filters__active"
      data-active-filters
      hidden
    >
    </div>


    <form
      class="hilya-filter-form"
      data-hilya-filter-form
    >

      <!-- =====================================
           AVAILABILITY
      ====================================== -->

      <div class="hilya-filter-group is-open">

        <button
          type="button"
          class="hilya-filter-group__toggle"
          data-filter-toggle
        >
          <span>Availability</span>
          <span
            class="hilya-filter-chevron"
            aria-hidden="true"
          ></span>
        </button>


        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="availability"
              value="in_stock"
            >

            <span>In stock</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="availability"
              value="out_of_stock"
            >

            <span>Out of stock</span>

          </label>

        </div>

      </div>


      <!-- =====================================
           PRICE
      ====================================== -->

      <div class="hilya-filter-group is-open">

        <button
          type="button"
          class="hilya-filter-group__toggle"
          data-filter-toggle
        >
          <span>Price</span>

          <span
            class="hilya-filter-chevron"
            aria-hidden="true"
          ></span>
        </button>


        <div class="hilya-filter-group__content">

          <div class="hilya-price-slider">

            <div class="hilya-price-slider__track"></div>

            <div
              class="hilya-price-slider__range"
              data-price-range
            ></div>


            <input
              type="range"
              name="price_min"
              min="0"
              max="1000"
              value="0"
              step="1"
              data-price-min
              aria-label="Minimum price"
            >

            <input
              type="range"
              name="price_max"
              min="0"
              max="1000"
              value="1000"
              step="1"
              data-price-max
              aria-label="Maximum price"
            >

          </div>


          <div class="hilya-price-values">

            <label class="hilya-price-input">

              <span>EGP</span>

              <input
                type="number"
                min="0"
                max="1000"
                step="1"
                value="0"
                inputmode="numeric"
                data-price-min-input
                aria-label="Minimum price"
              >

            </label>


            <span class="hilya-price-values__to">
              to
            </span>


            <label class="hilya-price-input hilya-price-input--max">

              <span>EGP</span>

              <input
                type="number"
                min="0"
                max="1000"
                step="1"
                value="1000"
                inputmode="numeric"
                data-price-max-input
                aria-label="Maximum price"
              >

            </label>

          </div>

        </div>

      </div>


      <!-- =====================================
           COLOR
      ====================================== -->

      <div class="hilya-filter-group is-open">

        <button
          type="button"
          class="hilya-filter-group__toggle"
          data-filter-toggle
        >
          <span>Color</span>

          <span
            class="hilya-filter-chevron"
            aria-hidden="true"
          ></span>
        </button>


        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="color"
              value="Gold Plated"
            >

            <span>Gold Plated</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="color"
              value="Silver Plated"
            >

            <span>Silver Plated</span>

          </label>

        </div>

      </div>


      <!-- =====================================
           PRODUCT TYPE
      ====================================== -->

      <div class="hilya-filter-group is-open">

        <button
          type="button"
          class="hilya-filter-group__toggle"
          data-filter-toggle
        >
          <span>Product Type</span>

          <span
            class="hilya-filter-chevron"
            aria-hidden="true"
          ></span>
        </button>


        <div class="hilya-filter-group__content">

          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="product_type"
              value="Necklaces"
            >

            <span>Necklaces</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="product_type"
              value="Rings"
            >

            <span>Rings</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="product_type"
              value="Pendants"
            >

            <span>Pendants</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="product_type"
              value="Bracelets"
            >

            <span>Bracelets</span>

          </label>


          <label class="hilya-filter-option">

            <input
              type="checkbox"
              name="product_type"
              value="Keychains"
            >

            <span>Keychains</span>

          </label>

        </div>

      </div>

    </form>

  </aside>


  <!-- =========================================
       MOBILE DRAWER
  ========================================== -->

  <div
    class="hilya-filter-overlay"
    data-filter-overlay
  ></div>


  <aside
    id="HilyaFilterDrawer"
    class="hilya-filter-drawer"
    data-filter-drawer
    aria-hidden="true"
  >

    <div class="hilya-filter-drawer__header">

      <div>

        <span class="hilya-filter-drawer__eyebrow">
          COLLECTION
        </span>

        <h2>
          FILTERS
        </h2>

      </div>


      <button
        type="button"
        class="hilya-filter-drawer__close"
        data-filter-close
        aria-label="Close filters"
      >
        ×
      </button>

    </div>


    <div class="hilya-filter-drawer__content">

      <div
        class="hilya-filters__active"
        data-active-filters-mobile
        hidden
      >
      </div>

      <div data-mobile-filter-content></div>

    </div>

  </aside>


  <!-- =========================================
       DESKTOP PRODUCTS / SORT TOOLBAR
  ========================================== -->

  <div class="hilya-filters__products-toolbar">

    <span class="hilya-filters__results">

      <span data-filter-results>
        {{ collection.products_count }}
      </span>

      PRODUCTS

    </span>


    <div
      class="hilya-filters__sort hilya-filters__sort--desktop"
      data-hilya-sort-wrap
    >

      <span class="hilya-filters__sort-label">
        Sort by
      </span>


      {% assign current_sort = collection.sort_by | default: 'manual' %}


      <button
        type="button"
        class="hilya-filters__sort-trigger"
        data-hilya-sort-trigger
        aria-expanded="false"
        aria-haspopup="listbox"
      >

        <span data-hilya-sort-current>

          {% for option in collection.sort_options %}

            {% if option.value == current_sort %}

              {{ option.name }}

            {% endif %}

          {% endfor %}

        </span>


        <span
          class="hilya-filters__sort-chevron"
          aria-hidden="true"
        ></span>

      </button>


      <div
        class="hilya-filters__sort-menu"
        data-hilya-sort-menu
        role="listbox"
        hidden
      >

        {% for option in collection.sort_options %}

          <button
            type="button"
            class="hilya-filters__sort-option{% if option.value == current_sort %} is-selected{% endif %}"
            data-sort-value="{{ option.value | escape }}"
            role="option"
            aria-selected="{% if option.value == current_sort %}true{% else %}false{% endif %}"
          >

            <span>
              {{ option.name }}
            </span>

            <span
              class="hilya-filters__sort-check"
              aria-hidden="true"
            >
              ✓
            </span>

          </button>

        {% endfor %}

      </div>

    </div>

  </div>

</div>


{% javascript %}

document.addEventListener('DOMContentLoaded', function () {

  const openButton =
    document.querySelector('[data-filter-open]');

  const closeButton =
    document.querySelector('[data-filter-close]');

  const drawer =
    document.querySelector('[data-filter-drawer]');

  const overlay =
    document.querySelector('[data-filter-overlay]');

  const form =
    document.querySelector('[data-hilya-filter-form]');

  const items =
    Array.from(
      document.querySelectorAll('[data-product-item]')
    );

  const resultsElements =
    document.querySelectorAll('[data-filter-results]');

  const countBadge =
    document.querySelector('[data-filter-count]');

  const activeFilters =
    document.querySelector('[data-active-filters]');

  const activeFiltersMobile =
    document.querySelector('[data-active-filters-mobile]');

  const mobileContent =
    document.querySelector('[data-mobile-filter-content]');


  if (!form) {
    return;
  }


  /* =========================================
     MOBILE DRAWER
  ========================================= */

  function openDrawer() {

    if (!drawer) {
      return;
    }

    drawer.classList.add('is-open');

    if (overlay) {
      overlay.classList.add('is-visible');
    }

    drawer.setAttribute(
      'aria-hidden',
      'false'
    );

    if (openButton) {
      openButton.setAttribute(
        'aria-expanded',
        'true'
      );
    }

    document.documentElement.classList.add(
      'hilya-filter-lock'
    );

  }


  function closeDrawer() {

    if (!drawer) {
      return;
    }

    drawer.classList.remove('is-open');

    if (overlay) {
      overlay.classList.remove('is-visible');
    }

    drawer.setAttribute(
      'aria-hidden',
      'true'
    );

    if (openButton) {
      openButton.setAttribute(
        'aria-expanded',
        'false'
      );
    }

    document.documentElement.classList.remove(
      'hilya-filter-lock'
    );

  }


  if (openButton) {

    openButton.addEventListener(
      'click',
      openDrawer
    );

  }


  if (closeButton) {

    closeButton.addEventListener(
      'click',
      closeDrawer
    );

  }


  if (overlay) {

    overlay.addEventListener(
      'click',
      closeDrawer
    );

  }


  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {
        closeDrawer();
      }

    }
  );


  /* =========================================
     MOVE FILTER CONTENT TO MOBILE
  ========================================= */

  if (mobileContent) {

    const filterGroups =
      form.querySelectorAll(
        '.hilya-filter-group'
      );

    filterGroups.forEach(function (group) {

      mobileContent.appendChild(
        group.cloneNode(true)
      );

    });

  }


  /* =========================================
     VARIANT IMAGE + PRICE
  ========================================= */

  function updateProductCard(item, color) {

    const dataElement =
      item.querySelector(
        '[data-variant-data]'
      );

    const card =
      item.querySelector(
        '[data-product-card]'
      );

    if (!dataElement || !card) {
      return;
    }


    let variants = [];

    try {

      variants =
        JSON.parse(
          dataElement.textContent
        );

    } catch (error) {

      return;

    }


    if (!color || color === 'all') {

      resetProductCard(item);

      return;

    }


    const wantedColor =
      color.trim().toLowerCase();


    const variant =
      variants.find(function (entry) {

        return (
          String(entry.color || '')
            .trim()
            .toLowerCase() ===
          wantedColor
        );

      });


    if (!variant) {

      resetProductCard(item);

      return;

    }


    /* PRICE */

    const priceElement =
      card.querySelector(
        '[data-product-price]'
      );


    if (
      priceElement &&
      variant.price !== undefined
    ) {

      priceElement.innerHTML =
        '<span class="price">' +
          '<span class="price__current">' +
            'EGP ' +
            Number(
              variant.price
            ).toLocaleString('en-US') +
          '</span>' +
        '</span>';

    }


    /* PRODUCT URL */

    const productLinks =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    productLinks.forEach(function (link) {

      if (variant.url) {

        link.setAttribute(
          'href',
          variant.url
        );

      }

    });


    /* IMAGES */

    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    const colorImages =
      Array.isArray(variant.images)
        ? variant.images
        : [];


    let primaryImage =
      null;

    let secondaryImage =
      null;


    if (
      variant.image &&
      variant.image.src
    ) {

      primaryImage =
        variant.image;

    }


    if (
      !primaryImage &&
      colorImages.length > 0
    ) {

      primaryImage =
        colorImages[0];

    }


    if (colorImages.length > 1) {

      const firstImageSrc =
        primaryImage
          ? primaryImage.src
          : null;


      secondaryImage =
        colorImages.find(function (image) {

          return (
            !firstImageSrc ||
            image.src !== firstImageSrc
          );

        });

    }


    if (
      !secondaryImage &&
      colorImages.length > 1
    ) {

      secondaryImage =
        colorImages[1];

    }


    if (primaryImage) {

      setLayerImage(
        primaryLayer,
        primaryImage
      );

    }


    if (secondaryImage) {

      setLayerImage(
        secondaryLayer,
        secondaryImage
      );

      if (secondaryLayer) {
        secondaryLayer.hidden = false;
      }

      card.classList.add(
        'product-card--has-secondary'
      );

    } else {

      if (secondaryLayer) {

        secondaryLayer.hidden = true;

        secondaryLayer.innerHTML = '';

      }

      card.classList.remove(
        'product-card--has-secondary'
      );

    }


    updateAvailabilityBadge(
      card,
      variant.available
    );

  }


  /* =========================================
     SET IMAGE
  ========================================= */

  function setLayerImage(layer, image) {

    if (
      !layer ||
      !image ||
      !image.src
    ) {
      return;
    }


    layer.innerHTML =
      '<img' +
      ' src="' +
      escapeAttribute(image.src) +
      '"' +
      ' alt="' +
      escapeAttribute(
        image.alt || ''
      ) +
      '"' +
      ' loading="lazy"' +
      ' width="1200"' +
      ' height="960"' +
      '>';

  }


  /* =========================================
     AVAILABILITY
  ========================================= */

  function updateAvailabilityBadge(
    card,
    available
  ) {

    const media =
      card.querySelector(
        '[data-product-media]'
      );

    if (!media) {
      return;
    }


    let badge =
      media.querySelector(
        '[data-variant-sold-out]'
      );


    if (available) {

      if (badge) {
        badge.remove();
      }

      return;

    }


    if (!badge) {

      badge =
        document.createElement(
          'span'
        );

      badge.className =
        'product-card__badge';

      badge.dataset.variantSoldOut =
        '';

      badge.textContent =
        'Sold out';

      media.appendChild(
        badge
      );

    }

  }


  /* =========================================
     RESET CARD
  ========================================= */

  function resetProductCard(item) {

    const card =
      item.querySelector(
        '[data-product-card]'
      );

    if (!card) {
      return;
    }


    const productPrice =
      item.dataset.productPrice;


    const priceElement =
      card.querySelector(
        '[data-product-price]'
      );


    if (
      priceElement &&
      productPrice !== undefined
    ) {

      priceElement.innerHTML =
        '<span class="price">' +
          '<span class="price__current">' +
            'EGP ' +
            Number(
              productPrice
            ).toLocaleString('en-US') +
          '</span>' +
        '</span>';

    }


    const links =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    links.forEach(function (link) {

      const originalUrl =
        link.dataset.originalUrl;

      if (originalUrl) {

        link.setAttribute(
          'href',
          originalUrl
        );

      }

    });


    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    if (primaryLayer) {

      const originalImage =
        primaryLayer.dataset.originalHtml;

      if (originalImage) {

        primaryLayer.innerHTML =
          originalImage;

      }

    }


    if (secondaryLayer) {

      const originalImage =
        secondaryLayer.dataset.originalHtml;

      if (originalImage) {

        secondaryLayer.innerHTML =
          originalImage;

        secondaryLayer.hidden =
          false;

      }

    }


    if (
      secondaryLayer &&
      !secondaryLayer.innerHTML.trim()
    ) {

      card.classList.remove(
        'product-card--has-secondary'
      );

    } else {

      card.classList.add(
        'product-card--has-secondary'
      );

    }


    const variantBadge =
      card.querySelector(
        '[data-variant-sold-out]'
      );


    if (variantBadge) {
      variantBadge.remove();
    }

  }


  /* =========================================
     ESCAPE
  ========================================= */

  function escapeAttribute(value) {

    return String(value)
      .replace(
        /&/g,
        '&amp;'
      )
      .replace(
        /"/g,
        '&quot;'
      )
      .replace(
        /</g,
        '&lt;'
      )
      .replace(
        />/g,
        '&gt;'
      );

  }


  /* =========================================
     STORE ORIGINAL CARD STATE
  ========================================= */

  items.forEach(function (item) {

    const card =
      item.querySelector(
        '[data-product-card]'
      );

    if (!card) {
      return;
    }


    const primaryLayer =
      card.querySelector(
        '[data-product-image-primary]'
      );

    const secondaryLayer =
      card.querySelector(
        '[data-product-image-secondary]'
      );


    const links =
      card.querySelectorAll(
        '[data-product-link], [data-product-media]'
      );


    links.forEach(function (link) {

      link.dataset.originalUrl =
        link.getAttribute('href') || '';

    });


    if (primaryLayer) {

      primaryLayer.dataset.originalHtml =
        primaryLayer.innerHTML;

    }


    if (secondaryLayer) {

      secondaryLayer.dataset.originalHtml =
        secondaryLayer.innerHTML;

    }

  });


  /* =========================================
     PRICE CONTROLS
  ========================================= */

  const desktopPriceMin =
    form.querySelector('[data-price-min]');

  const desktopPriceMax =
    form.querySelector('[data-price-max]');

  const desktopPriceMinInput =
    form.querySelector('[data-price-min-input]');

  const desktopPriceMaxInput =
    form.querySelector('[data-price-max-input]');

  const desktopPriceRange =
    form.querySelector('[data-price-range]');


  const mobilePriceMin =
    mobileContent
      ? mobileContent.querySelector(
          '[data-price-min]'
        )
      : null;

  const mobilePriceMax =
    mobileContent
      ? mobileContent.querySelector(
          '[data-price-max]'
        )
      : null;

  const mobilePriceMinInput =
    mobileContent
      ? mobileContent.querySelector(
          '[data-price-min-input]'
        )
      : null;

  const mobilePriceMaxInput =
    mobileContent
      ? mobileContent.querySelector(
          '[data-price-max-input]'
        )
      : null;

  const mobilePriceRange =
    mobileContent
      ? mobileContent.querySelector(
          '[data-price-range]'
        )
      : null;


  /* =========================================
     PRICE STATE
  ========================================= */

  let currentMinPrice = 0;
  let currentMaxPrice = 1000;


  function clampPrice(
    value,
    fallback
  ) {

    const number =
      Number(value);

    if (!Number.isFinite(number)) {
      return fallback;
    }

    return Math.min(
      1000,
      Math.max(
        0,
        Math.round(number)
      )
    );

  }


  function setPriceState(
    min,
    max,
    source
  ) {

    min =
      clampPrice(
        min,
        0
      );

    max =
      clampPrice(
        max,
        1000
      );


    if (min > max) {

      if (source === 'min') {
        max = min;
      } else {
        min = max;
      }

    }


    currentMinPrice =
      min;

    currentMaxPrice =
      max;


    syncPriceControls();

  }


  function syncPriceControls() {

    /* DESKTOP SLIDER */

    if (desktopPriceMin) {
      desktopPriceMin.value =
        currentMinPrice;
    }

    if (desktopPriceMax) {
      desktopPriceMax.value =
        currentMaxPrice;
    }


    /* DESKTOP INPUTS */

    if (desktopPriceMinInput) {
      desktopPriceMinInput.value =
        currentMinPrice;
    }

    if (desktopPriceMaxInput) {
      desktopPriceMaxInput.value =
        currentMaxPrice;
    }


    /* MOBILE SLIDER */

    if (mobilePriceMin) {
      mobilePriceMin.value =
        currentMinPrice;
    }

    if (mobilePriceMax) {
      mobilePriceMax.value =
        currentMaxPrice;
    }


    /* MOBILE INPUTS */

    if (mobilePriceMinInput) {
      mobilePriceMinInput.value =
        currentMinPrice;
    }

    if (mobilePriceMaxInput) {
      mobilePriceMaxInput.value =
        currentMaxPrice;
    }


    /* RANGE LINES */

    const minPercent =
      (currentMinPrice / 1000) * 100;

    const maxPercent =
      (currentMaxPrice / 1000) * 100;


    if (desktopPriceRange) {

      desktopPriceRange.style.left =
        minPercent + '%';

      desktopPriceRange.style.right =
        (100 - maxPercent) + '%';

    }


    if (mobilePriceRange) {

      mobilePriceRange.style.left =
        minPercent + '%';

      mobilePriceRange.style.right =
        (100 - maxPercent) + '%';

    }

  }


  /* =========================================
     PRICE CHANGE HANDLER
  ========================================= */

  function handlePriceSliderChange(
    type,
    value
  ) {

    if (type === 'min') {

      setPriceState(
        value,
        currentMaxPrice,
        'min'
      );

    } else {

      setPriceState(
        currentMinPrice,
        value,
        'max'
      );

    }


    applyFilters();

  }


  function handlePriceInputChange(
    type,
    value
  ) {

    if (type === 'min') {

      let min =
        clampPrice(
          value,
          0
        );


      if (min > currentMaxPrice) {
        min = currentMaxPrice;
      }


      setPriceState(
        min,
        currentMaxPrice,
        'min'
      );

    } else {

      let max =
        clampPrice(
          value,
          1000
        );


      if (max < currentMinPrice) {
        max = currentMinPrice;
      }


      setPriceState(
        currentMinPrice,
        max,
        'max'
      );

    }


    applyFilters();

  }


  /* =========================================
     DESKTOP PRICE EVENTS
  ========================================= */

  if (desktopPriceMin) {

    desktopPriceMin.addEventListener(
      'input',
      function () {

        handlePriceSliderChange(
          'min',
          this.value
        );

      }
    );

  }


  if (desktopPriceMax) {

    desktopPriceMax.addEventListener(
      'input',
      function () {

        handlePriceSliderChange(
          'max',
          this.value
        );

      }
    );

  }


  if (desktopPriceMinInput) {

    desktopPriceMinInput.addEventListener(
      'input',
      function () {

        handlePriceInputChange(
          'min',
          this.value
        );

      }
    );


    desktopPriceMinInput.addEventListener(
      'change',
      function () {

        handlePriceInputChange(
          'min',
          this.value
        );

      }
    );

  }


  if (desktopPriceMaxInput) {

    desktopPriceMaxInput.addEventListener(
      'input',
      function () {

        handlePriceInputChange(
          'max',
          this.value
        );

      }
    );


    desktopPriceMaxInput.addEventListener(
      'change',
      function () {

        handlePriceInputChange(
          'max',
          this.value
        );

      }
    );

  }


  /* =========================================
     MOBILE PRICE EVENTS
  ========================================= */

  if (mobilePriceMin) {

    mobilePriceMin.addEventListener(
      'input',
      function () {

        handlePriceSliderChange(
          'min',
          this.value
        );

      }
    );

  }


  if (mobilePriceMax) {

    mobilePriceMax.addEventListener(
      'input',
      function () {

        handlePriceSliderChange(
          'max',
          this.value
        );

      }
    );

  }


  if (mobilePriceMinInput) {

    mobilePriceMinInput.addEventListener(
      'input',
      function () {

        handlePriceInputChange(
          'min',
          this.value
        );

      }
    );


    mobilePriceMinInput.addEventListener(
      'change',
      function () {

        handlePriceInputChange(
          'min',
          this.value
        );

      }
    );

  }


  if (mobilePriceMaxInput) {

    mobilePriceMaxInput.addEventListener(
      'input',
      function () {

        handlePriceInputChange(
          'max',
          this.value
        );

      }
    );


    mobilePriceMaxInput.addEventListener(
      'change',
      function () {

        handlePriceInputChange(
          'max',
          this.value
        );

      }
    );

  }


  /* =========================================
     MOBILE PRICE INPUT
     CLOSE KEYBOARD ON ENTER
  ========================================= */

  function closeMobileKeyboardOnEnter(input) {

    if (!input) {
      return;
    }

    input.addEventListener(
      'keydown',
      function (event) {

        if (event.key !== 'Enter') {
          return;
        }

        event.preventDefault();

        input.dispatchEvent(
          new Event('change', {
            bubbles: true
          })
        );

        input.blur();

      }
    );

  }


  closeMobileKeyboardOnEnter(
    mobilePriceMinInput
  );

  closeMobileKeyboardOnEnter(
    mobilePriceMaxInput
  );


  /* =========================================
     INITIAL PRICE STATE
  ========================================= */

  setPriceState(
    desktopPriceMin
      ? desktopPriceMin.value
      : 0,

    desktopPriceMax
      ? desktopPriceMax.value
      : 1000,

    'initial'
  );


  /* =========================================
     CHECKED VALUES
  ========================================= */

  function getCheckedValues(name) {

    return Array.from(
      form.querySelectorAll(
        'input[name="' +
        name +
        '"]:checked'
      )
    ).map(function (input) {

      return input.value
        .trim()
        .toLowerCase();

    });

  }


  /* =========================================
     FILTER
  ========================================= */

  function applyFilters() {

    const availability =
      getCheckedValues(
        'availability'
      );

    const colors =
      getCheckedValues(
        'color'
      );

    const productTypes =
      getCheckedValues(
        'product_type'
      );


    const minPrice =
      currentMinPrice;

    const maxPrice =
      currentMaxPrice;


    let visibleCount = 0;


    items.forEach(function (item) {

      const itemType =
        (
          item.dataset.productType ||
          ''
        )
          .trim()
          .toLowerCase();


      const itemPrice =
        Number(
          item.dataset.productPrice ||
          0
        );


      const itemAvailable =
        item.dataset.productAvailable ===
        'true';


      const itemColors =
        (
          item.dataset.productColors ||
          ''
        )
          .toLowerCase()
          .split('|')
          .map(function (value) {
            return value.trim();
          })
          .filter(Boolean);


      let matches =
        true;


      /* AVAILABILITY */

      if (
        availability.length > 0
      ) {

        const matchesAvailability =
          availability.some(
            function (value) {

              if (
                value === 'in_stock'
              ) {

                return itemAvailable;

              }


              if (
                value === 'out_of_stock'
              ) {

                return !itemAvailable;

              }


              return false;

            }
          );


        if (
          !matchesAvailability
        ) {

          matches =
            false;

        }

      }


      /* COLOR */

      if (
        matches &&
        colors.length > 0
      ) {

        const matchesColor =
          colors.some(
            function (color) {

              return itemColors.includes(
                color
              );

            }
          );


        if (!matchesColor) {
          matches = false;
        }

      }


      /* PRODUCT TYPE */

      if (
        matches &&
        productTypes.length > 0
      ) {

        const matchesType =
          productTypes.includes(
            itemType
          );


        if (!matchesType) {
          matches = false;
        }

      }


      /* =====================================
         EFFECTIVE PRICE

         If one color is selected,
         use that variant's price.
      ===================================== */

      let effectivePrice =
        itemPrice;


      if (
        colors.length === 1
      ) {

        const dataElement =
          item.querySelector(
            '[data-variant-data]'
          );


        if (dataElement) {

          try {

            const variants =
              JSON.parse(
                dataElement.textContent
              );


            const selectedVariant =
              variants.find(
                function (variant) {

                  return (
                    String(
                      variant.color || ''
                    )
                      .trim()
                      .toLowerCase() ===
                    colors[0]
                  );

                }
              );


            if (
              selectedVariant &&
              selectedVariant.price !==
              undefined
            ) {

              effectivePrice =
                Number(
                  selectedVariant.price
                );

            }

          } catch (error) {}

        }

      }


      /* PRICE */

      if (
        effectivePrice <
        minPrice ||
        effectivePrice >
        maxPrice
      ) {

        matches =
          false;

      }


      /* DISPLAY */

      if (matches) {

        item.classList.remove(
          'is-filtered-out'
        );

        visibleCount++;


        if (
          colors.length === 1
        ) {

          updateProductCard(
            item,
            colors[0]
          );

        } else {

          resetProductCard(
            item
          );

        }

      } else {

        item.classList.add(
          'is-filtered-out'
        );

      }

    });


    /* RESULTS */

    resultsElements.forEach(
      function (element) {

        element.textContent =
          visibleCount;

      }
    );


    /* ACTIVE FILTER COUNT */

    const activeCount =
      availability.length +
      colors.length +
      productTypes.length +
      (
        minPrice > 0
          ? 1
          : 0
      ) +
      (
        maxPrice < 1000
          ? 1
          : 0
      );


    if (countBadge) {

      countBadge.textContent =
        activeCount;

      countBadge.hidden =
        activeCount === 0;

    }


    /* ACTIVE CHIPS */

    renderActiveFilters(
      availability,
      colors,
      productTypes,
      minPrice,
      maxPrice
    );

  }


  /* =========================================
     ACTIVE FILTER CHIPS
  ========================================= */

  function renderActiveFilters(
    availability,
    colors,
    productTypes,
    minPrice,
    maxPrice
  ) {

    const containers =
      [
        activeFilters,
        activeFiltersMobile
      ].filter(Boolean);


    containers.forEach(
      function (container) {

        container.innerHTML =
          '';


        const hasFilters =
          availability.length > 0 ||
          colors.length > 0 ||
          productTypes.length > 0 ||
          minPrice > 0 ||
          maxPrice < 1000;


        if (!hasFilters) {

          container.hidden =
            true;

          return;

        }


        container.hidden =
          false;


        const title =
          document.createElement(
            'span'
          );

        title.className =
          'hilya-filters__active-label';

        title.textContent =
          'FILTERED BY';

        container.appendChild(
          title
        );


        availability.forEach(
          function (value) {

            addChip(
              container,
              value === 'in_stock'
                ? 'In stock'
                : 'Out of stock',
              'availability',
              value
            );

          }
        );


        colors.forEach(
          function (value) {

            addChip(
              container,
              value.charAt(0).toUpperCase() +
                value.slice(1),
              'color',
              value
            );

          }
        );


        productTypes.forEach(
          function (value) {

            addChip(
              container,
              value.charAt(0).toUpperCase() +
                value.slice(1),
              'product_type',
              value
            );

          }
        );


        if (minPrice > 0) {

          addChip(
            container,
            'From EGP ' +
              minPrice.toLocaleString('en-US'),
            'price_min',
            '0'
          );

        }


        if (maxPrice < 1000) {

          addChip(
            container,
            'To EGP ' +
              maxPrice.toLocaleString('en-US'),
            'price_max',
            '1000'
          );

        }


        const clear =
          document.createElement(
            'button'
          );


        clear.type =
          'button';

        clear.className =
          'hilya-filters__clear';

        clear.textContent =
          'CLEAR ALL';


        clear.addEventListener(
          'click',
          clearFilters
        );


        container.appendChild(
          clear
        );

      }
    );

  }


  function addChip(
    container,
    label,
    inputName,
    inputValue
  ) {

    const chip =
      document.createElement(
        'button'
      );


    chip.type =
      'button';

    chip.className =
      'hilya-filter-chip';


    chip.innerHTML =
      '<span>' +
        escapeAttribute(label) +
      '</span>' +
      '<span class="hilya-filter-chip__remove" aria-hidden="true">' +
        '×' +
      '</span>';


    chip.setAttribute(
      'aria-label',
      'Remove ' + label
    );


    chip.addEventListener(
      'click',
      function () {

        /* PRICE MIN */

        if (
          inputName ===
          'price_min'
        ) {

          setPriceState(
            0,
            currentMaxPrice,
            'min'
          );

        }


        /* PRICE MAX */

        else if (
          inputName ===
          'price_max'
        ) {

          setPriceState(
            currentMinPrice,
            1000,
            'max'
          );

        }


        /* CHECKBOX */

        else if (inputName) {

          const inputs =
            form.querySelectorAll(
              'input[name="' +
              inputName +
              '"]'
            );


          inputs.forEach(
            function (input) {

              if (
                input.value
                  .trim()
                  .toLowerCase() ===
                String(inputValue)
                  .trim()
                  .toLowerCase()
              ) {

                input.checked =
                  false;

              }

            }
          );

        }


        syncMobileFilters();

        applyFilters();

      }
    );


    container.appendChild(
      chip
    );

  }


  /* =========================================
     SYNC MOBILE CHECKBOXES
  ========================================= */

  function syncMobileFilters() {

    if (!mobileContent) {
      return;
    }


    form
      .querySelectorAll(
        'input[type="checkbox"]'
      )
      .forEach(
        function (input) {

          const matching =
            mobileContent.querySelector(
              'input[name="' +
              input.name +
              '"][value="' +
              input.value +
              '"]'
            );


          if (matching) {

            matching.checked =
              input.checked;

          }

        }
      );


    syncPriceControls();

  }


  /* =========================================
     CLEAR
  ========================================= */

  function clearFilters() {

    form
      .querySelectorAll(
        'input[type="checkbox"]'
      )
      .forEach(
        function (input) {

          input.checked =
            false;

        }
      );


    setPriceState(
      0,
      1000,
      'initial'
    );


    if (mobileContent) {

      mobileContent
        .querySelectorAll(
          'input[type="checkbox"]'
        )
        .forEach(
          function (input) {

            input.checked =
              false;

          }
        );

    }


    applyFilters();

  }


  /* =========================================
     CHECKBOX EVENTS
  ========================================= */

  form.addEventListener(
    'change',
    function (event) {

      if (
        event.target.matches(
          'input[type="checkbox"]'
        )
      ) {

        if (mobileContent) {

          const matching =
            mobileContent.querySelector(
              'input[name="' +
              event.target.name +
              '"][value="' +
              event.target.value +
              '"]'
            );


          if (matching) {

            matching.checked =
              event.target.checked;

          }

        }


        applyFilters();

      }

    }
  );


  /* =========================================
     MOBILE CHECKBOX EVENTS
  ========================================= */

  if (mobileContent) {

    mobileContent.addEventListener(
      'change',
      function (event) {

        if (
          !event.target.matches(
            'input[type="checkbox"]'
          )
        ) {
          return;
        }


        const name =
          event.target.name;

        const value =
          event.target.value;


        const desktopInput =
          form.querySelector(
            'input[name="' +
            name +
            '"][value="' +
            value +
            '"]'
          );


        if (desktopInput) {

          desktopInput.checked =
            event.target.checked;

        }


        applyFilters();

      }
    );

  }


  /* =========================================
     SORT
  ========================================= */

  const sortWraps =
    document.querySelectorAll(
      '[data-hilya-sort-wrap]'
    );

  const sortTriggers =
    document.querySelectorAll(
      '[data-hilya-sort-trigger]'
    );

  const sortMenus =
    document.querySelectorAll(
      '[data-hilya-sort-menu]'
    );

  const sortOptions =
    document.querySelectorAll(
      '[data-sort-value]'
    );


  function closeSortMenus() {

    sortWraps.forEach(
      function (wrap) {

        wrap.classList.remove(
          'is-open'
        );

      }
    );


    sortTriggers.forEach(
      function (trigger) {

        trigger.setAttribute(
          'aria-expanded',
          'false'
        );

      }
    );


    sortMenus.forEach(
      function (menu) {

        menu.hidden =
          true;

      }
    );

  }


  function openSortMenu(
    targetWrap
  ) {

    closeSortMenus();


    const trigger =
      targetWrap.querySelector(
        '[data-hilya-sort-trigger]'
      );

    const menu =
      targetWrap.querySelector(
        '[data-hilya-sort-menu]'
      );


    if (
      !trigger ||
      !menu
    ) {
      return;
    }


    targetWrap.classList.add(
      'is-open'
    );


    trigger.setAttribute(
      'aria-expanded',
      'true'
    );


    menu.hidden =
      false;

  }


  sortTriggers.forEach(
    function (trigger) {

      trigger.addEventListener(
        'click',
        function (event) {

          event.stopPropagation();


          const wrap =
            trigger.closest(
              '[data-hilya-sort-wrap]'
            );


          const menu =
            wrap
              ? wrap.querySelector(
                  '[data-hilya-sort-menu]'
                )
              : null;


          if (!wrap || !menu) {
            return;
          }


          if (menu.hidden) {

            openSortMenu(
              wrap
            );

          } else {

            closeSortMenus();

          }

        }
      );

    }
  );


  sortOptions.forEach(
    function (option) {

      option.addEventListener(
        'click',
        function () {

          const value =
            option.getAttribute(
              'data-sort-value'
            );


          const url =
            new URL(
              window.location.href
            );


          url.searchParams.set(
            'sort_by',
            value
          );


          window.location.href =
            url.toString();

        }
      );

    }
  );


  document.addEventListener(
    'click',
    function (event) {

      const clickedSort =
        event.target.closest(
          '[data-hilya-sort-wrap]'
        );


      if (!clickedSort) {

        closeSortMenus();

      }

    }
  );


  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {

        closeSortMenus();

      }

    }
  );


  /* =========================================
     FILTER GROUP TOGGLES
  ========================================= */

  document.addEventListener(
    'click',
    function (event) {

      const toggle =
        event.target.closest(
          '[data-filter-toggle]'
        );


      if (!toggle) {
        return;
      }


      const group =
        toggle.closest(
          '.hilya-filter-group'
        );


      if (!group) {
        return;
      }


      group.classList.toggle(
        'is-open'
      );

    }
  );


  /* =========================================
     INITIAL FILTER
  ========================================= */

  syncPriceControls();

  applyFilters();

});


