  color: var(--color-muted);
  font-size: .66rem;
  font-weight: 400;
  letter-spacing: .035em;
  white-space: nowrap;
  text-transform: none;
}

.hilya-filters__sort-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: .9rem;
  min-width: auto;
  min-height: auto;
  padding: .15rem 0 .18rem;
  border: 0;
  border-bottom: 0 !important;
  border-radius: 0;
  background: transparent;
  color: var(--color-foreground);
  font: inherit;
  font-size: .68rem;
  font-weight: 400;
  text-align: left;
  cursor: pointer;
  box-shadow: none;
}

.hilya-filters__sort-trigger:hover {
  border-color: rgb(0 0 0 / 45%);
  border-bottom: 0 !important;
  background: transparent;
}

.hilya-filters__sort-chevron {
  position: relative;
  display: inline-block;
  width: .42rem;
  height: .42rem;
  flex: 0 0 auto;
  margin-top: -.18rem;
  border-right: 1px solid currentColor;
  border-bottom: 1px solid currentColor;
  transform: rotate(45deg);
  transition: transform 180ms ease;
}

.hilya-filters__sort.is-open .hilya-filters__sort-chevron {
  transform: rotate(225deg);
}

.hilya-filters__sort-menu {
  position: absolute;
  top: calc(100% + .45rem);
  right: 0;
  z-index: 30;
  width: 11rem;
  padding: .3rem 0;
  border: 1px solid rgb(0 0 0 / 12%);
  border-radius: 0;
  background: var(--color-background);
  box-shadow: 0 8px 24px rgb(0 0 0 / 8%);
}

.hilya-filters__sort-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: .6rem .7rem;
  border: 0;
  background: transparent;
  color: var(--color-foreground);
  font: inherit;
  font-size: .64rem;
  text-align: left;
  cursor: pointer;
}

.hilya-filters__sort-option:hover {
  background: rgb(0 0 0 / 4%);
}

.hilya-filters__sort-check {
  visibility: hidden;
  font-size: .7rem;
}

.hilya-filters__sort-option.is-selected .hilya-filters__sort-check {
  visibility: visible;
}


/* =========================================
   MOBILE OVERLAY
========================================= */

.hilya-filter-overlay {
  position: fixed;
  inset: 0;
  z-index: 100000;
  background: rgb(0 0 0 / 35%);
  opacity: 0;
  visibility: hidden;
  transition:
    opacity 260ms ease,
    visibility 260ms ease;
}

.hilya-filter-overlay.is-visible {
  opacity: 1;
  visibility: visible;
}


/* =========================================
   DESKTOP DRAWER DEFAULT
========================================= */

.hilya-filter-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100001;
  width: min(28rem, 92vw);
  overflow-y: auto;
  background: var(--color-background);
  transform: translateX(100%);
  transition: transform 320ms cubic-bezier(.22,.61,.36,1);
}

.hilya-filter-drawer.is-open {
  transform: translateX(0);
}


/* =========================================
   DESKTOP DRAWER HEADER
========================================= */

.hilya-filter-drawer__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 2rem 1.5rem 1.35rem;
  border-bottom: 1px solid rgb(0 0 0 / 8%);
}

.hilya-filter-drawer__eyebrow {
  display: block;
  margin-bottom: .45rem;
  color: var(--color-muted);
  font-size: .56rem;
  letter-spacing: .18em;
}

.hilya-filter-drawer__header h2 {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 400;
  letter-spacing: .08em;
}

.hilya-filter-drawer__close {
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-foreground);
  font-size: 1.8rem;
  font-weight: 300;
  line-height: 1;
  cursor: pointer;
}

.hilya-filter-drawer__content {
  padding: 0 1.5rem 2rem;
}

.hilya-filter-drawer .hilya-filter-group {
  border-top: 1px solid rgb(0 0 0 / 9%);
}

.hilya-filter-drawer .hilya-filter-group:last-child {
  border-bottom: 1px solid rgb(0 0 0 / 9%);
}

.hilya-filter-drawer .hilya-filter-group__toggle,
.hilya-filter-drawer .hilya-filter-group__content {
  padding-inline: 0;
}


/* =========================================
   DESKTOP
========================================= */

@media (min-width: 40.001rem) {

  .hilya-filter-sidebar {
    grid-area: sidebar;
    align-self: start;
    position: sticky;
    top: 96px;
