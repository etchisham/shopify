{% doc %}
  Renders a catalog toolbar, active filter chips, and modal side drawer.

  @param {object} filters - Shopify collection or search filters.
  @param {object} sort_options - Available Shopify sort options.
  @param {string} sort_by - Current sort value.
  @param {string} default_sort_by - Default sort value.
  @param {string} results_url - Form action URL.
  @param {string} clear_url - URL that removes all filters.
  @param {number} results_count - Current result count.
  @param {string} section_id - Unique section identifier.
  @param {string} [search_terms] - Search query to preserve.
  @param {boolean} [is_search] - Preserve product-only search scope.
{% enddoc %}

{% liquid
  assign active_filter_count = 0
  assign current_sort = sort_by | default: default_sort_by
  assign facets_id = 'FacetsDrawer-' | append: section_id

  for filter in filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size

    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor
%}


<div class="catalog-toolbar" data-catalog-toolbar>

  <div class="catalog-toolbar__left">

    {% if filters != blank %}

      <button
        class="catalog-toolbar__filter-button"
        type="button"
        aria-controls="{{ facets_id }}"
        aria-haspopup="dialog"
        data-facets-open
      >

        <span class="catalog-toolbar__filter-icon">
          {% render 'icon', name: 'filters' %}
        </span>

        <span class="catalog-toolbar__filter-label">
          {{ 'facets.all_filters' | t }}
        </span>

        {% if active_filter_count > 0 %}

          <span
            class="catalog-toolbar__count"
            aria-label="{{ 'facets.active_count' | t: count: active_filter_count | escape }}"
          >
            {{ active_filter_count }}
          </span>

        {% endif %}

      </button>

    {% endif %}

  </div>


  <div class="catalog-toolbar__right">

    <p
      class="catalog-toolbar__results"
      role="status"
    >
      {{ 'facets.items_count' | t: count: results_count }}
    </p>


    {% if sort_options.size > 1 %}

      <form
        class="catalog-toolbar__sort"
        action="{{ results_url | escape }}"
        method="get"
      >

        {% if search_terms != blank %}
          <input
            type="hidden"
            name="q"
            value="{{ search_terms | escape }}"
          >
        {% endif %}

        {% if is_search %}
          <input
            type="hidden"
            name="type"
            value="product"
          >
        {% endif %}


        {% for filter in filters %}

          {% for value in filter.active_values %}

            <input
              type="hidden"
              name="{{ value.param_name | escape }}"
              value="{{ value.value | escape }}"
            >

          {% endfor %}


          {% if filter.type == 'price_range' %}

            {% if filter.min_value.value != nil %}

              <input
                type="hidden"
                name="{{ filter.min_value.param_name | escape }}"
                value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
              >

            {% endif %}


            {% if filter.max_value.value != nil %}

              <input
                type="hidden"
                name="{{ filter.max_value.param_name | escape }}"
                value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
              >

            {% endif %}

          {% endif %}

        {% endfor %}


        <label
          class="catalog-toolbar__sort-label"
          for="SortBy-{{ section_id }}"
        >

          <span class="catalog-toolbar__sort-title">
            {{ 'collections.sort_by' | t }}
          </span>

          <span class="catalog-toolbar__sort-select-wrap">

            <select
              id="SortBy-{{ section_id }}"
              name="sort_by"
              onchange="this.form.submit()"
            >

              {% for option in sort_options %}

                <option
                  value="{{ option.value | escape }}"
                  {% if option.value == current_sort %}selected{% endif %}
                >
                  {{ option.name | escape }}
                </option>

              {% endfor %}

            </select>

            <span class="catalog-toolbar__sort-chevron">
              {% render 'icon', name: 'chevron' %}
            </span>

          </span>

        </label>


        <noscript>

          <button
            class="button"
            type="submit"
          >
            {{ 'collections.sort_by' | t }}
          </button>

        </noscript>

      </form>

    {% endif %}

  </div>

</div>


{% if active_filter_count > 0 %}

  <div
    class="active-facets"
    aria-label="{{ 'facets.active_count' | t: count: active_filter_count | escape }}"
  >

    {% for filter in filters %}

      {% for value in filter.active_values %}

        <a
          class="active-facets__pill"
          href="{{ value.url_to_remove | escape }}"
        >

          <span>
            {{ value.label | escape }}
          </span>

          <span aria-hidden="true">
            ×
          </span>

        </a>

      {% endfor %}


      {% if filter.type == 'price_range' %}

        {% if filter.min_value.value != nil or filter.max_value.value != nil %}

          <a
            class="active-facets__pill"
            href="{{ filter.url_to_remove | escape }}"
          >

            <span>

              {% if filter.min_value.value != nil %}
                {{ filter.min_value.value | money }}
              {% else %}
                {{ 0 | money }}
              {% endif %}

              –

              {% if filter.max_value.value != nil %}
                {{ filter.max_value.value | money }}
              {% else %}
                {{ filter.range_max | money }}
              {% endif %}

            </span>

            <span aria-hidden="true">
              ×
            </span>

          </a>

        {% endif %}

      {% endif %}

    {% endfor %}


    <a
      class="active-facets__clear"
      href="{{ clear_url | escape }}"
    >
      {{ 'facets.clear_all' | t }}
    </a>

  </div>

{% endif %}


{% if filters != blank %}

  <dialog
    class="facets-drawer"
    id="{{ facets_id }}"
    data-facets-dialog
  >

    <form
      class="facets-drawer__panel"
      action="{{ results_url | escape }}"
      method="get"
    >

      {% if search_terms != blank %}

        <input
          type="hidden"
          name="q"
          value="{{ search_terms | escape }}"
        >

      {% endif %}


      {% if is_search %}

        <input
          type="hidden"
          name="type"
          value="product"
        >

      {% endif %}


      {% if current_sort != blank %}

        <input
          type="hidden"
          name="sort_by"
          value="{{ current_sort | escape }}"
        >

      {% endif %}


      <header class="facets-drawer__header">

        <h2>
          {{ 'facets.all_filters' | t }}
        </h2>

        <button
          class="facets-drawer__close"
          type="button"
          aria-label="{{ 'accessibility.close_filters' | t | escape }}"
          data-facets-close
        >

          {% render 'icon', name: 'close' %}

        </button>

      </header>


      <div class="facets-drawer__body">

        {% for filter in filters %}

          <details
            class="facet"
            open
          >

            <summary>

              <span>
                {{ filter.label | escape }}
              </span>

              <span class="facet__chevron">
                {% render 'icon', name: 'chevron' %}
              </span>

            </summary>


            <div class="facet__content">

              {% case filter.type %}

                {% when 'boolean', 'list' %}

                  <ul
                    class="facet__values"
                    role="list"
                  >

                    {% for value in filter.values %}

                      {% assign value_id = 'Facet-' | append: section_id | append: '-' | append: filter.param_name | handleize | append: '-' | append: forloop.index %}

                      <li>

                        <input
                          id="{{ value_id }}"
                          type="checkbox"
                          name="{{ value.param_name | escape }}"
                          value="{{ value.value | escape }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >

                        <label for="{{ value_id }}">

                          <span>
                            {{ value.label | escape }}
                          </span>

                          <span class="facet__value-count">
                            {{ value.count }}
                          </span>

                        </label>

                      </li>

                    {% endfor %}

                  </ul>


                {% when 'price_range' %}

                  <div class="facet__price">

                    <label>

                      <span>
                        {{ 'facets.from' | t }}
                      </span>

                      <span class="facet__price-input">

                        <span aria-hidden="true">
                          EGP
                        </span>

                        <input
                          type="number"
                          name="{{ filter.min_value.param_name | escape }}"
                          value="{% if filter.min_value.value != nil %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          step="0.01"
                          inputmode="decimal"
                          aria-label="{{ 'facets.minimum_price' | t | escape }}"
                        >

                      </span>

                    </label>


                    <label>

                      <span>
                        {{ 'facets.to' | t }}
                      </span>

                      <span class="facet__price-input">

                        <span aria-hidden="true">
                          EGP
                        </span>

                        <input
                          type="number"
                          name="{{ filter.max_value.param_name | escape }}"
                          value="{% if filter.max_value.value != nil %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          step="0.01"
                          inputmode="decimal"
                          aria-label="{{ 'facets.maximum_price' | t | escape }}"
                        >

                      </span>

                    </label>

                  </div>

              {% endcase %}

            </div>

          </details>

        {% endfor %}

      </div>


      <footer class="facets-drawer__footer">

        {% if active_filter_count > 0 %}

          <a href="{{ clear_url | escape }}">
            {{ 'facets.clear_all' | t }}
          </a>

        {% endif %}

        <button
          class="button"
          type="submit"
        >
          {{ 'facets.apply' | t }}
        </button>

      </footer>

    </form>

  </dialog>

{% endif %}


{% stylesheet %}


/* =================================
   TOOLBAR
================================= */

.catalog-toolbar {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 1.5rem;

  min-height: 3.5rem;

  margin-block: 0;

  border-block: 1px solid rgb(0 0 0 / 8%);
}


/* =================================
   LEFT
================================= */

.catalog-toolbar__left {
  display: flex;

  align-items: center;
}


.catalog-toolbar__filter-button {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 0.55rem;

  min-height: 3.4rem;

  padding: 0;

  border: 0;

  background: transparent;

  color: var(--color-foreground);

  cursor: pointer;

  font-family: var(--font-body-family);

  font-size: 0.72rem;

  font-weight: 500;

  letter-spacing: 0.08em;

  text-transform: uppercase;
}


.catalog-toolbar__filter-button:hover {
  opacity: 0.62;
}


.catalog-toolbar__filter-icon,
.catalog-toolbar__filter-icon svg {
  width: 0.95rem;
  height: 0.95rem;
}


.catalog-toolbar__filter-icon svg,
.facets-drawer__close svg,
.facet__chevron svg,
.catalog-toolbar__sort-chevron svg {
  fill: none;

  stroke: currentcolor;

  stroke-linecap: round;

  stroke-linejoin: round;

  stroke-width: 1.6;
}


.catalog-toolbar__count {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-width: 1.15rem;

  height: 1.15rem;

  padding-inline: 0.25rem;

  border-radius: 50%;

  background: var(--color-foreground);

  color: var(--color-background);

  font-size: 0.58rem;

  font-weight: 600;

  letter-spacing: 0;
}


/* =================================
   RIGHT
================================= */

.catalog-toolbar__right {
  display: flex;

  align-items: center;

  justify-content: flex-end;

  gap: 1.5rem;
}


.catalog-toolbar__results {
  margin: 0;

  color: var(--color-muted);

  font-size: 0.68rem;

  font-weight: 400;

  letter-spacing: 0.06em;

  text-transform: uppercase;

  white-space: nowrap;
}


/* =================================
   SORT
================================= */

.catalog-toolbar__sort {
  display: flex;

  align-items: center;
}


.catalog-toolbar__sort-label {
  display: inline-flex;

  align-items: center;

  gap: 0.5rem;

  cursor: pointer;

  color: var(--color-foreground);

  font-size: 0.72rem;

  font-weight: 500;

  letter-spacing: 0.06em;

  text-transform: uppercase;
}


.catalog-toolbar__sort-title {
  color: var(--color-muted);
}


.catalog-toolbar__sort-select-wrap {
  position: relative;

  display: inline-flex;

  align-items: center;
}


.catalog-toolbar__sort select {
  min-height: 2.2rem;

  padding: 0 1.25rem 0 0;

  border: 0;

  outline: 0;

  background: transparent;

  color: var(--color-foreground);

  cursor: pointer;

  font: inherit;

  font-size: 0.72rem;

  font-weight: 500;

  letter-spacing: 0.06em;

  text-transform: uppercase;

  appearance: none;
}


.catalog-toolbar__sort-chevron {
  position: absolute;

  inset-inline-end: 0;

  top: 50%;

  display: flex;

  width: 0.65rem;

  height: 0.65rem;

  transform: translateY(-50%);

  pointer-events: none;
}


.catalog-toolbar__sort-chevron svg {
  width: 100%;
  height: 100%;
}


/* =================================
   ACTIVE FILTERS
================================= */

.active-facets {
  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: 0.5rem;

  margin-block-start: 0.9rem;

  margin-block-end: 1.25rem;
}


.active-facets__pill {
  display: inline-flex;

  align-items: center;

  gap: 0.5rem;

  min-height: 2rem;

  padding: 0.35rem 0.65rem;

  border: 1px solid rgb(0 0 0 / 10%);

  border-radius: 999px;

  color: var(--color-foreground);

  font-size: 0.68rem;

  letter-spacing: 0.03em;

  text-decoration: none;
}


.active-facets__pill:hover {
  background: var(--color-surface);
}


.active-facets__clear {
  color: var(--color-foreground);

  font-size: 0.68rem;

  font-weight: 500;

  letter-spacing: 0.04em;

  text-decoration: underline;

  text-underline-offset: 0.25em;
}


/* =================================
   DRAWER
================================= */

.facets-drawer {
  position: fixed;

  z-index: 100;

  inset-block: 0;

  inset-inline-start: 0;

  width: min(28rem, calc(100vw - 1.5rem));

  max-width: none;

  height: 100dvh;

  max-height: none;

  margin: 0;

  padding: 0;

  border: 0;

  background: transparent;

  color: var(--color-foreground);
}


.facets-drawer::backdrop {
  background: rgb(0 0 0 / 42%);
}


.facets-drawer__panel {
  display: grid;

  width: 100%;
  height: 100%;

  grid-template-rows: auto minmax(0, 1fr) auto;

  background: var(--color-background);

  box-shadow: 0.8rem 0 2.4rem rgb(0 0 0 / 12%);
}


[dir='rtl'] .facets-drawer__panel {
  box-shadow: -0.8rem 0 2.4rem rgb(0 0 0 / 12%);
}


/* =================================
   DRAWER HEADER / FOOTER
================================= */

.facets-drawer__header,
.facets-drawer__footer {
  display: flex;

  min-height: 4.5rem;

  align-items: center;

  justify-content: space-between;

  gap: 1rem;

  border-block-end: 1px solid rgb(0 0 0 / 8%);

  padding: 1rem 1.5rem;
}


.facets-drawer__header h2 {
  margin: 0;

  font-family: var(--font-body-family);

  font-size: 1.15rem;

  font-weight: 400;

  letter-spacing: 0.04em;

  text-transform: uppercase;
}


.facets-drawer__close {
  display: grid;

  width: 2.5rem;
  height: 2.5rem;

  place-items: center;

  padding: 0;

  border: 0;

  border-radius: 50%;

  background: transparent;

  color: inherit;

  cursor: pointer;
}


.facets-drawer__close:hover {
  background: var(--color-surface);
}


.facets-drawer__close svg {
  width: 1.1rem;
}


.facets-drawer__body {
  overflow-y: auto;

  overscroll-behavior: contain;

  padding-inline: 1.5rem;
}


/* =================================
   FACETS
================================= */

.facet {
  border-block-end: 1px solid rgb(0 0 0 / 8%);
}


.facet > summary {
  display: flex;

  min-height: 3.75rem;

  align-items: center;

  justify-content: space-between;

  gap: 1rem;

  cursor: pointer;

  font-size: 0.78rem;

  font-weight: 500;

  letter-spacing: 0.06em;

  text-transform: uppercase;

  list-style: none;
}


.facet > summary::-webkit-details-marker {
  display: none;
}


.facet__chevron {
  transition: transform 180ms ease;
}


.facet__chevron svg {
  width: 1rem;
}


.facet[open] .facet__chevron {
  transform: rotate(180deg);
}


.facet__content {
  padding-block: 0 1rem;
}


.facet__values {
  display: grid;

  gap: 0.15rem;

  margin: 0;

  padding: 0;

  list-style: none;
}


.facet__values li {
  position: relative;
}


.facet__values input {
  position: absolute;

  inset-block-start: 0.8rem;

  inset-inline-start: 0.15rem;

  width: 1rem;

  min-height: 1rem;

  accent-color: var(--color-foreground);
}


.facet__values label {
  display: flex;

  min-height: 2.6rem;

  align-items: center;

  justify-content: space-between;

  gap: 1rem;

  padding-inline-start: 1.8rem;

  cursor: pointer;

  font-size: 0.8rem;
}


.facet__values input:disabled + label {
  cursor: not-allowed;

  opacity: 0.45;
}


.facet__value-count {
  color: var(--color-muted);

  font-size: 0.72rem;
}


/* =================================
   PRICE
================================= */

.facet__price {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 0.75rem;
}


.facet__price label {
  display: grid;

  gap: 0.35rem;

  color: var(--color-muted);

  font-size: 0.7rem;

  letter-spacing: 0.04em;

  text-transform: uppercase;
}


.facet__price-input {
  display: grid;

  grid-template-columns: auto 1fr;

  align-items: center;

  gap: 0.4rem;

  min-height: 2.7rem;

  border: 1px solid rgb(0 0 0 / 12%);

  border-radius: 2px;

  padding-inline: 0.65rem;
}


.facet__price-input > span {
  color: var(--color-muted);

  font-size: 0.68rem;

  font-weight: 500;
}


.facet__price-input input {
  min-width: 0;

  width: 100%;

  padding: 0;

  border: 0;

  outline: 0;

  background: transparent;

  color: var(--color-foreground);

  font-size: 0.8rem;
}


/* =================================
   FOOTER
================================= */

.facets-drawer__footer {
  border-block-start: 1px solid rgb(0 0 0 / 8%);

  border-block-end: 0;

  padding: 1rem 1.5rem;
}


.facets-drawer__footer > a {
  margin-inline-end: auto;

  color: var(--color-foreground);

  font-size: 0.72rem;

  font-weight: 500;

  letter-spacing: 0.04em;

  text-decoration: underline;

  text-underline-offset: 0.25em;
}


.facets-drawer__footer .button {
  min-width: 8.5rem;

  border-radius: 0;

  font-size: 0.72rem;

  letter-spacing: 0.08em;

  text-transform: uppercase;
}


/* =================================
   MOBILE
================================= */

@media (max-width: 40rem) {

  .catalog-toolbar {
    min-height: 3.25rem;

    gap: 0.75rem;
  }


  .catalog-toolbar__filter-button {
    min-height: 3.15rem;

    font-size: 0.66rem;

    letter-spacing: 0.07em;
  }


  .catalog-toolbar__right {
    gap: 0.75rem;
  }


  .catalog-toolbar__results {
    display: none;
  }


  .catalog-toolbar__sort-label {
    gap: 0.3rem;

    font-size: 0.66rem;
  }


  .catalog-toolbar__sort-title {
    display: none;
  }


  .catalog-toolbar__sort select {
    max-width: 9.5rem;

    min-height: 2rem;

    padding-right: 1.1rem;

    font-size: 0.66rem;
  }


  .active-facets {
    margin-block-start: 0.75rem;

    margin-block-end: 1rem;
  }


  .active-facets__pill {
    min-height: 1.9rem;

    font-size: 0.64rem;
  }


  .facets-drawer {
    width: min(22rem, calc(100vw - 0.75rem));
  }


  .facets-drawer__header,
  .facets-drawer__footer {
    padding-inline: 1.15rem;
  }


  .facets-drawer__body {
    padding-inline: 1.15rem;
  }

}


/* =================================
   VERY SMALL MOBILE
================================= */

@media (max-width: 27rem) {

  .catalog-toolbar__filter-label {
    font-size: 0.62rem;
  }


  .catalog-toolbar__sort select {
    max-width: 8rem;

    font-size: 0.62rem;
  }

}


/* =================================
   REDUCED MOTION
================================= */

@media (prefers-reduced-motion: reduce) {

  .facet__chevron {
    transition: none;
  }

}

{% endstylesheet %}