{% liquid
  assign locale_root = request.locale.iso_code | split: '-' | first
  assign rtl_locales = 'ar,fa,he,ur' | split: ','
  assign text_direction = 'ltr'
  if rtl_locales contains locale_root
    assign text_direction = 'rtl'
  endif
%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ text_direction }}">
  <head>
    {% render 'css-variables' %}

    <script>document.documentElement.classList.remove('no-js');</script>

    {% unless settings.type_body_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'newsletter.js' | asset_url }}" defer="defer"></script>
    {{ 'quick-view.css' | asset_url | stylesheet_tag }}
    <script>
      window.hilyaQuickView = {
        root: {{ routes.root_url | json }},
        cartAddUrl: {{ routes.cart_add_url | json }},
        moneyFormat: {{ shop.money_format | json }},
        optionValues: {
          gold_plated: {{ 'products.option_values.gold_plated' | t | json }},
          silver_plated: {{ 'products.option_values.silver_plated' | t | json }}
        },
        optionNames: {
          color: {{ 'products.option_names.color' | t | json }},
          size: {{ 'products.option_names.size' | t | json }},
          material: {{ 'products.option_names.material' | t | json }}
        },
        text: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          quantity: {{ 'products.product.quantity' | t | json }}
          {%- if request.locale.iso_code contains 'ar' -%},
          title: "اختر الخيارات",
          close: "إغلاق",
          viewDetails: "عرض التفاصيل",
          decrease: "تقليل الكمية",
          increase: "زيادة الكمية",
          personalization: "التخصيص",
          required: "مطلوب",
          name: "الاسم",
          namePlaceholder: "اكتب الاسم",
          date: "التاريخ",
          letter: "الحرف",
          letterPlaceholder: "حرف واحد",
          letterError: "من فضلك اكتب حرفًا واحدًا (عربي أو إنجليزي).",
          loading: "جارٍ التحميل..."
          {%- endif -%}
        }
      };
    </script>
    <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>

    {% if request.page_type == 'product' %}
      {{ 'product.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'product.js' | asset_url }}" defer="defer"></script>
      {{ 'bought-together.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'bought-together.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    {% if request.page_type == 'index' %}
      {{ 'home.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'home.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    {% if request.page_type == 'page' and template.suffix == 'wishlist' %}
      {{ 'wishlist.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    {% render 'meta-tags' %}
    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link button" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-live-region></p>
    {% render 'support-widget' %}
  </body>
</html>
