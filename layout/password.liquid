{% liquid
  assign locale_root = request.locale.iso_code | split: '-' | first
  assign rtl_locales = 'ar,fa,he,ur' | split: ','
  assign text_direction = 'ltr'
  if rtl_locales contains locale_root
    assign text_direction = 'rtl'
  endif
%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ text_direction }}" data-theme-preference="{{ settings.default_color_mode }}">
  <head>
    {% render 'css-variables' %}
    <script>
      document.documentElement.classList.remove('no-js');
      try {
        const savedTheme = localStorage.getItem('theme-preference');
        const preferredTheme = savedTheme || {{ settings.default_color_mode | json }};
        document.documentElement.dataset.themePreference = preferredTheme;
        if (preferredTheme === 'light' || preferredTheme === 'dark') document.documentElement.dataset.theme = preferredTheme;
      } catch (error) {}
    </script>
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent" class="main-content">
      {{ content_for_layout }}
    </main>
  </body>
</html>
