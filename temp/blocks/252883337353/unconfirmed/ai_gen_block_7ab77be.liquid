{% doc %}
  @prompt
    i need a new custom collection 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    color: #171714;
  }

  .ai-custom-collection-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 28px 0;
  }

  .ai-custom-collection-{{ ai_gen_id }}__header {
    margin-bottom: 22px;
  }

  .ai-custom-collection-{{ ai_gen_id }}__title {
    margin: 0 0 8px;
    color: #171714;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.2;
  }

  .ai-custom-collection-{{ ai_gen_id }}__description {
    color: #625F58;
    line-height: 1.6;
  }

  .ai-custom-collection-{{ ai_gen_id }}__description p {
    margin: 0;
  }

  .ai-custom-collection-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-custom-collection-{{ ai_gen_id }}__card {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .ai-custom-collection-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 10px;
    background: #F4F0E8;
  }

  .ai-custom-collection-{{ ai_gen_id }}__media img,
  .ai-custom-collection-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-custom-collection-{{ ai_gen_id }}__details {
    padding-top: 12px;
  }

  .ai-custom-collection-{{ ai_gen_id }}__product-title {
    margin: 0 0 5px;
    color: #171714;
    font-size: 16px;
    line-height: 1.4;
  }

  .ai-custom-collection-{{ ai_gen_id }}__price {
    color: #625F58;
    font-size: 14px;
  }

  .ai-custom-collection-{{ ai_gen_id }}__empty {
    padding: 36px 20px;
    background: #F4F0E8;
    color: #625F58;
    text-align: center;
    border-radius: 10px;
    line-height: 1.6;
  }

  .ai-custom-collection-{{ ai_gen_id }}__empty p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-collection-{{ ai_gen_id }}__inner {
      width: 100%;
      padding: 20px 0;
    }

    .ai-custom-collection-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 12px;
    }
  }
{% endstyle %}

<div class="ai-custom-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-collection-{{ ai_gen_id }}__inner">
    {% if block.settings.collection != blank %}
      <div class="ai-custom-collection-{{ ai_gen_id }}__header">
        {% if block.settings.heading != blank %}
          <h2 class="ai-custom-collection-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
        {% else %}
          <h2 class="ai-custom-collection-{{ ai_gen_id }}__title">{{ block.settings.collection.title | escape }}</h2>
        {% endif %}
        {% if block.settings.show_description and block.settings.collection.description != blank %}
          <div class="ai-custom-collection-{{ ai_gen_id }}__description">{{ block.settings.collection.description }}</div>
        {% endif %}
      </div>

      {% if block.settings.collection.products_count > 0 %}
        <div class="ai-custom-collection-{{ ai_gen_id }}__grid">
          {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
            <a class="ai-custom-collection-{{ ai_gen_id }}__card" href="{{ product.url }}">
              <div class="ai-custom-collection-{{ ai_gen_id }}__media">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                  >
                {% else %}
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                {% endif %}
              </div>
              <div class="ai-custom-collection-{{ ai_gen_id }}__details">
                <h3 class="ai-custom-collection-{{ ai_gen_id }}__product-title">{{ product.title | escape }}</h3>
                <div class="ai-custom-collection-{{ ai_gen_id }}__price">{{ product.price | money }}</div>
              </div>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-custom-collection-{{ ai_gen_id }}__empty"><p>This collection has no products yet. Add products to the selected collection to display them here.</p></div>
      {% endif %}
    {% else %}
      <div class="ai-custom-collection-{{ ai_gen_id }}__empty"><p>Select a collection in the block settings to show its products.</p></div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Custom collection",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Custom collection"
    }
  ],
  "tag": null,
  "class": "custom-collection-block"
}
{% endschema %}