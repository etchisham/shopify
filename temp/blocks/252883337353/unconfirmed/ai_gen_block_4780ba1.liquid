{% doc %}
  @prompt
    <section class="new-arrivals-banner">
    
      <div class="new-arrivals-banner__image">
        {% if section.settings.image != blank %}
          {{ section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '640, 960, 1280, 1600, 2000, 2400',
              sizes: '100vw',
              loading: 'lazy'
          }}
        {% endif %}
      </div>
    
      <div class="new-arrivals-banner__overlay"></div>
    
      <div class="new-arrivals-banner__content">
    
        <p class="new-arrivals-banner__eyebrow">
          NEW ARRIVALS
        </p>
    
        <h2 class="new-arrivals-banner__heading">
          Fresh Pieces,<br>
          Four New Moments
        </h2>
    
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="new-arrivals-banner__button"
        >
          <span>EXPLORE NEW ARRIVALS</span>
          <span class="new-arrivals-banner__arrow">→</span>
        </a>
    
      </div>
    
    </section>
    
    {% stylesheet %}
    
    .new-arrivals-banner {
      position: relative;
      width: 100%;
      min-height: 620px;
      overflow: hidden;
      isolation: isolate;
      background: #eee;
    }
    
    .new-arrivals-banner__image,
    .new-arrivals-banner__overlay {
      position: absolute;
      inset: 0;
    }
    
    .new-arrivals-banner__image {
      z-index: -2;
    }
    
    .new-arrivals-banner__image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    .new-arrivals-banner__overlay {
      z-index: -1;
      background: rgba(0, 0, 0, 0.25);
    }
    
    .new-arrivals-banner__content {
      position: relative;
      z-index: 1;
    
      min-height: 620px;
      padding: 60px 40px;
    
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    
      text-align: center;
      color: #fff;
    }
    
    .new-arrivals-banner__eyebrow {
      margin: 0 0 18px;
    
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10px;
      line-height: 1;
      font-weight: 500;
      letter-spacing: 0.28em;
      text-transform: uppercase;
    
      color: #fff;
    }
    
    .new-arrivals-banner__heading {
      margin: 0;
    
      font-family:
        "Cormorant Garamond",
        "Bodoni Moda",
        "Didot",
        serif;
    
      font-size: clamp(42px, 5vw, 72px);
      line-height: 0.95;
      font-weight: 400;
      font-style: italic;
      letter-spacing: -0.01em;
    
      color: #fff;
    }
    
    .new-arrivals-banner__button {
      display: inline-flex;
      align-items: center;
      gap: 14px;
    
      margin-top: 32px;
      padding: 13px 20px;
    
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.75);
    
      text-decoration: none;
    
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10px;
      line-height: 1;
      font-weight: 500;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    
      transition:
        background 0.3s ease,
        color 0.3s ease,
        border-color 0.3s ease;
    }
    
    .new-arrivals-banner__button:hover {
      background: #fff;
      color: #111;
      border-color: #fff;
    }
    
    .new-arrivals-banner__arrow {
      font-size: 16px;
      line-height: 1;
      transition: transform 0.3s ease;
    }
    
    .new-arrivals-banner__button:hover .new-arrivals-banner__arrow {
      transform: translateX(4px);
    }
    
    
    /* MOBILE */
    
    @media (max-width: 749px) {
    
      .new-arrivals-banner {
        min-height: 560px;
      }
    
      .new-arrivals-banner__content {
        min-height: 560px;
        padding: 40px 24px;
      }
    
      .new-arrivals-banner__eyebrow {
        font-size: 8px;
        letter-spacing: 0.24em;
        margin-bottom: 15px;
      }
    
      .new-arrivals-banner__heading {
        font-size: clamp(38px, 11vw, 54px);
      }
    
      .new-arrivals-banner__button {
        margin-top: 28px;
        padding: 12px 17px;
        font-size: 9px;
      }
    
    }
    
    {% endstylesheet %}
    
    {% schema %}
    {
      "name": "New Arrivals",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ],
      "presets": [
        {
          "name": "New Arrivals"
        }
      ]
    }
    {% endschema %}
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-new-arrivals-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.banner_height }}px;
    overflow: hidden;
    isolation: isolate;
    background: #e8e5df;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__media,
  .ai-new-arrivals-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__media { z-index: -2; }
  .ai-new-arrivals-{{ ai_gen_id }}__media img,
  .ai-new-arrivals-{{ ai_gen_id }}__placeholder,
  .ai-new-arrivals-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ai-new-arrivals-{{ ai_gen_id }}__media img,
  .ai-new-arrivals-{{ ai_gen_id }}__placeholder svg { object-fit: cover; }
  .ai-new-arrivals-{{ ai_gen_id }}__placeholder { position: relative; }
  .ai-new-arrivals-{{ ai_gen_id }}__empty {
    position: absolute;
    inset: auto 16px 18px;
    color: #171714;
    text-align: center;
    font: 14px/1.4 sans-serif;
  }
  .ai-new-arrivals-{{ ai_gen_id }}__shade {
    z-index: -1;
    background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
  }
  .ai-new-arrivals-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    min-height: {{ block.settings.banner_height }}px;
    padding: 60px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
  }
  .ai-new-arrivals-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 18px;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
    font-size: 11px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: #fff;
  }
  .ai-new-arrivals-{{ ai_gen_id }}__heading {
    margin: 0;
    max-width: 18ch;
    font-family: {{ settings.type_heading_font.family }}, serif;
    font-size: clamp(40px, 5vw, {{ block.settings.heading_size }}px);
    line-height: .98;
    font-weight: 400;
    font-style: italic;
    color: #fff;
  }
  .ai-new-arrivals-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 32px;
    padding: 14px 20px;
    color: #fff;
    border: 1px solid rgba(255,255,255,.85);
    text-decoration: none;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
    font-size: 11px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    transition: background-color .2s ease, color .2s ease;
  }
  .ai-new-arrivals-{{ ai_gen_id }}__button:hover {
    background: #fff;
    color: #171714;
  }
  .ai-new-arrivals-{{ ai_gen_id }}__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }
  .ai-new-arrivals-{{ ai_gen_id }}__arrow { font-size: 18px; line-height: 1; }

  @media screen and (max-width: 749px) {
    .ai-new-arrivals-{{ ai_gen_id }},
    .ai-new-arrivals-{{ ai_gen_id }}__content { min-height: {{ block.settings.mobile_height }}px; }
    .ai-new-arrivals-{{ ai_gen_id }}__content { padding: 40px 24px; }
    .ai-new-arrivals-{{ ai_gen_id }}__eyebrow { font-size: 9px; margin-bottom: 15px; }
    .ai-new-arrivals-{{ ai_gen_id }}__heading { font-size: clamp(36px, 10vw, 54px); }
    .ai-new-arrivals-{{ ai_gen_id }}__button { margin-top: 28px; padding: 12px 16px; font-size: 10px; }
  }
{% endstyle %}

<section class="ai-new-arrivals-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-new-arrivals-{{ ai_gen_id }}__media">
    {% if block.settings.image != blank %}
      {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '640, 960, 1280, 1600, 2000, 2400', sizes: '100vw', loading: 'lazy', alt: block.settings.image.alt }}
    {% else %}
      <div class="ai-new-arrivals-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-new-arrivals-{{ ai_gen_id }}__empty">Choose a background image to complete this banner.</div>
      </div>
    {% endif %}
  </div>
  <div class="ai-new-arrivals-{{ ai_gen_id }}__shade" aria-hidden="true"></div>
  <div class="ai-new-arrivals-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}<p class="ai-new-arrivals-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h2 class="ai-new-arrivals-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>{% endif %}
    {% if block.settings.button_label != blank %}
      <a href="{% if block.settings.button_link != blank %}{{ block.settings.button_link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="ai-new-arrivals-{{ ai_gen_id }}__button">
        <span>{{ block.settings.button_label | escape }}</span><span class="ai-new-arrivals-{{ ai_gen_id }}__arrow" aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "New arrivals banner",
  "settings": [
    { "type": "header", "content": "Banner content" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Fresh Pieces,\nFour New Moments" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore new arrivals" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Layout and appearance" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "banner_height", "label": "Desktop height", "min": 400, "max": 800, "step": 20, "unit": "px", "default": 620 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 360, "max": 700, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 48, "max": 88, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay darkness", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 }
  ],
  "presets": [
    { "name": "New arrivals banner" }
  ],
  "tag": null,
  "class": "new-arrivals-banner-block"
}
{% endschema %}