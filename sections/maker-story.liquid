{%- liquid
  assign maker = product.metafields.custom.maker.value
  assign maker_name = maker.name.value | default: section.settings.name
  assign maker_location = maker.location.value | default: section.settings.location
  assign maker_image = maker.portrait.value | default: section.settings.image
  assign maker_story = maker.story
-%}
{%- if maker_name != blank or request.design_mode -%}
  <section class="fl-section full-width">
    <div class="fl-editorial-split fl-container--wide{% if section.settings.reverse %} fl-editorial-split--reverse{% endif %}">
      <div class="fl-editorial-split__media">
        {%- if maker_image != blank -%}
          {%- assign maker_alt = maker_image.alt | default: maker_name -%}
          {{ maker_image | image_url: width: 1600 | image_tag: widths: '640, 960, 1280, 1600', sizes: '(min-width: 640px) 50vw, 100vw', loading: 'lazy', alt: maker_alt }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="fl-editorial-split__content">
        <span class="fl-eyebrow">Maker{% if maker_location != blank %} · {{ maker_location }}{% endif %}</span>
        <h2>{{ maker_name | default: 'Add maker details' }}</h2>
        <div class="fl-editorial-split__text fl-richtext">
          {%- if maker_story != blank -%}{{ maker_story | metafield_tag }}{%- else -%}{{ section.settings.story }}{%- endif -%}
        </div>
        {%- if section.settings.link_label != blank -%}<a class="fl-button fl-button--secondary" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Maker story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Fallback portrait or studio image" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "text", "id": "name", "label": "Fallback maker name" },
    { "type": "text", "id": "location", "label": "Fallback location" },
    { "type": "richtext", "id": "story", "label": "Fallback story", "default": "<p>Connect this section to a maker metaobject for verified place, process, and material context.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Meet the maker" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Maker story" }]
}
{% endschema %}
