{% liquid
  assign locale_root = request.locale.iso_code | split: '-' | first
  assign kicker = section.settings.kicker_en
  assign before = section.settings.before_en
  assign highlight = section.settings.highlight_en
  assign after = section.settings.after_en
  assign button_label = section.settings.button_en
  if locale_root == 'ar'
    assign kicker = section.settings.kicker_ar | default: kicker
    assign before = section.settings.before_ar | default: before
    assign highlight = section.settings.highlight_ar | default: highlight
    assign after = section.settings.after_ar | default: after
    assign button_label = section.settings.button_ar | default: button_label
  endif
%}
<section class="home-statement full-width" style="--home-background: {{ section.settings.background }}; --home-foreground: {{ section.settings.foreground }}; --home-accent: {{ section.settings.accent }}; --statement-size: {{ section.settings.heading_size }}px; --statement-padding: {{ section.settings.padding }}px;">
  <div class="home-statement__inner">
    {% if kicker != blank %}<p class="home-statement__kicker">{{ kicker | escape }}</p>{% endif %}
    <h2 class="home-statement__heading">{{ before | escape }} {% if highlight != blank %}<span class="home-statement__highlight">{{ highlight | escape }}</span>{% endif %}{% if section.settings.line_break %}<br>{% else %} {% endif %}{{ after | escape }}</h2>
    {% if button_label != blank %}<a class="home-button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ button_label | escape }}</a>{% endif %}
  </div>
</section>
{% schema %}
{
  "name":"t:home.statement","enabled_on":{"templates":["index"]},
  "settings":[
    {"type":"text","id":"kicker_en","label":"t:labels.subheading_en","default":"A daily reminder of what matters"},
    {"type":"text","id":"kicker_ar","label":"t:labels.subheading_ar","default":"إلهام يرافقك كل يوم"},
    {"type":"text","id":"before_en","label":"t:home.before_en","default":"Find your"},
    {"type":"text","id":"before_ar","label":"t:home.before_ar","default":"اكتشف"},
    {"type":"text","id":"highlight_en","label":"t:home.highlight_en","default":"inspiration"},
    {"type":"text","id":"highlight_ar","label":"t:home.highlight_ar","default":"إلهامك"},
    {"type":"text","id":"after_en","label":"t:home.after_en","default":"Make it yours."},
    {"type":"text","id":"after_ar","label":"t:home.after_ar","default":"واجعل مساحتك تعبّر عنك."},
    {"type":"checkbox","id":"line_break","label":"t:home.line_break","default":true},
    {"type":"text","id":"button_en","label":"t:labels.button_label_en","default":"Shop all art"},
    {"type":"text","id":"button_ar","label":"t:labels.button_label_ar","default":"تسوّق كل اللوحات"},
    {"type":"url","id":"link","label":"t:labels.button_link"},
    {"type":"range","id":"heading_size","label":"t:labels.heading_size","min":32,"max":88,"step":4,"unit":"px","default":64},
    {"type":"range","id":"padding","label":"t:home.vertical_padding","min":32,"max":128,"step":8,"unit":"px","default":64},
    {"type":"color","id":"background","label":"t:labels.background","default":"#FFFFFF"},
    {"type":"color","id":"foreground","label":"t:labels.foreground","default":"#111111"},
    {"type":"color","id":"accent","label":"t:labels.accent","default":"#FF9E18"}
  ],"presets":[{"name":"t:home.statement"}]
}
{% endschema %}
