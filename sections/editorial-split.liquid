<section class="fl-section full-width">
  <div class="fl-editorial-split fl-container--wide{% if section.settings.reverse %} fl-editorial-split--reverse{% endif %}">
    <div class="fl-editorial-split__media">
      {%- if section.settings.image != blank -%}
        {%- assign image_alt = section.settings.image.alt | default: section.settings.heading -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '640, 960, 1280, 1600', sizes: '(min-width: 640px) 50vw, 100vw', loading: 'lazy', alt: image_alt }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="fl-editorial-split__content">
      {%- if section.settings.eyebrow != blank -%}<span class="fl-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="fl-editorial-split__text fl-richtext">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}<a class="fl-button fl-button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The current edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quiet forms. Lasting presence." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Objects chosen for proportion, material honesty, and the way they change a room without taking it over.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the edit" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Editorial split" }]
}
{% endschema %}
