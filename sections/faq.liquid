<section class="fl-section fl-section--surface full-width">
  <div class="fl-faq fl-container">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="fl-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="fl-section__intro">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.enable_search -%}
        <div class="fl-field" style="margin-top: var(--fl-space-6);">
          <label for="FaqSearch-{{ section.id }}">Search questions</label>
          <input id="FaqSearch-{{ section.id }}" class="fl-input" type="search" placeholder="Try delivery or care" data-faq-search="{{ section.id }}">
        </div>
      {%- endif -%}
    </div>
    <div class="fl-faq__items" data-faq-list="{{ section.id }}">
      {%- for block in section.blocks -%}
        <details class="fl-accordion" data-faq-item {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="fl-accordion__body fl-richtext">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered clearly" },
    { "type": "text", "id": "text", "label": "Supporting text", "default": "Keep product-specific objections near the product. Use this area for wider store questions." },
    { "type": "checkbox", "id": "enable_search", "label": "Enable question search", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I know an object will fit my room?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Every product page includes exact dimensions and an in-room scale image when available. Our team can help review placement before you order.</p>" }
      ]
    }
  ],
  "presets": [{
    "name": "FAQ",
    "blocks": [
      { "type": "question", "settings": { "question": "How do I know an object will fit my room?", "answer": "<p>Every product page includes exact dimensions and an in-room scale image when available. Our team can help review placement before you order.</p>" } },
      { "type": "question", "settings": { "question": "Where are pieces made?", "answer": "<p>Maker, origin, material, and process appear on each product page. We publish only details we can verify.</p>" } },
      { "type": "question", "settings": { "question": "What happens if an item arrives damaged?", "answer": "<p>Contact us with photos of the packaging and item. We will explain the replacement or refund path without sending you between sellers.</p>" } },
      { "type": "question", "settings": { "question": "Can I return an item?", "answer": "<p>Eligible items can be returned within the stated window. Product-specific exclusions and fees appear before purchase.</p>" } }
    ]
  }]
}
{% endschema %}
