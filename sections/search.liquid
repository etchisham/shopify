<section class="search-page section-spacing">
  <h1>{{ 'search.title' | t }}</h1>

  <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="SearchInput-{{ section.id }}">{{ 'search.placeholder' | t }}</label>
    <input id="SearchInput-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
    <button class="button" type="submit">{{ 'search.submit' | t }}</button>
  </form>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="search-page__message">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {% else %}
      <p class="search-page__message">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

      {% paginate search.results by 20 %}
        <div class="search-page__results">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}
              {% render 'product-card', product: result, sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw' %}
            {% else %}
              <article class="search-card">
                {% assign featured_image = result.image %}
                {% if featured_image %}
                  {% render 'image', image: featured_image, url: result.url, width: 800, widths: '320, 480, 640, 800', sizes: '(min-width: 768px) 33vw, 100vw' %}
                {% endif %}
                <p class="eyebrow">{{ result.object_type | capitalize }}</p>
                <h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2>
                <p class="muted">{{ result.content | strip_html | truncatewords: 24 }}</p>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        <div class="search-page__pagination">{{ paginate | default_pagination }}</div>
      {% endpaginate %}
    {% endif %}
  {% endif %}
</section>

{% stylesheet %}
  .search-page > h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }

  .search-page__form {
    display: flex;
    max-width: 44rem;
    gap: var(--space-2);
    margin-block: var(--space-5) var(--space-6);
  }

  .search-page__form input {
    min-width: 0;
  }

  .search-page__message {
    margin-block-end: var(--space-5);
  }

  .search-page__results {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--space-7) var(--grid-gap);
  }

  .search-card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .search-card .image {
    overflow: hidden;
    border-radius: var(--radius-large);
  }

  .search-card h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .search-page__pagination {
    margin-block-start: var(--space-7);
    text-align: center;
  }

  @media (max-width: 30rem) {
    .search-page__form {
      align-items: stretch;
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": []
}
{% endschema %}
