{% render 'catalog-styles' %}

<section class="catalog-page search-page full-width section-spacing">
  <div class="catalog-page__inner search-page__inner">

    <header class="search-page__header">
      <h1 class="search-page__title">
        {%- if search.performed and search.terms != blank -%}
          Results for "{{ search.terms | escape }}"
        {%- else -%}
          {{ 'search.title' | t }}
        {%- endif -%}
      </h1>

      <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <label class="visually-hidden" for="SearchInput-{{ section.id }}">{{ 'search.placeholder' | t }}</label>
        <input id="SearchInput-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
        <button class="search-page__submit" type="submit" aria-label="{{ 'search.submit' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
      </form>
    </header>

    {% if search.performed %}

      {% paginate search.results by 24 %}

        <div class="catalog-page__toolbar">
  {% render 'facets-toolbar',
    sort_options: search.sort_options,
    sort_by: search.sort_by,
    default_sort_by: search.default_sort_by,
    results_count: search.results_count
  %}
</div>

        {% if search.results_count == 0 %}
          <p class="search-page__empty">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
        {% else %}
          <div class="catalog-grid">
            {% for result in search.results %}
              {% if result.object_type == 'product' %}
                {% render 'catalog-product-item', product: result %}
              {% else %}
                <article class="search-card">
                  {% assign featured_image = result.image %}
                  {% if featured_image %}
                    {% render 'image', image: featured_image, url: result.url, width: 1000, widths: '320, 480, 640, 800, 1000', sizes: '(min-width: 1024px) 25vw, (min-width: 750px) 33vw, 50vw' %}
                  {% endif %}
                  <p class="eyebrow">{{ result.object_type | capitalize }}</p>
                  <h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2>
                  <p class="muted">{{ result.content | strip_html | truncatewords: 24 }}</p>
                </article>
              {% endif %}
            {% endfor %}
          </div>
          <div class="search-page__pagination catalog-page__pagination">{{ paginate | default_pagination }}</div>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .search-page__inner {
    width: 100%;
    padding-inline: clamp(1rem, 5.2vw, 6.25rem);
  }

  /* Page starts right under the header (the collection page pulls itself up) */
  .catalog-page.search-page {
    margin-top: 0;
  }

  /* Centered header: title, then a small search box */
  .search-page__header {
    grid-area: header;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    width: 100%;
    margin-inline: auto;
    margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
    text-align: center;
  }

  .search-page__title {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .search-page__form {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 24rem;
    height: 3.2rem;
    padding-inline: 1.1rem 0.4rem;
    border: 2px solid var(--color-foreground, #111);
    border-radius: 1.1rem;
    background: var(--color-background, #fffcf7);
  }

  .search-page__form input[type='search'] {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    color: inherit;
    font: inherit;
    font-size: 0.95rem;
    appearance: none;
    -webkit-appearance: none;
  }

  .search-page__form input[type='search']::-webkit-search-cancel-button {
    display: none;
  }

  .search-page__submit {
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .search-page__submit svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .search-card {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: var(--space-2);
  }

  .search-card .image {
    border-radius: var(--product-card-radius);
  }

  .search-card .image img {
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }

  .search-card h2 {
    margin: 0;
    overflow: hidden;
    font-family: var(--font-body-family);
    font-size: 1rem;
    letter-spacing: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-page__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
    margin-block-start: var(--space-7);
    text-align: center;
  }

  .search-page__pagination > * {
    display: inline-grid;
    min-width: 2.75rem;
    min-height: 2.75rem;
    place-items: center;
    border-radius: 999px;
    padding: 0.55rem;
  }

  .search-page__empty {
    grid-area: products;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-large);
    padding: var(--space-7);
    text-align: center;
  }

  @media (max-width: 40rem) {
    .search-page__inner {
      padding-inline: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": []
}
{% endschema %}
