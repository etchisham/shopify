{%- liquid
  assign story_locale = request.locale.iso_code | split: '-' | first

  assign story_eyebrow = section.settings.eyebrow
  assign story_line_1 = section.settings.heading_line_1
  assign story_line_2 = section.settings.heading_line_2
  assign story_description = section.settings.description
  assign story_button = section.settings.button_label
  assign story_alt = section.settings.image_alt

  if story_locale == 'ar'
    if section.settings.eyebrow_ar != blank
      assign story_eyebrow = section.settings.eyebrow_ar
    endif
    if section.settings.heading_line_1_ar != blank
      assign story_line_1 = section.settings.heading_line_1_ar
    endif
    if section.settings.heading_line_2_ar != blank
      assign story_line_2 = section.settings.heading_line_2_ar
    endif
    if section.settings.description_ar != blank
      assign story_description = section.settings.description_ar
    endif
    if section.settings.button_label_ar != blank
      assign story_button = section.settings.button_label_ar
    endif
    if section.settings.image_alt_ar != blank
      assign story_alt = section.settings.image_alt_ar
    endif
  endif
-%}

<section class="story-section">

  <div class="story-section__inner">

    <div class="story-section__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '(min-width: 750px) 60vw, 100vw',
            loading: 'lazy',
            alt: story_alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'story-section__placeholder' }}
      {% endif %}
    </div>
    

    <div class="story-section__content">

      {% if story_eyebrow != blank %}
        <p class="story-section__eyebrow">
          {{ story_eyebrow | escape }}
        </p>
      {% endif %}

      {% if story_line_1 != blank or story_line_2 != blank %}
        <h2 class="story-section__heading">
          {% if story_line_1 != blank %}
            <span>{{ story_line_1 | escape }}</span>
          {% endif %}

          {% if story_line_2 != blank %}
            <span>{{ story_line_2 | escape }}</span>
          {% endif %}
        </h2>
      {% endif %}

      {% if story_description != blank %}
        <div class="story-section__text">
          {{ story_description }}
        </div>
      {% endif %}

      {% if story_button != blank %}
        <a
          class="story-section__link"
          href="{{ section.settings.button_link | default: '#' }}"
        >
          <span>{{ story_button | escape }}</span>
          <span class="story-section__arrow" aria-hidden="true">→</span>
        </a>
      {% endif %}

    </div>

  </div>

</section>

{% stylesheet %}

.story-section {
  width: 100vw;
  max-width: 100vw;
  margin-inline: calc(50% - 50vw);
  padding: 35px max(24px, calc((100vw - 1400px) / 2)) 45px;
  box-sizing: border-box;
  background: #F7F4EE;
}

.story-section__inner {
  display: grid;
  grid-template-columns: 50% minmax(0, 1fr);
  align-items: center;
  gap: clamp(40px, 4vw, 65px);
}

/* IMAGE */

.story-section__media {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #f4f1eb;
}

.story-section__media img,
.story-section__placeholder {
  display: block;
  width: 100%;
  height: 100%;
  aspect-ratio: 2.15 / 1;
  object-fit: cover;
}

/* CONTENT */

.story-section__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 520px;
  padding: 20px 0;
}

/* EYEBROW */

.story-section__eyebrow {
  margin: 0 0 20px;
  color: #C8B28A;
  font-size: 10px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: .18em;
  text-transform: uppercase;
}

/* HEADING */

.story-section__heading {
  display: flex;
  flex-direction: column;
  margin: 0 0 28px;

  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: clamp(42px, 4.3vw, 64px);
  font-weight: 400;
  font-style: normal;
  line-height: .92;
  letter-spacing: -.025em;
}

.story-section__heading span {
  display: block;
}

/* TEXT */

.story-section__text {
  max-width: 380px;
  margin: 0 0 32px;
}

.story-section__text p {
  margin: 0;
  color: #8b8b8b;
  font-size: 13px;
  line-height: 1.8;
  font-weight: 400;
  letter-spacing: .01em;
}

.story-section__text strong {
  color: #111111;
  font-weight: 600;
}


/* LINK */

.story-section__link {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 8px;

  color: #111111;
  text-decoration: none;

  font-size: 10px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.story-section__arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  font-size: 13px;
  line-height: 1;
  margin-top: -1px;

  transition: transform .3s ease;
}

.story-section__link:hover .story-section__arrow {
  transform: translateX(4px);
}

/* LARGE DESKTOP */

@media (min-width: 1500px) {
  .story-section {
    padding-left: max(32px, calc((100vw - 1500px) / 2));
    padding-right: max(32px, calc((100vw - 1500px) / 2));
  }
}

/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {
  .story-section {
    padding: 25px 28px 0;
  }

  .story-section__inner {
    gap: 45px;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, .7fr);
  }

  .story-section__media img,
  .story-section__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  .story-section__heading {
    font-size: 46px;
  }

  .story-section__content {
    padding: 15px 0;
  }
}

/* MOBILE */

@media (max-width: 749px) {
  .story-section {
  width: 100vw;
  max-width: 100vw;
  margin-inline: calc(50% - 50vw);
  padding: 25px 16px 35px;
  background: #F7F4EE;
}

  .story-section__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* RECTANGULAR IMAGE */

  .story-section__media {
    width: 100%;
  }

  .story-section__media img,
  .story-section__placeholder {
    width: 100%;
    height: auto;
    aspect-ratio: 2.05 / 1;
    object-fit: cover;
  }

  .story-section__content {
    max-width: none;
    padding: 0 10px 10px;
  }

  .story-section__eyebrow {
    margin-bottom: 16px;
    font-size: 9px;
  }

  .story-section__heading {
    margin-bottom: 22px;
    font-size: 42px;
    line-height: .92;
    letter-spacing: -.025em;
  }

  .story-section__text {
    max-width: 340px;
    margin-bottom: 28px;
  }

  .story-section__text p {
    font-size: 12px;
    line-height: 1.75;
  }

  .story-section__link {
  font-size: 9px;
  gap: 6px;
  align-items: center;
}

.story-section__arrow {
  font-size: 12px;
  line-height: 1;
  position: relative;
  top: -2px;
}
}

/* ARABIC / RTL */

[dir="rtl"] .story-section__arrow {
  transform: scaleX(-1);
}

[dir="rtl"] .story-section__link:hover .story-section__arrow {
  transform: scaleX(-1) translateX(4px);
}

[dir="rtl"] .story-section__heading {
  line-height: 1.3;
}

[dir="rtl"] .story-section__eyebrow {
  font-size: 13px;
  line-height: 1.3;
}

[dir="rtl"] .story-section__text p {
  font-size: 15px;
  line-height: 1.9;
}

[dir="rtl"] .story-section__link {
  font-size: 13px;
}

@media (max-width: 749px) {
  [dir="rtl"] .story-section__eyebrow {
    font-size: 12px;
  }

  [dir="rtl"] .story-section__text p {
    font-size: 14px;
  }

  [dir="rtl"] .story-section__link {
    font-size: 12px;
  }
}

/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {
  .story-section__media img {
    transition: none;
  }

  .story-section__link:hover .story-section__arrow,
  [dir="rtl"] .story-section__link:hover .story-section__arrow {
    transform: none;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Special Offers",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Offer image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Hilya special offers"
    },
    {
      "type": "text",
      "id": "image_alt_ar",
      "label": "Image description - Arabic",
      "default": "عروض حلية الخاصة"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Special Offers"
    },
    {
      "type": "text",
      "id": "eyebrow_ar",
      "label": "Eyebrow - Arabic",
      "info": "Shown on the Arabic site. Leave blank to use the English text.",
      "default": "عرض خاص"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading - Line 1",
      "default": "Special Offers."
    },
    {
      "type": "text",
      "id": "heading_line_1_ar",
      "label": "Heading line 1 - Arabic",
      "default": "لفترة محدودة"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading - Line 2",
      "default": "Made for You."
    },
    {
      "type": "text",
      "id": "heading_line_2_ar",
      "label": "Heading line 2 - Arabic",
      "default": "خصم يصل إلى 30%"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover selected pieces at special prices, made to bring timeless elegance to your everyday style.</p>"
    },
    {
      "type": "richtext",
      "id": "description_ar",
      "label": "Description - Arabic",
      "default": "<p>اكتشف قطعًا مختارة بأسعار خاصة، لتمنح إطلالتك اليومية أناقة خالدة.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Offers"
    },
    {
      "type": "text",
      "id": "button_label_ar",
      "label": "Button label - Arabic",
      "default": "تسوق التخفيضات"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Special Offers"
    }
  ]
}
{% endschema %}

