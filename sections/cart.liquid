{% comment %}Shopify owns /cart. JavaScript sends old cart URLs to the storefront drawer.{% endcomment %}
<noscript>
  <section class="section-spacing">
    <h1>{{ 'cart.title' | t }}</h1>
    {% if cart.item_count > 0 %}
      <p>{{ 'cart.total' | t }}: {{ cart.total_price | money_with_currency }}</p>
      <form action="{{ routes.cart_url }}" method="post">
        <button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
      </form>
    {% else %}
      <p>{{ 'cart.empty' | t }}</p>
    {% endif %}
    <a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
  </section>
</noscript>

{% schema %}
{
  "name": "t:general.cart",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": []
}
{% endschema %}
