<section class="not-found section-spacing">
  <p class="eyebrow">404</p>
  <h1>{{ '404.title' | t }}</h1>
  <p class="muted">{{ '404.not_found' | t }}</p>
  <a class="button" href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a>
</section>

{% stylesheet %}
  .not-found {
    display: grid;
    min-height: 55svh;
    align-content: center;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .not-found h1 {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{ "name": "t:general.404", "settings": [] }
{% endschema %}
