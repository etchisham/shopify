{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="fl-section full-width">
  <div class="fl-container--wide">
    <div class="fl-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="fl-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p class="fl-section__intro">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="fl-product-benefits">
      {%- for block in section.blocks -%}
        <article class="fl-benefit" {{ block.shopify_attributes }}>
          <div class="fl-benefit__media">
            {%- if block.settings.image != blank -%}
              {%- assign benefit_alt = block.settings.image.alt | default: block.settings.heading -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '640, 900, 1200, 1600', sizes: '(min-width: 640px) 50vw, 100vw', loading: 'lazy', alt: benefit_alt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="fl-benefit__content">
            <span class="fl-eyebrow">0{{ forloop.index }}</span>
            <h3>{{ block.settings.heading }}</h3>
            <div class="fl-richtext">{{ block.settings.text }}</div>
            {%- if block.settings.proof != blank -%}<div class="fl-benefit__proof">{% render 'fl-icon', name: 'check' %} {{ block.settings.proof }}</div>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product benefits",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why it earns a place" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to live well" },
    { "type": "text", "id": "text", "label": "Supporting text", "default": "Pair every benefit with a material, process, measurement, or other evidence." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Proof image" },
        { "type": "text", "id": "heading", "label": "Outcome-led heading", "default": "Presence without noise" },
        { "type": "richtext", "id": "text", "label": "Explanation", "default": "<p>Explain what the piece changes for the customer, then name the form or material choice that creates the result.</p>" },
        { "type": "text", "id": "proof", "label": "Short proof point", "default": "Replace with a verified product fact" }
      ]
    }
  ],
  "presets": [{
    "name": "Product benefits",
    "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }]
  }]
}
{% endschema %}
