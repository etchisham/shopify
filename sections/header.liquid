{% if section.settings.sticky_header %}
  {% style %}
    #shopify-section-{{ section.id }} {
      position: sticky;
      z-index: 40;
      inset-block-start: 0;
    }
  {% endstyle %}
{% endif %}

<header
  class="site-header full-width"
  style="
    --header-background: {{ section.settings.background_color }};
    --header-color: {{ section.settings.text_color }};
    --header-border: {{ section.settings.border_color }};
    --header-desktop-height: {{ section.settings.desktop_height }}px;
    --header-mobile-height: {{ section.settings.mobile_height }}px;
    --header-desktop-padding: {{ section.settings.desktop_padding }}px;
  "
>

  <div class="site-header__inner">

    <!-- BRAND -->

    <a
      class="site-header__brand"
      href="{{ routes.root_url }}"
      aria-label="Hilya"
    >
      Hilya
    </a>


    <!-- DESKTOP NAVIGATION -->

    <nav
      class="desktop-navigation"
      aria-label="Main navigation"
    >

      <ul role="list">

        <li>
          <a href="{{ routes.root_url }}">
            Home
          </a>
        </li>


        <li class="desktop-navigation__dropdown">

          <button
            type="button"
            class="desktop-navigation__dropdown-trigger"
            aria-haspopup="true"
          >
            Categories
          </button>


          <div class="desktop-navigation__dropdown-menu">

            {% assign allowed_collections =
              'necklaces,rings,pendants,bracelets,keychains'
              | split: ','
            %}

            {% for handle in allowed_collections %}

              {% assign category = collections[handle] %}

              {% if category != blank %}

                <a href="{{ category.url }}">
                  {{ category.title | escape }}
                </a>

              {% endif %}

            {% endfor %}

          </div>

        </li>


        <li>
          <a href="{{ section.settings.contact_link | default: '/pages/contact' }}">
            Contact Us
          </a>
        </li>

      </ul>

    </nav>


    <!-- RIGHT ACTIONS -->

    <div class="site-header__actions">


      <!-- MENU -->

      <details
        class="header-menu"
        data-menu-drawer
        scroll-lock
      >

        <summary
          class="header-icon-button header-menu__toggle"
          aria-label="Open menu"
        >

          <span class="header-menu__open-icon">
            {% render 'icon', name: 'menu' %}
          </span>

          <span class="header-menu__close-icon">
            {% render 'icon', name: 'close' %}
          </span>

        </summary>


        <div class="header-menu__panel">

          <nav
            class="drawer-navigation"
            aria-label="Menu"
          >


            <!-- SHOP ALL -->

            <a
              class="drawer-navigation__main-link"
              href="{{ routes.all_products_collection_url }}"
            >

              <span>
                Shop All
              </span>

              <span aria-hidden="true">
                {% render 'icon', name: 'arrow' %}
              </span>

            </a>


            <!-- NEW ARRIVALS -->

            {% if section.settings.show_new_arrivals and section.settings.new_arrivals_link != blank %}

              <a
                class="drawer-navigation__main-link"
                href="{{ section.settings.new_arrivals_link }}"
              >

                <span>
                  New Arrivals
                </span>

                <span aria-hidden="true">
                  {% render 'icon', name: 'arrow' %}
                </span>

              </a>

            {% endif %}


            <!-- BEST SELLERS -->

            {% if section.settings.show_best_sellers and section.settings.best_sellers_link != blank %}

              <a
                class="drawer-navigation__main-link"
                href="{{ section.settings.best_sellers_link }}"
              >

                <span>
                  Best Sellers
                </span>

                <span aria-hidden="true">
                  {% render 'icon', name: 'arrow' %}
                </span>

              </a>

            {% endif %}


            <!-- OUR STORY -->

            {% if section.settings.show_our_story and section.settings.our_story_link != blank %}

              <a
                class="drawer-navigation__main-link"
                href="{{ section.settings.our_story_link }}"
              >

                <span>
                  Our Story
                </span>

                <span aria-hidden="true">
                  {% render 'icon', name: 'arrow' %}
                </span>

              </a>

            {% endif %}


            <!-- CATEGORIES -->

            <div class="drawer-navigation__section">

              <p class="drawer-navigation__heading">
                Categories
              </p>


              <ul
                class="drawer-navigation__categories"
                role="list"
              >

                {% assign allowed_collections =
                  'necklaces,rings,pendants,bracelets,keychains'
                  | split: ','
                %}

                {% for handle in allowed_collections %}

                  {% assign category = collections[handle] %}

                  {% if category != blank %}

                    <li>

                      <a href="{{ category.url }}">

                        <span>
                          {{ category.title | escape }}
                        </span>

                        <span aria-hidden="true">
                          {% render 'icon', name: 'arrow' %}
                        </span>

                      </a>

                    </li>

                  {% endif %}

                {% endfor %}

              </ul>

            </div>


            <!-- SHIPPING & RETURNS -->

            {% if section.settings.show_shipping_returns and section.settings.shipping_returns_page != blank %}

              <a
                class="drawer-navigation__main-link"
                href="{{ section.settings.shipping_returns_page.url }}"
              >

                <span>
                  Shipping & Returns
                </span>

                <span aria-hidden="true">
                  {% render 'icon', name: 'arrow' %}
                </span>

              </a>

            {% endif %}


            <!-- FAQ -->

            {% if section.settings.show_faq and section.settings.faq_page != blank %}

              <a
                class="drawer-navigation__main-link"
                href="{{ section.settings.faq_page.url }}"
              >

                <span>
                  FAQ
                </span>

                <span aria-hidden="true">
                  {% render 'icon', name: 'arrow' %}
                </span>

              </a>

            {% endif %}


            <!-- CONTACT -->

            <a
              class="drawer-navigation__main-link"
              href="{{ section.settings.contact_link | default: '/pages/contact' }}"
            >

              <span>
                Contact Us
              </span>

              <span aria-hidden="true">
                {% render 'icon', name: 'arrow' %}
              </span>

            </a>


            <!-- INSTAGRAM -->

            {% if section.settings.instagram_link != blank %}

              <a
                class="drawer-navigation__main-link drawer-navigation__instagram"
                href="{{ section.settings.instagram_link }}"
                target="_blank"
                rel="noopener"
              >

                <span>
                  Instagram
                </span>

                <span aria-hidden="true">
                  ↗
                </span>

              </a>

            {% endif %}


          </nav>

        </div>

      </details>


      <!-- SEARCH -->

      {% if section.settings.show_search %}

        <a
          class="header-icon-button site-header__search-icon"
          href="{{ routes.search_url }}"
          aria-label="Search"
        >

          {% render 'icon', name: 'search' %}

        </a>

      {% endif %}


      <!-- ACCOUNT -->

      {% if shop.customer_accounts_enabled and section.settings.show_account %}

        <a
          class="header-icon-button site-header__account"
          href="{{ routes.account_url }}"
          aria-label="Account"
        >

          {% render 'icon', name: 'account' %}

        </a>

      {% endif %}


      <!-- CART -->

      <a
        class="header-icon-button site-header__cart"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'general.cart' | t: count: cart.item_count | escape }}"
        data-cart-open
        aria-haspopup="dialog"
        aria-controls="CartDrawer"
        aria-expanded="false"
      >

        {% render 'icon', name: 'cart' %}

        <span
          class="site-header__cart-count"
          aria-hidden="true"
          data-cart-count
          {% if cart.item_count == 0 %}
            hidden
          {% endif %}
        >
          {{ cart.item_count }}
        </span>

      </a>

    </div>

  </div>

</header>


{% stylesheet %}


/* ========================================
   HEADER
======================================== */


.site-header {

  position:
    relative;

  z-index:
    40;

  width:
    100%;

  border-block-end:
    1px solid var(--header-border);

  background:
    var(--header-background);

  color:
    var(--header-color);

  font-family:
    Arial,
    Helvetica,
    sans-serif;

}


.site-header__inner {

  position:
    relative;

  display:
    flex;

  width:
    100%;

  min-height:
    var(--header-mobile-height);

  align-items:
    center;

  justify-content:
    space-between;

  padding-inline:
    1rem;

}


/* ========================================
   HILYA WORDMARK
======================================== */


.site-header__brand {

  position:
    relative;

  z-index:
    2;

  display:
    inline-block;

  color:
    var(--header-color);

  font-family:
    "Cormorant Garamond",
    "Bodoni Moda",
    "Didot",
    "Times New Roman",
    serif;

  font-size:
    2.25rem;

  font-style:
    italic;

  font-weight:
    600;

  letter-spacing:
    -0.075em;

  line-height:
    .8;

  text-decoration:
    none;

  white-space:
    nowrap;

  transition:
    opacity .25s ease,
    transform .25s ease;

}


.site-header__brand:hover {

  opacity:
    .72;

  transform:
    translateY(-1px);

}


/* ========================================
   DESKTOP NAVIGATION
======================================== */


.desktop-navigation {

  position:
    absolute;

  left:
    50%;

  top:
    50%;

  transform:
    translate(-50%, -50%);

}


.desktop-navigation > ul {

  display:
    flex;

  align-items:
    center;

  gap:
    2.35rem;

  margin:
    0;

  padding:
    0;

  list-style:
    none;

}


.desktop-navigation a,
.desktop-navigation__dropdown-trigger {

  position:
    relative;

  display:
    inline-flex;

  align-items:
    center;

  padding:
    0;

  border:
    0;

  background:
    transparent;

  color:
    inherit;

  cursor:
    pointer;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size:
    .72rem;

  font-weight:
    500;

  letter-spacing:
    .14em;

  line-height:
    1;

  text-decoration:
    none;

  text-transform:
    uppercase;

  white-space:
    nowrap;

}


.desktop-navigation a::after,
.desktop-navigation__dropdown-trigger::after {

  content:
    "";

  position:
    absolute;

  left:
    0;

  bottom:
    -7px;

  width:
    0;

  height:
    1px;

  background:
    currentColor;

  transition:
    width .25s ease;

}


.desktop-navigation a:hover::after,
.desktop-navigation__dropdown-trigger:hover::after {

  width:
    100%;

}


/* ========================================
   CATEGORY DROPDOWN
======================================== */


.desktop-navigation__dropdown {

  position:
    relative;

  padding-block:
    1.8rem;

}


.desktop-navigation__dropdown::after {

  content:
    "";

  position:
    absolute;

  left:
    50%;

  bottom:
    0;

  width:
    180px;

  height:
    20px;

  transform:
    translateX(-50%);

}


.desktop-navigation__dropdown-menu {

  position:
    absolute;

  top:
    calc(100% - .45rem);

  left:
    50%;

  min-width:
    185px;

  padding:
    10px 0;

  transform:
    translateX(-50%)
    translateY(8px);

  background:
    #ffffff;

  border:
    1px solid #eeeeee;

  box-shadow:
    0 15px 40px
    rgb(0 0 0 / 9%);

  opacity:
    0;

  visibility:
    hidden;

  pointer-events:
    none;

  transition:
    opacity .2s ease,
    transform .2s ease,
    visibility .2s ease;

}


.desktop-navigation__dropdown:hover
.desktop-navigation__dropdown-menu,
.desktop-navigation__dropdown:focus-within
.desktop-navigation__dropdown-menu {

  opacity:
    1;

  visibility:
    visible;

  pointer-events:
    auto;

  transform:
    translateX(-50%)
    translateY(0);

}


.desktop-navigation__dropdown-menu a {

  display:
    block;

  width:
    100%;

  padding:
    11px 20px;

  font-size:
    .67rem;

  letter-spacing:
    .12em;

}


.desktop-navigation__dropdown-menu a::after {

  display:
    none;

}


.desktop-navigation__dropdown-menu a:hover {

  background:
    #f7f4ee;

}


/* ========================================
   RIGHT ACTIONS
======================================== */


.site-header__actions {

  display:
    flex;

  align-items:
    center;

  justify-content:
    flex-end;

  gap:
    .15rem;

}


/* ========================================
   ICON BUTTONS
======================================== */


.header-icon-button {

  position:
    relative;

  display:
    inline-grid;

  width:
    2.55rem;

  min-width:
    2.55rem;

  height:
    2.55rem;

  place-items:
    center;

  border:
    0;

  background:
    transparent;

  color:
    inherit;

  cursor:
    pointer;

  text-decoration:
    none;

}


.header-icon-button:hover {

  background:
    rgb(0 0 0 / 4%);

}


.header-icon-button svg {

  width:
    1.18rem;

  height:
    1.18rem;

  fill:
    none;

  stroke:
    currentcolor;

  stroke-linecap:
    round;

  stroke-linejoin:
    round;

  stroke-width:
    1.45;

}


/* ========================================
   MENU
======================================== */


.header-menu {

  position:
    relative;

}


.header-menu > summary {

  list-style:
    none;

}


.header-menu > summary::-webkit-details-marker {

  display:
    none;

}


.header-menu__open-icon,
.header-menu__close-icon {

  display:
    inline-flex;

}


.header-menu[open]
.header-menu__open-icon {

  display:
    none;

}


.header-menu[open]
.header-menu__close-icon {

  display:
    inline-flex;

}


/* ========================================
   MENU PANEL
======================================== */


.header-menu__panel {

  position:
    absolute;

  z-index:
    100;

  top:
    calc(100% + 1.25rem);

  right:
    0;

  width:
    310px;

  max-width:
    calc(100vw - 2rem);

  max-height:
    calc(100svh - 100px);

  overflow-y:
    auto;

  background:
    var(--header-background);

  border:
    1px solid var(--header-border);

  box-shadow:
    0 18px 50px
    rgb(0 0 0 / 10%);

}


.drawer-navigation {

  display:
    flex;

  flex-direction:
    column;

  padding:
    1.15rem 1.4rem 1.35rem;

}


.drawer-navigation__main-link {

  display:
    flex;

  min-height:
    3.15rem;

  align-items:
    center;

  justify-content:
    space-between;

  color:
    inherit;

  font-size:
    .88rem;

  font-weight:
    500;

  letter-spacing:
    .03em;

  text-decoration:
    none;

  border-bottom:
    1px solid
    rgb(0 0 0 / 7%);

  transition:
    padding-left .2s ease,
    opacity .2s ease;

}


.drawer-navigation__main-link:hover {

  padding-left:
    .25rem;

  opacity:
    .65;

}


.drawer-navigation__main-link svg {

  width:
    13px;

  height:
    13px;

}


.drawer-navigation__section {

  padding:
    .65rem 0 .4rem;

}


.drawer-navigation__heading {

  margin:
    .75rem 0 .45rem;

  color:
    color-mix(
      in srgb,
      currentcolor 50%,
      transparent
    );

  font-size:
    .62rem;

  font-weight:
    600;

  letter-spacing:
    .17em;

  text-transform:
    uppercase;

}


.drawer-navigation__categories {

  display:
    grid;

  margin:
    0;

  padding:
    0;

  list-style:
    none;

}


.drawer-navigation__categories li {

  border-bottom:
    1px solid
    rgb(0 0 0 / 5%);

}


.drawer-navigation__categories a {

  display:
    flex;

  min-height:
    2.65rem;

  align-items:
    center;

  justify-content:
    space-between;

  padding:
    .25rem .15rem;

  color:
    inherit;

  font-size:
    .82rem;

  letter-spacing:
    .02em;

  text-decoration:
    none;

  transition:
    padding-left .2s ease,
    opacity .2s ease;

}


.drawer-navigation__categories a:hover {

  padding-left:
    .4rem;

  opacity:
    .65;

}


.drawer-navigation__categories svg {

  width:
    12px;

  height:
    12px;

}


.drawer-navigation__instagram {

  margin-top:
    .45rem;

  border-bottom:
    0;

}


/* ========================================
   CART COUNT
======================================== */


.site-header__cart-count {

  position:
    absolute;

  top:
    .1rem;

  right:
    .05rem;

  display:
    grid;

  min-width:
    .95rem;

  height:
    .95rem;

  place-items:
    center;

  border-radius:
    999px;

  background:
    var(--header-color);

  color:
    var(--header-background);

  font-size:
    .58rem;

  font-weight:
    700;

  line-height:
    1;

}


/* ========================================
   DESKTOP
======================================== */


@media (min-width: 61.875rem) {

  .site-header__inner {

    min-height:
      var(--header-desktop-height);

    padding-inline:
      var(--header-desktop-padding);

  }


  .site-header__brand {

    font-size:
      2.4rem;

  }


  .header-menu__panel {

    top:
      calc(100% + 1.25rem);

  }

}


/* ========================================
   TABLET / MOBILE
======================================== */


@media (max-width: 61.874rem) {

  .site-header__inner {

    padding-inline:
      .8rem;

  }


  .site-header__brand {

    font-size:
      2rem;

  }


  .desktop-navigation {

    display:
      none;

  }


  .header-menu__panel {

    position:
      fixed;

    top:
      var(--header-mobile-height);

    right:
      0;

    left:
      0;

    width:
      100%;

    max-width:
      none;

    max-height:
      calc(
        100svh -
        var(--header-mobile-height)
      );

    border-inline:
      0;

    border-block-start:
      1px solid var(--header-border);

  }


  .drawer-navigation {

    padding:
      1.5rem 1.5rem 2rem;

  }

}


/* ========================================
   SMALL MOBILE
======================================== */


@media (max-width: 30rem) {

  .site-header__inner {

    padding-inline:
      .45rem;

  }


  .site-header__brand {

    font-size:
      1.85rem;

  }


  .header-icon-button {

    width:
      2.3rem;

    min-width:
      2.3rem;

    height:
      2.3rem;

  }


  .header-icon-button svg {

    width:
      1.08rem;

    height:
      1.08rem;

  }


  .drawer-navigation {

    padding-inline:
      1.15rem;

  }

}

{% endstylesheet %}


{% schema %}

{
  "name": "Hilya Header",

  "enabled_on": {
    "groups": ["header"]
  },

  "settings": [

    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Us link"
    },


    {
      "type": "header",
      "content": "Menu Links"
    },


    {
      "type": "checkbox",
      "id": "show_new_arrivals",
      "label": "Show New Arrivals",
      "default": true
    },

    {
      "type": "url",
      "id": "new_arrivals_link",
      "label": "New Arrivals link"
    },


    {
      "type": "checkbox",
      "id": "show_best_sellers",
      "label": "Show Best Sellers",
      "default": true
    },

    {
      "type": "url",
      "id": "best_sellers_link",
      "label": "Best Sellers link"
    },


    {
      "type": "checkbox",
      "id": "show_our_story",
      "label": "Show Our Story",
      "default": true
    },

    {
      "type": "url",
      "id": "our_story_link",
      "label": "Our Story link"
    },


    {
      "type": "checkbox",
      "id": "show_shipping_returns",
      "label": "Show Shipping & Returns",
      "default": false
    },

    {
      "type": "page",
      "id": "shipping_returns_page",
      "label": "Shipping & Returns page"
    },


    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Show FAQ",
      "default": false
    },

    {
      "type": "page",
      "id": "faq_page",
      "label": "FAQ page"
    },


    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram URL"
    },


    {
      "type": "header",
      "content": "Header Options"
    },


    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
      "default": true
    },


    {
      "type": "header",
      "content": "Header Style"
    },


    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Foreground",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#EFEFEF"
    },


    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop header height",
      "min": 64,
      "max": 112,
      "step": 2,
      "unit": "px",
      "default": 84
    },


    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile header height",
      "min": 56,
      "max": 88,
      "step": 2,
      "unit": "px",
      "default": 72
    },


    {
      "type": "range",
      "id": "desktop_padding",
      "label": "Desktop horizontal padding",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    }

  ],


  "presets": [
    {
      "name": "Hilya Header"
    }
  ]

}

{% endschema %}