    {
      "type": "header",
      "content": "Returns"
    },

    {
      "type": "checkbox",
      "id": "show_returns",
      "label": "Show Returns",
      "default": false
    },

    {
      "type": "page",
      "id": "returns_page",
      "label": "Returns page"
    },


    {
      "type": "header",
      "content": "FAQ"
    },

    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Show FAQ",
      "default": false
    },

    {
      "type": "page",
      "id": "faq_page",
      "label": "FAQ page"
    },


    {
      "type": "header",
      "content": "Header settings"
    },

    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "sticky_header",
