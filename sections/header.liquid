{% style %}

@font-face {
  font-family: "Hilya Script";
  src: url("https://cdn.shopify.com/s/files/1/0785/2454/7209/files/allura-regular-webfont.woff2?v=1790688458") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
/* =========================================================
   HILYA HEADER
   ========================================================= */

.site-header {
  --header-bg: {{ section.settings.background_color }};
  --header-text: {{ section.settings.text_color }};
  --header-border: {{ section.settings.border_color }};
  --header-height: {{ section.settings.desktop_height }}px;
  --header-mobile-height: {{ section.settings.mobile_height }}px;
  --hilya-header-height: {{ section.settings.desktop_height }}px;

  width: 100vw !important;
  max-width: none !important;

  margin-left: calc(50% - 50vw) !important;
  margin-right: 0 !important;

  padding: 0 !important;

  background: var(--header-bg);
  color: var(--header-text);

  border-bottom: 1px solid var(--header-border);

  position: relative;
  z-index: 1000;

  box-sizing: border-box;
}

.site-header,
.site-header * {
  box-sizing: border-box;
}


/* =========================================================
   FIXED HEADER
   ========================================================= */

.site-header--sticky {
  position: fixed !important;

  top: 0 !important;
  left: 0 !important;
  right: 0 !important;

  width: 100vw !important;
  max-width: none !important;

  margin-left: 0 !important;
  margin-right: 0 !important;

  z-index: 99999 !important;
}


/* =========================================================
   RESERVE SPACE FOR FIXED HEADER
   ========================================================= */

body:has(.site-header--sticky) {
  padding-top: {{ section.settings.desktop_height }}px !important;
}

@media screen and (max-width: 749px) {
  body:has(.site-header--sticky) {
    padding-top: {{ section.settings.mobile_height }}px !important;
  }
}


/* =========================================================
   HEADER INNER
   ========================================================= */

.site-header__inner {
  width: 100% !important;
  max-width: none !important;

  height: var(--header-height);

  margin: 0 !important;

  padding-left: {{ section.settings.desktop_padding }}px;
  padding-right: {{ section.settings.desktop_padding }}px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  position: relative;
}


/* =========================================================
   HILYA BRAND
   Elegant Script / Luxury Wordmark
   ========================================================= */

.site-header__brand {
  position: relative;
  z-index: 20;

  color: var(--header-text);
  text-decoration: none;

  font-family: "Hilya Script", cursive;

  font-size: 2.7rem;

  font-style: normal;
  font-weight: 400;

  letter-spacing: 0;

  line-height: 1;

  white-space: nowrap;

  transform: translateY(-1px);
}

.site-header__brand:hover {
  color: var(--header-text);
}


/* =========================================================
   DESKTOP NAV
   ========================================================= */

.desktop-nav {
  position: absolute;

  left: 50%;
  top: 50%;

  transform: translate(-50%, -50%);

  height: 100%;

  display: flex;
  align-items: center;

  gap: 30px;

  z-index: 15;
}

.desktop-nav > a {
  color: var(--header-text);
  text-decoration: none;

  font-size: 0.78rem;
  font-weight: 500;

  letter-spacing: 0.08em;
  text-transform: uppercase;

  white-space: nowrap;

  height: 100%;

  display: flex;
  align-items: center;
}

.desktop-nav > a:hover {
  opacity: 0.65;
}


/* =========================================================
   DESKTOP MENU + CATEGORIES
   HOVER ONLY
   ========================================================= */

.desktop-menu,
.desktop-categories {
  position: relative;

  height: 100%;

  display: flex;
  align-items: center;
}


/* =========================================================
   DESKTOP TRIGGERS
   ========================================================= */

.desktop-menu__trigger,
.desktop-categories__trigger {
  appearance: none;
  -webkit-appearance: none;

  border: 0;
  outline: 0;

  margin: 0;
  padding: 0;

  background: transparent;

  color: var(--header-text);

  font-family: inherit;

  cursor: default;
}

.desktop-menu__trigger {
  height: 100%;

  display: flex;
  align-items: center;
}

.desktop-categories__trigger {
  height: 100%;

  display: flex;
  align-items: center;

  font-size: 0.78rem;
  font-weight: 500;

  letter-spacing: 0.08em;
  text-transform: uppercase;

  white-space: nowrap;
}


/* =========================================================
   DESKTOP HAMBURGER
   ========================================================= */

.desktop-menu__icon {
  width: 18px;
  height: 14px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  pointer-events: none;
}

.desktop-menu__icon span {
  width: 100%;
  height: 1px;

  display: block;

  background: currentColor;
}


/* =========================================================
   DESKTOP DROPDOWN
   ========================================================= */

.desktop-dropdown {
  position: absolute;

  top: 100%;
  left: 50%;

  transform: translateX(-50%) translateY(8px);

  min-width: 195px;

  padding: 14px 0;

  background: var(--header-bg);

  border: 1px solid var(--header-border);

  box-shadow:
    0 12px 30px rgba(0, 0, 0, 0.07);

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transition:
    opacity 0.18s ease,
    transform 0.18s ease,
    visibility 0.18s ease;

  z-index: 2000;
}

.desktop-dropdown a {
  display: block;

  padding: 9px 20px;

  color: var(--header-text);

  text-decoration: none;

  font-size: 0.76rem;
  font-weight: 500;

  letter-spacing: 0.06em;

  text-transform: uppercase;

  white-space: nowrap;
}

.desktop-dropdown a:hover {
  background: rgba(0, 0, 0, 0.035);
}


/* =========================================================
   DESKTOP HOVER ONLY
   ========================================================= */

@media screen and (min-width: 750px) {

  .desktop-menu:hover .desktop-dropdown,
  .desktop-categories:hover .desktop-dropdown {

    opacity: 1;

    visibility: visible;

    pointer-events: auto;

    transform:
      translateX(-50%)
      translateY(0);
  }

}


/* =========================================================
   RIGHT ACTIONS
   ========================================================= */

.header-actions {
  margin-left: auto;

  display: flex;
  align-items: center;

  gap: 17px;

  position: relative;

  z-index: 20;
}

.header-action {
  color: var(--header-text);

  text-decoration: none;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;
}

.header-action svg {
  width: 18px;
  height: 18px;

  stroke: currentColor;
}

.cart-count {
  position: absolute;

  top: -8px;
  right: -9px;

  min-width: 15px;
  height: 15px;

  padding: 0 3px;

  border-radius: 50%;

  background: var(--header-text);
  color: var(--header-bg);

  font-size: 9px;
  line-height: 15px;

  text-align: center;
}


/* =========================================================
   SEARCH
   ========================================================= */

.header-search {
  position: relative;
}

.header-search summary {
  list-style: none;
  cursor: pointer;
}

.header-search summary::-webkit-details-marker {
  display: none;
}


/* Search box */

.header-search__panel {
  position: absolute;

  right: 0;
  top: calc(100% + 18px);

  width: 270px;

  padding: 12px;

  background: var(--header-bg);

  border: 1px solid var(--header-border);

  box-shadow:
    0 12px 30px rgba(0, 0, 0, 0.07);

  z-index: 3000;
}

.header-search__form {
  display: flex;
  align-items: center;

  gap: 8px;
}

.header-search__input {
  flex: 1;

  min-width: 0;

  height: 38px;

  padding: 0 11px;

  border: 1px solid var(--header-border);

  background: transparent;

  color: var(--header-text);

  outline: none;

  font-size: 0.78rem;
}

.header-search__input::placeholder {
  color: var(--header-text);
  opacity: 0.55;
}


/* =========================================================
   SEARCH SUBMIT BUTTON
   ========================================================= */

.header-search__submit {
  width: 38px;
  height: 38px;

  border: 0;

  background: transparent;

  color: #000000ff;

  display: flex;
  align-items: center;
  justify-content: center;

  cursor: pointer;

  padding: 0;
}

.header-search__submit svg {
  width: 18px;
  height: 18px;

  stroke: currentColor;

  fill: none;

  stroke-width: 1.5;

  stroke-linecap: round;
  stroke-linejoin: round;
}


/* =========================================================
   MOBILE MENU
   ========================================================= */

.mobile-menu {
  display: none;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .site-header {
    --hilya-header-height: {{ section.settings.mobile_height }}px;

    width: 100vw !important;
    max-width: none !important;

    margin-left: 0 !important;
    margin-right: 0 !important;
  }


  .site-header__inner {
    width: 100% !important;
    max-width: none !important;

    height: var(--header-mobile-height);

    padding-left: 16px;
    padding-right: 16px;
  }


  /* =======================================================
     MOBILE BRAND
     ======================================================= */

  .site-header__brand {
  position: absolute;

  left: 50%;
  top: 50%;

  transform:
    translate(-50%, -50%)
    translateY(-1px);

  font-family: "Hilya Script", cursive;

  font-size: 2.15rem;

  font-style: normal;
  font-weight: 400;

  letter-spacing: 0;
}


  /* =======================================================
     HIDE DESKTOP NAV
     ======================================================= */

  .desktop-nav {
    display: none;
  }


  /* =======================================================
     MOBILE MENU
     ======================================================= */

  .mobile-menu {
    display: block;

    position: static;

    z-index: 100000;
  }


  .mobile-menu summary {
    list-style: none;

    width: 22px;
    height: 18px;

    padding: 0;
    margin: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    position: relative;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }


  /* =======================================================
     MOBILE HAMBURGER / X
     ======================================================= */

  .mobile-menu__icon {
    width: 21px;
    height: 16px;

    display: flex;
    flex-direction: column;

    justify-content: space-between;

    position: relative;
  }

  .mobile-menu__icon span {
    width: 100%;
    height: 1px;

    display: block;

    background: currentColor;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;

    transform-origin: center;
  }


  /* Open = X */

  .mobile-menu[open]
  .mobile-menu__icon span:nth-child(1) {
    transform:
      translateY(7.5px)
      rotate(45deg);
  }

  .mobile-menu[open]
  .mobile-menu__icon span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu[open]
  .mobile-menu__icon span:nth-child(3) {
    transform:
      translateY(-7.5px)
      rotate(-45deg);
  }


  /* =======================================================
     MOBILE MENU FULL SCREEN
     ======================================================= */

  .mobile-menu__panel {
    position: fixed;

    top: var(--header-mobile-height);
    left: 0;

    width: 100vw;

    height:
      calc(100vh - var(--header-mobile-height));

    max-height: none;

    overflow-y: auto;
    overflow-x: hidden;

    padding:
      18px 22px 40px;

    background: var(--header-bg);

    border-top:
      1px solid var(--header-border);

    border-bottom:
      1px solid var(--header-border);

    box-shadow:
      none;

    z-index: 99998;

    box-sizing: border-box;

    -webkit-overflow-scrolling: touch;
  }


  /* =======================================================
     MOBILE MENU LINKS
     ======================================================= */

  .mobile-menu__panel > a {
    display: block;

    width: 100%;

    padding: 15px 2px;

    color: var(--header-text);

    text-decoration: none;

    font-size: 0.82rem;
    font-weight: 500;

    letter-spacing: 0.08em;

    text-transform: uppercase;

    border-bottom:
      1px solid rgba(0, 0, 0, 0.08);
  }


  /* =======================================================
     MOBILE CATEGORIES
     ======================================================= */

  .mobile-categories {
    width: 100%;

    border-bottom:
      1px solid rgba(0, 0, 0, 0.08);
  }

  .mobile-categories summary {
    list-style: none;

    width: 100%;

    min-height: 48px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    color: var(--header-text);

    font-size: 0.82rem;
    font-weight: 500;

    letter-spacing: 0.08em;

    text-transform: uppercase;

    cursor: pointer;
  }

  .mobile-categories summary::-webkit-details-marker {
    display: none;
  }


  /* Categories arrow */

  .mobile-categories__arrow {
    width: 7px;
    height: 7px;

    border-right:
      1px solid currentColor;

    border-bottom:
      1px solid currentColor;

    transform: rotate(45deg);

    margin-right: 3px;
    margin-top: -4px;

    transition:
      transform 0.2s ease;
  }

  .mobile-categories[open]
  .mobile-categories__arrow {

    transform: rotate(225deg);

    margin-top: 4px;
  }


  /* Category items */

  .mobile-categories__items {
    width: 100%;

    padding:
      0 0 5px 14px;
  }

  .mobile-categories__items a {
    display: block;

    width: 100%;

    padding: 11px 2px;

    color: var(--header-text);

    text-decoration: none;

    font-size: 0.76rem;

    letter-spacing: 0.07em;

    text-transform: uppercase;

    border: 0;
  }


  /* =======================================================
     MOBILE ACTIONS
     ======================================================= */

  .header-actions {
    margin-left: auto;

    gap: 14px;
  }

  .header-action svg {
    width: 18px;
    height: 18px;
  }


  /* =======================================================
     MOBILE SEARCH
     ======================================================= */

  .header-search__panel {
    position: fixed;

    top: var(--header-mobile-height);
    left: 0;

    width: 100vw;

    padding:
      14px 16px;

    box-sizing: border-box;

    z-index: 99998;
  }

  .header-search__form {
    width: 100%;
  }

}


/* =========================================================
   DESKTOP / MOBILE DISPLAY
   ========================================================= */

@media screen and (min-width: 750px) {

  .mobile-menu {
    display: none !important;
  }

}


/* =========================================================
   FULL WIDTH SHOPIFY SECTION
   ========================================================= */

.shopify-section:has(.site-header) {
  width: 100vw !important;
  max-width: none !important;

  margin-left: calc(50% - 50vw) !important;
  margin-right: 0 !important;

  padding-left: 0 !important;
  padding-right: 0 !important;
}

{% endstyle %}


<header
  class="site-header{% if section.settings.sticky_header %} site-header--sticky{% endif %}"
>

  <div class="site-header__inner">


    <!-- =====================================================
         MOBILE MENU
         ===================================================== -->

    <details class="mobile-menu">

      <summary aria-label="Open menu">

        <span class="mobile-menu__icon">
          <span></span>
          <span></span>
          <span></span>
        </span>

      </summary>


      <nav class="mobile-menu__panel">

        <a href="{{ routes.root_url }}">
          Home
        </a>

        <a href="{{ routes.all_products_collection_url }}">
          All Products
        </a>


        <!-- MOBILE CATEGORIES -->

        <details class="mobile-categories">

          <summary>

            <span>
              Categories
            </span>

            <span class="mobile-categories__arrow"></span>

          </summary>


          <div class="mobile-categories__items">

            <a href="{{ routes.collections_url }}/necklaces">
              Necklaces
            </a>

            <a href="{{ routes.collections_url }}/rings">
              Rings
            </a>

            <a href="{{ routes.collections_url }}/pendants">
              Pendants
            </a>

            <a href="{{ routes.collections_url }}/bracelets">
              Bracelets
            </a>

            <a href="{{ routes.collections_url }}/keychains">
              Keychains
            </a>

          </div>

        </details>


        {% if section.settings.show_new_arrivals
          and section.settings.new_arrivals_link != blank %}

          <a href="{{ section.settings.new_arrivals_link }}">
            New Arrivals
          </a>

        {% endif %}


        {% if section.settings.show_best_sellers
          and section.settings.best_sellers_link != blank %}

          <a href="{{ section.settings.best_sellers_link }}">
            Best Sellers
          </a>

        {% endif %}

        {% if section.settings.show_sales
          and section.settings.sales_link != blank %}

          <a href="{{ section.settings.sales_link }}">
          Sales
          </a>

        {% endif %}


        <a href="{{ section.settings.contact_link }}">
          Contact Us
        </a>


        <!-- INSTAGRAM - NEW TAB -->

        <a
          href="{{ section.settings.instagram_link }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          Our Instagram
        </a>


        {% if section.settings.show_shipping
          and section.settings.shipping_page != blank %}

          <a href="{{ section.settings.shipping_page.url }}">
            Shipping
          </a>

        {% endif %}


        {% if section.settings.show_returns
          and section.settings.returns_page != blank %}

          <a href="{{ section.settings.returns_page.url }}">
            Returns
          </a>

        {% endif %}


        {% if section.settings.show_faq
          and section.settings.faq_page != blank %}

          <a href="{{ section.settings.faq_page.url }}">
            FAQ
          </a>

        {% endif %}

      </nav>

    </details>


    <!-- =====================================================
         BRAND
         ===================================================== -->

    <a
      href="{{ routes.root_url }}"
      class="site-header__brand"
    >
      Hilya
    </a>


    <!-- =====================================================
         DESKTOP NAV
         ===================================================== -->

    <nav class="desktop-nav">


      <!-- DESKTOP MENU -->

      <div class="desktop-menu">

        <button
          class="desktop-menu__trigger"
          type="button"
          aria-label="Menu"
        >

          <span class="desktop-menu__icon">
            <span></span>
            <span></span>
            <span></span>
          </span>

        </button>


        <div class="desktop-dropdown">

          <a href="{{ routes.all_products_collection_url }}">
            All Products
          </a>


          {% if section.settings.show_new_arrivals
            and section.settings.new_arrivals_link != blank %}

            <a href="{{ section.settings.new_arrivals_link }}">
              New Arrivals
            </a>

          {% endif %}


          {% if section.settings.show_best_sellers
            and section.settings.best_sellers_link != blank %}

            <a href="{{ section.settings.best_sellers_link }}">
              Best Sellers
            </a>

          {% endif %}

          {% if section.settings.show_sales
            and section.settings.sales_link != blank %}

            <a href="{{ section.settings.sales_link }}">
            Sales
            </a>

          {% endif %}



          <!-- INSTAGRAM - NEW TAB -->

          <a
            href="{{ section.settings.instagram_link }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            Our Instagram
          </a>


          {% if section.settings.show_shipping
            and section.settings.shipping_page != blank %}

            <a href="{{ section.settings.shipping_page.url }}">
              Shipping
            </a>

          {% endif %}


          {% if section.settings.show_returns
            and section.settings.returns_page != blank %}

            <a href="{{ section.settings.returns_page.url }}">
              Returns
            </a>

          {% endif %}


          {% if section.settings.show_faq
            and section.settings.faq_page != blank %}

            <a href="{{ section.settings.faq_page.url }}">
              FAQ
            </a>

          {% endif %}

        </div>

      </div>


      <!-- HOME -->

      <a href="{{ routes.root_url }}">
        Home
      </a>


      <!-- DESKTOP CATEGORIES -->

      <div class="desktop-categories">

        <button
          class="desktop-categories__trigger"
          type="button"
        >
          Categories
        </button>


        <div class="desktop-dropdown">

          <a href="{{ routes.collections_url }}/necklaces">
            Necklaces
          </a>

          <a href="{{ routes.collections_url }}/rings">
            Rings
          </a>

          <a href="{{ routes.collections_url }}/pendants">
            Pendants
          </a>

          <a href="{{ routes.collections_url }}/bracelets">
            Bracelets
          </a>

          <a href="{{ routes.collections_url }}/keychains">
            Keychains
          </a>

        </div>

      </div>


      <!-- CONTACT -->

      <a href="{{ section.settings.contact_link }}">
        Contact Us
      </a>

    </nav>


    <!-- =====================================================
         RIGHT ACTIONS
         ===================================================== -->

    <div class="header-actions">


      <!-- SEARCH -->

      {% if section.settings.show_search %}

        <details class="header-search">

          <summary
            class="header-action"
            aria-label="Search"
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >

              <circle
                cx="11"
                cy="11"
                r="7"
              ></circle>

              <path
                d="M20 20L16.2 16.2"
              ></path>

            </svg>

          </summary>


          <div class="header-search__panel">

            <form
              class="header-search__form"
              action="{{ routes.search_url }}"
              method="get"
            >

              <input
                class="header-search__input"
                type="search"
                name="q"
                placeholder="Search"
                aria-label="Search"
              >


              <button
                class="header-search__submit"
                type="submit"
                aria-label="Submit search"
              >

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >

                  <circle
                    cx="11"
                    cy="11"
                    r="7"
                  ></circle>

                  <path
                    d="M20 20L16.2 16.2"
                  ></path>

                </svg>

              </button>

            </form>

          </div>

        </details>

      {% endif %}


      <!-- ACCOUNT -->

      {% if section.settings.show_account %}

        <a
          href="{{ routes.account_url }}"
          class="header-action"
          aria-label="Account"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >

            <circle
              cx="12"
              cy="8"
              r="3.5"
            ></circle>

            <path
              d="M5 20c.8-3.2 3.2-5 7-5s6.2 1.8 7 5"
            ></path>

          </svg>

        </a>

      {% endif %}


      <!-- CART -->

      <a
        href="{{ routes.cart_url }}"
        class="header-action"
        aria-label="Cart"
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >

          <path
            d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 7H6"
          ></path>

          <circle
            cx="10"
            cy="20"
            r="1"
          ></circle>

          <circle
            cx="18"
            cy="20"
            r="1"
          ></circle>

        </svg>


        {% if cart.item_count > 0 %}

          <span class="cart-count">
            {{ cart.item_count }}
          </span>

        {% endif %}

      </a>

    </div>

  </div>

</header>


<script>
(function () {

  function setupHilyaMobileMenu() {

    const menu = document.querySelector('.mobile-menu');

    if (!menu) return;

    function lockPage() {
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    }

    function unlockPage() {
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }

    menu.addEventListener('toggle', function () {

      if (menu.open) {
        lockPage();
      } else {
        unlockPage();
      }

    });

    window.addEventListener('resize', function () {

      if (window.innerWidth > 749) {
        menu.open = false;
        unlockPage();
      }

    });

  }

  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      setupHilyaMobileMenu
    );

  } else {

    setupHilyaMobileMenu();

  }

})();
</script>


