<section class="hilya-header">

  <!-- ANNOUNCEMENT BAR -->
  <div class="hilya-announcement">
    Free shipping on orders over 1,000 EGP
  </div>

  <!-- MAIN HEADER -->
  <header class="hilya-nav">

    <!-- MOBILE MENU -->
    <button
      class="hilya-menu"
      type="button"
      aria-label="Open menu"
      onclick="document.querySelector('.hilya-mobile-menu').classList.toggle('is-open')"
    >
      <span></span>
      <span></span>
    </button>

    <!-- LEFT NAV -->
    <nav class="hilya-nav-left">
      <a href="{{ routes.root_url }}">Shop</a>
      <a href="{{ routes.root_url }}#collections">Categories</a>
      <a href="/pages/about">About</a>
    </nav>

    <!-- LOGO -->
    <a href="{{ routes.root_url }}" class="hilya-logo">
      Hilya
    </a>

    <!-- RIGHT ICONS -->
    <div class="hilya-nav-right">

      <!-- SEARCH -->
      <a href="{{ routes.search_url }}" class="hilya-icon" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="M16 16L21 21"></path>
        </svg>
      </a>

      <!-- ACCOUNT -->
      <a href="{{ routes.account_url }}" class="hilya-icon" aria-label="Account">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="3.5"></circle>
          <path d="M5 21c.7-4.2 3.2-6.5 7-6.5s6.3 2.3 7 6.5"></path>
        </svg>
      </a>

      <!-- CART -->
      <a href="{{ routes.cart_url }}" class="hilya-icon hilya-cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 8h14l-1 12H6L5 8Z"></path>
          <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
        </svg>

        {% if cart.item_count > 0 %}
          <span class="hilya-cart-count">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>

    </div>

  </header>

  <!-- MOBILE MENU -->
  <div class="hilya-mobile-menu">

    <a href="{{ routes.root_url }}">Shop</a>
    <a href="{{ routes.root_url }}#collections">Categories</a>
    <a href="/pages/about">About</a>

  </div>

</section>


{% stylesheet %}

.hilya-header {
  width: 100%;
  position: relative;
  z-index: 50;
  background: #ffffff;
}

/* ANNOUNCEMENT */

.hilya-announcement {
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eee9e1;
  color: #555;
  font-family: Arial, sans-serif;
  font-size: 8px;
  line-height: 1;
  letter-spacing: .02em;
}

/* NAV */

.hilya-nav {
  position: relative;
  height: 49px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 max(24px, calc((100vw - 1400px) / 2));
  box-sizing: border-box;
  background: #ffffff;
}

/* LEFT */

.hilya-nav-left {
  position: absolute;
  left: max(24px, calc((100vw - 1400px) / 2));
  top: 0;
  height: 100%;
  display: flex;
  align-items: center;
  gap: 36px;
}

.hilya-nav-left a {
  color: #171717;
  text-decoration: none;
  font-family: Arial, sans-serif;
  font-size: 9px;
  line-height: 1;
  font-weight: 400;
}

/* LOGO */

.hilya-logo {
  color: #111111;
  text-decoration: none;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: 34px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: -.04em;
}

/* RIGHT */

.hilya-nav-right {
  position: absolute;
  right: max(24px, calc((100vw - 1400px) / 2));
  top: 0;
  height: 100%;
  display: flex;
  align-items: center;
  gap: 22px;
}

.hilya-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  color: #171717;
  text-decoration: none;
}

.hilya-icon svg {
  width: 17px;
  height: 17px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.15;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.hilya-cart-count {
  position: absolute;
  top: -6px;
  right: -8px;
  width: 11px;
  height: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #171717;
  color: #fff;
  font-family: Arial, sans-serif;
  font-size: 6px;
  line-height: 1;
}

/* MOBILE MENU BUTTON */

.hilya-menu {
  display: none;
}

/* MOBILE MENU */

.hilya-mobile-menu {
  display: none;
}


/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {

  .hilya-nav-left {
    left: 28px;
    gap: 26px;
  }

  .hilya-nav-right {
    right: 28px;
  }

}


/* MOBILE */

@media (max-width: 749px) {

  .hilya-announcement {
    height: 23px;
    font-size: 7px;
  }

  .hilya-nav {
    height: 54px;
    padding: 0 18px;
  }

  .hilya-nav-left {
    display: none;
  }

  .hilya-logo {
    font-size: 31px;
  }

  .hilya-nav-right {
    right: 18px;
    gap: 15px;
  }

  .hilya-nav-right .hilya-icon:first-child {
    display: none;
  }

  .hilya-icon {
    width: 17px;
    height: 17px;
  }

  /* MENU */

  .hilya-menu {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .hilya-menu span {
    display: block;
    width: 17px;
    height: 1px;
    background: #111;
  }

  /* MOBILE MENU */

  .hilya-mobile-menu {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-height: 0;
    overflow: hidden;
    padding: 0 20px;
    background: #fff;
    transition: max-height .3s ease, padding .3s ease;
  }

  .hilya-mobile-menu.is-open {
    max-height: 220px;
    padding-top: 22px;
    padding-bottom: 24px;
  }

  .hilya-mobile-menu a {
    color: #111;
    text-decoration: none;
    font-family: Arial, sans-serif;
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

}

{% endstylesheet %}


