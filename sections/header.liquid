      "id": "desktop_height",
      "label": "Desktop height",
      "min": 55,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    },

    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 50,
      "max": 90,
      "step": 1,
      "unit": "px",
      "default": 64
