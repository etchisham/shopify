{% liquid
  assign wishlist_page = pages['wishlist']
  assign wishlist_url = routes.root_url | append: 'pages/wishlist'

  if wishlist_page != blank
    assign wishlist_url = wishlist_page.url
  endif
%}

{% if section.settings.sticky_header %}
  {% style %}
    #shopify-section-{{ section.id }} {
      position: sticky;
      z-index: 40;
      inset-block-start: 0;
    }
  {% endstyle %}
{% endif %}

<header
  class="site-header full-width"
  style="
    --header-background: {{ section.settings.background_color }};
    --header-color: {{ section.settings.text_color }};
    --header-border: {{ section.settings.border_color }};
    --header-desktop-height: {{ section.settings.desktop_height }}px;
    --header-mobile-height: {{ section.settings.mobile_height }}px;
    --header-desktop-padding: {{ section.settings.desktop_padding }}px;
    --header-mobile-logo-width: {{ section.settings.mobile_logo_width }}px;
    --drawer-font-size: {{ section.settings.mobile_menu_font_size }}px;
  "
>

  <div class="site-header__inner">

    <!-- MOBILE MENU -->

    <div class="site-header__mobile-menu">

      <details class="header-menu" data-menu-drawer scroll-lock>

        <summary class="header-icon-button header-menu__toggle">

          <span class="header-menu__open-icon">
            {% render 'icon', name: 'menu' %}
          </span>

          <span class="header-menu__close-icon">
            {% render 'icon', name: 'close' %}
          </span>

          <span class="visually-hidden">
            {{ 'accessibility.open_menu' | t }}
          </span>

        </summary>


        <div class="header-menu__panel">

          <nav
            class="drawer-navigation"
            aria-label="{{ 'general.menu' | t | escape }}"
          >

            <a
              class="drawer-navigation__all"
              href="{{ routes.root_url }}"
            >
              <span>Home</span>
              <span aria-hidden="true">
                {% render 'icon', name: 'arrow' %}
              </span>
            </a>


            <p class="drawer-navigation__heading">
              Categories
            </p>


            <ul
              class="drawer-navigation__categories"
              role="list"
            >

              {% assign allowed_collections =
                'necklaces,rings,pendants,bracelets,keychains'
                | split: ','
              %}

              {% for handle in allowed_collections %}

                {% assign category = collections[handle] %}

                {% if category != blank %}

                  <li>

                    <a href="{{ category.url }}">

                      <span>
                        {{ category.title | escape }}
                      </span>

                      {% if category.all_products_count > 0 %}
                        <span class="drawer-navigation__count">
                          {{ category.all_products_count }}
                        </span>
                      {% endif %}

                    </a>

                  </li>

                {% endif %}

              {% endfor %}

            </ul>


            <a
              class="drawer-navigation__contact"
              href="{{ section.settings.contact_link }}"
            >
              Contact Us
            </a>

          </nav>

        </div>

      </details>

    </div>


    <!-- BRAND -->

    <a
      class="site-header__brand"
      href="{{ routes.root_url }}"
      aria-label="Hilya"
    >
      Hilya
    </a>


    <!-- DESKTOP NAVIGATION -->

    <nav
      class="desktop-navigation"
      aria-label="Main navigation"
    >

      <ul role="list">

        <li>
          <a href="{{ routes.root_url }}">
            Home
          </a>
        </li>


        <li class="desktop-navigation__dropdown">

          <button
            type="button"
            class="desktop-navigation__dropdown-trigger"
            aria-haspopup="true"
          >
            Categories
          </button>


          <div class="desktop-navigation__dropdown-menu">

            {% assign allowed_collections =
              'necklaces,rings,pendants,bracelets,keychains'
              | split: ','
            %}

            {% for handle in allowed_collections %}

              {% assign category = collections[handle] %}

              {% if category != blank %}

                <a href="{{ category.url }}">
                  {{ category.title | escape }}
                </a>

              {% endif %}

            {% endfor %}

          </div>

        </li>


        <li>
          <a href="{{ section.settings.contact_link }}">
            Contact Us
          </a>
        </li>

      </ul>

    </nav>


    <!-- RIGHT ACTIONS -->

    <div class="site-header__actions">


      <!-- SEARCH -->

      {% if section.settings.show_search %}

        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="header-search"
        >

          <input
            type="search"
            name="q"
            placeholder="Search"
            aria-label="Search"
            value="{{ search.terms | escape }}"
          >

          <button
            type="submit"
            aria-label="Search"
          >

            {% render 'icon', name: 'search' %}

          </button>

        </form>

      {% endif %}


      <!-- ACCOUNT -->

      {% if shop.customer_accounts_enabled and section.settings.show_account %}

        <a
          class="header-icon-button site-header__account"
          href="{{ routes.account_url }}"
          aria-label="{{ 'general.account' | t | escape }}"
        >

          {% render 'icon', name: 'account' %}

        </a>

      {% endif %}


      <!-- WISHLIST -->

      <a
        class="header-icon-button site-header__wishlist"
        href="{{ wishlist_url }}"
        aria-label="{{ 'general.wishlist' | t | escape }}"
      >

        {% render 'icon', name: 'heart' %}

        <span
          class="site-header__wishlist-count"
          aria-hidden="true"
          data-wishlist-count
          hidden
        >
          0
        </span>

      </a>


      <!-- CART -->

      <a
        class="header-icon-button site-header__cart"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'general.cart' | t: count: cart.item_count | escape }}"
        data-cart-open
        aria-haspopup="dialog"
        aria-controls="CartDrawer"
        aria-expanded="false"
      >

        {% render 'icon', name: 'cart' %}

        <span
          class="site-header__cart-count"
          aria-hidden="true"
          data-cart-count
          {% if cart.item_count == 0 %}
            hidden
          {% endif %}
        >
          {{ cart.item_count }}
        </span>

      </a>

    </div>

  </div>

</header>


{% stylesheet %}


/* ========================================
   HEADER
======================================== */


.site-header {

  position: relative;

  z-index: 40;

  border-block-end:
    1px solid var(--header-border);

  background:
    var(--header-background);

  color:
    var(--header-color);

  font-family:
    Arial,
    Helvetica,
    sans-serif;

}


.site-header__inner {

  position: relative;

  display: grid;

  width: 100%;

  min-height:
    var(--header-mobile-height);

  grid-template-columns:
    1fr auto 1fr;

  align-items: center;

  padding-inline:
    1rem;

}


/* ========================================
   HILYA BRAND
======================================== */


.site-header__brand {

  color:
    var(--header-color);

  font-family:
    "Cormorant Garamond",
    "Bodoni Moda",
    "Didot",
    "Times New Roman",
    serif;

  font-size:
    2.15rem;

  font-style:
    italic;

  font-weight:
    500;

  letter-spacing:
    -0.065em;

  line-height:
    .8;

  text-decoration:
    none;

  white-space:
    nowrap;

  transition:
    opacity .25s ease,
    transform .25s ease;

}


.site-header__brand:hover {

  opacity: .72;

  transform:
    translateY(-1px);

}


/* ========================================
   MOBILE MENU
======================================== */


.site-header__mobile-menu {

  grid-column:
    1;

  display:
    flex;

  align-items:
    center;

}


.header-menu {

  position:
    static;

}


.header-menu__toggle {

  cursor:
    pointer;

  list-style:
    none;

}


.header-menu__toggle::-webkit-details-marker {

  display:
    none;

}


.header-menu__close-icon,

.header-menu[open]
.header-menu__open-icon {

  display:
    none;

}


.header-menu[open]
.header-menu__close-icon {

  display:
    inline;

}


/* ========================================
   ICON BUTTONS
======================================== */


.header-icon-button {

  position:
    relative;

  display:
    inline-grid;

  width:
    2.65rem;

  min-width:
    2.65rem;

  height:
    2.65rem;

  place-items:
    center;

  border:
    0;

  border-radius:
    0;

  background:
    transparent;

  color:
    inherit;

  text-decoration:
    none;

}


.header-icon-button:hover {

  background:
    rgb(0 0 0 / 4%);

}


.header-icon-button svg {

  width:
    1.25rem;

  height:
    1.25rem;

  fill:
    none;

  stroke:
    currentcolor;

  stroke-linecap:
    round;

  stroke-linejoin:
    round;

  stroke-width:
    1.45;

}


/* ========================================
   DESKTOP NAVIGATION
======================================== */


.desktop-navigation {

  position:
    absolute;

  left:
    50%;

  top:
    50%;

  transform:
    translate(-50%, -50%);

}


.desktop-navigation > ul {

  display:
    flex;

  align-items:
    center;

  gap:
    2.35rem;

  margin:
    0;

  padding:
    0;

  list-style:
    none;

}


.desktop-navigation a,
.desktop-navigation__dropdown-trigger {

  position:
    relative;

  display:
    inline-flex;

  align-items:
    center;

  border:
    0;

  background:
    transparent;

  color:
    inherit;

  cursor:
    pointer;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size:
    .72rem;

  font-weight:
    500;

  letter-spacing:
    .14em;

  line-height:
    1;

  text-decoration:
    none;

  text-transform:
    uppercase;

  white-space:
    nowrap;

}


.desktop-navigation a::after,
.desktop-navigation__dropdown-trigger::after {

  content:
    "";

  position:
    absolute;

  left:
    0;

  bottom:
    -6px;

  width:
    0;

  height:
    1px;

  background:
    currentColor;

  transition:
    width .25s ease;

}


.desktop-navigation a:hover::after,
.desktop-navigation__dropdown-trigger:hover::after {

  width:
    100%;

}


/* ========================================
   CATEGORY DROPDOWN
======================================== */


.desktop-navigation__dropdown {

  position:
    relative;

  padding-block:
    1.8rem;

}


.desktop-navigation__dropdown-menu {

  position:
    absolute;

  top:
    calc(100% - .45rem);

  left:
    50%;

  min-width:
    175px;

  padding:
    13px 0;

  transform:
    translateX(-50%)
    translateY(8px);

  background:
    #ffffff;

  border:
    1px solid #eeeeee;

  box-shadow:
    0 12px 35px
    rgb(0 0 0 / 9%);

  opacity:
    0;

  visibility:
    hidden;

  pointer-events:
    none;

  transition:
    opacity .2s ease,
    transform .2s ease,
    visibility .2s ease;

}


.desktop-navigation__dropdown:hover
.desktop-navigation__dropdown-menu {

  opacity:
    1;

  visibility:
    visible;

  pointer-events:
    auto;

  transform:
    translateX(-50%)
    translateY(0);

}


.desktop-navigation__dropdown-menu a {

  display:
    block;

  padding:
    10px 20px;

  font-size:
    .68rem;

  letter-spacing:
    .12em;

  white-space:
    nowrap;

}


.desktop-navigation__dropdown-menu a::after {

  display:
    none;

}


.desktop-navigation__dropdown-menu a:hover {

  background:
    #f7f4ee;

}


/* ========================================
   RIGHT SIDE
======================================== */


.site-header__actions {

  grid-column:
    3;

  display:
    flex;

  align-items:
    center;

  justify-content:
    flex-end;

  gap:
    .15rem;

}


/* ========================================
   SEARCH
======================================== */


.header-search {

  display:
    flex;

  width:
    150px;

  height:
    32px;

  margin-right:
    6px;

  border-bottom:
    1px solid
    color-mix(
      in srgb,
      var(--header-color) 45%,
      transparent
    );

}


.header-search input {

  width:
    100%;

  min-width:
    0;

  border:
    0;

  outline:
    0;

  background:
    transparent;

  color:
    inherit;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size:
    .7rem;

  letter-spacing:
    .05em;

}


.header-search input::placeholder {

  color:
    color-mix(
      in srgb,
      var(--header-color) 55%,
      transparent
    );

}


.header-search button {

  display:
    grid;

  width:
    30px;

  flex-shrink:
    0;

  place-items:
    center;

  padding:
    0;

  border:
    0;

  background:
    transparent;

  color:
    inherit;

  cursor:
    pointer;

}


.header-search button svg {

  width:
    16px;

  height:
    16px;

  fill:
    none;

  stroke:
    currentcolor;

  stroke-width:
    1.5;

}


/* ========================================
   COUNTERS
======================================== */


.site-header__cart-count,
.site-header__wishlist-count {

  position:
    absolute;

  top:
    .1rem;

  right:
    .05rem;

  display:
    grid;

  min-width:
    .95rem;

  height:
    .95rem;

  place-items:
    center;

  border-radius:
    999px;

  background:
    var(--header-color);

  color:
    var(--header-background);

  font-size:
    .58rem;

  font-weight:
    700;

  line-height:
    1;

}


/* ========================================
   MOBILE DRAWER
======================================== */


.header-menu__panel {

  position:
    absolute;

  z-index:
    50;

  inset-block-start:
    100%;

  inset-inline-start:
    0;

  width:
    100%;

  max-height:
    calc(
      100svh -
      var(--header-mobile-height)
    );

  overflow-y:
    auto;

  border-block-end:
    1px solid
    var(--header-border);

  background:
    var(--header-background);

  box-shadow:
    0 1rem 2rem
    rgb(0 0 0 / 8%);

}


.drawer-navigation {

  min-height:
    100%;

  padding:
    2.25rem 1.75rem 1.8rem;

}


.drawer-navigation__all {

  display:
    flex;

  min-height:
    3.5rem;

  align-items:
    center;

  justify-content:
    space-between;

  color:
    inherit;

  font-size:
    1.35rem;

  font-weight:
    500;

  letter-spacing:
    -.03em;

  text-decoration:
    none;

  border-bottom:
    1px solid
    var(--header-border);

}


.drawer-navigation__heading {

  margin:
    1.5rem 0 .7rem;

  color:
    color-mix(
      in srgb,
      currentcolor 55%,
      transparent
    );

  font-size:
    .7rem;

  font-weight:
    600;

  letter-spacing:
    .15em;

  text-transform:
    uppercase;

}


.drawer-navigation__categories {

  display:
    grid;

  gap:
    .1rem;

  margin:
    0;

  padding:
    0;

  list-style:
    none;

}


.drawer-navigation__categories a,
.drawer-navigation__contact {

  display:
    flex;

  min-height:
    3rem;

  align-items:
    center;

  justify-content:
    space-between;

  color:
    inherit;

  font-size:
    1rem;

  text-decoration:
    none;

  padding:
    .5rem .2rem;

  border-bottom:
    1px solid
    rgb(0 0 0 / 6%);

}


.drawer-navigation__contact {

  margin-top:
    1.2rem;

  border-bottom:
    0;

  font-weight:
    500;

}


.drawer-navigation__count {

  color:
    color-mix(
      in srgb,
      currentcolor 50%,
      transparent
    );

  font-size:
    .7rem;

}


/* ========================================
   DESKTOP
======================================== */


@media (min-width: 61.875rem) {

  .site-header__inner {

    min-height:
      var(--header-desktop-height);

    padding-inline:
      var(--header-desktop-padding);

  }


  .site-header__mobile-menu {

    display:
      none;

  }


  .site-header__brand {

    position:
      absolute;

    left:
      var(--header-desktop-padding);

    top:
      50%;

    transform:
      translateY(-50%);

    font-size:
      2.35rem;

  }


  .site-header__brand:hover {

    transform:
      translateY(
        calc(-50% - 1px)
      );

  }


}


/* ========================================
   TABLET / MOBILE
======================================== */


@media (max-width: 61.874rem) {

  .site-header__brand {

    position:
      static;

    grid-column:
      2;

    justify-self:
      center;

    font-size:
      1.9rem;

  }


  .desktop-navigation {

    display:
      none;

  }


  .header-search {

    display:
      none;

  }


  .site-header__actions {

    gap:
      0;

  }


}


/* ========================================
   SMALL MOBILE
======================================== */


@media (max-width: 30rem) {

  .site-header__inner {

    padding-inline:
      .45rem;

  }


  .site-header__brand {

    font-size:
      1.65rem;

  }


  .header-icon-button {

    width:
      2.35rem;

    min-width:
      2.35rem;

  }


  .site-header__account {

    display:
      none;

  }

}

{% endstylesheet %}


{% schema %}

{
  "name": "Hilya Header",

  "enabled_on": {
    "groups": ["header"]
  },

  "settings": [

    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact Us link"
    },

    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
      "default": true
    },


    {
      "type": "header",
      "content": "Header Style"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Foreground",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#EFEFEF"
    },


    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop header height",
      "min": 64,
      "max": 112,
      "step": 2,
      "unit": "px",
      "default": 84
    },

    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile header height",
      "min": 56,
      "max": 88,
      "step": 2,
      "unit": "px",
      "default": 72
    },

    {
      "type": "range",
      "id": "desktop_padding",
      "label": "Desktop horizontal padding",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },

    {
      "type": "range",
      "id": "mobile_menu_font_size",
      "label": "Mobile menu font size",
      "min": 24,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 32
    },

    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile brand width",
      "min": 72,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 112
    }

  ],

  "presets": [
    {
      "name": "Hilya Header"
    }
  ]

}

{% endschema %}