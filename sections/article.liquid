<article class="article-page section-spacing">
  <header class="article-page__header">
    {% assign date = article.published_at | time_tag: format: 'date' %}
    <p class="eyebrow">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
    <h1>{{ article.title | escape }}</h1>
  </header>

  {% if article.image %}
    {% render 'image', image: article.image, width: 1800, widths: '640, 960, 1280, 1800', sizes: '(min-width: 900px) 60rem, 100vw', loading: 'eager', fetchpriority: 'high', alt: article.image.alt %}
  {% endif %}

  <div class="article-page__content rte">{{ article.content }}</div>

  {% if blog.comments_enabled? %}
    <section class="article-comments" id="comments">
      <h2>{{ 'blog.article_comments' | t }}</h2>
      {% paginate article.comments by 10 %}
        {% for comment in article.comments %}
          <article class="article-comment">
            <p><strong>{{ comment.author | escape }}</strong> · {{ comment.created_at | time_tag: format: 'date' }}</p>
            <div class="rte">{{ comment.content }}</div>
          </article>
        {% endfor %}
        {{ paginate | default_pagination: anchor: 'comments' }}
      {% endpaginate %}

      {% form 'new_comment', article, class: 'comment-form' %}
        <h2>{{ 'blog.comment_form_title' | t }}</h2>
        {{ form.errors | default_errors }}
        <div><label for="CommentAuthor">{{ 'blog.comment_form_name' | t }}</label><input id="CommentAuthor" type="text" name="comment[author]" value="{{ form.author }}" autocomplete="name" required></div>
        <div><label for="CommentEmail">{{ 'blog.comment_form_email' | t }}</label><input id="CommentEmail" type="email" name="comment[email]" value="{{ form.email }}" autocomplete="email" required></div>
        <div><label for="CommentBody">{{ 'blog.comment_form_body' | t }}</label><textarea id="CommentBody" name="comment[body]" required>{{ form.body }}</textarea></div>
        <button class="button" type="submit">{{ 'blog.comment_form_submit' | t }}</button>
      {% endform %}
    </section>
  {% endif %}
</article>

{% stylesheet %}
  .article-page {
    max-width: 64rem;
    margin-inline: auto;
  }

  .article-page__header,
  .article-page__content,
  .article-comments {
    width: min(100%, 46rem);
    margin-inline: auto;
  }

  .article-page__header {
    margin-block-end: var(--space-6);
  }

  .article-page__header h1 {
    margin-block-start: var(--space-3);
  }

  .article-page > .image {
    overflow: hidden;
    border-radius: var(--radius-large);
    margin-block-end: var(--space-7);
  }

  .article-page__content {
    font-size: 1.05rem;
  }

  .article-comments {
    border-block-start: 1px solid var(--color-border);
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-7);
  }

  .article-comment {
    border-block-end: 1px solid var(--color-border);
    padding-block: var(--space-4);
  }

  .comment-form {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-7);
  }

  .comment-form > div {
    display: grid;
    gap: var(--space-2);
  }

  .comment-form label {
    font-weight: 650;
  }
{% endstylesheet %}

{% schema %}
{ "name": "t:general.article", "settings": [] }
{% endschema %}
