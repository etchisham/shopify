<section class="fl-hero full-width" style="--fl-hero-position: {{ section.settings.image_position }};">
  <div class="fl-hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading -%}
      {{ section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '640, 960, 1280, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: hero_alt
      }}
    {%- else -%}
      <div class="fl-hero__placeholder"></div>
    {%- endif -%}
  </div>
  <div class="fl-hero__content">
    {%- if section.settings.eyebrow != blank -%}<span class="fl-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1 class="fl-hero__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="fl-hero__text">{{ section.settings.text }}</div>{%- endif -%}
    <div class="fl-hero__actions">
      {%- if section.settings.primary_label != blank -%}<a class="fl-button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{%- endif -%}
      {%- if section.settings.secondary_label != blank -%}<a class="fl-button fl-button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "select", "id": "image_position", "label": "Image focus", "options": [
      { "value": "center", "label": "Center" },
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ], "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The autumn edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Objects worth living with." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Distinctive modern décor, selected from independent makers and shown with every detail you need to choose well.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Shop the edit" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Meet the makers" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Editorial hero" }]
}
{% endschema %}
