<section class="password-page section-spacing">
  <div class="password-page__card">
    <p class="eyebrow">{{ shop.name | escape }}</p>
    <h1>{{ 'password.title' | t }}</h1>

    {% if shop.password_message != blank %}
      <div class="rte muted">{{ shop.password_message }}</div>
    {% endif %}

    {% form 'storefront_password', class: 'password-form' %}
      {% if form.errors %}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{% endif %}
      <div>
        <label for="PasswordInput">{{ 'password.password' | t }}</label>
        <input id="PasswordInput" type="password" name="password" autocomplete="current-password" required>
      </div>
      <button class="button" type="submit">{{ 'password.enter' | t }}</button>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .password-page {
    display: grid;
    min-height: 100svh;
    place-items: center;
  }

  .password-page__card {
    width: min(100%, 34rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    padding: clamp(var(--space-5), 6vw, var(--space-7));
  }

  .password-page__card h1 {
    margin-block-start: var(--space-2);
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .password-form,
  .password-form > div:not(.form-message) {
    display: grid;
    gap: var(--space-3);
  }

  .password-form {
    margin-block-start: var(--space-5);
  }

  .password-form label {
    font-weight: 650;
  }

  .password-page .form-message--error {
    color: var(--color-error);
  }
{% endstylesheet %}

{% schema %}
{ "name": "t:general.password", "settings": [] }
{% endschema %}
