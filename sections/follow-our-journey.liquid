{%- liquid
  assign hs_locale = request.locale.iso_code | split: '-' | first
  assign hs_name = section.settings.brand_name
  assign hs_text = section.settings.description
  assign hs_button = section.settings.button_label
  assign instagram_alt = 'home.instagram_alt' | t

  if hs_locale == 'ar'
    if section.settings.brand_name_ar != blank
      assign hs_name = section.settings.brand_name_ar
    endif
    if section.settings.description_ar != blank
      assign hs_text = section.settings.description_ar
    endif
    if section.settings.button_label_ar != blank
      assign hs_button = section.settings.button_label_ar
    endif
  endif
-%}

<section class="hilya-social">

  <div class="hilya-social__grid">

    {%- for i in (1..5) -%}
      {%- assign image_key = 'image_' | append: i -%}
      {%- assign social_image = section.settings[image_key] -%}

      {%- if social_image != blank -%}
        <a
          href="{{ section.settings.instagram_url }}"
          class="hilya-social__image hilya-social__image--{{ i }}"
          target="_blank"
          rel="noopener"
        >
          {{
            social_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '300, 500, 700, 900',
              sizes: '(min-width: 750px) 33vw, 50vw',
              alt: instagram_alt
          }}
        </a>
      {%- else -%}
        <span class="hilya-social__image hilya-social__image--{{ i }}"></span>
      {%- endif -%}
    {%- endfor -%}

    <div class="hilya-social__head">

      <p class="hilya-social__eyebrow">{{ 'home.follow_journey' | t }}</p>

      <p class="hilya-social__brand">
        <svg class="hilya-social__icon" viewBox="0 0 24 24" aria-hidden="true">
          <defs>
            <linearGradient id="hilya-ig-grad" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0" stop-color="#f9a43a"></stop>
              <stop offset=".5" stop-color="#e1306c"></stop>
              <stop offset="1" stop-color="#833ab4"></stop>
            </linearGradient>
          </defs>
          <rect x="3.5" y="3.5" width="17" height="17" rx="4"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1"></circle>
        </svg>
        <span>{{ hs_name | remove: '@' | escape }}</span>
      </p>

      {%- if hs_text != blank -%}
        <p class="hilya-social__text">{{ hs_text | escape }}</p>
      {%- endif -%}

    </div>

    {%- if hs_button != blank -%}
      <a
        class="hilya-social__button"
        href="{{ section.settings.instagram_url }}"
        target="_blank"
        rel="noopener"
      >
        <span>{{ hs_button | escape }}</span>
      </a>
    {%- endif -%}

  </div>

</section>


{% stylesheet %}

/* SECTION (same width as Best Sellers) */

.hilya-social {
  width: 100vw;
  max-width: 100vw;
  margin-inline: calc(50% - 50vw);
  padding: 15px max(24px, calc((100vw - 1400px) / 2));
  box-sizing: border-box;
  overflow-x: clip;
  background: #f4f1eb;
}


/* =========================
   DESKTOP + TABLET
   3 columns: [image 1, image 2] [title, image 3, image 4, button] [image 5]
========================= */

.hilya-social__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1fr);
  /* title row, 9 equal picture rows, button row */
  grid-template-rows: auto repeat(9, minmax(0, 1fr)) auto;
  column-gap: 10px;
  row-gap: 0;
  height: clamp(420px, 40vw, 600px);
  padding: 28px 32px 24px;
  box-sizing: border-box;
  background: #f4f1eb;
}


/* IMAGES */

.hilya-social__image {
  position: relative;
  display: block;
  min-width: 0;
  margin-bottom: 10px;
  overflow: hidden;
  isolation: isolate;
  border-radius: 16px;
  background: #e4dbcf;
}

.hilya-social__image--1 { grid-column: 1; grid-row: 1 / 6; }
.hilya-social__image--2 { grid-column: 1; grid-row: 6 / 11; }
.hilya-social__image--3 { grid-column: 2; grid-row: 2 / 6; }
.hilya-social__image--4 { grid-column: 2; grid-row: 6 / 11; }
.hilya-social__image--5 { grid-column: 3; grid-row: 4 / 11; }

.hilya-social__image img {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease;
}

.hilya-social__image:hover img {
  transform: scale(1.04);
}


/* TITLE (top of the center column) */

.hilya-social__head {
  grid-column: 2;
  grid-row: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 14px;
  text-align: center;
}

.hilya-social__eyebrow {
  margin: 0 0 8px;
  color: #2a2420;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 11px;
  line-height: 1.2;
  font-weight: 500;
  letter-spacing: .3em;
  text-transform: uppercase;
}

.hilya-social__brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin: 0;
  color: #2a2420;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: clamp(26px, 2.6vw, 38px);
  line-height: 1.1;
  font-weight: 400;
}

.hilya-social__icon {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  fill: none;
  stroke: url(#hilya-ig-grad);
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* The description is not shown in the new design.
   Delete this rule if you want it to appear under the name again. */
.hilya-social__text {
  display: none;
}


/* BUTTON (bottom of the center column) */

.hilya-social__button {
  grid-column: 2;
  grid-row: 11;
  justify-self: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 36px;
  border: 1px solid #b8975a;
  border-radius: 10px;
  background: #2a2420;
  color: #fff;
  text-decoration: none;
  font-size: 14px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: .03em;
  transition: background-color .3s ease, color .3s ease;
}

.hilya-social__button:hover {
  background: #b8975a;
  color: #fff;
}


/* LARGE DESKTOP */

@media (min-width: 1500px) {
  .hilya-social {
    padding-left: max(32px, calc((100vw - 1500px) / 2));
    padding-right: max(32px, calc((100vw - 1500px) / 2));
  }
}


/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {
  .hilya-social {
    padding-left: 28px;
    padding-right: 28px;
  }

  .hilya-social__grid {
    padding: 22px 20px 20px;
  }

  .hilya-social__eyebrow {
    font-size: 10px;
    letter-spacing: .22em;
  }
}


/* =========================
   MOBILE
   2 columns: title on top, 5 pictures, one button at the bottom
========================= */

@media (max-width: 749px) {

  .hilya-social {
    padding: 10px 1rem;
  }

  .hilya-social__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* title row, 7 picture rows, button row */
    grid-template-rows: auto repeat(7, clamp(56px, 18vw, 90px)) auto;
    height: auto;
    padding: 24px 14px 18px;
  }

  .hilya-social__head {
    grid-column: 1 / -1;
    grid-row: 1;
    padding-bottom: 16px;
  }

  .hilya-social__eyebrow {
    margin-bottom: 8px;
    font-size: 11px;
  }

  .hilya-social__brand {
    gap: 8px;
    font-size: 34px;
  }

  .hilya-social__icon {
    width: 30px;
    height: 30px;
  }

  .hilya-social__image--1 { grid-column: 1; grid-row: 2 / 5; }
  .hilya-social__image--3 { grid-column: 1; grid-row: 5 / 7; }
  .hilya-social__image--5 { grid-column: 1; grid-row: 7 / 9; }
  .hilya-social__image--2 { grid-column: 2; grid-row: 2 / 5; }
  .hilya-social__image--4 { grid-column: 2; grid-row: 5 / 9; }

  .hilya-social__button {
    grid-column: 1 / -1;
    grid-row: 9;
    padding: 14px 36px;
  }
}


/* ARABIC / RTL */

[dir="rtl"] .hilya-social__eyebrow {
  font-size: 13px;
  letter-spacing: 0;
}

[dir="rtl"] .hilya-social__brand {
  font-size: 30px;
}

[dir="rtl"] .hilya-social__button {
  font-size: 15px;
  letter-spacing: 0;
}

@media (max-width: 749px) {
  [dir="rtl"] .hilya-social__eyebrow {
    font-size: 12px;
  }

  [dir="rtl"] .hilya-social__brand {
    font-size: 28px;
  }

  [dir="rtl"] .hilya-social__button {
    font-size: 14px;
  }
}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {
  .hilya-social__image img {
    transition: none;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "Hilya Social",
  "settings": [
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (desktop: left, tall / mobile: top left, tall)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2 (desktop: left, bottom / mobile: top right)"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3 (desktop: center, top / mobile: left, middle)"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4 (desktop: center, bottom / mobile: right, tall)"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5 (desktop: right, tall / mobile: left, bottom)"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Name next to the Instagram icon",
      "default": "Hilya"
    },
    {
      "type": "text",
      "id": "brand_name_ar",
      "label": "Name - Arabic",
      "default": "حلية"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description (hidden in this design)",
      "default": "For more inspiration, behind the scenes and special moments."
    },
    {
      "type": "text",
      "id": "description_ar",
      "label": "Description - Arabic (hidden in this design)",
      "default": "لمزيد من الإلهام وكواليس العمل واللحظات المميزة."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Follow Us"
    },
    {
      "type": "text",
      "id": "button_label_ar",
      "label": "Button label - Arabic",
      "default": "تابعنا"
    }
  ],
  "presets": [
    {
      "name": "Hilya Social"
    }
  ]
}
{% endschema %}