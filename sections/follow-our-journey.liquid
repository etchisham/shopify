<section class="hilya-social">

  <div class="hilya-social__inner">

    <!-- TEXT -->

    <div class="hilya-social__intro">

      <p class="hilya-social__title">
        Follow Our Journey
      </p>

      <a
        href="{{ section.settings.instagram_url }}"
        class="hilya-social__instagram"
        target="_blank"
        rel="noopener"
      >

        <svg
          class="hilya-social__instagram-icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <rect x="3.5" y="3.5" width="17" height="17" rx="4"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1"></circle>
        </svg>

        <span>Hilya</span>

      </a>

    </div>


    <!-- FOUR IMAGES -->

    <div class="hilya-social__grid">

      {% if section.settings.image_1 != blank %}
        <a
          href="{{ section.settings.instagram_url }}"
          class="hilya-social__image"
          target="_blank"
          rel="noopener"
        >
          {{
            section.settings.image_1
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '300, 500, 700, 800',
              sizes: '(min-width: 750px) 16vw, 24vw',
              alt: 'Hilya Instagram'
          }}
        </a>
      {% endif %}


      {% if section.settings.image_2 != blank %}
        <a
          href="{{ section.settings.instagram_url }}"
          class="hilya-social__image"
          target="_blank"
          rel="noopener"
        >
          {{
            section.settings.image_2
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '300, 500, 700, 800',
              sizes: '(min-width: 750px) 16vw, 24vw',
              alt: 'Hilya Instagram'
          }}
        </a>
      {% endif %}


      {% if section.settings.image_3 != blank %}
        <a
          href="{{ section.settings.instagram_url }}"
          class="hilya-social__image"
          target="_blank"
          rel="noopener"
        >
          {{
            section.settings.image_3
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '300, 500, 700, 800',
              sizes: '(min-width: 750px) 16vw, 24vw',
              alt: 'Hilya Instagram'
          }}
        </a>
      {% endif %}


      {% if section.settings.image_4 != blank %}
        <a
          href="{{ section.settings.instagram_url }}"
          class="hilya-social__image"
          target="_blank"
          rel="noopener"
        >
          {{
            section.settings.image_4
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '300, 500, 700, 800',
              sizes: '(min-width: 750px) 16vw, 24vw',
              alt: 'Hilya Instagram'
          }}
        </a>
      {% endif %}

    </div>

  </div>

</section>


{% stylesheet %}

/* SECTION */

.hilya-social {
  width: 100%;
  max-width: 1080px;
  margin: 0 auto;
  padding: 8px 0 25px;
  box-sizing: border-box;
}


/* LAYOUT */

.hilya-social__inner {
  display: grid;
  grid-template-columns: 1fr 2.4fr;
  align-items: center;
  gap: 35px;
}


/* TEXT */

.hilya-social__intro {
  text-align: center;
}

.hilya-social__title {
  margin: 0 0 9px;
  color: #222222;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: 22px;
  line-height: 1;
  font-weight: 400;
  font-style: italic;
  letter-spacing: .01em;
}


/* INSTAGRAM LINK */

.hilya-social__instagram {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: #777777;
  text-decoration: none;
  font-family: Arial, sans-serif;
  font-size: 8px;
  line-height: 1;
  letter-spacing: .02em;
}

.hilya-social__instagram:hover {
  color: #111111;
}

.hilya-social__instagram-icon {
  width: 12px;
  height: 12px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.35;
  stroke-linecap: round;
  stroke-linejoin: round;
}


/* IMAGES */

.hilya-social__grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.hilya-social__image {
  display: block;
  width: 100%;
  aspect-ratio: 1.45 / 1;
  overflow: hidden;
  background: #f4f1eb;
}

.hilya-social__image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease;
}

.hilya-social__image:hover img {
  transform: scale(1.04);
}


/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {

  .hilya-social {
    padding-left: 28px;
    padding-right: 28px;
  }

  .hilya-social__inner {
    gap: 35px;
  }

}


/* MOBILE */

@media (max-width: 749px) {

  .hilya-social {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 25px 5px 34px;
}

  .hilya-social__inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hilya-social__intro {
    width: 100%;
  }

  .hilya-social__title {
    font-size: 18px;
  }

  .hilya-social__instagram {
    font-size: 8px;
  }

  .hilya-social__grid {
    width: 100%;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }

}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {

  .hilya-social__image img {
    transition: none;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Hilya Social",
  "settings": [
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Instagram image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Instagram image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Instagram image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Instagram image 4"
    }
  ],
  "presets": [
    {
      "name": "Hilya Social"
    }
  ]
}
{% endschema %}