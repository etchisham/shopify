{%- liquid
  assign hs_locale = request.locale.iso_code | split: '-' | first
  assign hs_name = section.settings.brand_name
  assign hs_text = section.settings.description
  assign hs_button = section.settings.button_label
  assign instagram_alt = 'home.instagram_alt' | t

  if hs_locale == 'ar'
    if section.settings.brand_name_ar != blank
      assign hs_name = section.settings.brand_name_ar
    endif
    if section.settings.description_ar != blank
      assign hs_text = section.settings.description_ar
    endif
    if section.settings.button_label_ar != blank
      assign hs_button = section.settings.button_label_ar
    endif
  endif
-%}

<section class="hilya-social">

  <div class="hilya-social__grid">

    {%- for i in (1..5) -%}
      {%- assign image_key = 'image_' | append: i -%}
      {%- assign social_image = section.settings[image_key] -%}

      {%- if social_image != blank -%}
        <a
          href="{{ section.settings.instagram_url }}"
          class="hilya-social__image"
          style="grid-column: {{ i }};"
          target="_blank"
          rel="noopener"
        >
          {{
            social_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '300, 500, 700, 900',
              sizes: '(min-width: 750px) 20vw, 25vw',
              alt: instagram_alt
          }}
        </a>
      {%- else -%}
        <span class="hilya-social__image" style="grid-column: {{ i }};"></span>
      {%- endif -%}
    {%- endfor -%}

    <div class="hilya-social__panel">

      <p class="hilya-social__eyebrow">{{ 'home.follow_journey' | t }}</p>

      <p class="hilya-social__brand">
        <svg class="hilya-social__icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3.5" y="3.5" width="17" height="17" rx="4"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1"></circle>
        </svg>
        <span>{{ hs_name | escape }}</span>
      </p>

      {%- if hs_text != blank -%}
        <p class="hilya-social__text">{{ hs_text | escape }}</p>
      {%- endif -%}

      {%- if hs_button != blank -%}
        <a
          class="hilya-social__button"
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener"
        >
          <span>{{ hs_button | escape }}</span>
          <span class="hilya-social__arrow" aria-hidden="true">→</span>
        </a>
      {%- endif -%}

    </div>

  </div>

</section>


{% stylesheet %}

/* SECTION (same width as Best Sellers) */

.hilya-social {
  width: 100vw;
  max-width: 100vw;
  margin-inline: calc(50% - 50vw);
  padding: 15px max(24px, calc((100vw - 1400px) / 2));
  box-sizing: border-box;
  overflow-x: clip;
}

.hilya-social__grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  grid-template-rows: minmax(0, 1fr);
  height: clamp(300px, 28vw, 420px);
  background: #f4f1eb;
}


/* IMAGES */

.hilya-social__image {
  position: relative;
  display: block;
  grid-row: 1;
  min-width: 0;
  overflow: hidden;
}

.hilya-social__image img {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease;
}

.hilya-social__image:hover img {
  transform: scale(1.04);
}


/* TEXT (over the center image) */

.hilya-social__panel {
  position: relative;
  z-index: 2;
  grid-column: 3;
  grid-row: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px 20px;
  background: rgba(0, 0, 0, 0.32); /* غطاء خفيف عشان الكلام يتقري، زوّده أو قلّله */
  color: #fff;
  text-align: center;
  pointer-events: none; /* الضغط على الصورة نفسها يفتح الإنستجرام */
}

.hilya-social__eyebrow {
  margin: 0 0 14px;
  color: #fff;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 11px;
  line-height: 1.2;
  font-weight: 500;
  letter-spacing: .3em;
  text-transform: uppercase;
  text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
}

.hilya-social__brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin: 0 0 14px;
  color: #fff;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: clamp(26px, 2.4vw, 34px);
  line-height: 1.1;
  font-weight: 400;
  text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
}

.hilya-social__icon {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  fill: none;
  stroke: #fff;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.hilya-social__text {
  max-width: 230px;
  margin: 0 0 22px;
  color: #fff;
  font-size: 13px;
  line-height: 1.6;
  text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
}

.hilya-social__button {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 13px 28px;
  border: 1px solid rgba(255, 255, 255, 0.85);
  color: #fff;
  text-decoration: none;
  font-size: 13px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: .03em;
  pointer-events: auto;
  transition: background-color .3s ease, color .3s ease;
}

.hilya-social__button:hover {
  background: #fff;
  color: #111;
}

.hilya-social__arrow {
  display: inline-flex;
  font-size: 15px;
  transition: transform .3s ease;
}

.hilya-social__button:hover .hilya-social__arrow {
  transform: translateX(4px);
}


/* LARGE DESKTOP */

@media (min-width: 1500px) {
  .hilya-social {
    padding-left: max(32px, calc((100vw - 1500px) / 2));
    padding-right: max(32px, calc((100vw - 1500px) / 2));
  }
}


/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {
  .hilya-social {
    padding-left: 28px;
    padding-right: 28px;
  }
}


/* TABLET + MOBILE: الكلام على الصور الخمسة كلها */

@media (max-width: 1100px) {

  .hilya-social__grid {
    height: 300px;
  }

  .hilya-social__panel {
    grid-column: 1 / -1;
    background: rgba(0, 0, 0, 0.38);
  }

  .hilya-social__text {
    max-width: 300px;
  }
}


/* MOBILE */

@media (max-width: 749px) {

  .hilya-social {
    padding: 10px 1rem;
  }

  .hilya-social__grid {
    height: 270px;
  }

  .hilya-social__panel {
    padding: 20px 16px;
  }

  .hilya-social__eyebrow {
    margin-bottom: 11px;
    font-size: 10px;
  }

  .hilya-social__brand {
    gap: 8px;
    margin-bottom: 11px;
    font-size: 26px;
  }

  .hilya-social__icon {
    width: 20px;
    height: 20px;
  }

  .hilya-social__text {
    max-width: 260px;
    margin-bottom: 18px;
    font-size: 12px;
  }

  .hilya-social__button {
    padding: 11px 22px;
    font-size: 12px;
  }
}


/* ARABIC / RTL */

[dir="rtl"] .hilya-social__eyebrow {
  font-size: 13px;
  letter-spacing: 0;
}

[dir="rtl"] .hilya-social__brand {
  font-size: 30px;
}

[dir="rtl"] .hilya-social__text {
  font-size: 15px;
  line-height: 1.8;
}

[dir="rtl"] .hilya-social__button {
  font-size: 14px;
  letter-spacing: 0;
}

[dir="rtl"] .hilya-social__arrow {
  transform: scaleX(-1);
}

[dir="rtl"] .hilya-social__button:hover .hilya-social__arrow {
  transform: scaleX(-1) translateX(4px);
}

@media (max-width: 749px) {
  [dir="rtl"] .hilya-social__eyebrow {
    font-size: 12px;
  }

  [dir="rtl"] .hilya-social__brand {
    font-size: 26px;
  }

  [dir="rtl"] .hilya-social__text {
    font-size: 14px;
  }

  [dir="rtl"] .hilya-social__button {
    font-size: 13px;
  }
}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {
  .hilya-social__image img {
    transition: none;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "Hilya Social",
  "settings": [
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (far left)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3 (center, the text sits on it)"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5 (far right)"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Name next to the Instagram icon",
      "default": "Hilya"
    },
    {
      "type": "text",
      "id": "brand_name_ar",
      "label": "Name - Arabic",
      "default": "حلية"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "For more inspiration, behind the scenes and special moments."
    },
    {
      "type": "text",
      "id": "description_ar",
      "label": "Description - Arabic",
      "default": "لمزيد من الإلهام وكواليس العمل واللحظات المميزة."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Follow Us"
    },
    {
      "type": "text",
      "id": "button_label_ar",
      "label": "Button label - Arabic",
      "default": "تابعنا"
    }
  ],
  "presets": [
    {
      "name": "Hilya Social"
    }
  ]
}
{% endschema %}