{%- liquid
  assign hs_locale = request.locale.iso_code | split: '-' | first
  assign hs_name = section.settings.brand_name
  assign hs_text = section.settings.description
  assign hs_button = section.settings.button_label
  assign instagram_alt = 'home.instagram_alt' | t

  if hs_locale == 'ar'
    if section.settings.brand_name_ar != blank
      assign hs_name = section.settings.brand_name_ar
    endif
    if section.settings.description_ar != blank
      assign hs_text = section.settings.description_ar
    endif
    if section.settings.button_label_ar != blank
      assign hs_button = section.settings.button_label_ar
    endif
  endif
-%}

<section
  class="hilya-social"
  style="--hs-extra-desktop: {{ section.settings.extra_space_desktop }}px; --hs-extra-mobile: {{ section.settings.extra_space_mobile }}px;"
>

  <div class="hilya-social__grid">

    {%- for i in (1..6) -%}
      {%- assign image_key = 'image_' | append: i -%}
      {%- assign x_key = image_key | append: '_x' -%}
      {%- assign y_key = image_key | append: '_y' -%}
      {%- assign social_image = section.settings[image_key] -%}

      {%- if social_image != blank -%}
        {%- assign pos_x = section.settings[x_key] | default: 50 -%}
        {%- assign pos_y = section.settings[y_key] | default: 50 -%}
        {%- assign pos_mx = pos_x -%}
        {%- assign pos_my = pos_y -%}
        {%- if section.settings.mobile_crop -%}
          {%- assign mx_key = image_key | append: '_x_mobile' -%}
          {%- assign my_key = image_key | append: '_y_mobile' -%}
          {%- assign pos_mx = section.settings[mx_key] | default: 50 -%}
          {%- assign pos_my = section.settings[my_key] | default: 50 -%}
        {%- endif -%}
        {%- capture pos_style -%}--pos-x: {{ pos_x }}%; --pos-y: {{ pos_y }}%; --pos-mx: {{ pos_mx }}%; --pos-my: {{ pos_my }}%;{%- endcapture -%}
        <a
          href="{{ section.settings.instagram_url }}"
          class="hilya-social__image hilya-social__image--{{ i }}"
          target="_blank"
          rel="noopener"
        >
          {{
            social_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '300, 500, 700, 900',
              sizes: '(min-width: 750px) 33vw, 50vw',
              alt: instagram_alt,
              style: pos_style
          }}
        </a>
      {%- else -%}
        <span class="hilya-social__image hilya-social__image--{{ i }}"></span>
      {%- endif -%}
    {%- endfor -%}

    <div class="hilya-social__head">

      <p class="hilya-social__eyebrow">{{ 'home.follow_journey' | t }}</p>

      <p class="hilya-social__brand">
        <svg class="hilya-social__icon" viewBox="0 0 24 24" aria-hidden="true">
          <defs>
            <linearGradient id="hilya-ig-grad" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0" stop-color="#feda75"></stop>
              <stop offset=".3" stop-color="#fa7e1e"></stop>
              <stop offset=".55" stop-color="#d62976"></stop>
              <stop offset=".8" stop-color="#962fbf"></stop>
              <stop offset="1" stop-color="#4f5bd5"></stop>
            </linearGradient>
          </defs>
          <rect x="3.5" y="3.5" width="17" height="17" rx="4"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1"></circle>
        </svg>
        <span>{{ hs_name | remove: '@' | escape }}</span>
      </p>

      {%- if hs_text != blank -%}
        <p class="hilya-social__text">{{ hs_text | escape }}</p>
      {%- endif -%}

    </div>

    {%- if hs_button != blank -%}
      <a
        class="hilya-social__button"
        href="{{ section.settings.instagram_url }}"
        target="_blank"
        rel="noopener"
      >
        <span>{{ hs_button | escape }}</span>
      </a>
    {%- endif -%}

  </div>

</section>


{% stylesheet %}

/* SECTION - smaller side spacing */

.hilya-social {
  width: 100vw;
  max-width: 100vw;
  margin-inline: calc(50% - 50vw);
  --hs-extra-top: var(--hs-extra-desktop, 0px);
  padding: calc(15px + var(--hs-extra-top)) max(12px, calc((100vw - 1660px) / 2)) 15px;
  box-sizing: border-box;
  overflow-x: clip;
  background: #f4f1eb;
}


/* =========================
   DESKTOP + TABLET
   3 columns, every column ends on the same bottom line
   left   : image 1 (tall) + image 3
   center : title + image 2 + image 4, button under it
   right  : image 5 (tall) + image 6, same layout as the left column
========================= */

.hilya-social__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1fr);
  /* 12 equal picture rows + button row */
  grid-template-rows: repeat(12, minmax(0, 1fr)) auto;
  column-gap: 10px;
  row-gap: 0;
  height: clamp(440px, 40vw, 680px);
  padding: 22px 8px 20px;
  box-sizing: border-box;
  background: #f4f1eb;
}


/* IMAGES */

.hilya-social__image {
  position: relative;
  display: block;
  min-width: 0;
  margin-bottom: 10px;
  overflow: hidden;
  isolation: isolate;
  border-radius: 16px;
  background: #e4dbcf;
}

/* left column */
.hilya-social__image--1 { grid-column: 1; grid-row: 1 / 8; }
.hilya-social__image--3 { grid-column: 1; grid-row: 8 / 13; }

/* center column */
.hilya-social__image--2 { grid-column: 2; grid-row: 4 / 8; }
.hilya-social__image--4 { grid-column: 2; grid-row: 8 / 13; }

/* right column */
.hilya-social__image--5 { grid-column: 3; grid-row: 1 / 8; }
.hilya-social__image--6 { grid-column: 3; grid-row: 8 / 13; }

.hilya-social__image img {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: var(--pos-x, 50%) var(--pos-y, 50%);
  transition: transform .5s ease;
}

.hilya-social__image:hover img {
  transform: scale(1.04);
}


/* TITLE (top of the center column) */

.hilya-social__head {
  grid-column: 2;
  grid-row: 1 / 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 10px;
  text-align: center;
}

.hilya-social__eyebrow {
  margin: 0 0 8px;
  color: #2a2420;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 11px;
  line-height: 1.2;
  font-weight: 500;
  letter-spacing: .3em;
  text-transform: uppercase;
}

.hilya-social__brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin: 0;
  color: #2a2420;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: clamp(26px, 2.6vw, 38px);
  line-height: 1.1;
  font-weight: 400;
}

.hilya-social__icon {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  fill: none;
  stroke: url(#hilya-ig-grad);
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* The description is not shown in this design.
   Delete this rule if you want it to appear under the name again. */
.hilya-social__text {
  display: none;
}


/* BUTTON (under the center column) - Instagram colors */

.hilya-social__button {
  grid-column: 2;
  grid-row: 13;
  justify-self: center;
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 13px 38px;
  border: 2px solid transparent;
  border-radius: 10px;
  background:
    linear-gradient(#fff, #fff) padding-box,
    linear-gradient(45deg, #feda75, #fa7e1e, #d62976, #962fbf, #4f5bd5) border-box;
  overflow: hidden;
  isolation: isolate;
  text-decoration: none;
  font-size: 14px;
  line-height: 1;
  font-weight: 600;
  letter-spacing: .03em;
}

.hilya-social__button::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(45deg, #feda75, #fa7e1e, #d62976, #962fbf, #4f5bd5);
  opacity: 0;
  transition: opacity .3s ease;
}

.hilya-social__button span {
  background: linear-gradient(45deg, #fa7e1e, #d62976, #962fbf, #4f5bd5);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  transition: color .3s ease, -webkit-text-fill-color .3s ease;
}

.hilya-social__button:hover::before {
  opacity: 1;
}

.hilya-social__button:hover span {
  background: none;
  -webkit-text-fill-color: #fff;
  color: #fff;
}


/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {
  .hilya-social {
    padding-left: 12px;
    padding-right: 12px;
  }

  .hilya-social__grid {
    padding: 20px 6px 18px;
  }

  .hilya-social__eyebrow {
    font-size: 10px;
    letter-spacing: .22em;
  }
}


/* =========================
   MOBILE
   2 columns, 6 pictures. Different heights, but both columns
   start on the same line and end on the same line (17 rows each).
   left: 6 + 5 + 6   |   right: 5 + 7 + 5
========================= */

@media (max-width: 749px) {

  .hilya-social {
    --hs-extra-top: var(--hs-extra-mobile, 0px);
    padding: calc(10px + var(--hs-extra-top)) 6px 10px;
  }

  .hilya-social__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* title row, 17 picture rows, button row */
    grid-template-rows: auto repeat(17, clamp(26px, 9.5vw, 48px)) auto;
    height: auto;
    padding: 20px 4px 16px;
    column-gap: 8px;
  }

  .hilya-social__head {
    grid-column: 1 / -1;
    grid-row: 1;
    padding-bottom: 16px;
  }

  .hilya-social__eyebrow {
    margin-bottom: 8px;
    font-size: 11px;
  }

  .hilya-social__brand {
    gap: 8px;
    font-size: 34px;
  }

  .hilya-social__icon {
    width: 30px;
    height: 30px;
  }

  /* left column: 6 + 5 + 6 */
  .hilya-social__image--1 { grid-column: 1; grid-row: 2 / 8; }
  .hilya-social__image--3 { grid-column: 1; grid-row: 8 / 13; }
  .hilya-social__image--5 { grid-column: 1; grid-row: 13 / 19; }

  /* right column: 5 + 7 + 5 */
  .hilya-social__image--2 { grid-column: 2; grid-row: 2 / 7; }
  .hilya-social__image--4 { grid-column: 2; grid-row: 7 / 14; }
  .hilya-social__image--6 { grid-column: 2; grid-row: 14 / 19; }

  .hilya-social__image img {
    object-position: var(--pos-mx, 50%) var(--pos-my, 50%);
  }
  .hilya-social__button {
    grid-column: 1 / -1;
    grid-row: 19;
    padding: 10px 28px;
    border-width: 1.5px;
    font-size: 12.5px;
  }
}


/* ARABIC / RTL */

[dir="rtl"] .hilya-social__eyebrow {
  font-size: 13px;
  letter-spacing: 0;
}

[dir="rtl"] .hilya-social__brand {
  font-size: 30px;
}

[dir="rtl"] .hilya-social__button {
  letter-spacing: 0;
}

@media (max-width: 749px) {
  [dir="rtl"] .hilya-social__eyebrow {
    font-size: 12px;
  }

  [dir="rtl"] .hilya-social__brand {
    font-size: 28px;
  }

}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {
  .hilya-social__image img,
  .hilya-social__button::before,
  .hilya-social__button span {
    transition: none;
  }
}

{% endstylesheet %}


