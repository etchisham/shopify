<section class="follow-our-journey">

  <div class="hilya-social__inner">

    <div class="hilya-social__intro">
      <p class="hilya-social__eyebrow">
        Follow Our Journey
      </p>

      <a
        href="{{ section.settings.instagram_url }}"
        class="hilya-social__handle"
        target="_blank"
        rel="noopener"
      >
        @hilyaeg
      </a>
    </div>


    <div class="hilya-social__grid">

      {% for block in section.blocks %}

        {% if block.settings.image != blank %}

          <a
            href="{{ section.settings.instagram_url }}"
            class="hilya-social__image"
            target="_blank"
            rel="noopener"
            {{ block.shopify_attributes }}
          >
            {{
              block.settings.image
              | image_url: width: 700
              | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600, 700',
                sizes: '(min-width: 750px) 12vw, 42vw',
                alt: 'Hilya Instagram'
            }}
          </a>

        {% endif %}

      {% endfor %}

    </div>

  </div>

</section>


{% stylesheet %}

.hilya-social {
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
  padding: 18px max(24px, calc((100vw - 1400px) / 2)) 42px;
  box-sizing: border-box;
  background: #ffffff;
}

.hilya-social__inner {
  display: grid;
  grid-template-columns: 1fr 2.4fr;
  align-items: center;
  gap: 55px;
}

/* INTRO */

.hilya-social__intro {
  text-align: center;
}

.hilya-social__eyebrow {
  margin: 0 0 6px;
  color: #222;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: 17px;
  line-height: 1.1;
  font-weight: 400;
}

.hilya-social__handle {
  color: #777;
  text-decoration: none;
  font-family: Arial, sans-serif;
  font-size: 8px;
  line-height: 1;
}

/* IMAGES */

.hilya-social__grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.hilya-social__image {
  display: block;
  overflow: hidden;
  aspect-ratio: 1 / 1;
  background: #f4f1eb;
}

.hilya-social__image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease;
}

.hilya-social__image:hover img {
  transform: scale(1.04);
}


/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {

  .hilya-social {
    padding-left: 28px;
    padding-right: 28px;
  }

  .hilya-social__inner {
    gap: 35px;
  }

}


/* MOBILE */

@media (max-width: 749px) {

  .hilya-social {
    width: 100%;
    max-width: none;
    margin-left: 0;
    padding: 25px 5px 34px;
  }

  .hilya-social__inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hilya-social__intro {
    width: 100%;
  }

  .hilya-social__eyebrow {
    font-size: 18px;
  }

  .hilya-social__handle {
    font-size: 8px;
  }

  .hilya-social__grid {
    width: 100%;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Hilya Social",
  "settings": [
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Instagram image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hilya Social",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}