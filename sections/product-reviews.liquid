{%- liquid
  assign rating_value = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign has_review_content = false
  if rating_count > 0 or section.blocks.size > 0
    assign has_review_content = true
  endif
-%}
{%- if has_review_content or request.design_mode -%}
  <section id="ProductReviews" class="fl-section full-width">
    <div class="fl-container">
      <div class="fl-quote">
        <div>
          <span class="fl-eyebrow">Verified buyer proof</span>
          <h2>{{ section.settings.heading }}</h2>
          {%- if rating_count > 0 -%}
            <p class="fl-price__current">{{ rating_value }} / 5</p>
            <p class="fl-section__intro">From {{ rating_count }} verified reviews. Critical reviews remain visible.</p>
          {%- endif -%}
        </div>
        <div>
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}{% render block %}
              {%- when 'review' -%}
                {%- if block.settings.quote != blank -%}
                  <figure class="fl-value" {{ block.shopify_attributes }}>
                    <div class="fl-rating"><span class="fl-rating__stars" aria-hidden="true">★★★★★</span><span>{{ block.settings.rating }}/5</span></div>
                    <blockquote>“{{ block.settings.quote }}”</blockquote>
                    <figcaption class="fl-quote__meta">{{ block.settings.customer }} · {{ block.settings.context }}{% if block.settings.verified %} · Verified purchase{% endif %}</figcaption>
                  </figure>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
          {%- if section.blocks.size == 0 and request.design_mode -%}<p>Add your review app block or genuine verified review blocks.</p>{%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it lives at home" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Verified review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Exact customer quote" },
        { "type": "text", "id": "customer", "label": "Customer name" },
        { "type": "text", "id": "context", "label": "Variant or use context" },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
