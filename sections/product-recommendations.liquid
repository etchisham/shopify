{% liquid
  assign recommendation_collection = section.settings.collection

  assign max_products = section.settings.max_products | default: 12
  assign loop_limit = max_products | plus: 1

  assign add_label = 'products.product.add_to_cart' | t
  assign sold_out_label = 'products.product.sold_out' | t

  assign carousel_locale = request.locale.iso_code | split: '-' | first
  assign rtl_locales = 'ar,fa,he,ur' | split: ','
  assign left_arrow_label = 'home.previous_products' | t
  assign right_arrow_label = 'home.next_products' | t
  # The arrow buttons are physical (left scrolls left). In RTL, scrolling left shows the NEXT products.
  if rtl_locales contains carousel_locale
    assign left_arrow_label = 'home.next_products' | t
    assign right_arrow_label = 'home.previous_products' | t
  endif

  assign rec_heading = section.settings.heading
  if carousel_locale == 'ar'
    assign rec_heading = section.settings.heading_ar | default: rec_heading
  endif
  if rec_heading == blank
    assign rec_heading = 'cart.you_may_also_like' | t
  endif
%}

<section
  class="product-recommendations"
  data-product-recommendations
>
  <div class="product-recommendations__inner">

    <div class="product-recommendations__header">
      <h2 class="product-recommendations__title">
        {{ rec_heading | escape }}
      </h2>
    </div>

    {% if recommendation_collection != blank and recommendation_collection.products_count > 0 %}

      <div class="product-recommendations__carousel">

        <button
          type="button"
          class="product-recommendations__arrow product-recommendations__arrow--prev"
          data-recommendations-prev
          aria-label="{{ left_arrow_label | escape }}"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        </button>

        <button
          type="button"
          class="product-recommendations__arrow product-recommendations__arrow--next"
          data-recommendations-next
          aria-label="{{ right_arrow_label | escape }}"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>

        <div
          class="product-recommendations__track"
          data-recommendations-track
        >

          {% assign shown = 0 %}

          {% for item in recommendation_collection.products limit: loop_limit %}

            {% if item.id == product.id %}
              {% continue %}
            {% endif %}

            {% if shown >= max_products %}
              {% break %}
            {% endif %}

            {% assign shown = shown | plus: 1 %}

            {% liquid
              assign rating = item.metafields.reviews.rating.value
              assign rating_count = item.metafields.reviews.rating_count.value | default: 0
              assign rating_value = rating.rating | default: rating
              assign rating_maximum = rating.scale_max | default: 5
              assign rating_display = rating_value | round: 1 | append: '' | remove: '.0'

              comment
                Hover picture: the "Detail" image of the same material (Gold / Silver), found through the image alt text.
                Alt names used in the store: "Gold Plated - Front / Detail / Lifestyle" and "Silver Plated - Front / Detail / Lifestyle".
                If there is no Detail image, the first other image of the same material is used.
              endcomment
              assign hover_image = nil
              assign featured_alt = item.featured_image.alt | downcase
              assign wanted_material = ''
              if featured_alt contains 'gold' or featured_alt contains 'ذهب'
                assign wanted_material = 'gold'
              elsif featured_alt contains 'silver' or featured_alt contains 'فض'
                assign wanted_material = 'silver'
              endif

              assign same_material_image = nil

              for candidate in item.images
                if candidate.id == item.featured_image.id
                  continue
                endif

                assign candidate_alt = candidate.alt | downcase
                assign same_material = false

                if wanted_material == 'gold'
                  if candidate_alt contains 'gold' or candidate_alt contains 'ذهب'
                    assign same_material = true
                  endif
                elsif wanted_material == 'silver'
                  if candidate_alt contains 'silver' or candidate_alt contains 'فض'
                    assign same_material = true
                  endif
                else
                  assign same_material = true
                endif

                if same_material
                  if same_material_image == blank
                    assign same_material_image = candidate
                  endif

                  if candidate_alt contains 'detail'
                    assign hover_image = candidate
                    break
                  endif
                endif
              endfor

              if hover_image == blank
                assign hover_image = same_material_image
              endif
            %}

            <article class="product-recommendations__item" data-rec-item>

              <div class="product-recommendations__media">

                <a
                  href="{{ item.url }}"
                  class="product-recommendations__image-link{% if hover_image != blank %} has-hover-image{% endif %}"
                  aria-label="{{ item.title | escape }}"
                >

                  {% if item.featured_image != blank %}

                    {{
                      item.featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 720, 900',
                        sizes: '(min-width: 990px) 25vw, 70vw',
                        alt: item.featured_image.alt | default: item.title
                      }}

                    {%- if hover_image != blank -%}
                      {{
                        hover_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '360, 540, 720, 900',
                          sizes: '(min-width: 990px) 25vw, 70vw',
                          class: 'product-recommendations__hover-image',
                          alt: ''
                      }}
                    {%- endif -%}

                  {% else %}

                    {{ 'product-1' | placeholder_svg_tag }}

                  {% endif %}

                </a>

                <div class="product-recommendations__quick-wrap">

                  {% if item.available %}

                    <a class="product-recommendations__quick" href="{{ item.url }}" data-quick-view>
                      <svg class="product-recommendations__quick-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 7H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
                      <span class="product-recommendations__quick-text">+ {{ add_label }}</span>
                    </a>

                  {% else %}

                    <span class="product-recommendations__quick is-disabled is-sold-out">
                      <span class="product-recommendations__quick-text">{{ sold_out_label }}</span>
                    </span>

                  {% endif %}

                </div>

              </div>

              <div class="product-recommendations__info">

                <h3 class="product-recommendations__product-title">
                  <a href="{{ item.url }}">
                    {{ item.title | escape }}
                  </a>
                </h3>

                {% if settings.card_show_rating and rating_value != blank and rating_count > 0 %}
                  <div
                    class="product-recommendations__rating"
                    role="img"
                    aria-label="{{ 'products.product.rating' | t: rating: rating_display, maximum: rating_maximum | escape }}, {{ 'products.product.rating_count' | t: count: rating_count | escape }}"
                  >
                    <span class="product-recommendations__rating-star" aria-hidden="true">★</span>
                    <span class="product-recommendations__rating-value">{{ rating_display }}</span>
                    <span class="product-recommendations__rating-count">({{ 'products.product.rating_count' | t: count: rating_count }})</span>
                  </div>
                {% endif %}

                <div class="product-recommendations__price" data-card-price>
                  {% render 'price', product: item %}
                </div>

              </div>

            </article>

          {% endfor %}

        </div>

      </div>

    {% endif %}

  </div>
</section>

<script>
  (() => {
    const section = document.currentScript?.previousElementSibling;

    if (!section) return;

    const track = section.querySelector('[data-recommendations-track]');
    const previous = section.querySelector('[data-recommendations-prev]');
    const next = section.querySelector('[data-recommendations-next]');

    if (!track) return;

    const isRtl = () => window.getComputedStyle(track).direction === 'rtl';

    const updateArrows = () => {
      const max = track.scrollWidth - track.clientWidth;
      const fromLeft = isRtl() ? max + track.scrollLeft : track.scrollLeft;
      const fromRight = max - fromLeft;

      previous?.setAttribute('data-hidden', fromLeft <= 1 ? 'true' : 'false');
      next?.setAttribute('data-hidden', fromRight <= 1 ? 'true' : 'false');
    };

    previous?.addEventListener('click', () => {
      track.scrollBy({
        left: -track.clientWidth,
        behavior: 'smooth'
      });
    });

    next?.addEventListener('click', () => {
      track.scrollBy({
        left: track.clientWidth,
        behavior: 'smooth'
      });
    });

    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    window.addEventListener('load', updateArrows);
    updateArrows();

    /* Narrow screens: touch already swipes the row; this lets a mouse drag it too */
    const dragQuery = window.matchMedia('(max-width: 749px)');
    let drag = null;
    let suppressClick = false;

    track.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0 || !dragQuery.matches) return;
      drag = { x: event.clientX, left: track.scrollLeft, moved: false };
    });

    window.addEventListener('pointermove', (event) => {
      if (!drag) return;
      const dx = event.clientX - drag.x;
      if (!drag.moved && Math.abs(dx) < 5) return;

      if (!drag.moved) {
        drag.moved = true;
        track.style.scrollSnapType = 'none';
        track.style.scrollBehavior = 'auto';
        track.classList.add('is-dragging');
      }

      track.scrollLeft = drag.left - dx;
    });

    const endDrag = () => {
      if (!drag) return;

      if (drag.moved) {
        suppressClick = true;
        setTimeout(() => { suppressClick = false; }, 60);
        track.style.scrollSnapType = '';
        track.style.scrollBehavior = '';
        track.classList.remove('is-dragging');
      }

      drag = null;
    };

    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    /* After a drag, do not open the product under the mouse */
    track.addEventListener('click', (event) => {
      if (!suppressClick) return;
      event.preventDefault();
      event.stopPropagation();
    }, true);

    /*
      Touch screens: hold a finger on a card to see its second picture.
      It stays while the finger is down (even while scrolling) and goes back when the finger lifts.
    */
    let holdTimer = null;
    let heldMedia = null;

    const releaseHold = () => {
      clearTimeout(holdTimer);

      if (heldMedia) {
        heldMedia.classList.remove('is-touch-hover');
        heldMedia = null;
      }
    };

    track.addEventListener('touchstart', (event) => {
      const media = event.target.closest?.('.product-recommendations__media');

      if (!media || !media.querySelector('.product-recommendations__hover-image')) return;

      releaseHold();

      /* Short hold, so a quick tap or flick does not flash the second picture */
      holdTimer = setTimeout(() => {
        media.classList.add('is-touch-hover');
        heldMedia = media;
      }, 100);
    }, { passive: true });

    track.addEventListener('touchend', releaseHold, { passive: true });
    track.addEventListener('touchcancel', releaseHold, { passive: true });

    /* A long press would open the link menu and cancel the hold */
    track.addEventListener('contextmenu', (event) => {
      if (
        window.matchMedia('(hover: none)').matches &&
        event.target.closest?.('.product-recommendations__image-link')
      ) {
        event.preventDefault();
      }
    });

    /*
      Scroll reveal, the same feel as the home page: the heading first, then the cards one after
      the other. What is already passed, or hidden inside the row, shows without motion.
    */
    if (
      !('IntersectionObserver' in window) ||
      (window.Shopify && window.Shopify.designMode) ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) return;

    const header = section.querySelector('.product-recommendations__header');
    const cards = Array.from(track.querySelectorAll('[data-rec-item]'));
    const targets = [header].concat(cards).filter(Boolean);

    section.classList.add('has-reveal');
    targets.forEach((el) => el.classList.add('hr-item'));

    const io = new IntersectionObserver((entries) => {
      const shown = entries
        .filter((entry) => entry.isIntersecting)
        .map((entry) => entry.target);

      if (!shown.length) return;

      shown.sort((a, b) =>
        a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1
      );

      const withHeader = shown.includes(header);
      let position = 0;

      shown.forEach((el) => {
        if (el === header) {
          el.style.setProperty('--reveal-delay', '0s');
        } else {
          el.style.setProperty('--reveal-delay', ((withHeader ? 0.5 : 0) + position * 0.28) + 's');
          position++;
        }

        el.classList.add('is-revealed');
        io.unobserve(el);
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -15% 0px' });

    const settle = () => {
      const row = track.getBoundingClientRect();

      targets.forEach((el) => {
        if (el.classList.contains('is-revealed')) return;

        const box = el.getBoundingClientRect();

        if (box.bottom < 0 || box.left >= row.right - 1 || box.right <= row.left + 1) {
          el.classList.add('hilya-instant', 'is-revealed');
          io.unobserve(el);
        }
      });
    };

    targets.forEach((el) => io.observe(el));
    settle();
    window.addEventListener('load', () => setTimeout(settle, 150));
  })();
</script>

{% stylesheet %}

.product-recommendations,
.product-recommendations *,
.product-recommendations *::before,
.product-recommendations *::after {
  box-sizing: border-box;
}

/* Let the section use the full screen width (some themes wrap sections in a narrow container) */
.shopify-section:has(> .product-recommendations) {
  width: 100%;
  max-width: none;
  margin-inline: 0;
}

.product-recommendations {
  /* Same value as .explore-collection so both sections sit the same distance from the section above */
  --section-gap: 2.5rem;

  width: 100%;
  max-width: 100%;
  margin-top: 0;
  padding: var(--section-gap) 0 1rem;
  overflow-x: clip;
}

.product-recommendations__inner {
  width: 100%;
  max-width: 98rem;
  margin: 0 auto;
  padding: 0 clamp(1rem, 4vw, 4rem);
}

.product-recommendations__header {
  display: flex;
  justify-content: center;
  margin-bottom: 2.2rem;
  text-align: center;
}

.product-recommendations__title {
  position: relative;
  margin: 0;
  color: var(--hilya-ink);
  font-family: "Cormorant Garamond", "Bodoni Moda", "Didot", serif;
  font-size: 28px;
  font-style: italic;
  font-weight: 500;
  letter-spacing: 0.01em;
  line-height: 1.1;
}

/* the thin rose gold line under the title (same as the home page sections) */
.product-recommendations__title::after {
  content: "";
  position: absolute;
  bottom: -12px;
  left: 50%;
  width: 2.4rem;
  height: 1px;
  margin-left: -1.2rem;
  background: var(--hilya-rose);
}


/* =========================================
   CAROUSEL
   Card size is controlled from these 4 values:
   --per-view : cards visible at once
   --gap      : space between cards
   --ratio-w / --ratio-h : image shape (3 / 4 = portrait, 2 / 3 = taller)
========================================= */

.product-recommendations__carousel {
  --per-view: 4;
  --gap: 1.5rem;
  --ratio-w: var(--card-ratio-w, 3);
  --ratio-h: var(--card-ratio-h, 4);

  position: relative;
  container-type: inline-size;
}

.product-recommendations__track {
  display: flex;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  gap: var(--gap);
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  scroll-behavior: smooth;

  /* room under the cards so they are not cut at the bottom while they rise */
  padding-bottom: 40px;
  margin-bottom: -40px;
}

.product-recommendations__track::-webkit-scrollbar {
  display: none;
}

/* Few products: keep them in the middle under the heading.
   The auto margins turn into 0 when the row is full, so scrolling still works. */
.product-recommendations__track > :first-child {
  margin-inline-start: auto;
}

.product-recommendations__track > :last-child {
  margin-inline-end: auto;
}

.product-recommendations__item {
  min-width: 0;
  flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  scroll-snap-align: start;
}


/* =========================================
   ARROWS (centered on the image)
========================================= */

.product-recommendations__arrow {
  position: absolute;

  /* half of the image height = exact middle of the image */
  top: calc(
    (100cqw - (var(--per-view) - 1) * var(--gap)) / var(--per-view)
    * var(--ratio-h) / var(--ratio-w) / 2
  );

  z-index: 3;
  display: grid;
  width: 3.25rem;
  height: 3.25rem;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 0.9rem;
  background: #fff;
  color: var(--hilya-ink);
  cursor: pointer;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.16);
  opacity: 0;
  pointer-events: none;
  transform: translateY(-50%);
  transition:
    opacity 200ms ease,
    background-color 160ms ease;
}

.product-recommendations__arrow--prev {
  left: -1.625rem;
}

.product-recommendations__arrow--next {
  right: -1.625rem;
}

.product-recommendations__arrow[data-hidden="true"] {
  visibility: hidden;
}

@media (hover: hover) and (pointer: fine) {
  .product-recommendations__carousel:hover .product-recommendations__arrow {
    opacity: 1;
    pointer-events: auto;
  }

  .product-recommendations__carousel:has(:focus-visible) .product-recommendations__arrow {
    opacity: 1;
    pointer-events: auto;
  }
}

.product-recommendations__arrow:hover {
  background: var(--hilya-rose-deep);
  color: #fff;
}


/* =========================================
   IMAGE
========================================= */

.product-recommendations__media {
  position: relative;
  overflow: hidden;
  border-radius: var(--product-card-radius, 0);
  background: #f5f5f1;
}

.product-recommendations__image-link {
  position: relative;
  display: block;
  width: 100%;
  aspect-ratio: var(--ratio-w) / var(--ratio-h);
  text-decoration: none;
}

.product-recommendations__image-link img,
.product-recommendations__image-link svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-recommendations__image-link img {
  transition: transform 400ms ease;
}

.product-recommendations__image-link:hover img {
  transform: scale(1.025);
}

/* Second picture on hover (same material), instead of a zoom */
.product-recommendations__image-link img.product-recommendations__hover-image {
  position: absolute;
  inset: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 350ms ease;
}

.product-recommendations__image-link.has-hover-image:hover img {
  transform: none;
}

@media (hover: hover) and (pointer: fine) {
  .product-recommendations__media:hover .product-recommendations__hover-image {
    opacity: 1;
  }
}

/* Touch screens: the second picture shows while a finger is held on the card */
.product-recommendations__media.is-touch-hover .product-recommendations__hover-image {
  opacity: 1;
}

@media (hover: none) {
  .product-recommendations__image-link,
  .product-recommendations__image-link img {
    -webkit-touch-callout: none;
    user-select: none;
  }
}


/* =========================================
   ADD TO CART (appears on hover)
========================================= */

.product-recommendations__quick-wrap {
  position: absolute;
  inset-inline: 0.75rem;
  bottom: 0.75rem;
  z-index: 2;
  opacity: 0;
  pointer-events: none;
  transform: translateY(0.5rem);
  transition:
    opacity 220ms ease,
    transform 220ms ease;
}

.product-recommendations__media:hover .product-recommendations__quick-wrap {
  opacity: 1;
  pointer-events: auto;
  transform: none;
}

/* Keyboard focus only (a mouse click must not keep the button visible) */
.product-recommendations__media:has(:focus-visible) .product-recommendations__quick-wrap {
  opacity: 1;
  pointer-events: auto;
  transform: none;
}

.product-recommendations__quick {
  display: flex;
  width: 100%;
  min-height: 3.1rem;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 1rem;
  border: 0;
  border-radius: 0.85rem;
  background: var(--color-background, #fffcf7);
  color: var(--hilya-ink);
  font: inherit;
  font-size: 0.9rem;
  line-height: 1.2;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.08);

  /* only the background fades: the text colour changes at once so the letters stay sharp */
  transition: background-color 160ms ease;
}

/* hover: the same deep rose gold as the Add to cart on the product page */
.product-recommendations__quick:hover {
  background: var(--hilya-rose-deep);
  color: #fff;
}

/* The icon is only used on mobile */
.product-recommendations__quick-icon {
  display: none;
}

.product-recommendations__quick.is-disabled,
.product-recommendations__quick:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

/* sold out: no hover colour */
.product-recommendations__quick.is-disabled:hover,
.product-recommendations__quick:disabled:hover {
  background: var(--color-background, #fffcf7);
  color: var(--hilya-ink);
}

/* Touch screens have no hover: keep the button visible and hide the arrows (swipe instead) */
@media (hover: none) {
  .product-recommendations__arrow {
    display: none;
  }

  .product-recommendations__quick-wrap {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .product-recommendations__quick {
    min-height: 2.6rem;
    font-size: 0.82rem;
  }
}


/* =========================================
   INFO
========================================= */

.product-recommendations__info {
  display: grid;
  justify-items: center;
  gap: 5px;
  padding-top: 12px;
  text-align: center;
}

.product-recommendations__product-title {
  min-width: 0;
  width: 100%;
  margin: 0;
  overflow: hidden;
  color: var(--color-foreground, #222);
  font-family: var(--font-body-family);
  font-size: clamp(0.78rem, 0.82vw, 0.92rem);
  font-weight: 400;
  letter-spacing: 0.02em;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-recommendations__product-title a {
  color: inherit;
  text-decoration: none;
}


/* Price (same sizes as the product card on every page) */

.product-recommendations__price {
  display: flex;
  justify-content: center;
  width: 100%;
  text-align: center;
}

.product-recommendations__price .price {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 7px;
  width: 100%;
  font-size: 0.8rem;
  line-height: 1.25;
  text-align: center;
}

/* Phones: the two price lines are stacked (a column), where align-items: baseline
   pushes them to the start side. center keeps them in the middle under the name. */
@media (max-width: 749px) {
  .product-recommendations__price .price {
    align-items: center;
  }
}

.product-recommendations__price .price__current {
  color: var(--color-foreground, #222);
  font-size: 0.88rem;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.product-recommendations__price .price__compare {
  color: var(--hilya-muted);
  font-size: 0.74rem;
}


/* Rating */

.product-recommendations__rating {
  display: flex;
  min-height: 1.35rem;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.3rem;
  line-height: 1;
}

.product-recommendations__rating-star {
  color: #f5b301;
  font-size: 1.05rem;
  line-height: 1;
}

.product-recommendations__rating-value {
  font-size: 0.875rem;
  font-weight: 600;
}

.product-recommendations__rating-count {
  color: var(--hilya-muted);
  font-size: 0.8rem;
  white-space: nowrap;
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 989px) {
  .product-recommendations__carousel {
    --per-view: 3.3; /* same as the home page rows */
  }
}


/* =========================================
   MOBILE (Artsy style)
   Full-width swipe row + small cart icon on the right of the image
========================================= */

@media (max-width: 749px) {

  .product-recommendations {
    --section-gap: 1.75rem;

    /* Break out of the page side padding: the row runs from screen edge to screen edge */
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  .product-recommendations__inner {
    padding-inline: 0;
  }

  .product-recommendations__header {
    margin-bottom: 1.2rem;
    padding-inline: 1rem;
  }

  .product-recommendations__title {
    font-size: 1.5rem;
  }

  /* Card size: about 2.2 cards visible, same size as the home page rows */
  .product-recommendations__carousel {
    --per-view: 2.2;
    --gap: 0.75rem;
  }

  /* No arrows on mobile: just swipe */
  .product-recommendations__arrow {
    display: none;
  }

  .product-recommendations__track {
    padding-inline: 1rem;
    scroll-padding-inline: 1rem;
    cursor: grab;
  }

  .product-recommendations__track.is-dragging {
    cursor: grabbing;
  }

  .product-recommendations__track img,
  .product-recommendations__track a {
    -webkit-user-drag: none;
    user-select: none;
  }

  /* Cart icon on the right of the image (same color as the page, no border) */
  .product-recommendations__quick-wrap {
    inset-inline-start: auto;
    inset-inline-end: 0.6rem;
    bottom: 0.6rem;
  }

  .product-recommendations__quick {
    width: 2.4rem;
    height: 2.4rem;
    min-height: 0;
    padding: 0;
    border: 0;
    border-radius: 0.35rem;
    box-shadow: 0 1px 8px rgb(0 0 0 / 14%);
  }

  .product-recommendations__quick-icon {
    display: block;
    width: 1.3rem;
    height: 1.3rem;
  }

  /* The words stay for screen readers only */
  .product-recommendations__quick-text {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Sold out keeps a small text label (an icon alone would not say it) */
  .product-recommendations__quick.is-sold-out {
    width: auto;
    height: auto;
    min-height: 2rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.72rem;
  }

  .product-recommendations__quick.is-sold-out .product-recommendations__quick-icon {
    display: none;
  }

  .product-recommendations__quick.is-sold-out .product-recommendations__quick-text {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip-path: none;
  }
}

@media (max-width: 27rem) {
  .product-recommendations__info {
    padding-top: 9px;
    gap: 4px;
  }

  .product-recommendations__product-title {
    font-size: 0.78rem;
  }

  .product-recommendations__price .price__current {
    font-size: 0.82rem;
  }

  .product-recommendations__price .price__compare {
    font-size: 0.68rem;
  }

  .product-recommendations__rating-star {
    font-size: 0.92rem;
  }

  .product-recommendations__rating-count {
    font-size: 0.72rem;
  }
}

/* =========================================
   REVEAL ON SCROLL
   The script marks the heading and the cards with hr-item.
   Same feel as the home page sections: they rise one after the other.
========================================= */

@keyframes recommendations-reveal {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
}

.product-recommendations.has-reveal .hr-item:not(.is-revealed) {
  opacity: 0;
}

.product-recommendations.has-reveal .hr-item.is-revealed {
  animation: recommendations-reveal 2s cubic-bezier(.22, .8, .3, 1) backwards;
  animation-delay: var(--reveal-delay, 0s);
}

.product-recommendations.has-reveal .is-revealed.hilya-instant {
  animation: none;
}

/* the line under the title is drawn from the middle to both sides after the title appears */
.product-recommendations.has-reveal .product-recommendations__header.hr-item .product-recommendations__title::after {
  transform: scaleX(0);
  transition: transform 1.6s cubic-bezier(.22, .8, .3, 1) .7s;
}

.product-recommendations.has-reveal .product-recommendations__header.is-revealed .product-recommendations__title::after {
  transform: scaleX(1);
}

.product-recommendations.has-reveal .product-recommendations__header.hilya-instant .product-recommendations__title::after {
  transition: none;
}

@media (prefers-reduced-motion: reduce) {
  .product-recommendations__track {
    scroll-behavior: auto;
  }

  .product-recommendations__image-link img,
  .product-recommendations__quick-wrap {
    transition: none;
  }
}

/* ARABIC / RTL */

/* Arabic: no italic, and more room between the lines */
[dir="rtl"] .product-recommendations__title {
  font-style: normal;
  font-weight: 400;
  line-height: 1.4;
}

[dir="rtl"] .product-recommendations__product-title {
  font-size: 1rem;
  line-height: 1.6;
}

[dir="rtl"] .product-recommendations__rating-count {
  font-size: .85rem;
}

{% endstylesheet %}

