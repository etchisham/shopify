{% liquid
  assign recommendation_collection = section.settings.collection

  assign max_products = section.settings.max_products | default: 12
  assign loop_limit = max_products | plus: 1

  assign locale_root = request.locale.iso_code | split: '-' | first
  assign add_label = 'products.product.add_to_cart' | t
  assign sold_out_label = 'products.product.sold_out' | t
  assign options_label = 'Select options'
  if locale_root == 'ar'
    assign options_label = 'اختر الخيارات'
  endif
%}

<section
  class="product-recommendations"
  data-product-recommendations
  data-add-label="{{ add_label | escape }}"
  data-sold-out-label="{{ sold_out_label | escape }}"
>
  <div class="product-recommendations__inner">

    <div class="product-recommendations__header">
      <h2 class="product-recommendations__title">
        {{ section.settings.heading | escape }}
      </h2>
    </div>

    {% if recommendation_collection != blank and recommendation_collection.products_count > 0 %}

      <div class="product-recommendations__carousel">

        <button
          type="button"
          class="product-recommendations__arrow product-recommendations__arrow--prev"
          data-recommendations-prev
          aria-label="Previous products"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        </button>

        <button
          type="button"
          class="product-recommendations__arrow product-recommendations__arrow--next"
          data-recommendations-next
          aria-label="Next products"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>

        <div
          class="product-recommendations__track"
          data-recommendations-track
        >

          {% assign shown = 0 %}

          {% for item in recommendation_collection.products limit: loop_limit %}

            {% if item.id == product.id %}
              {% continue %}
            {% endif %}

            {% if shown >= max_products %}
              {% break %}
            {% endif %}

            {% assign shown = shown | plus: 1 %}

            {% liquid
              assign rating = item.metafields.reviews.rating.value
              assign rating_count = item.metafields.reviews.rating_count.value | default: 0
              assign rating_value = rating.rating | default: rating
              assign rating_maximum = rating.scale_max | default: 5
              assign rating_display = rating_value | round: 1 | append: '' | remove: '.0'
              assign review_word = 'review'
              if rating_count != 1
                assign review_word = 'reviews'
              endif

              assign variant = item.selected_or_first_available_variant
              assign min_quantity = variant.quantity_rule.min | default: 1
              assign form_id = 'RecForm-' | append: item.id

              comment
                Products that need the customer to choose something first
                (personalization / selling plan) open the product page instead.
              endcomment
              assign go_to_product = false
              if item.tags contains 'Name' or item.tags contains 'Date' or item.requires_selling_plan or item.metafields.custom.personalization_required.value == true
                assign go_to_product = true
              endif
              if item.variants.size > 1 and section.settings.quick_add == 'view_product'
                assign go_to_product = true
              endif

              assign show_select = false
              if item.variants.size > 1 and go_to_product == false and item.available
                assign show_select = true
              endif
            %}

            <article class="product-recommendations__item" data-rec-item>

              <div class="product-recommendations__media">

                <a
                  href="{{ item.url }}"
                  class="product-recommendations__image-link"
                  aria-label="{{ item.title | escape }}"
                >

                  {% if item.featured_image != blank %}

                    {{
                      item.featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 720, 900',
                        sizes: '(min-width: 990px) 25vw, 70vw',
                        alt: item.featured_image.alt | default: item.title
                      }}

                  {% else %}

                    {{ 'product-1' | placeholder_svg_tag }}

                  {% endif %}

                </a>

                <div class="product-recommendations__quick-wrap">

                  {% if go_to_product %}

                    <a class="product-recommendations__quick" href="{{ item.url }}">
                      <svg class="product-recommendations__quick-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg>
                      <span class="product-recommendations__quick-text">{{ options_label }}</span>
                    </a>

                  {% elsif item.available %}

                    {% form 'product', item,
                      id: form_id,
                      class: 'product-recommendations__form product-form',
                      data-product-title: item.title
                    %}
                      {% unless show_select %}
                        <input type="hidden" name="id" value="{{ variant.id }}">
                      {% endunless %}
                      <input type="hidden" name="quantity" value="{{ min_quantity }}">

                      <button
                        type="submit"
                        name="add"
                        class="product-recommendations__quick"
                        data-rec-add
                      >
                        <svg class="product-recommendations__quick-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8.5h11l.8 11H3.2z"/><path d="M7 8.5V7a2.5 2.5 0 0 1 5 0v1.5"/><path d="M19 3v6M16 6h6"/></svg>
                        <span class="product-recommendations__quick-text">+ {{ add_label }}</span>
                      </button>
                    {% endform %}

                  {% else %}

                    <span class="product-recommendations__quick is-disabled is-sold-out">
                      <span class="product-recommendations__quick-text">{{ sold_out_label }}</span>
                    </span>

                  {% endif %}

                </div>

              </div>

              <div class="product-recommendations__info">

                <h3 class="product-recommendations__product-title">
                  <a href="{{ item.url }}">
                    {{ item.title | escape }}
                  </a>
                </h3>

                {% if show_select %}
                  <div class="product-recommendations__variant">
                    <select
                      class="product-recommendations__select"
                      name="id"
                      form="{{ form_id }}"
                      aria-label="{{ item.title | escape }}"
                      data-variant-select
                    >
                      {%- for v in item.variants -%}
                        <option
                          value="{{ v.id }}"
                          {% if v.id == variant.id %}selected{% endif %}
                          data-available="{{ v.available }}"
                          data-price="{{ v.price | money | escape }}"
                          data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | escape }}{% endif %}"
                          data-image="{% if v.featured_image %}{{ v.featured_image | image_url: width: 900 }}{% endif %}"
                        >
                          {{- v.title | escape -}}
                          {%- unless v.available %} · {{ sold_out_label }}{% endunless -%}
                        </option>
                      {%- endfor -%}
                    </select>
                    <span class="product-recommendations__chevron" aria-hidden="true"></span>
                  </div>
                {% endif %}

                {% if settings.card_show_rating and rating_value != blank and rating_count > 0 %}
                  <div
                    class="product-recommendations__rating"
                    role="img"
                    aria-label="{{ rating_display }} / {{ rating_maximum }} ({{ rating_count }} {{ review_word }})"
                  >
                    <span class="product-recommendations__rating-star" aria-hidden="true">★</span>
                    <span class="product-recommendations__rating-value">{{ rating_display }}</span>
                    <span class="product-recommendations__rating-count">({{ rating_count }} {{ review_word }})</span>
                  </div>
                {% endif %}

                <div class="product-recommendations__price" data-card-price>
                  {% render 'price', product: item %}
                </div>

              </div>

            </article>

          {% endfor %}

        </div>

      </div>

    {% endif %}

  </div>
</section>

<script>
  (() => {
    const section = document.currentScript?.previousElementSibling;

    if (!section) return;

    const track = section.querySelector('[data-recommendations-track]');
    const previous = section.querySelector('[data-recommendations-prev]');
    const next = section.querySelector('[data-recommendations-next]');

    if (!track) return;

    const isRtl = () => window.getComputedStyle(track).direction === 'rtl';

    const updateArrows = () => {
      const max = track.scrollWidth - track.clientWidth;
      const fromLeft = isRtl() ? max + track.scrollLeft : track.scrollLeft;
      const fromRight = max - fromLeft;

      previous?.setAttribute('data-hidden', fromLeft <= 1 ? 'true' : 'false');
      next?.setAttribute('data-hidden', fromRight <= 1 ? 'true' : 'false');
    };

    previous?.addEventListener('click', () => {
      track.scrollBy({
        left: -track.clientWidth,
        behavior: 'smooth'
      });
    });

    next?.addEventListener('click', () => {
      track.scrollBy({
        left: track.clientWidth,
        behavior: 'smooth'
      });
    });

    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    window.addEventListener('load', updateArrows);
    updateArrows();

    /* Variant dropdown: update price, image and the add button */
    section.addEventListener('change', (event) => {
      const select = event.target.closest?.('[data-variant-select]');
      if (!select) return;

      const card = select.closest('[data-rec-item]');
      const option = select.options[select.selectedIndex];
      if (!card || !option) return;

      const priceBox = card.querySelector('[data-card-price]');
      const button = card.querySelector('[data-rec-add]');
      const image = card.querySelector('.product-recommendations__image-link img');

      if (priceBox && option.dataset.price) {
        const wrapper = document.createElement('div');
        wrapper.className = 'price';

        const current = document.createElement('span');
        current.className = 'price__current';
        current.textContent = option.dataset.price;
        wrapper.appendChild(current);

        if (option.dataset.compare) {
          const compare = document.createElement('s');
          compare.className = 'price__compare';
          compare.textContent = option.dataset.compare;
          wrapper.appendChild(compare);
        }

        priceBox.replaceChildren(wrapper);
      }

      if (image && option.dataset.image) {
        image.removeAttribute('srcset');
        image.src = option.dataset.image;
      }

      if (button) {
        const available = option.dataset.available === 'true';
        button.disabled = !available;
        button.classList.toggle('is-sold-out', !available);

        const text = button.querySelector('.product-recommendations__quick-text');
        if (text) {
          text.textContent = available
            ? '+ ' + section.dataset.addLabel
            : section.dataset.soldOutLabel;
        }
      }
    });

  })();
</script>

{% stylesheet %}

.product-recommendations,
.product-recommendations *,
.product-recommendations *::before,
.product-recommendations *::after {
  box-sizing: border-box;
}

/* Let the section use the full screen width (some themes wrap sections in a narrow container) */
.shopify-section:has(> .product-recommendations) {
  width: 100% !important;
  max-width: none !important;
  margin-inline: 0 !important;
}

.product-recommendations {
  /* Same value as .explore-collection so both sections sit the same distance from the section above */
  --section-gap: 2.5rem;

  width: 100%;
  max-width: 100%;
  margin-top: 0;
  padding: var(--section-gap) 0 1rem;
  overflow-x: clip;
}

.product-recommendations__inner {
  width: 100%;
  max-width: 98rem;
  margin: 0 auto;
  padding: 0 clamp(1rem, 4vw, 4rem);
}

.product-recommendations__header {
  display: flex;
  justify-content: center;
  margin-bottom: 1.75rem;
  text-align: center;
}

.product-recommendations__title {
  margin: 0;
  color: #222;
  font-family: sans-serif;
  font-size: clamp(1.35rem, 2vw, 1.75rem);
  font-weight: 400;
  letter-spacing: -0.015em;
  line-height: 1.2;
}


/* =========================================
   CAROUSEL
   Card size is controlled from these 4 values:
   --per-view : cards visible at once
   --gap      : space between cards
   --ratio-w / --ratio-h : image shape (3 / 4 = portrait, 2 / 3 = taller)
========================================= */

.product-recommendations__carousel {
  --per-view: 4;
  --gap: 1.5rem;
  --ratio-w: 3;
  --ratio-h: 4;

  position: relative;
  container-type: inline-size;
}

.product-recommendations__track {
  display: flex;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  gap: var(--gap);
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  scroll-behavior: smooth;
}

.product-recommendations__track::-webkit-scrollbar {
  display: none;
}

.product-recommendations__item {
  min-width: 0;
  flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  scroll-snap-align: start;
}


/* =========================================
   ARROWS (centered on the image)
========================================= */

.product-recommendations__arrow {
  position: absolute;

  /* half of the image height = exact middle of the image */
  top: calc(
    (100cqw - (var(--per-view) - 1) * var(--gap)) / var(--per-view)
    * var(--ratio-h) / var(--ratio-w) / 2
  );

  z-index: 3;
  display: grid;
  width: 3.25rem;
  height: 3.25rem;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 0.9rem;
  background: #fff;
  color: #222;
  cursor: pointer;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.16);
  opacity: 0;
  pointer-events: none;
  transform: translateY(-50%);
  transition:
    opacity 200ms ease,
    background-color 160ms ease,
    color 160ms ease;
}

.product-recommendations__arrow--prev {
  left: -1.625rem;
}

.product-recommendations__arrow--next {
  right: -1.625rem;
}

.product-recommendations__arrow[data-hidden="true"] {
  visibility: hidden;
}

@media (hover: hover) and (pointer: fine) {
  .product-recommendations__carousel:hover .product-recommendations__arrow,
  .product-recommendations__carousel:focus-within .product-recommendations__arrow {
    opacity: 1;
    pointer-events: auto;
  }
}

.product-recommendations__arrow:hover {
  background: #222;
  color: #fff;
}


/* =========================================
   IMAGE
========================================= */

.product-recommendations__media {
  position: relative;
  overflow: hidden;
  border-radius: var(--product-card-radius, 0);
  background: #f5f5f1;
}

.product-recommendations__image-link {
  display: block;
  width: 100%;
  aspect-ratio: var(--ratio-w) / var(--ratio-h);
  text-decoration: none;
}

.product-recommendations__image-link img,
.product-recommendations__image-link svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-recommendations__image-link img {
  transition: transform 400ms ease;
}

.product-recommendations__image-link:hover img {
  transform: scale(1.025);
}


/* =========================================
   ADD TO CART (appears on hover)
========================================= */

.product-recommendations__quick-wrap {
  position: absolute;
  inset-inline: 0.75rem;
  bottom: 0.75rem;
  z-index: 2;
  opacity: 0;
  pointer-events: none;
  transform: translateY(0.5rem);
  transition:
    opacity 220ms ease,
    transform 220ms ease;
}

.product-recommendations__media:hover .product-recommendations__quick-wrap,
.product-recommendations__media:focus-within .product-recommendations__quick-wrap {
  opacity: 1;
  pointer-events: auto;
  transform: none;
}

.product-recommendations__form {
  margin: 0;
}

.product-recommendations__quick {
  display: flex;
  width: 100%;
  min-height: 3.1rem;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 1rem;
  border: 0;
  border-radius: 0.85rem;
  background: var(--color-background, #fffcf7);
  color: #222;
  font: inherit;
  font-size: 0.9rem;
  line-height: 1.2;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.08);
  transition:
    background-color 160ms ease,
    color 160ms ease;
}

.product-recommendations__quick:hover {
  background: #222;
  color: var(--color-background, #fffcf7);
}

/* The icon is only used on mobile */
.product-recommendations__quick-icon {
  display: none;
}

.product-recommendations__quick.is-disabled,
.product-recommendations__quick:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.product-recommendations__quick.is-disabled:hover,
.product-recommendations__quick:disabled:hover {
  background: var(--color-background, #fffcf7);
  color: #222;
}

/* Touch screens have no hover: keep the button visible and hide the arrows (swipe instead) */
@media (hover: none) {
  .product-recommendations__arrow {
    display: none;
  }

  .product-recommendations__quick-wrap {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .product-recommendations__quick {
    min-height: 2.6rem;
    font-size: 0.82rem;
  }
}


/* =========================================
   INFO
========================================= */

.product-recommendations__info {
  padding-top: 0.8rem;
  text-align: center;
}

.product-recommendations__product-title {
  margin: 0;
  color: #222;
  font-size: 0.9rem;
  font-weight: 500;
  line-height: 1.4;
}

.product-recommendations__product-title a {
  color: inherit;
  text-decoration: none;
}

.product-recommendations__product-title a:hover {
  text-decoration: underline;
  text-underline-offset: 0.2rem;
}

/* Variant dropdown (Gold Plated / Silver Plated ...) */

.product-recommendations__variant {
  position: relative;
  display: inline-block;
  max-width: 100%;
  margin-top: 0.5rem;
}

.product-recommendations__select {
  min-width: 8.5rem;
  max-width: 100%;
  padding: 0.5rem 2.1rem;
  border: 1px solid #d8d8d8;
  border-radius: 999px;
  background: transparent;
  color: #222;
  font: inherit;
  font-size: 0.8rem;
  line-height: 1.2;
  text-align: center;
  text-align-last: center;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
}

.product-recommendations__select:hover {
  border-color: #222;
}

.product-recommendations__chevron {
  position: absolute;
  top: 50%;
  inset-inline-end: 0.95rem;
  width: 0.4rem;
  height: 0.4rem;
  border-right: 1px solid currentColor;
  border-bottom: 1px solid currentColor;
  transform: translateY(-70%) rotate(45deg);
  pointer-events: none;
}

.product-recommendations__price {
  margin-top: 0.35rem;
  color: #555;
  font-size: 0.85rem;
}

.product-recommendations__price .price {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  direction: ltr;
}

html[dir="rtl"] .product-recommendations__price .price {
  justify-content: flex-end;
}

.product-recommendations__price .price__current {
  order: 1;
  font-size: 0.9rem;
  font-weight: 500;
}

.product-recommendations__price .price__compare {
  order: 2;
  font-size: 0.78rem;
}

.product-recommendations__rating {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.3rem;
  margin-top: 0.3rem;
  line-height: 1;
  justify-content: center;
}

.product-recommendations__rating-star {
  color: #f5b301;
  font-size: 1.05rem;
  line-height: 1;
}

.product-recommendations__rating-value {
  font-size: 0.85rem;
  font-weight: 600;
}

.product-recommendations__rating-count {
  color: #666;
  font-size: 0.8rem;
  white-space: nowrap;
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 989px) {
  .product-recommendations__carousel {
    --per-view: 3;
  }
}


/* =========================================
   MOBILE (Artsy style)
   Full-width swipe row + small icon-only add button on the right of the image
========================================= */

@media (max-width: 749px) {

  .product-recommendations {
    --section-gap: 1.75rem;

    /* Break out of the page side padding: the row runs from screen edge to screen edge */
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  .product-recommendations__inner {
    padding-inline: 0;
  }

  .product-recommendations__header {
    margin-bottom: 1.2rem;
    padding-inline: 1rem;
  }

  .product-recommendations__title {
    font-size: 1.3rem;
  }

  /* Card size: about 1.7 cards visible, tall 2 / 3 image like Artsy */
  .product-recommendations__carousel {
    --per-view: 1.7;
    --gap: 0.75rem;
    --ratio-w: 2;
    --ratio-h: 3;
  }

  /* 1rem space before the first card; set both to 0 to start flush with the screen edge */
  .product-recommendations__track {
    padding-inline: 1rem;
    scroll-padding-inline: 1rem;
  }

  /* Add / Select options: small icon on the right (same color as the page) */
  .product-recommendations__quick-wrap {
    inset-inline-start: auto;
    inset-inline-end: 0.6rem;
    bottom: 0.6rem;
  }

  .product-recommendations__quick {
    width: 2.4rem;
    height: 2.4rem;
    min-height: 0;
    padding: 0;
    border: 1px solid rgb(34 34 34 / 85%);
    border-radius: 0.35rem;
    box-shadow: none;
  }

  .product-recommendations__quick-icon {
    display: block;
    width: 1.3rem;
    height: 1.3rem;
  }

  /* The words stay for screen readers only */
  .product-recommendations__quick-text {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Sold out keeps a small text label (an icon alone would not say it) */
  .product-recommendations__quick.is-sold-out {
    width: auto;
    height: auto;
    min-height: 2rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.72rem;
  }

  .product-recommendations__quick.is-sold-out .product-recommendations__quick-icon {
    display: none;
  }

  .product-recommendations__quick.is-sold-out .product-recommendations__quick-text {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip-path: none;
  }

  .product-recommendations__info {
    padding-top: 0.65rem;
  }

  .product-recommendations__product-title {
    font-size: 0.95rem;
  }

  /* Price on one line, like Artsy */
  .product-recommendations__price {
    font-size: 0.9rem;
  }

  .product-recommendations__price .price {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.1rem 0.4rem;
  }

  .product-recommendations__price .price__current {
    font-size: 0.95rem;
  }

  .product-recommendations__price .price__compare {
    font-size: 0.8rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .product-recommendations__track {
    scroll-behavior: auto;
  }

  .product-recommendations__image-link img,
  .product-recommendations__quick-wrap {
    transition: none;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
