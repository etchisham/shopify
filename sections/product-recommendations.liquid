{% liquid
  assign recommendation_collection = section.settings.collection
%}

<section
  class="product-recommendations"
  data-product-recommendations
>
  <div class="product-recommendations__inner">

    <div class="product-recommendations__header">

      <h2 class="product-recommendations__title">
        {{ section.settings.heading | escape }}
      </h2>

      {% if recommendation_collection != blank and recommendation_collection.products_count > 4 %}
        <div class="product-recommendations__controls">

          <button
            type="button"
            class="product-recommendations__arrow product-recommendations__arrow--prev"
            data-recommendations-prev
            aria-label="Previous products"
          >
            <span aria-hidden="true">←</span>
          </button>

          <button
            type="button"
            class="product-recommendations__arrow product-recommendations__arrow--next"
            data-recommendations-next
            aria-label="Next products"
          >
            <span aria-hidden="true">→</span>
          </button>

        </div>
      {% endif %}

    </div>

    {% if recommendation_collection != blank and recommendation_collection.products_count > 0 %}

      <div
        class="product-recommendations__track"
        data-recommendations-track
      >

        {% for product in recommendation_collection.products limit: 12 %}

          <article class="product-recommendations__item">

            <a
              href="{{ product.url }}"
              class="product-recommendations__image-link"
              aria-label="{{ product.title | escape }}"
            >

              {% if product.featured_image != blank %}

                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    alt: product.featured_image.alt | default: product.title
                  }}

              {% else %}

                {{ 'product-1' | placeholder_svg_tag }}

              {% endif %}

            </a>

            <div class="product-recommendations__info">

              <h3 class="product-recommendations__product-title">
                <a href="{{ product.url }}">
                  {{ product.title | escape }}
                </a>
              </h3>

              <div class="product-recommendations__price">
                {% render 'price', product: product %}
              </div>

            </div>

          </article>

        {% endfor %}

      </div>

    {% endif %}

  </div>
</section>

<script>
  (() => {
    const section = document.currentScript?.previousElementSibling;

    if (!section) return;

    const track = section.querySelector('[data-recommendations-track]');
    const previous = section.querySelector('[data-recommendations-prev]');
    const next = section.querySelector('[data-recommendations-next]');

    if (!track) return;

    const getScrollAmount = () => {
      const item = track.querySelector('.product-recommendations__item');

      if (!item) {
        return track.clientWidth;
      }

      const styles = window.getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap || 0);

      return item.getBoundingClientRect().width + gap;
    };

    previous?.addEventListener('click', () => {
      track.scrollBy({
        left: -(getScrollAmount() * 4),
        behavior: 'smooth'
      });
    });

    next?.addEventListener('click', () => {
      track.scrollBy({
        left: getScrollAmount() * 4,
        behavior: 'smooth'
      });
    });

  })();
</script>
{% stylesheet %}

.product-recommendations {
  width: 100%;
  max-width: 100%;
  margin-top: 5rem;
  padding: 0;
  overflow: hidden;
}

.product-recommendations__inner {
  width: 100%;
  max-width: 87.5rem;
  margin: 0 auto;
  padding: 0 clamp(1rem, 3vw, 2.25rem);
  box-sizing: border-box;
}

.product-recommendations__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.75rem;
}

.product-recommendations__title {
  margin: 0;
  color: #222;
  font-family: Arial, Helvetica, sans-serif;
  font-size: clamp(1.35rem, 2vw, 1.75rem);
  font-weight: 400;
  letter-spacing: -0.015em;
  line-height: 1.2;
}

.product-recommendations__controls {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 0.55rem;
}

.product-recommendations__arrow {
  display: grid;
  width: 2.65rem;
  height: 2.65rem;
  place-items: center;
  padding: 0;
  border: 1px solid #d8d8d8;
  border-radius: 50%;
  background: #fff;
  color: #222;
  cursor: pointer;
  font-size: 1rem;
  line-height: 1;
  transition:
    background-color 160ms ease,
    color 160ms ease,
    border-color 160ms ease,
    transform 160ms ease;
}

.product-recommendations__arrow:hover {
  border-color: #222;
  background: #222;
  color: #fff;
  transform: translateY(-1px);
}

.product-recommendations__track {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.product-recommendations__item {
  min-width: 0;
  width: 100%;
}

.product-recommendations__image-link {
  display: block;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: #f5f5f1;
  text-decoration: none;
}

.product-recommendations__image-link img,
.product-recommendations__image-link svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-recommendations__image-link img {
  transition: transform 400ms ease;
}

.product-recommendations__image-link:hover img {
  transform: scale(1.025);
}

.product-recommendations__info {
  min-width: 0;
  padding-top: 0.8rem;
}

.product-recommendations__product-title {
  margin: 0;
  color: #222;
  font-size: 0.9rem;
  font-weight: 500;
  line-height: 1.4;
}

.product-recommendations__product-title a {
  color: inherit;
  text-decoration: none;
}

.product-recommendations__product-title a:hover {
  text-decoration: underline;
  text-underline-offset: 0.2rem;
}

.product-recommendations__price {
  margin-top: 0.35rem;
  color: #555;
  font-size: 0.85rem;
}

.product-recommendations__price .price {
  gap: 0.35rem;
}

.product-recommendations__price .price__current {
  font-size: 0.9rem;
  font-weight: 500;
}

.product-recommendations__price .price__compare {
  font-size: 0.78rem;
}

.product-recommendations__empty {
  margin: 0;
  color: #666;
  font-size: 0.9rem;
}

/* Tablet */
@media (max-width: 989px) and (min-width: 750px) {
  .product-recommendations__track {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

/* Mobile */
@media (max-width: 749px) {
  .product-recommendations {
    margin-top: 3.5rem;
  }

  .product-recommendations__inner {
    padding-inline: 1rem;
  }

  .product-recommendations__header {
    margin-bottom: 1.2rem;
  }

  .product-recommendations__title {
    font-size: 1.3rem;
  }

  .product-recommendations__controls {
    gap: 0.4rem;
  }

  .product-recommendations__arrow {
    width: 2.35rem;
    height: 2.35rem;
  }

  .product-recommendations__track {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .product-recommendations__info {
    padding-top: 0.65rem;
  }

  .product-recommendations__product-title {
    font-size: 0.82rem;
  }

  .product-recommendations__price {
    margin-top: 0.25rem;
    font-size: 0.8rem;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}