{% comment %}
  "You may also like" row on the product page.
  It looks and behaves exactly like the Best Sellers row on the home page:
  same product card, same size, same arrows, same motion. The only difference is the rose gold arrows.
{% endcomment %}

{%- liquid
  assign recommendation_collection = section.settings.collection

  assign max_products = section.settings.max_products | default: 12
  assign loop_limit = max_products | plus: 1

  assign carousel_locale = request.locale.iso_code | split: '-' | first
  assign rtl_locales = 'ar,fa,he,ur' | split: ','
  assign left_arrow_label = 'home.previous_products' | t
  assign right_arrow_label = 'home.next_products' | t

  # The arrow buttons are physical (left scrolls left). In RTL, scrolling left shows the NEXT products.
  if rtl_locales contains carousel_locale
    assign left_arrow_label = 'home.next_products' | t
    assign right_arrow_label = 'home.previous_products' | t
  endif

  assign rec_heading = section.settings.heading
  if carousel_locale == 'ar'
    assign rec_heading = section.settings.heading_ar | default: rec_heading
  endif
  if rec_heading == blank
    assign rec_heading = 'cart.you_may_also_like' | t
  endif
-%}

<section class="product-recommendations" data-product-recommendations>

  <div class="product-recommendations__header">
    <h2 class="product-recommendations__title">{{ rec_heading | escape }}</h2>
  </div>

  {% if recommendation_collection != blank and recommendation_collection.products_count > 0 %}

    <div
      class="product-recommendations__slider"
      style="--product-columns: {{ section.settings.columns }};"
    >

      <button
        type="button"
        class="product-recommendations__nav product-recommendations__nav--prev"
        aria-label="{{ left_arrow_label | escape }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      </button>

      <div class="product-recommendations__grid">

        {%- assign shown = 0 -%}

        {%- for item in recommendation_collection.products limit: loop_limit -%}
          {%- if item.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= max_products -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}

          <div class="product-recommendations__product">
            {% render 'product-card',
              product: item,
              sizes: '(min-width: 990px) 20vw, 50vw'
            %}
          </div>
        {%- endfor -%}

      </div>

      <button
        type="button"
        class="product-recommendations__nav product-recommendations__nav--next"
        aria-label="{{ right_arrow_label | escape }}"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>

    </div>

  {% endif %}

</section>

<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    const grid = section && section.querySelector('.product-recommendations__grid');

    if (!grid) return;

    const prev = section.querySelector('.product-recommendations__nav--prev');
    const next = section.querySelector('.product-recommendations__nav--next');

    const update = () => {
      const max = grid.scrollWidth - grid.clientWidth;
      const rtl = getComputedStyle(grid).direction === 'rtl';
      const fromLeft = rtl ? max + grid.scrollLeft : grid.scrollLeft;
      const fromRight = max - fromLeft;

      if (prev) prev.setAttribute('data-hidden', fromLeft <= 1 ? 'true' : 'false');
      if (next) next.setAttribute('data-hidden', fromRight <= 1 ? 'true' : 'false');
    };

    if (prev) prev.addEventListener('click', () => grid.scrollBy({ left: -grid.clientWidth, behavior: 'smooth' }));
    if (next) next.addEventListener('click', () => grid.scrollBy({ left: grid.clientWidth, behavior: 'smooth' }));

    grid.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    window.addEventListener('load', update);
    update();

    /* Mouse: hold the left button and drag the row to the left or right (touch screens already swipe) */
    let drag = null;
    let suppressClick = false;

    grid.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      drag = { x: event.clientX, left: grid.scrollLeft, moved: false };
    });

    window.addEventListener('pointermove', (event) => {
      if (!drag) return;

      const dx = event.clientX - drag.x;
      if (!drag.moved && Math.abs(dx) < 5) return;

      if (!drag.moved) {
        drag.moved = true;
        grid.style.scrollSnapType = 'none';
        grid.classList.add('is-dragging');
      }

      grid.scrollLeft = drag.left - dx;
    });

    const endDrag = () => {
      if (!drag) return;

      if (drag.moved) {
        suppressClick = true;
        setTimeout(() => { suppressClick = false; }, 60);
        grid.style.scrollSnapType = '';
        grid.classList.remove('is-dragging');
      }

      drag = null;
    };

    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    /* after a drag, do not open the product under the mouse */
    grid.addEventListener('click', (event) => {
      if (!suppressClick) return;
      event.preventDefault();
      event.stopPropagation();
    }, true);

    /* Phones: the row starts with the card in the middle centred (until the shopper touches it) */
    let touched = false;
    grid.addEventListener('pointerdown', () => { touched = true; }, { once: true });

    const centerMiddle = () => {
      if (touched || !window.matchMedia('(max-width: 749px)').matches) return;

      const cards = grid.querySelectorAll('.product-recommendations__product');
      if (cards.length < 3) return;

      const mid = cards[Math.floor((cards.length - 1) / 2)];
      const g = grid.getBoundingClientRect();
      const c = mid.getBoundingClientRect();

      grid.scrollBy({
        left: (c.left + c.width / 2) - (g.left + g.width / 2),
        behavior: 'auto'
      });
      update();
    };

    centerMiddle();
    window.addEventListener('load', centerMiddle);

    /* Scroll reveal: the heading first, then the cards one after the other (same as the home page) */
    if (
      'IntersectionObserver' in window &&
      !(window.Shopify && window.Shopify.designMode) &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      const header = section.querySelector('.product-recommendations__header');
      const cards = Array.from(grid.querySelectorAll('.product-recommendations__product'));
      const targets = [header].concat(cards).filter(Boolean);

      section.classList.add('has-reveal');
      targets.forEach((el) => el.classList.add('hr-item'));

      const io = new IntersectionObserver((entries) => {
        const shown = entries
          .filter((entry) => entry.isIntersecting)
          .map((entry) => entry.target);

        if (!shown.length) return;

        shown.sort((a, b) =>
          a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1
        );

        const withHeader = shown.indexOf(header) !== -1;
        let position = 0;

        shown.forEach((el) => {
          if (el === header) {
            el.style.setProperty('--reveal-delay', '0s');
          } else {
            el.style.setProperty(
              '--reveal-delay',
              ((withHeader ? 0.5 : 0) + position * 0.28) + 's'
            );
            position++;
          }

          el.classList.add('is-revealed');
          io.unobserve(el);
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -15% 0px' });

      /* what is already passed (above the screen) or hidden inside the row shows without motion */
      const settle = () => {
        const g = grid.getBoundingClientRect();

        targets.forEach((el) => {
          if (el.classList.contains('is-revealed')) return;

          const r = el.getBoundingClientRect();

          if (r.bottom < 0 || r.left >= g.right - 1 || r.right <= g.left + 1) {
            el.classList.add('hilya-instant', 'is-revealed');
            io.unobserve(el);
          }
        });
      };

      targets.forEach((el) => io.observe(el));
      settle();
      window.addEventListener('load', () => setTimeout(settle, 150));
    }
  })();
</script>

{% stylesheet %}

/* Let the section use the full screen width (some themes wrap sections in a narrow container) */
.shopify-section:has(> .product-recommendations) {
  width: 100%;
  max-width: none;
  margin-inline: 0;
}

/* SECTION (same as the Best Sellers row on the home page) */

.product-recommendations {
  width: 100vw;
  max-width: 100vw;
  margin-inline: calc(50% - 50vw);
  padding: 30px max(24px, calc((100vw - 1400px) / 2)) 30px;
  box-sizing: border-box;
}

.product-recommendations *,
.product-recommendations *::before,
.product-recommendations *::after {
  box-sizing: border-box;
}

/* HEADER */

.product-recommendations__header {
  display: flex;
  justify-content: center;
  margin: 0 auto 28px;
  text-align: center;
}

.product-recommendations__title {
  position: relative;
  margin: 0;
  color: var(--hilya-ink);
  font-family: "Cormorant Garamond", "Bodoni Moda", "Didot", serif;
  font-size: 28px;
  font-style: italic;
  font-weight: 500;
  letter-spacing: 0.01em;
  line-height: 1.1;
}

/* the thin rose gold line under the title */
.product-recommendations__title::after {
  content: "";
  position: absolute;
  bottom: -12px;
  left: 50%;
  width: 2.4rem;
  height: 1px;
  margin-left: -1.2rem;
  background: var(--hilya-rose);
}

/* SLIDER */

.product-recommendations__slider {
  --per-view: var(--product-columns, 5);
  --gap: 18px;
  --ratio-w: var(--card-ratio-w, 3);
  --ratio-h: var(--card-ratio-h, 4);

  position: relative;
  container-type: inline-size;
}

.product-recommendations__grid {
  display: flex;
  flex-wrap: nowrap;
  gap: var(--gap);
  width: 100%;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;

  /* room under the cards so they are not cut at the bottom while they rise */
  padding-bottom: 40px;
  margin-bottom: -40px;
}

.product-recommendations__grid::-webkit-scrollbar {
  display: none;
}

/* the row can be dragged with the mouse, so the pictures and links must not be dragged on their own */
.product-recommendations__grid {
  cursor: grab;
}

.product-recommendations__grid.is-dragging {
  cursor: grabbing;
}

.product-recommendations__grid img,
.product-recommendations__grid a {
  -webkit-user-drag: none;
  user-select: none;
}

.product-recommendations__product {
  flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  min-width: 0;
  scroll-snap-align: start;
}

/* Few products: sit in the middle of the row */
.product-recommendations__product:first-child {
  margin-inline-start: auto;
}

.product-recommendations__product:last-child {
  margin-inline-end: auto;
}

/* ARROWS (desktop: they show when the mouse is over the row; rose gold on hover) */

.product-recommendations__nav {
  position: absolute;

  /* half of the image height = exact middle of the image */
  top: calc(
    (100cqw - (var(--per-view) - 1) * var(--gap)) / var(--per-view)
    * var(--ratio-h) / var(--ratio-w) / 2
  );

  z-index: 3;
  display: grid;
  width: 3.25rem;
  height: 3.25rem;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 0.9rem;
  background: #fff;
  color: var(--hilya-ink);
  cursor: pointer;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.16);
  opacity: 0;
  pointer-events: none;
  transform: translateY(-50%);

  /* only the background fades: the arrow colour changes at once */
  transition:
    opacity 200ms ease,
    background-color 160ms ease;
  -webkit-tap-highlight-color: transparent;
}

.product-recommendations__nav--prev { left: -1.625rem; }
.product-recommendations__nav--next { right: -1.625rem; }

.product-recommendations__nav[data-hidden="true"] {
  visibility: hidden;
}

.product-recommendations__nav svg {
  display: block;
}

@media (hover: hover) and (pointer: fine) {
  .product-recommendations__slider:hover .product-recommendations__nav,
  .product-recommendations__slider:has(:focus-visible) .product-recommendations__nav {
    opacity: 1;
    pointer-events: auto;
  }

  .product-recommendations__nav:hover {
    background: var(--hilya-rose-deep);
    color: #fff;
  }
}

/* big touch screens (tablet): swipe only, no arrows */
@media (hover: none) and (min-width: 750px) {
  .product-recommendations__nav {
    display: none;
  }
}

/* LARGE DESKTOP */

@media (min-width: 1500px) {
  .product-recommendations {
    padding-left: max(32px, calc((100vw - 1500px) / 2));
    padding-right: max(32px, calc((100vw - 1500px) / 2));
  }
}

/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {
  .product-recommendations {
    padding-left: 28px;
    padding-right: 28px;
  }

  .product-recommendations__slider {
    --per-view: 3.3;
    --gap: 14px;
  }

  .product-recommendations__header {
    margin-bottom: 20px;
  }
}

/* MOBILE */

@media (max-width: 749px) {
  .product-recommendations {
    padding: 30px 0 30px;
    overflow-x: clip;
  }

  .product-recommendations__header {
    margin-bottom: 20px;
    padding-inline: 1rem;
  }

  .product-recommendations__title {
    margin-top: 7px;
    font-size: 18px;
  }

  .product-recommendations__title::after {
    bottom: -11px;
  }

  .product-recommendations__product {
    scroll-snap-align: center;
  }

  .product-recommendations__slider {
    --per-view: 2.2;
    --gap: 0.75rem;
  }

  .product-recommendations__grid {
    padding-inline: 1rem;
    scroll-padding-inline: 1rem;
  }

  /* small round arrows on the phone */
  .product-recommendations__nav {
    top: 38%;
    width: 30px;
    height: 30px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    background: var(--hilya-beige);
    opacity: 1;
    pointer-events: auto;
  }

  .product-recommendations__nav svg {
    width: 14px;
    height: 14px;
  }

  .product-recommendations__nav--prev { left: 8px; }
  .product-recommendations__nav--next { right: 8px; }
}

/* REVEAL ON SCROLL
   The script marks the heading and the cards with hr-item: they rise one after the other. */

@keyframes recommendations-reveal {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
}

.product-recommendations.has-reveal .hr-item:not(.is-revealed) {
  opacity: 0;
}

.product-recommendations.has-reveal .hr-item.is-revealed {
  animation: recommendations-reveal 2s cubic-bezier(.22, .8, .3, 1) backwards;
  animation-delay: var(--reveal-delay, 0s);
}

.product-recommendations.has-reveal .is-revealed.hilya-instant {
  animation: none;
}

/* the line under the title is drawn from the middle to both sides after the title appears */
.product-recommendations.has-reveal .product-recommendations__header.hr-item .product-recommendations__title::after {
  transform: scaleX(0);
  transition: transform 1.6s cubic-bezier(.22, .8, .3, 1) .7s;
}

.product-recommendations.has-reveal .product-recommendations__header.is-revealed .product-recommendations__title::after {
  transform: scaleX(1);
}

.product-recommendations.has-reveal .product-recommendations__header.hilya-instant .product-recommendations__title::after {
  transition: none;
}

/* ARABIC / RTL */

[dir="rtl"] .product-recommendations__title {
  line-height: 1.4;
}

{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "text",
      "id": "heading_ar",
      "label": "Heading - Arabic",
      "default": "قد يعجبك أيضًا"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
