{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id

  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign rating_value = rating.rating | default: rating
  assign rating_maximum = rating.scale_max | default: 5

  assign rating_display = rating_value | round: 1 | append: '' | remove: '.0'
  assign review_word = 'review'
  if rating_count != 1
    assign review_word = 'reviews'
  endif

  assign browsing_collection = collection | default: product.collections.first
  assign checkout_url = routes.root_url | append: '/checkout' | replace: '//', '/'

  assign saved_image_url = ''
  if product.featured_image != blank
    assign saved_image_url = product.featured_image | image_url: width: 360
  endif

  assign has_name_tag = false
  assign has_date_tag = false
  assign has_letter_tag = false

  if product.tags contains 'Name'
    assign has_name_tag = true
  endif

  if product.tags contains 'Date'
    assign has_date_tag = true
  endif

  if product.tags contains 'Letter'
    assign has_letter_tag = true
  endif
%}

<article
  class="product-page product-page--media-{{ section.settings.media_position }}"
  data-product-page
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-product-title="{{ product.title | escape }}"
  data-product-image="{{ saved_image_url }}"
  data-product-price="{{ current_variant.price | money | escape }}"
  data-product-vendor="{{ product.vendor | escape }}"
  data-option-error="{{ 'products.details.option_error' | t | escape }}"
  data-back-label="{{ 'products.details.back_to_results' | t | escape }}"
  data-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  data-name-required="{{ has_name_tag }}"
  data-date-required="{{ has_date_tag }}"
  data-letter-required="{{ has_letter_tag }}"
  data-personalization-error="Please complete the required personalization fields."
  style="
    --product-image-ratio: {{ section.settings.image_ratio }};
    --product-image-fit: {{ section.settings.image_fit }};
  "
>

  {% if section.settings.show_breadcrumbs %}
    {% render 'product-breadcrumbs', product: product, collection: collection %}
  {% endif %}

    <script>
    (function () {
      try {
        var r = new URL(document.referrer);
        if (r.origin === location.origin && /\/(collections\/[^/]+|search)\/?$/.test(r.pathname)) {
          document.currentScript.parentElement.setAttribute('data-back-pending', '');
        }
      } catch (e) {}
    })();
  </script>

  <a
    class="product-page__back"
    data-product-back
    href="{{ browsing_collection.url | default: routes.all_products_collection_url }}"
  >
    <span aria-hidden="true">←</span>
    <span data-product-back-label>
      {{ 'products.details.back_to_catalog' | t }}
    </span>
  </a>

  <div class="product-layout">

    {% render 'product-gallery', product: product, section_id: section.id %}

    <div class="product__info">

      <div
        data-product-variant-content
        data-variant-id="{{ current_variant.id }}"
        data-featured-media-id="{{ current_variant.featured_media.id }}"
        data-variant-title="{{ current_variant.title | escape }}"
        data-variant-price="{{ current_variant.price }}"
        data-variant-price-label="{{ current_variant.price | money | escape }}"
        data-variant-minimum="{{ current_variant.quantity_rule.min | default: 1 }}"
        data-variant-available="{{ current_variant.available }}"
      >

        {% if section.settings.show_product_vendor and product.vendor != blank %}
          <div class="product-page__seller">
            <span class="product-page__shop">
              {{ product.vendor | escape }}
            </span>
          </div>
        {% endif %}

        <div class="product-page__title-row">

          <h1>{{ product.title | escape }}</h1>

          {% if section.settings.show_rating and rating_value != blank and rating_count > 0 %}
            <span
              class="product-page__rating"
              role="img"
              aria-label="{{ rating_display }} / {{ rating_maximum }} ({{ rating_count }} {{ review_word }})"
            >
              <span class="product-page__rating-star" aria-hidden="true">★</span>
              <span class="product-page__rating-value">{{ rating_display }}</span>
              <span class="product-page__rating-count">({{ rating_count }} {{ review_word }})</span>
            </span>
          {% endif %}

        </div>

        <div class="product-page__price" data-product-price-block>

          {% if current_variant != blank %}
            {% render 'price', product: product, use_variant: true %}
          {% else %}
            <p>{{ 'products.product.unavailable' | t }}</p>
          {% endif %}

          {% if current_variant.compare_at_price > current_variant.price %}
            {% assign percent_off = current_variant.compare_at_price
              | minus: current_variant.price
              | times: 100.0
              | divided_by: current_variant.compare_at_price
              | round
            %}

            <p class="product-page__discount">
              {{ 'products.product.discount' | t: percent: percent_off }}
            </p>
          {% endif %}

        </div>

        {% if section.settings.show_tax_note %}
          <p class="product-page__tax-note">
            {% if cart.taxes_included %}
              {{ 'products.details.taxes_included' | t }}
            {% else %}
              {{ 'cart.taxes_and_shipping_at_checkout' | t }}
            {% endif %}
          </p>
        {% endif %}

        <div data-product-inventory>
        {% if section.settings.show_inventory and current_variant.inventory_management %}
          {% if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 10 %}

            <p class="product__inventory product__inventory--low">
              {{ 'products.product.inventory_low' | t: count: current_variant.inventory_quantity }}
            </p>

          {% elsif current_variant.available %}

            <p class="product__inventory">
              {{ 'products.product.inventory_in_stock' | t }}
            </p>

          {% endif %}
        {% endif %}
        </div>

        <ul class="product-page__delivery" role="list">

          {% if product.metafields.custom.delivery_note != blank %}
            <li>
              {% render 'icon', name: 'check' %}
              <span>{{ product.metafields.custom.delivery_note | metafield_tag }}</span>
            </li>
          {% endif %}

          {% if product.metafields.custom.returns_note != blank %}
            <li>
              {% render 'icon', name: 'check' %}
              <span>{{ product.metafields.custom.returns_note | metafield_tag }}</span>
            </li>
          {% endif %}

        </ul>
        <script type="application/json" data-product-variants-json>
{
  "variants": [
    {% for variant in product.variants %}
      {
        "id": {{ variant.id | json }},
        "options": {{ variant.options | json }},
        "price": {{ variant.price | json }},
        "price_formatted": {{ variant.price | money | json }},
        "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
        "compare_at_price_formatted": {{ variant.compare_at_price | money | json }},
        "available": {{ variant.available | json }},
        "featured_media_id": {{ variant.featured_media.id | default: 0 | json }},
        "quantity_rule": {
          "min": {{ variant.quantity_rule.min | default: 1 | json }},
          "increment": {{ variant.quantity_rule.increment | default: 1 | json }},
          "max": {{ variant.quantity_rule.max | default: 0 | json }}
        }
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>

        {% form 'product',
          product,
          id: product_form_id,
          class: 'product-form',
          data-product-title: product.title
        %}

          <input
            type="hidden"
            name="id"
            value="{{ current_variant.id }}"
          >

          {% render 'product-options', product: product, section_id: section.id %}

          {% if has_name_tag or has_date_tag or has_letter_tag %}

            <div class="product-personalization">

              <div class="product-personalization__heading">
                <span>Personalization</span>
                <span class="product-personalization__required">Required</span>
              </div>

              {% if has_name_tag %}

                <div class="product-form__field">
                  <label for="ProductName-{{ section.id }}">
                    Name
                  </label>

                  <input
                    id="ProductName-{{ section.id }}"
                    type="text"
                    name="properties[Name]"
                    maxlength="100"
                    autocomplete="name"
                    required
                    data-personalization-name
                    placeholder="Enter the name"
                  >
                </div>

              {% endif %}

              {% if has_date_tag %}

                <div class="product-form__field">
                  <label for="ProductDate-{{ section.id }}">
                    Date
                  </label>

                  <input
                    id="ProductDate-{{ section.id }}"
                    type="date"
                    name="properties[Date]"
                    required
                    data-personalization-date
                  >
                </div>

              {% endif %}

              {% if has_letter_tag %}

                <div class="product-form__field">
                  <label for="ProductLetter-{{ section.id }}">
                    Letter
                  </label>

                  <input
                    id="ProductLetter-{{ section.id }}"
                    type="text"
                    name="properties[Letter]"
                    maxlength="1"
                    autocomplete="off"
                    required
                    data-personalization-letter
                    placeholder="Enter one letter"
                  >
                </div>

              {% endif %}

            </div>

          {% endif %}

          {% if section.settings.show_quantity %}

            <div class="product-form__field product-form__quantity">

              <label for="Quantity-{{ section.id }}">
                {{ 'products.product.quantity' | t }}
              </label>

              <div class="quantity-selector">

                <button
                  type="button"
                  class="quantity-selector__button"
                  data-quantity-minus
                  aria-label="Decrease quantity"
                >
                  −
                </button>

                <input
                  id="Quantity-{{ section.id }}"
                  class="quantity-selector__input"
                  type="number"
                  name="quantity"
                  min="{{ current_variant.quantity_rule.min | default: 1 }}"
                  step="{{ current_variant.quantity_rule.increment | default: 1 }}"
                  {% if current_variant.quantity_rule.max %}
                    max="{{ current_variant.quantity_rule.max }}"
                  {% endif %}
                  value="{{ current_variant.quantity_rule.min | default: 1 }}"
                  inputmode="numeric"
                  data-quantity-input
                >

                <button
                  type="button"
                  class="quantity-selector__button"
                  data-quantity-plus
                  aria-label="Increase quantity"
                >
                  +
                </button>

              </div>

            </div>

          {% else %}

            <input
              type="hidden"
              name="quantity"
              value="{{ current_variant.quantity_rule.min | default: 1 }}"
            >

          {% endif %}

          <div
            class="product-form__actions"
            data-product-actions
          >

            {% if section.settings.show_buy_now %}

              <button
                class="button button--full product-form__buy-now"
                type="submit"
                name="return_to"
                value="{{ checkout_url }}"
                data-product-buy
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                Buy it now
              </button>

            {% elsif section.settings.show_dynamic_checkout and current_variant.available %}

              {{ form | payment_button }}

            {% endif %}

            <button
              class="button button--full"
              type="submit"
              name="add"
              data-product-add
              {% unless current_variant.available %}
                data-unavailable="true"
                disabled
              {% endunless %}
            >

              <span
                class="button-spinner"
                aria-hidden="true"
              ></span>

              <span data-product-add-label>
                {% if current_variant == blank %}
                  {{ 'products.product.unavailable' | t }}
                {% elsif current_variant.available %}
                  {{ 'products.product.add_to_cart' | t }}
                {% else %}
                  {{ 'products.product.sold_out' | t }}
                {% endif %}
              </span>

              <span
                data-loading-label
                hidden
              >
                {{ 'products.bundle.adding' | t }}
              </span>

            </button>

          </div>

        {% endform %}

      </div>

      <p
        class="product-page__error"
        data-product-error
        role="alert"
        hidden
      ></p>

      <div class="product-page__accordions">

        {% for block in section.blocks %}

          {% case block.type %}

            {% when 'accordion' %}

              {% render 'product-accordion',
                product: product,
                block: block,
                section_id: section.id
              %}

            {% when '@app' %}

              {% render block %}

          {% endcase %}

        {% endfor %}

      </div>

    </div>

  </div>

</article>

{% stylesheet %}

.product-page__title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.4rem 0.9rem;
}

.product-page__title-row h1 {
  margin: 0;
}

.product-page__rating {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.95rem;
  white-space: nowrap;
}

.product-page__rating-star {
  color: #f5b301;
  font-size: 1.15rem;
  line-height: 1;
}

.product-page__rating-value {
  font-weight: 600;
}

.product-page__rating-count {
  color: #666;
}

/* Mobile / touch: no gallery arrows, swipe instead */
@media (max-width: 749px), (hover: none) {
  [data-product-previous],
  [data-product-next],
  [data-product-zoom-previous],
  [data-product-zoom-next] {
    display: none !important;
  }

  /* Lets the swipe code take the sideways drag */
  [data-product-zoom-canvas]:not(.is-zoomed) {
    touch-action: pan-y;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "accordion",
      "name": "t:product_details.accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading_en",
          "label": "t:labels.heading_en"
        },
        {
          "type": "text",
          "id": "heading_ar",
          "label": "t:labels.heading_ar"
        },
        {
          "type": "select",
          "id": "source",
          "label": "t:product_details.content_source",
          "default": "description",
          "options": [
            {
              "value": "description",
              "label": "t:product_details.description"
            },
            {
              "value": "metafield",
              "label": "t:product_details.metafield"
            },
            {
              "value": "editor",
              "label": "t:product_details.editor_content"
            }
          ]
        },
        {
          "type": "text",
          "id": "metafield_namespace",
          "label": "t:product_details.metafield_namespace",
          "default": "custom"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "t:product_details.metafield_key",
          "default": "item_details",
          "info": "t:product_details.metafield_info"
        },
        {
          "type": "text",
          "id": "metafield_key_ar",
          "label": "t:product_details.metafield_key_ar",
          "info": "t:product_details.metafield_ar_info"
        },
        {
          "type": "richtext",
          "id": "content_en",
          "label": "t:product_details.content_en",
          "default": "<p>Contact us if you have questions about this product or need help choosing before placing your order.</p>"
        },
        {
          "type": "richtext",
          "id": "content_ar",
          "label": "t:product_details.content_ar",
          "default": "<p>تواصل معنا إذا كانت لديك أسئلة عن هذا المنتج أو كنت بحاجة إلى مساعدة في الاختيار قبل إتمام طلبك.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "t:product_details.open_by_default",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "truncate_content",
          "label": "t:product_details.truncate_content",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_highlights",
          "label": "t:product_details.show_highlights",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:product_details.show_breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_vendor",
      "label": "t:labels.show_product_vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:labels.card_show_rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_inventory",
      "label": "t:labels.show_inventory",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tax_note",
      "label": "t:product_details.show_tax_note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:product_details.show_quantity",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "t:product_details.show_buy_now",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:labels.show_dynamic_checkout",
      "info": "t:product_details.accelerated_checkout_info",
      "default": true
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:labels.image_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.image_position.left"
        },
        {
          "value": "right",
          "label": "t:options.image_position.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:product_details.image_ratio",
      "default": "1 / 1",
      "options": [
        {
          "value": "1 / 1",
          "label": "t:product_details.square"
        },
        {
          "value": "4 / 5",
          "label": "t:product_details.portrait"
        },
        {
          "value": "4 / 3",
          "label": "t:product_details.landscape"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:product_details.image_fit",
      "default": "contain",
      "options": [
        {
          "value": "contain",
          "label": "t:product_details.contain"
        },
        {
          "value": "cover",
          "label": "t:product_details.cover"
        }
      ]
    }
  ]
}
{% endschema %}
