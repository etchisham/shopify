{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
%}

<section class="product section-spacing product--media-{{ section.settings.media_position }}">
  <div class="product__media" aria-label="{{ product.title | escape }}">
    {% for media in product.media %}
      <div class="product__media-item" data-media-id="{{ media.id }}">
        {% case media.media_type %}
          {% when 'image' %}
            {% liquid
              assign media_loading = 'lazy'
              assign media_fetchpriority = 'auto'
              if forloop.first
                assign media_loading = 'eager'
                assign media_fetchpriority = 'high'
              endif
            %}
            {% render 'image',
              image: media.preview_image,
              width: 1600,
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 768px) 55vw, 100vw',
              loading: media_loading,
              fetchpriority: media_fetchpriority,
              alt: media.alt
            %}
          {% when 'video' %}
            {{ media | video_tag: controls: true, preload: 'none', image_size: '1200x' }}
          {% when 'external_video' %}
            {{ media | external_video_tag }}
          {% when 'model' %}
            {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
        {% endcase %}
      </div>
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'product__placeholder' }}
    {% endfor %}
  </div>

  <div class="product__info">
    {% if section.settings.show_product_vendor and product.vendor != blank %}
      <p class="eyebrow">{{ product.vendor | escape }}</p>
    {% endif %}

    <h1>{{ product.title | escape }}</h1>
    {% render 'price', product: product, use_variant: true %}

    {% if section.settings.show_inventory and current_variant.inventory_management %}
      {% if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 10 %}
        <p class="product__inventory product__inventory--low">{{ 'products.product.inventory_low' | t: count: current_variant.inventory_quantity }}</p>
      {% elsif current_variant.available %}
        <p class="product__inventory">{{ 'products.product.inventory_in_stock' | t }}</p>
      {% endif %}
    {% endif %}

    {% form 'product', product, id: product_form_id, class: 'product-form', data-product-title: product.title %}
      {% unless product.has_only_default_variant %}
        <div class="product-form__field">
          <label for="Variant-{{ section.id }}">{{ 'products.product.choose_variant' | t }}</label>
          <select id="Variant-{{ section.id }}" name="id">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
              </option>
            {% endfor %}
          </select>
        </div>
      {% else %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% endunless %}

      <div class="product-form__field product-form__quantity">
        <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
        <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric">
      </div>

      <button class="button button--full" type="submit" name="add"{% unless current_variant.available %} disabled{% endunless %}>
        {% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
      </button>

      {% if section.settings.show_dynamic_checkout and current_variant.available %}
        {{ form | payment_button }}
      {% endif %}
    {% endform %}

    {% if product.description != blank %}
      <div class="product__description rte">{{ product.description }}</div>
    {% endif %}

    {% for block in section.blocks %}
      {% render block %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .product {
    display: grid;
    align-items: start;
    gap: clamp(var(--space-6), 6vw, var(--space-8));
  }

  .product__media {
    display: grid;
    gap: var(--space-4);
  }

  .product__media-item {
    overflow: hidden;
    border-radius: var(--radius-large);
    background: var(--color-surface);
  }

  .product__media-item :is(img, video, iframe, model-viewer),
  .product__placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .product__info {
    display: grid;
    gap: var(--space-4);
  }

  .product__info h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .product__inventory {
    margin: 0;
    color: var(--color-success);
    font-weight: 650;
  }

  .product__inventory--low {
    color: var(--color-error);
  }

  .product-form {
    display: grid;
    gap: var(--space-4);
    border-block: 1px solid var(--color-border);
    padding-block: var(--space-5);
  }

  .product-form__field {
    display: grid;
    gap: var(--space-2);
  }

  .product-form__field label {
    font-weight: 700;
  }

  .product-form__quantity {
    width: 7rem;
  }

  .shopify-payment-button__button {
    min-height: 2.9rem !important;
    border-radius: var(--radius-small) !important;
  }

  .product__description {
    border-block-end: 1px solid var(--color-border);
    padding-block-end: var(--space-5);
  }

  @media (min-width: 48rem) {
    .product {
      grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.85fr);
    }

    .product--media-right .product__media {
      order: 2;
    }

    .product__info {
      position: sticky;
      inset-block-start: var(--space-5);
    }

    .product__media {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product__media-item:first-child {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "checkbox", "id": "show_product_vendor", "label": "t:labels.show_product_vendor", "default": false },
    { "type": "checkbox", "id": "show_inventory", "label": "t:labels.show_inventory", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:labels.show_dynamic_checkout", "default": true },
    { "type": "select", "id": "media_position", "label": "t:labels.image_position", "options": [{ "value": "left", "label": "t:options.image_position.left" }, { "value": "right", "label": "t:options.image_position.right" }], "default": "left" }
  ]
}
{% endschema %}
