{% liquid
  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'

  if section.index == 1
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif

  assign hero_locale = request.locale.iso_code | split: '-' | first

  assign hero_eyebrow = section.settings.eyebrow
  assign hero_text = section.settings.text
  assign hero_button = section.settings.button_label
  assign hero_button_2 = section.settings.secondary_button_label

  if hero_locale == 'ar'
    if section.settings.eyebrow_ar != blank
      assign hero_eyebrow = section.settings.eyebrow_ar
    endif
    if section.settings.text_ar != blank
      assign hero_text = section.settings.text_ar
    endif
    if section.settings.button_label_ar != blank
      assign hero_button = section.settings.button_label_ar
    endif
    if section.settings.secondary_button_label_ar != blank
      assign hero_button_2 = section.settings.secondary_button_label_ar
    endif
  endif

  # ---- Images: English by default, Arabic overrides when provided ----
  assign hero_image = section.settings.image
  assign hero_mobile_image = section.settings.mobile_image
  assign hero_pos_x = section.settings.desktop_position_x
  assign hero_pos_y = section.settings.desktop_position_y
  assign hero_mobile_pos_x = section.settings.mobile_position_x
  assign hero_mobile_pos_y = section.settings.mobile_position_y

  if hero_locale == 'ar'
    if section.settings.arabic_image != blank
      assign hero_image = section.settings.arabic_image
      assign hero_pos_x = section.settings.arabic_desktop_position_x
      assign hero_pos_y = section.settings.arabic_desktop_position_y
    endif

    if section.settings.arabic_mobile_image != blank
      assign hero_mobile_image = section.settings.arabic_mobile_image
      assign hero_mobile_pos_x = section.settings.arabic_mobile_position_x
      assign hero_mobile_pos_y = section.settings.arabic_mobile_position_y
    elsif section.settings.arabic_image != blank
      assign hero_mobile_image = section.settings.arabic_image
      assign hero_mobile_pos_x = section.settings.arabic_mobile_position_x
      assign hero_mobile_pos_y = section.settings.arabic_mobile_position_y
    endif
  endif

  assign hero_line_1 = section.settings.heading_line_1
  if hero_line_1 == blank
    assign hero_line_1 = 'home.hero_title_1' | t
  endif

  assign hero_line_2 = section.settings.heading_line_2
  if hero_line_2 == blank
    assign hero_line_2 = 'home.hero_title_2' | t
  endif
%}

<section
  class="hero full-width hero--{{ section.settings.alignment }}{% if hero_image == blank %} hero--no-image{% endif %}{% if section.settings.show_text_mobile %} hero--show-text-mobile{% endif %}"
  style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-text-width: {{ section.settings.text_width }}rem; --hero-pos-x: {{ hero_pos_x }}%; --hero-pos-y: {{ hero_pos_y }}%; --hero-mobile-pos-x: {{ hero_mobile_pos_x }}%; --hero-mobile-pos-y: {{ hero_mobile_pos_y }}%;"
>
  {% if hero_image != blank %}
    <div class="hero__media">
      <picture>
        {% if hero_mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ hero_mobile_image | image_url: width: 750 }} 750w, {{ hero_mobile_image | image_url: width: 1125 }} 1125w, {{ hero_mobile_image | image_url: width: 1500 }} 1500w"
            sizes="100vw"
          >
        {% endif %}
        {{ hero_image
          | image_url: width: 2400
          | image_tag:
            widths: '640, 960, 1280, 1600, 2000, 2400',
            sizes: '100vw',
            loading: image_loading,
            fetchpriority: image_fetchpriority
        }}
      </picture>
    </div>
  {% endif %}

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content">

    {% if hero_eyebrow != blank %}
      <p class="eyebrow">{{ hero_eyebrow | escape }}</p>
    {% endif %}

    <h1 class="hero__heading">
      <span>{{ hero_line_1 | escape }}</span>
      <span>{{ hero_line_2 | escape }}</span>
    </h1>

    {% if hero_text != blank %}
      <div class="hero__text rte">
        {{ hero_text }}
      </div>
    {% endif %}

    {% if hero_button != blank or hero_button_2 != blank %}
      <div class="hero__actions">

        {% if hero_button != blank %}
          <a
            class="hero__button"
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          >
            <span>{{ hero_button | escape }}</span>
            <span class="hero__button-arrow" aria-hidden="true"></span>
          </a>
        {% endif %}

        {% if hero_button_2 != blank %}
          <a
            class="hero__button hero__button--secondary"
            href="{{ section.settings.secondary_button_link | default: routes.root_url }}"
          >
            <span>{{ hero_button_2 | escape }}</span>
            <span class="hero__button-arrow" aria-hidden="true"></span>
          </a>
        {% endif %}

      </div>
    {% endif %}

  </div>
</section>

{% stylesheet %}

/* =========================
   HERO
========================= */

.hero {
  /* ---- Easy tweaks ---- */
  --hero-ratio: 1920 / 720;            /* desktop height (was 1920 / 600) */
  --hero-mobile-min-height: 72svh;     /* mobile height (was 62svh) */
  --hero-heading-mobile: clamp(2.5rem, 11vw, 3.3rem); /* mobile heading size */
  --hero-ink: #000;                    /* text + button color */

  position: relative;
  display: grid;

  width: 100%;
  max-width: 1920px;

  margin-inline: auto;

  aspect-ratio: var(--hero-ratio);

  isolation: isolate;
  overflow: hidden;

  background: var(--color-surface);

  place-items: center start;
}


/* =========================
   MEDIA
========================= */

.hero__media,
.hero__overlay {
  position: absolute;
  z-index: -2;
  inset: 0;
}

.hero__media picture {
  display: block;

  width: 100%;
  height: 100%;
}

.hero__media img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: var(--hero-pos-x, 50%) var(--hero-pos-y, 50%);
}


/* =========================
   OVERLAY
========================= */

.hero__overlay {
  z-index: -1;

  background: rgb(0 0 0 / var(--hero-overlay));
}


/* =========================
   CONTENT
========================= */

.hero__content {
  width: min(
    var(--hero-text-width),
    calc(100% - 48px)
  );

  max-width: var(--hero-text-width);

  margin-inline-start:
    max(24px, calc((100% - 1400px) / 2));

  margin-inline-end: auto;

  padding-block: 48px;

  color: var(--hero-ink);

  text-align: start;
}


.hero__heading {
  margin-block: var(--space-3);

  color: var(--hero-ink);
}

.hero__heading span {
  display: block;
}

.hero__content .eyebrow {
  color: var(--hero-ink);
}

.hero__text {
  max-width: 34rem;

  padding-block: 1.6em;

  font-size:
    clamp(1rem, 1.5vw, 1.15rem);

  color: var(--hero-ink);
}


/* =========================
   BUTTONS
========================= */

.hero__actions {
  display: flex;

  flex-wrap: wrap;

  justify-content: flex-start;

  gap: 14px;

  margin-top: 30px;
}

.hero__button {
  display: inline-flex;

  align-items: center;

  gap: 18px;

  padding: 16px 28px;

  background: var(--hero-ink);
  color: #fff;

  border: 1px solid var(--hero-ink);

  text-decoration: none;

  font-size: 12px;
  line-height: 1;
  font-weight: 500;

  letter-spacing: .18em;
  text-transform: uppercase;

  transition:
    background .35s ease,
    color .35s ease,
    border-color .35s ease;
}

.hero__button-arrow {
  position: relative;

  display: block;

  width: 13px;
  height: 10px;

  flex-shrink: 0;
}

.hero__button-arrow::before {
  content: "";

  position: absolute;

  left: 0;
  top: 5px;

  width: 8px;
  height: 1px;

  background: currentColor;
}

.hero__button-arrow::after {
  content: "";

  position: absolute;

  right: 1px;
  top: 2px;

  width: 6px;
  height: 6px;

  border-top: 1px solid currentColor;
  border-right: 1px solid currentColor;

  transform: rotate(45deg);

  transition: transform .35s ease;
}

.hero__button:hover {
  background: transparent;

  color: var(--hero-ink);

  border-color: var(--hero-ink);
}

.hero__button:hover
.hero__button-arrow::after {
  transform:
    translateX(4px)
    rotate(45deg);
}

.hero__button:focus-visible {
  outline: 2px solid var(--hero-ink);
  outline-offset: 3px;
}


/* =========================
   SECONDARY BUTTON
========================= */

.hero__button--secondary {
  background: transparent;

  color: var(--hero-ink);

  border-color: var(--hero-ink);
}

.hero__button--secondary:hover {
  background: var(--hero-ink);

  color: #fff;

  border-color: var(--hero-ink);
}


/* =========================
   CENTER
========================= */

.hero--center {
  place-items: center;
}

.hero--center .hero__content {
  margin-inline: auto;
  text-align: center;
}

.hero--center .hero__text {
  margin-inline: auto;
}

.hero--center .hero__actions {
  justify-content: center;
}


/* =========================
   LEFT
========================= */

.hero--left {
  place-items: center start;
}

.hero--left .hero__content {
  text-align: start;
}

.hero--left .hero__actions {
  justify-content: flex-start;
}


/* =========================
   NO IMAGE
========================= */

.hero--no-image .hero__content,
.hero--no-image .hero__heading,
.hero--no-image .hero__content .eyebrow,
.hero--no-image .hero__text {
  color: var(--color-foreground);
}


/* =========================
   LARGE DESKTOP
========================= */

@media (min-width: 1500px) {

  .hero__content {
    margin-inline-start:
      max(
        32px,
        calc((100% - 1500px) / 2)
      );
  }
}


/* =========================
   TABLET
========================= */

@media (min-width: 750px) and (max-width: 1100px) {

  .hero {
    aspect-ratio: var(--hero-ratio);
  }

  .hero__content {
    width:
      min(
        42rem,
        calc(100% - 56px)
      );

    margin-inline-start: 28px;
  }
}


/* =========================
   MOBILE
========================= */

@media (max-width: 749px) {

  .hero {
    min-height: var(--hero-mobile-min-height);
    aspect-ratio: auto;
    max-width: 100%;
  }

  .hero__media img {
    object-position: var(--hero-mobile-pos-x, 58%) var(--hero-mobile-pos-y, 50%);
  }

  .hero__content {
    width: calc(100% - 40px);

    max-width: none;

    margin-inline-start: 20px;

    padding-block: 40px;
  }

  .hero__heading {
    max-width: none;

    font-size: var(--hero-heading-mobile);
    line-height: 1.05;
  }

  /* small description hidden on mobile unless enabled in the editor */
  .hero__text {
    display: none;

    max-width: 21rem;

    font-size: .95rem;
  }

  .hero--show-text-mobile .hero__text {
    display: block;
  }

  .hero__actions {
    margin-top: 28px;
  }

  .hero__button {
    padding: 15px 24px;

    gap: 15px;

    font-size: 11px;
  }

}
/* =========================
   ARABIC / RTL
========================= */

[dir="rtl"] .hero__button-arrow {
  transform: scaleX(-1);
}

[dir="rtl"] .hero__button {
  font-size: 13px;
  letter-spacing: 0;
}

[dir="rtl"] .hero__content .eyebrow {
  font-size: 1rem;
}

@media (max-width: 749px) {
  [dir="rtl"] .hero__button {
    font-size: 12px;
  }
}

.shopify-section:has(.hero) {
  background: #F7F4EE;
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional portrait image (4:5 or 3:4) used on mobile. Leave blank to use the main image."
    },
    {
      "type": "header",
      "content": "Arabic images (optional)"
    },
    {
      "type": "image_picker",
      "id": "arabic_image",
      "label": "Arabic image",
      "info": "Desktop image for the Arabic site. Leave blank to use the main image."
    },
    {
      "type": "image_picker",
      "id": "arabic_mobile_image",
      "label": "Arabic mobile image",
      "info": "Mobile image for the Arabic site. If blank: Arabic image, then Mobile image, then main image."
    },
    {
      "type": "header",
      "content": "Image crop - Desktop"
    },
    {
      "type": "range",
      "id": "desktop_position_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Horizontal position",
      "info": "0% = left, 100% = right",
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_position_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Vertical position",
      "info": "0% = top, 100% = bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Image crop - Mobile"
    },
    {
      "type": "range",
      "id": "mobile_position_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Horizontal position",
      "info": "0% = left, 100% = right",
      "default": 58
    },
    {
      "type": "range",
      "id": "mobile_position_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Vertical position",
      "info": "0% = top, 100% = bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Arabic image crop - Desktop"
    },
    {
      "type": "range",
      "id": "arabic_desktop_position_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Horizontal position",
