      "default": 50
    },
    {
      "type": "range",
      "id": "arabic_desktop_position_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Vertical position",
      "info": "Used only when an Arabic image is set. 0% = top, 100% = bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Arabic image crop - Mobile"
    },
    {
      "type": "range",
      "id": "arabic_mobile_position_x",
      "min": 0,
