{% liquid
  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'

  if section.index == 1
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif
%}

<section
  class="hero full-width hero--{{ section.settings.alignment }}{% if section.settings.image == blank %} hero--no-image{% endif %}"
  style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-text-width: {{ section.settings.text_width }}rem;"
>
  {% if section.settings.image != blank %}
    <div class="hero__media">
      {{ section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '640, 960, 1280, 1600, 2000, 2400',
          sizes: '100vw',
          loading: image_loading,
          fetchpriority: image_fetchpriority
      }}
    </div>
  {% endif %}

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content">

    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    <h1 class="hero__heading">
      <span>Elegance</span>
      <span>in Every Detail</span>
    </h1>

    {% if section.settings.text != blank %}
      <div class="hero__text rte">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank or section.settings.secondary_button_label != blank %}
      <div class="hero__actions">

        {% if section.settings.button_label != blank %}
          <a
            class="hero__button"
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          >
            <span>{{ section.settings.button_label | escape }}</span>
            <span class="hero__button-arrow" aria-hidden="true"></span>
          </a>
        {% endif %}

        {% if section.settings.secondary_button_label != blank %}
          <a
            class="hero__button hero__button--secondary"
            href="{{ section.settings.secondary_button_link | default: routes.root_url }}"
          >
            <span>{{ section.settings.secondary_button_label | escape }}</span>
            <span class="hero__button-arrow" aria-hidden="true"></span>
          </a>
        {% endif %}

      </div>
    {% endif %}

  </div>
</section>

{% stylesheet %}

/* =========================
   HERO
========================= */

.hero {
  position: relative;
  display: grid;

  width: 100%;
  max-width: 1920px;

  margin-inline: auto;

  aspect-ratio: 1920 / 600;

  isolation: isolate;
  overflow: hidden;

  background: var(--color-surface);

  place-items: center start;
}


/* =========================
   MEDIA
========================= */

.hero__media,
.hero__overlay {
  position: absolute;
  z-index: -2;
  inset: 0;
}

.hero__media img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;
}


/* =========================
   OVERLAY
========================= */

.hero__overlay {
  z-index: -1;

  background: rgb(0 0 0 / var(--hero-overlay));
}


/* =========================
   CONTENT
========================= */

.hero__content {
  width: min(
    var(--hero-text-width),
    calc(100% - 48px)
  );

  max-width: var(--hero-text-width);

  margin-left:
    max(24px, calc((100% - 1400px) / 2));

  margin-right: auto;

  padding-block: 48px;

  color: #fff;

  text-align: left;
}


.hero__heading {
  margin-block: var(--space-3);

  color: #fff;
}

.hero__heading span {
  display: block;
}

.hero__content .eyebrow {
  color: #fff;
}

.hero__text {
  max-width: 34rem;

  font-size:
    clamp(1rem, 1.5vw, 1.15rem);

  color: #fff;
}


/* =========================
   BUTTONS
========================= */

.hero__actions {
  display: flex;

  flex-wrap: wrap;

  justify-content: flex-start;

  gap: 12px;

  margin-top: 26px;
}

.hero__button {
  display: inline-flex;

  align-items: center;

  gap: 15px;

  padding: 13px 19px;

  background: #fff;
  color: #000;

  border: 1px solid #fff;

  text-decoration: none;

  font-size: 11px;
  line-height: 1;
  font-weight: 500;

  letter-spacing: .12em;
  text-transform: uppercase;

  transition:
    background .3s ease,
    color .3s ease,
    border-color .3s ease;
}

.hero__button-arrow {
  position: relative;

  display: block;

  width: 13px;
  height: 10px;

  flex-shrink: 0;
}

.hero__button-arrow::before {
  content: "";

  position: absolute;

  left: 0;
  top: 5px;

  width: 8px;
  height: 1px;

  background: currentColor;
}

.hero__button-arrow::after {
  content: "";

  position: absolute;

  right: 1px;
  top: 2px;

  width: 6px;
  height: 6px;

  border-top: 1px solid currentColor;
  border-right: 1px solid currentColor;

  transform: rotate(45deg);

  transition: transform .3s ease;
}

.hero__button:hover {
  background: transparent;

  color: #fff;

  border-color: #fff;
}

.hero__button:hover
.hero__button-arrow::after {
  transform:
    translateX(4px)
    rotate(45deg);
}


/* =========================
   SECONDARY BUTTON
========================= */

.hero__button--secondary {
  background: transparent;

  color: #fff;

  border-color:
    rgb(255 255 255 / 70%);
}

.hero__button--secondary:hover {
  background: #fff;

  color: #000;

  border-color: #fff;
}


/* =========================
   CENTER
========================= */

.hero--center {
  place-items: center;
}

.hero--center .hero__content {
  margin-inline: auto;
  text-align: center;
}

.hero--center .hero__text {
  margin-inline: auto;
}

.hero--center .hero__actions {
  justify-content: center;
}


/* =========================
   LEFT
========================= */

.hero--left {
  place-items: center start;
}

.hero--left .hero__content {
  text-align: left;
}

.hero--left .hero__actions {
  justify-content: flex-start;
}


/* =========================
   NO IMAGE
========================= */

.hero--no-image .hero__content,
.hero--no-image .hero__heading,
.hero--no-image .hero__content .eyebrow,
.hero--no-image .hero__text {
  color: var(--color-foreground);
}


/* =========================
   LARGE DESKTOP
========================= */

@media (min-width: 1500px) {

  .hero__content {
    margin-left:
      max(
        32px,
        calc((100% - 1500px) / 2)
      );
      background: #F7F4EE;
  }

  .hero__media img {
    object-position: center;
  }
}


/* =========================
   TABLET
========================= */

@media (min-width: 750px) and (max-width: 1100px) {

  .hero {
  aspect-ratio: 1920 / 600;
}

  .hero__content {
    width:
      min(
        42rem,
        calc(100% - 56px)
      );

    margin-left: 28px;
  }
}


/* =========================
   MOBILE
========================= */

@media (max-width: 749px) {

  .hero {
    min-height: 62svh;
    aspect-ratio: auto;
    max-width: 100%;
  }

  .hero__media img {
    object-position: 58% center;
  }

  .hero__content {
    width: calc(100% - 40px);

    max-width: none;

    margin-left: 20px;

    padding-block: 40px;
  }

  .hero__heading {
    max-width: 21rem;
  }

  .hero__text {
    max-width: 21rem;

    font-size: .95rem;
  }

  .hero__actions {
    margin-top: 24px;
  }

  .hero__button {
    padding: 12px 17px;

    gap: 13px;

    font-size: 10px;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:labels.overlay_opacity",
      "default": 35
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Made for real life"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Products worth making room for"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Clear value, thoughtful details, and an easy path from discovery to checkout.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:labels.secondary_button_label"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "t:labels.secondary_button_link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "text_width",
      "min": 28,
      "max": 60,
      "step": 2,
      "unit": "rem",
      "label": "t:labels.text_width",
      "default": 46
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
