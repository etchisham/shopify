{% liquid
  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif
%}

<section
  class="hero full-width hero--{{ section.settings.alignment }}{% if section.settings.image == blank %} hero--no-image{% endif %}"
  style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-text-width: {{ section.settings.text_width }}rem;"
>
  {% if section.settings.image != blank %}
    <div class="hero__media">
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '640, 960, 1280, 1600, 2000, 2400', sizes: '100vw', loading: image_loading, fetchpriority: image_fetchpriority }}
    </div>
  {% endif %}
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h1>{{ section.settings.heading | escape }}</h1>{% endif %}
    {% if section.settings.text != blank %}<div class="hero__text rte">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.button_label != blank or section.settings.secondary_button_label != blank %}
      <div class="hero__actions">
        {% if section.settings.button_label != blank %}
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
        {% endif %}
        {% if section.settings.secondary_button_label != blank %}
          <a class="button button--secondary" href="{{ section.settings.secondary_button_link | default: routes.root_url }}">{{ section.settings.secondary_button_label | escape }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    min-height: clamp(32rem, 74svh, 52rem);
    isolation: isolate;
    place-items: center;
    overflow: hidden;
    background: var(--color-surface);
  }

  .hero__media,
  .hero__overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    z-index: -1;
    background: rgb(0 0 0 / var(--hero-overlay));
  }

  .hero__content {
    width: min(var(--hero-text-width), calc(100% - var(--page-margin) * 2));
    color: #fff;
    padding-block: var(--space-8);
    text-align: center;
  }

  .hero__content h1 {
    margin-block: var(--space-3);
  }

  .hero__text {
    font-size: clamp(1rem, 2vw, 1.2rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-block-start: var(--space-5);
  }

  .hero .button--secondary {
    border-color: rgb(255 255 255 / 65%);
    color: #fff;
  }

  .hero--no-image .hero__content {
    color: var(--color-foreground);
  }

  .hero--no-image .button--secondary {
    border-color: var(--color-border);
    color: var(--color-foreground);
  }

  .hero--left {
    place-items: center start;
  }

  .hero--left .hero__content {
    margin-inline: max(var(--page-margin), calc((100% - var(--page-width)) / 2));
    text-align: start;
  }

  .hero--left .hero__actions {
    justify-content: flex-start;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "t:labels.overlay_opacity", "default": 35 },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Made for real life" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Products worth making room for" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Clear value, thoughtful details, and an easy path from discovery to checkout.</p>" },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Shop products" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "text", "id": "secondary_button_label", "label": "t:labels.secondary_button_label" },
    { "type": "url", "id": "secondary_button_link", "label": "t:labels.secondary_button_link" },
    { "type": "select", "id": "alignment", "label": "t:labels.alignment", "options": [{ "value": "left", "label": "t:options.alignment.left" }, { "value": "center", "label": "t:options.alignment.center" }], "default": "center" },
    { "type": "range", "id": "text_width", "min": 28, "max": 60, "step": 2, "unit": "rem", "label": "t:labels.text_width", "default": 46 }
  ],
  "presets": [{ "name": "t:general.hero" }]
}
{% endschema %}
