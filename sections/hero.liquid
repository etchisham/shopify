{% liquid
  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'

  if section.index == 1
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif

  assign hero_locale = request.locale.iso_code | split: '-' | first

  assign hero_eyebrow = section.settings.eyebrow
  assign hero_text = section.settings.text
  assign hero_button = section.settings.button_label
  assign hero_button_2 = section.settings.secondary_button_label

  if hero_locale == 'ar'
    if section.settings.eyebrow_ar != blank
      assign hero_eyebrow = section.settings.eyebrow_ar
    endif
    if section.settings.text_ar != blank
      assign hero_text = section.settings.text_ar
    endif
    if section.settings.button_label_ar != blank
      assign hero_button = section.settings.button_label_ar
    endif
    if section.settings.secondary_button_label_ar != blank
      assign hero_button_2 = section.settings.secondary_button_label_ar
    endif
  endif

  assign hero_line_1 = section.settings.heading_line_1
  if hero_line_1 == blank
    assign hero_line_1 = 'home.hero_title_1' | t
  endif

  assign hero_line_2 = section.settings.heading_line_2
  if hero_line_2 == blank
    assign hero_line_2 = 'home.hero_title_2' | t
  endif
%}

<section
  class="hero full-width hero--{{ section.settings.alignment }}{% if section.settings.image == blank %} hero--no-image{% endif %}"
  style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-text-width: {{ section.settings.text_width }}rem;"
>
  {% if section.settings.image != blank %}
    <div class="hero__media">
      {{ section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '640, 960, 1280, 1600, 2000, 2400',
          sizes: '100vw',
          loading: image_loading,
          fetchpriority: image_fetchpriority
      }}
    </div>
  {% endif %}

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content">

    {% if hero_eyebrow != blank %}
      <p class="eyebrow">{{ hero_eyebrow | escape }}</p>
    {% endif %}

    <h1 class="hero__heading">
      <span>{{ hero_line_1 | escape }}</span>
      <span>{{ hero_line_2 | escape }}</span>
    </h1>

    {% if hero_text != blank %}
      <div class="hero__text rte">
        {{ hero_text }}
      </div>
    {% endif %}

    {% if hero_button != blank or hero_button_2 != blank %}
      <div class="hero__actions">

        {% if hero_button != blank %}
          <a
            class="hero__button"
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          >
            <span>{{ hero_button | escape }}</span>
            <span class="hero__button-arrow" aria-hidden="true"></span>
          </a>
        {% endif %}

        {% if hero_button_2 != blank %}
          <a
            class="hero__button hero__button--secondary"
            href="{{ section.settings.secondary_button_link | default: routes.root_url }}"
          >
            <span>{{ hero_button_2 | escape }}</span>
            <span class="hero__button-arrow" aria-hidden="true"></span>
          </a>
        {% endif %}

      </div>
    {% endif %}

  </div>
</section>

{% stylesheet %}

/* =========================
   HERO
========================= */

.hero {
  position: relative;
  display: grid;

  width: 100%;
  max-width: 1920px;

  margin-inline: auto;

  aspect-ratio: 1920 / 600;

  isolation: isolate;
  overflow: hidden;

  background: var(--color-surface);

  place-items: center start;
}


/* =========================
   MEDIA
========================= */

.hero__media,
.hero__overlay {
  position: absolute;
  z-index: -2;
  inset: 0;
}

.hero__media img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;
}


/* =========================
   OVERLAY
========================= */

.hero__overlay {
  z-index: -1;

  background: rgb(0 0 0 / var(--hero-overlay));
}


/* =========================
   CONTENT
========================= */

.hero__content {
  width: min(
    var(--hero-text-width),
    calc(100% - 48px)
  );

  max-width: var(--hero-text-width);

  margin-inline-start:
    max(24px, calc((100% - 1400px) / 2));

  margin-inline-end: auto;

  padding-block: 48px;

  color: #fff;

  text-align: start;
}


.hero__heading {
  margin-block: var(--space-3);

  color: #fff;
}

.hero__heading span {
  display: block;
}

.hero__content .eyebrow {
  color: #fff;
}

.hero__text {
  max-width: 34rem;

  font-size:
    clamp(1rem, 1.5vw, 1.15rem);

  color: #fff;
}


/* =========================
   BUTTONS
========================= */

.hero__actions {
  display: flex;

  flex-wrap: wrap;

  justify-content: flex-start;

  gap: 12px;

  margin-top: 26px;
}

.hero__button {
  display: inline-flex;

  align-items: center;

  gap: 15px;

  padding: 13px 19px;

  background: #fff;
  color: #000;

  border: 1px solid #fff;

  text-decoration: none;

  font-size: 11px;
  line-height: 1;
  font-weight: 500;

  letter-spacing: .12em;
  text-transform: uppercase;

  transition:
    background .3s ease,
    color .3s ease,
    border-color .3s ease;
}

.hero__button-arrow {
  position: relative;

  display: block;

  width: 13px;
  height: 10px;

  flex-shrink: 0;
}

.hero__button-arrow::before {
  content: "";

  position: absolute;

  left: 0;
  top: 5px;

  width: 8px;
  height: 1px;

  background: currentColor;
}

.hero__button-arrow::after {
  content: "";

  position: absolute;

  right: 1px;
  top: 2px;

  width: 6px;
  height: 6px;

  border-top: 1px solid currentColor;
  border-right: 1px solid currentColor;

  transform: rotate(45deg);

  transition: transform .3s ease;
}

.hero__button:hover {
  background: transparent;

  color: #fff;

  border-color: #fff;
}

.hero__button:hover
.hero__button-arrow::after {
  transform:
    translateX(4px)
    rotate(45deg);
}


/* =========================
   SECONDARY BUTTON
========================= */

.hero__button--secondary {
  background: transparent;

  color: #fff;

  border-color:
    rgb(255 255 255 / 70%);
}

.hero__button--secondary:hover {
  background: #fff;

  color: #000;

  border-color: #fff;
}


/* =========================
   CENTER
========================= */

.hero--center {
  place-items: center;
}

.hero--center .hero__content {
  margin-inline: auto;
  text-align: center;
}

.hero--center .hero__text {
  margin-inline: auto;
}

.hero--center .hero__actions {
  justify-content: center;
}


/* =========================
   LEFT
========================= */

.hero--left {
  place-items: center start;
}

.hero--left .hero__content {
  text-align: start;
}

.hero--left .hero__actions {
  justify-content: flex-start;
}


/* =========================
   NO IMAGE
========================= */

.hero--no-image .hero__content,
.hero--no-image .hero__heading,
.hero--no-image .hero__content .eyebrow,
.hero--no-image .hero__text {
  color: var(--color-foreground);
}


/* =========================
   LARGE DESKTOP
========================= */

@media (min-width: 1500px) {

  .hero__content {
    margin-inline-start:
      max(
        32px,
        calc((100% - 1500px) / 2)
      );
      
  }

  .hero__media img {
    object-position: center;
  }
}


/* =========================
   TABLET
========================= */

@media (min-width: 750px) and (max-width: 1100px) {

  .hero {
  aspect-ratio: 1920 / 600;
}

  .hero__content {
    width:
      min(
        42rem,
        calc(100% - 56px)
      );

    margin-inline-start: 28px;
  }
}


/* =========================
   MOBILE
========================= */

@media (max-width: 749px) {

  .hero {
    min-height: 62svh;
    aspect-ratio: auto;
    max-width: 100%;
  }

  .hero__media img {
    object-position: 58% center;
  }

  .hero__content {
    width: calc(100% - 40px);

    max-width: none;

    margin-inline-start: 20px;

    padding-block: 40px;
  }

  .hero__heading {
    max-width: 21rem;
  }

  .hero__text {
    max-width: 21rem;

    font-size: .95rem;
  }

  .hero__actions {
    margin-top: 24px;
  }

  .hero__button {
    padding: 12px 17px;

    gap: 13px;

    font-size: 10px;
  }

}
/* =========================
   ARABIC / RTL
========================= */

[dir="rtl"] .hero__button-arrow {
  transform: scaleX(-1);
}

[dir="rtl"] .hero__heading {
  line-height: 1.3;
}

[dir="rtl"] .hero__button {
  font-size: 13px;
}

[dir="rtl"] .hero__content .eyebrow {
  font-size: 1rem;
}

@media (max-width: 749px) {
  [dir="rtl"] .hero__button {
    font-size: 12px;
  }
}

.shopify-section:has(.hero) {
  background: #F7F4EE;
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:labels.overlay_opacity",
      "default": 35
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Made for real life"
    },
    {
      "type": "text",
      "id": "eyebrow_ar",
      "label": "Eyebrow - Arabic",
      "info": "Shown on the Arabic site. Leave blank to use the English text (or its Translate & Adapt translation).",
      "default": "مجوهرات خالدة"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Products worth making room for"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading - Line 1",
      "info": "Leave blank to use the translated default (Elegance)."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading - Line 2",
      "info": "Leave blank to use the translated default (in Every Detail)."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Clear value, thoughtful details, and an easy path from discovery to checkout.</p>"
    },
    {
      "type": "richtext",
      "id": "text_ar",
      "label": "Text - Arabic",
      "default": "<p>قطع عصرية تترك أثرًا يدوم.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop Now"
    },
    {
      "type": "text",
      "id": "button_label_ar",
      "label": "Button label - Arabic",
      "default": "تسوق الآن"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:labels.secondary_button_label"
    },
    {
      "type": "text",
      "id": "secondary_button_label_ar",
      "label": "Secondary button label - Arabic"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "t:labels.secondary_button_link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "text_width",
      "min": 28,
      "max": 60,
      "step": 2,
      "unit": "rem",
      "label": "t:labels.text_width",
      "default": 46
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
