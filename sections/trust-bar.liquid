{%- liquid
  assign trust_locale = request.locale.iso_code | split: '-' | first
  assign trust_heading = section.settings.heading
  if trust_locale == 'ar' and section.settings.heading_ar != blank
    assign trust_heading = section.settings.heading_ar
  endif
-%}

<section class="trust-bar section-spacing" aria-label="{{ trust_heading | escape }}">
  {% if trust_heading != blank %}<h2 class="visually-hidden">{{ trust_heading | escape }}</h2>{% endif %}
  <ul class="trust-bar__grid" role="list">
    {% for block in section.blocks %}
      {%- liquid
        assign item_heading = block.settings.heading
        assign item_text = block.settings.text
        if trust_locale == 'ar'
          if block.settings.heading_ar != blank
            assign item_heading = block.settings.heading_ar
          endif
          if block.settings.text_ar != blank
            assign item_text = block.settings.text_ar
          endif
        endif
      -%}
      <li class="trust-bar__item" {{ block.shopify_attributes }}>
        <span class="trust-bar__mark" aria-hidden="true">✓</span>
        <div>
          <h3>{{ item_heading | escape }}</h3>
          {% if item_text != blank %}<p>{{ item_text | escape }}</p>{% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
</section>

<script>
  /* The items rise and fade in one after the other when the bar comes into view */
  (() => {
    const bar = document.currentScript.previousElementSibling;

    if (
      !bar ||
      !('IntersectionObserver' in window) ||
      (window.Shopify && window.Shopify.designMode) ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) return;

    const items = Array.from(bar.querySelectorAll('.trust-bar__item'));

    if (!items.length) return;

    bar.classList.add('has-reveal');

    /* already passed (above the screen): show without motion */
    if (bar.getBoundingClientRect().bottom < 0) {
      items.forEach((item) => item.classList.add('hilya-instant', 'is-revealed'));
      return;
    }

    const io = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;

      items.forEach((item, index) => {
        item.style.setProperty('--reveal-delay', (index * 0.2) + 's');
        item.classList.add('is-revealed');
      });

      io.disconnect();
    }, { threshold: 0.1, rootMargin: '0px 0px -12% 0px' });

    io.observe(bar);
  })();
</script>

{% stylesheet %}
  .trust-bar {
    padding-block: var(--space-5);
    margin-top: 2rem;
    border-block: 1px solid var(--color-border);
  }
  

  .trust-bar__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
  }

  .trust-bar__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .trust-bar__mark {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--hilya-rose-deep);
    font-weight: 800;
  }

  .trust-bar h3 {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    letter-spacing: 0;
  }

  .trust-bar p {
    margin: 0.15rem 0 0;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  /* Rise and fade in (only when the script above switched it on) */
  .trust-bar.has-reveal .trust-bar__item {
    transition:
      opacity 1.2s ease var(--reveal-delay, 0s),
      transform 1.6s cubic-bezier(.22, .8, .3, 1) var(--reveal-delay, 0s);
  }

  .trust-bar.has-reveal .trust-bar__item:not(.is-revealed) {
    opacity: 0;
    transform: translateY(40px);
  }

  .trust-bar.has-reveal .trust-bar__item.hilya-instant {
    transition: none;
  }

  /* Arabic */
  [dir="rtl"] .trust-bar h3 {
    font-size: 1.05rem;
    line-height: 1.5;
  }

  [dir="rtl"] .trust-bar p {
    font-size: .92rem;
    line-height: 1.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.trust_bar",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Why shop with us" },
    { "type": "text", "id": "heading_ar", "label": "Heading - Arabic", "default": "لماذا تتسوق معنا" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:general.content",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Secure checkout" },
        { "type": "text", "id": "text", "label": "t:labels.text", "default": "Protected by Shopify" },
        { "type": "text", "id": "heading_ar", "label": "Heading - Arabic", "info": "Shown on the Arabic site. Leave blank to use the English heading." },
        { "type": "text", "id": "text_ar", "label": "Text - Arabic" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.trust_bar",
      "blocks": [
        { "type": "item", "settings": { "heading": "Secure checkout", "text": "Protected by Shopify" } },
        { "type": "item", "settings": { "heading": "Clear product details", "text": "Know what you are choosing" } },
        { "type": "item", "settings": { "heading": "Questions?", "text": "Contact us before ordering" } }
      ]
    }
  ]
}
{% endschema %}
