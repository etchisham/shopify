<section class="fl-section fl-section--surface full-width">
  <div class="fl-container--wide">
    <div class="fl-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="fl-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p class="fl-section__intro">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="fl-collection-grid">
      {%- for block in section.blocks -%}
        {%- assign tile_collection = block.settings.collection -%}
        {%- assign tile_image = block.settings.image | default: tile_collection.featured_image -%}
        {%- assign tile_title = block.settings.title | default: tile_collection.title -%}
        <a class="fl-collection-tile" href="{{ tile_collection.url | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if tile_image != blank -%}
            {%- assign tile_alt = tile_image.alt | default: tile_title -%}
            {{ tile_image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 1024px) 33vw, 100vw', loading: 'lazy', alt: tile_alt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          <span class="fl-collection-tile__content">
            <span class="fl-eyebrow">{{ block.settings.eyebrow }}</span>
            <span class="fl-collection-tile__title fl-display">{{ tile_title | default: 'Choose a collection' }}</span>
            <span class="fl-link">Explore</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your way in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by room" },
    { "type": "text", "id": "text", "label": "Supporting text", "default": "Begin with the place you want to make feel complete." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Override image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A considered room" },
        { "type": "text", "id": "title", "label": "Override title" }
      ]
    }
  ],
  "presets": [{
    "name": "Collection tiles",
    "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
  }]
}
{% endschema %}
