<article class="page-content section-spacing">
  <h1>{{ page.title | escape }}</h1>
  <div class="rte">{{ page.content }}</div>
</article>

{% stylesheet %}
  .page-content {
    max-width: 52rem;
    margin-inline: auto;
  }

  .page-content > h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
    margin-block-end: var(--space-6);
  }
{% endstylesheet %}

{% schema %}
{ "name": "t:general.page", "settings": [] }
{% endschema %}
