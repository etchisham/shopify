{%- liquid
  assign has_proof = false
  if section.blocks.size > 0
    assign has_proof = true
  endif
-%}
{%- if has_proof or request.design_mode -%}
  <section id="CustomerProof" class="fl-section full-width">
    <div class="fl-container">
      <div class="fl-section__head">
        <div><span class="fl-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
      </div>
      <div class="fl-product-grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.quote != blank -%}
            <figure class="fl-value" {{ block.shopify_attributes }}>
              <div class="fl-rating" aria-label="{{ block.settings.rating }} out of 5 stars">
                <span class="fl-rating__stars" aria-hidden="true">★★★★★</span><span>{{ block.settings.rating }}/5</span>
              </div>
              <blockquote>“{{ block.settings.quote }}”</blockquote>
              <figcaption class="fl-quote__meta">{{ block.settings.customer }}{% if block.settings.context != blank %} · {{ block.settings.context }}{% endif %}{% if block.settings.verified %} · Verified purchase{% endif %}</figcaption>
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.blocks.size == 0 and request.design_mode -%}<p>Add genuine customer reviews as blocks. Empty section stays hidden on storefront.</p>{%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Customer proof",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Living with it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In considered homes" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Verified review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Exact customer quote" },
        { "type": "text", "id": "customer", "label": "Customer name" },
        { "type": "text", "id": "context", "label": "Product or room context" },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Customer proof" }]
}
{% endschema %}
