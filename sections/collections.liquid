<section class="collection-list">
  <div class="collection-list__grid">
    {% assign allowed_collections = 'necklaces,rings,pendants,bracelets,keychains' | split: ',' %}

    {% for handle in allowed_collections %}
      {% assign collection = collections[handle] %}

      {% if collection != blank %}
        <article class="collection-card">
          <a href="{{ collection.url }}" class="collection-card__link">

            <div class="collection-card__media">
              {% if collection.featured_image %}
                {{ collection.featured_image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 1000',
                    sizes: '(min-width: 990px) 20vw, 50vw',
                    alt: collection.title
                }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
              {% endif %}

              <div class="collection-card__overlay">
                <h2 class="collection-card__title">
                  {{ collection.title | escape }}
                </h2>

                <span class="collection-card__arrow">→</span>
              </div>
            </div>

          </a>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}

.collection-list {
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
  padding: 20px max(24px, calc((100vw - 1400px) / 2)) 0;
  box-sizing: border-box;
}

.collection-list__grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 18px;
  width: 100%;
}

.collection-card {
  min-width: 0;
}

.collection-card__link {
  display: block;
  color: inherit;
  text-decoration: none;
}

.collection-card__media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1.15;
  overflow: hidden;
  background: #f5f2ed;
}

.collection-card__media::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.38),
    rgba(0, 0, 0, 0.08) 40%,
    transparent 65%
  );
  pointer-events: none;
}

.collection-card__media img,
.collection-card__placeholder {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.collection-card__link:hover .collection-card__media img {
  transform: scale(1.03);
}

.collection-card__overlay {
  position: absolute;
  z-index: 2;
  left: 22px;
  bottom: 20px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  color: #fff;
}

.collection-card__title {
  margin: 0;
  color: #fff;
  font-size: 11px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.collection-card__arrow {
  display: block;
  color: #fff;
  font-size: 18px;
  line-height: 1;
  font-weight: 300;
  transition: transform 0.3s ease;
}

.collection-card__link:hover .collection-card__arrow {
  transform: translateX(5px);
}

/* Large desktop */

@media (min-width: 1500px) {
  .collection-list {
    padding-left: max(32px, calc((100vw - 1500px) / 2));
    padding-right: max(32px, calc((100vw - 1500px) / 2));
  }
}

/* Tablet */

@media (min-width: 750px) and (max-width: 1100px) {
  .collection-list {
    padding-left: 28px;
    padding-right: 28px;
  }

  .collection-list__grid {
    gap: 14px;
  }

  .collection-card__overlay {
    left: 17px;
    bottom: 17px;
  }
}

/* Mobile */

/* Mobile */

@media (max-width: 749px) {
  .collection-list {
    width: 100%;
    max-width: none;
    margin-left: 0;
    padding: 20px 5px 0;
  }

  .collection-list__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .collection-card__overlay {
    left: 14px;
    bottom: 14px;
    gap: 7px;
  }

  .collection-card__title {
    font-size: 9px;
    letter-spacing: 0.11em;
  }

  .collection-card__arrow {
    font-size: 15px;
  }

  .collection-card:last-child {
    grid-column: 1 / -1;
    width: calc(50% - 7px);
    margin-inline: auto;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:general.collections_grid"
    }
  ]
}
{% endschema %}