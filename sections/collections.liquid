<section class="collection-list section-spacing">
  <h1>{{ 'collections.title' | t }}</h1>
  <div class="collection-list__grid" style="--collection-gap: {{ section.settings.grid_gap }}px;">
    {% for collection in collections %}
      <article class="collection-card">
        <a class="collection-card__media" href="{{ collection.url }}" tabindex="-1" aria-hidden="true">
          {% if collection.featured_image %}
            {% render 'image', image: collection.featured_image, width: 1000, widths: '360, 540, 720, 1000', sizes: '(min-width: 768px) 33vw, 100vw', alt: collection.featured_image.alt %}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
          {% endif %}
        </a>
        <div>
          <h2><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h2>
          {% if collection.description != blank %}<p class="muted">{{ collection.description | strip_html | truncatewords: 20 }}</p>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .collection-list > h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
    margin-block-end: var(--space-6);
  }

  .collection-list__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: var(--collection-gap);
  }

  .collection-card {
    position: relative;
    display: grid;
    gap: var(--space-4);
  }

  .collection-card__media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-large);
    background: var(--color-surface);
  }

  .collection-card__media .image,
  .collection-card__media img,
  .collection-card__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .collection-card h2 {
    margin: 0;
    font-size: 1.4rem;
  }

  .collection-card h2 a {
    text-decoration: none;
  }

  .collection-card h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    { "type": "range", "id": "grid_gap", "label": "t:labels.grid_gap", "min": 12, "max": 48, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
