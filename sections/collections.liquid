<section class="collection-list">
  <div class="collection-list__grid">
    {% assign allowed_collections = 'necklaces,rings,pendants,bracelets,keychains' | split: ',' %}

    {% for handle in allowed_collections %}
      {% assign collection = collections[handle] %}

      {% if collection != blank %}
        <article class="collection-card">
          <a href="{{ collection.url }}" class="collection-card__link">
            
            <div class="collection-card__media">
              {% if collection.featured_image %}
                {{ collection.featured_image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 1000',
                    sizes: '(min-width: 990px) 20vw, 50vw',
                    alt: collection.title
                }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
              {% endif %}
            </div>

            <h2 class="collection-card__title">
              {{ collection.title | escape }}
            </h2>

          </a>
        </article>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}

.collection-list {
  padding-top: 20px;
}

.collection-list__grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 24px;
}

.collection-card {
  min-width: 0;
}

.collection-card__link {
  display: block;
  color: inherit;
  text-decoration: none;
}

.collection-card__media {
  width: 100%;
  aspect-ratio: 1 / 1.15;
  overflow: hidden;
  background: #f5f2ed;
}

.collection-card__media img,
.collection-card__placeholder {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.collection-card__link:hover .collection-card__media img {
  transform: scale(1.03);
}

.collection-card__title {
  margin: 14px 0 0;
  text-align: center;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* Mobile */
@media (max-width: 749px) {
  .collection-list__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 14px;
  }

  .collection-card__title {
    margin-top: 11px;
    font-size: 13px;
    letter-spacing: 0.07em;
  }

  .collection-card:last-child {
    grid-column: 1 / -1;
    width: calc(50% - 7px);
    margin-inline: auto;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:general.collections_grid"
    }
  ]
}
{% endschema %}