{%- liquid
  assign co_locale = request.locale.iso_code | split: '-' | first
  assign co_ar = false
  if co_locale == 'ar'
    assign co_ar = true
  endif

  assign co_eyebrow = section.settings.eyebrow
  assign co_heading = section.settings.heading
  assign co_text = section.settings.description
  assign co_button = section.settings.button_label
  assign co_image = section.settings.image
  assign co_s1 = section.settings.step_1
  assign co_s2 = section.settings.step_2
  assign co_s3 = section.settings.step_3
  assign co_words = section.settings.typed_words

  if co_ar
    if section.settings.eyebrow_ar != blank
      assign co_eyebrow = section.settings.eyebrow_ar
    endif
    if section.settings.heading_ar != blank
      assign co_heading = section.settings.heading_ar
    endif
    if section.settings.description_ar != blank
      assign co_text = section.settings.description_ar
    endif
    if section.settings.button_label_ar != blank
      assign co_button = section.settings.button_label_ar
    endif
    if section.settings.image_ar != blank
      assign co_image = section.settings.image_ar
    endif
    if section.settings.step_1_ar != blank
      assign co_s1 = section.settings.step_1_ar
    endif
    if section.settings.step_2_ar != blank
      assign co_s2 = section.settings.step_2_ar
    endif
    if section.settings.step_3_ar != blank
      assign co_s3 = section.settings.step_3_ar
    endif
    if section.settings.typed_words_ar != blank
      assign co_words = section.settings.typed_words_ar
    endif
  endif

  # Form (pop-up) texts. Edit the wording here if you want it different.

  if co_ar
    assign s_title = 'خصّص قطعتك'
    assign s_intro = 'شاركنا فكرتك وسنتواصل معك قريبًا.'
    assign s_phone = 'رقم هاتفك'
    assign s_phone_ph = 'مثال: 01012345678'
    assign s_message = 'رسالتك'
    assign s_message_ph = 'اشرح لنا ما تريد تصميمه'
    assign s_image = 'ارفع صورة (اختياري)'
    assign s_choose = 'اختر صورة'
    assign s_no_file = 'لم يتم اختيار صورة'
    assign s_submit = 'إرسال'
    assign s_sending = 'جارٍ الإرسال...'
    assign s_err_phone = 'من فضلك أدخل رقم هاتف صحيح.'
    assign s_err_message = 'من فضلك اكتب رسالتك.'
    assign s_err_type = 'من فضلك اختر ملف صورة.'
    assign s_err_size = 'حجم الصورة كبير جدًا (الحد الأقصى 8 ميجابايت).'
    assign s_err_send = 'حدث خطأ ما، حاول مرة أخرى.'
    assign s_ok_title = 'شكرًا لك!'
    assign s_ok_text = 'استلمنا طلبك وسنتواصل معك قريبًا.'
    assign s_close = 'إغلاق'
  else
    assign s_title = 'Customize your own'
    assign s_intro = 'Share your idea and we will get back to you soon.'
    assign s_phone = 'Your number'
    assign s_phone_ph = 'e.g. 01012345678'
    assign s_message = 'Your message'
    assign s_message_ph = 'Describe what you would like us to make'
    assign s_image = 'Upload a picture (optional)'
    assign s_choose = 'Choose image'
    assign s_no_file = 'No image selected'
    assign s_submit = 'Submit'
    assign s_sending = 'Sending...'
    assign s_err_phone = 'Please enter a valid phone number.'
    assign s_err_message = 'Please write your message.'
    assign s_err_type = 'Please choose an image file.'
    assign s_err_size = 'The image is too large (max 8 MB).'
    assign s_err_send = 'Something went wrong, please try again.'
    assign s_ok_title = 'Thank you!'
    assign s_ok_text = 'We received your request and will contact you soon.'
    assign s_close = 'Close'
  endif
-%}

<section
  class="custom-order"
  style="--co-section-desktop: {{ section.settings.section_space_desktop }}px; --co-section-mobile: {{ section.settings.section_space_mobile }}px; --co-content-desktop: {{ section.settings.content_space_desktop }}px; --co-content-mobile: {{ section.settings.content_space_mobile }}px; --co-card-opacity: {{ section.settings.card_opacity | divided_by: 100.0 }};"
>

  <div class="custom-order__frame">

    <div class="custom-order__inner" style="--co-pos-x: {{ section.settings.desktop_position_x }}%; --co-pos-y: {{ section.settings.desktop_position_y }}%; --co-mobile-pos-x: {{ section.settings.mobile_position_x }}%; --co-mobile-pos-y: {{ section.settings.mobile_position_y }}%;">
      <div class="custom-order__media">
        {% if co_image != blank %}
          <picture>
            {% if section.settings.mobile_image != blank %}
              <source
                media="(max-width: 749px)"
                srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1125 }} 1125w, {{ section.settings.mobile_image | image_url: width: 1500 }} 1500w"
                sizes="100vw"
              >
            {% endif %}
            {{
              co_image
              | image_url: width: 2400
              | image_tag:
                widths: '800, 1200, 1600, 2000, 2400',
                sizes: '100vw',
                loading: 'lazy',
                alt: ''
            }}
          </picture>
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'custom-order__placeholder' }}
        {% endif %}
      </div>

      <div class="custom-order__content">

        <span class="custom-order__marks" aria-hidden="true"></span>

        {% if co_eyebrow != blank %}
          <p class="custom-order__eyebrow">{{ co_eyebrow | escape }}</p>
        {% endif %}

        {% if co_heading != blank %}
          <h2 class="custom-order__heading">{{ co_heading | escape }}</h2>
        {% endif %}

        {% if section.settings.show_typed and co_words != blank %}
          {%- assign co_first = co_words | split: '|' | first | strip -%}
          <p class="custom-order__typed-line">
            <span class="visually-hidden">{{ co_first | escape }}</span>
            <span class="custom-order__typed" data-co-typed data-words="{{ co_words | escape }}" aria-hidden="true">{{ co_first | escape }}</span>
            <span class="custom-order__caret" aria-hidden="true"></span>
          </p>
        {% endif %}

        {% if co_text != blank %}
          <p class="custom-order__text">{{ co_text | escape }}</p>
        {% endif %}

        {% if co_button != blank %}
          <button type="button" class="custom-order__button" data-co-open aria-haspopup="dialog">
            <span class="custom-order__button-label">
              {{ co_button | escape }}
              <i class="custom-order__line"></i>
              <svg class="custom-order__pencil" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1-4L16.5 4.5a2.1 2.1 0 0 1 3 3L8 19l-4 1z"/><path d="M14 7l3 3"/></svg>
            </span>
            <svg class="custom-order__arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"></path></svg>
          </button>
        {% endif %}

      </div>

      <ol class="custom-order__steps">

        {% if co_s1 != blank %}
          <li class="custom-order__step">
            <span class="custom-order__step-no" aria-hidden="true">{% if co_ar %}١{% else %}01{% endif %}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M4 20l1-4L16.5 4.5a2.1 2.1 0 0 1 3 3L8 19l-4 1z"/><path pathLength="1" d="M14 7l3 3"/></svg>
            <span class="custom-order__step-label">{{ co_s1 | escape }}</span>
          </li>
        {% endif %}

        {% if co_s2 != blank %}
          <li class="custom-order__step">
            <span class="custom-order__step-no" aria-hidden="true">{% if co_ar %}٢{% else %}02{% endif %}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M6 3h12l4 6-10 12L2 9l4-6z"/><path pathLength="1" d="M2 9h20"/><path pathLength="1" d="M10 3L8 9l4 12 4-12-2-6"/></svg>
            <span class="custom-order__step-label">{{ co_s2 | escape }}</span>
          </li>
        {% endif %}

        {% if co_s3 != blank %}
          <li class="custom-order__step">
            <span class="custom-order__step-no" aria-hidden="true">{% if co_ar %}٣{% else %}03{% endif %}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M3 8h18v4H3z"/><path pathLength="1" d="M5 12v8h14v-8"/><path pathLength="1" d="M12 8v12"/><path pathLength="1" d="M12 8c-1.5-3-5-3.5-5-1.5S10.5 8 12 8zm0 0c1.5-3 5-3.5 5-1.5S13.5 8 12 8z"/></svg>
            <span class="custom-order__step-label">{{ co_s3 | escape }}</span>
          </li>
        {% endif %}

      </ol>

    </div>


    {%- comment -%} The pop-up is moved to the end of <body> by the script below {%- endcomment -%}
    <div class="co-drawer" data-co-drawer data-co-owner="{{ section.id }}" aria-hidden="true">

      <div class="co-drawer__overlay" data-co-close></div>

      <div
        class="co-drawer__panel"
        tabindex="-1"
        role="dialog"
        aria-modal="true"
        aria-labelledby="co-title-{{ section.id }}"
      >

        <button type="button" class="co-drawer__close" data-co-close aria-label="{{ s_close | escape }}">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>

        <div class="co-drawer__body">

          <h3 class="co-drawer__title" id="co-title-{{ section.id }}">{{ s_title | escape }}</h3>
          <p class="co-drawer__intro">{{ s_intro | escape }}</p>

          <form
            class="co-form"
            novalidate
            data-co-form
            data-webhook="{{ section.settings.webhook_url | escape }}"
            data-whatsapp="{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | escape }}"
            data-store="{{ shop.name | escape }}"
            data-submit="{{ s_submit | escape }}"
            data-sending="{{ s_sending | escape }}"
            data-no-file="{{ s_no_file | escape }}"
            data-err-phone="{{ s_err_phone | escape }}"
            data-err-message="{{ s_err_message | escape }}"
            data-err-type="{{ s_err_type | escape }}"
            data-err-size="{{ s_err_size | escape }}"
            data-err-send="{{ s_err_send | escape }}"
          >

            <div class="co-field">
              <label class="co-label" for="co-phone-{{ section.id }}">{{ s_phone | escape }} *</label>
              <input
                class="co-input co-input--phone"
                id="co-phone-{{ section.id }}"
                name="phone"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                dir="ltr"
                placeholder="{{ s_phone_ph | escape }}"
              >
              <p class="co-error" data-error-for="phone" hidden></p>
            </div>

            <div class="co-field">
              <label class="co-label" for="co-message-{{ section.id }}">{{ s_message | escape }} *</label>
              <textarea
                class="co-input co-input--message"
                id="co-message-{{ section.id }}"
                name="message"
                rows="5"
                placeholder="{{ s_message_ph | escape }}"
              ></textarea>
              <p class="co-error" data-error-for="message" hidden></p>
            </div>

            <div class="co-field">
              <span class="co-label">{{ s_image | escape }}</span>

              <label class="co-file">
                <input class="co-file__input" type="file" name="image" accept="image/*">
                <span class="co-file__button">{{ s_choose | escape }}</span>
                <span class="co-file__name" data-co-file-name>{{ s_no_file | escape }}</span>
              </label>

              <p class="co-error" data-error-for="image" hidden></p>
            </div>

            {%- comment -%} Spam trap: real people never see or fill this {%- endcomment -%}
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="co-trap" aria-hidden="true">

            <p class="co-error co-error--form" data-error-for="form" hidden></p>

            <button type="submit" class="co-submit">{{ s_submit | escape }}</button>

          </form>

          <div class="co-success" data-co-success hidden>
            <h4 class="co-success__title">{{ s_ok_title | escape }}</h4>
            <p class="co-success__text">{{ s_ok_text | escape }}</p>
            <button type="button" class="co-submit" data-co-close>{{ s_close | escape }}</button>
          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    if (!section) return;

    /* ظهور متدرج: الصورة الخلفية الأول، وبعدها الكارت، وبعده الخطوات واحدة ورا التانية */
    if (
      'IntersectionObserver' in window &&
      !(window.Shopify && window.Shopify.designMode) &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      const band = section.querySelector('.custom-order__inner');
      const media = section.querySelector('.custom-order__media');
      const card = section.querySelector('.custom-order__content');
      const circles = Array.from(section.querySelectorAll('.custom-order__step'));
      const items = [media, card].concat(circles).filter(Boolean);

      if (band && items.length) {
        section.classList.add('has-reveal');

        const run = (list, instant, base, space) => {
          list.filter(Boolean).forEach((el, index) => {
            if (instant) {
              el.classList.add('hilya-instant');
            } else {
              el.style.setProperty('--reveal-delay', (base + index * (space || 0.4)) + 's');
            }
            el.classList.add('is-revealed');
          });
        };

        const watch = (options, callback) => {
          const io = new IntersectionObserver((entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            callback();
            io.disconnect();
          }, options);

          io.observe(band);
          return io;
        };

        /* the picture starts to appear a little before the section reaches the screen */
        const early = watch(
          { threshold: 0, rootMargin: '0px 0px 15% 0px' },
          () => run([media], false, 0)
        );

        /* the card and the circles follow when the section is really in view */
        const later = watch(
          { threshold: 0.25, rootMargin: '0px 0px -10% 0px' },
          () => {
            run([card], false, 0.3);
            /* the steps come one after the other, like a piece being made */
            run(circles, false, 1, 1.3);
          }
        );

        /* after a refresh in the middle of the page, a section already passed shows without motion */
        const settle = () => {
          if (items.every((el) => el.classList.contains('is-revealed'))) return;

          if (band.getBoundingClientRect().bottom < 0) {
            run(items, true, 0);
            early.disconnect();
            later.disconnect();
          }
        };

        settle();
        window.addEventListener('load', () => setTimeout(settle, 150));
      }
    }

    /* the word under the title types itself, waits, erases, then types the next one */
    const typed = section.querySelector('[data-co-typed]');

    if (typed) {
      const words = (typed.dataset.words || '').split('|').map((word) => word.trim()).filter(Boolean);

      if (words.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let index = 0;
        let visible = false;

        /* waits, and keeps waiting while the section is off screen */
        const wait = (ms, next) => setTimeout(() => (visible ? next() : wait(400, next)), ms);

        const typeWord = () => {
          const word = words[index];
          let count = 0;

          const tick = () => {
            count += 1;
            typed.textContent = word.slice(0, count);

            if (count < word.length) {
              wait(95, tick);
            } else {
              wait(2200, eraseWord);
            }
          };

          tick();
        };

        const eraseWord = () => {
          let count = typed.textContent.length;

          const tick = () => {
            count -= 1;
            /* a zero-width space keeps the line at full height while the word is empty */
            typed.textContent = count > 0 ? typed.textContent.slice(0, count) : '\u200b';

            if (count > 0) {
              wait(45, tick);
            } else {
              index = (index + 1) % words.length;
              wait(350, typeWord);
            }
          };

          tick();
        };

        new IntersectionObserver((entries) => {
          visible = entries[entries.length - 1].isIntersecting;
        }).observe(typed);

        typed.parentElement.classList.add('is-typing');
        wait(2200, eraseWord);
      }
    }

    const openButton = section.querySelector('[data-co-open]');
    const drawer = section.querySelector('[data-co-drawer]');

    if (!openButton || !drawer) return;

    /* In the theme editor the section re-renders: remove the old copy of the pop-up */
    const owner = drawer.dataset.coOwner;

    if (owner) {
      document.querySelectorAll('[data-co-drawer][data-co-owner="' + owner + '"]').forEach((old) => {
        if (old !== drawer) old.remove();
      });
    }

    /* Move the pop-up out of the section so no parent can break position: fixed */
    document.body.appendChild(drawer);

    const panel = drawer.querySelector('.co-drawer__panel');
    const form = drawer.querySelector('[data-co-form]');
    const success = drawer.querySelector('[data-co-success]');
    const fileName = drawer.querySelector('[data-co-file-name]');
    const submit = form.querySelector('[type="submit"]');
    const phone = form.elements.phone;
    const message = form.elements.message;
    const file = form.elements.image;
    const text = form.dataset;

    const MAX_SIZE = 8 * 1024 * 1024;

    /* Arabic-Indic digits -> 0-9, so ٠١٠١٢٣٤٥٦٧٨ works too */
    const normalize = (value) => value
      .replace(/[٠-٩]/g, (d) => '٠١٢٣٤٥٦٧٨٩'.indexOf(d))
      .replace(/[۰-۹]/g, (d) => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d));

    const setError = (name, textValue) => {
      const el = form.querySelector('[data-error-for="' + name + '"]');
      const field = form.elements[name];

      if (el) {
        el.textContent = textValue || '';
        el.hidden = !textValue;
      }

      if (field && field.toggleAttribute) field.toggleAttribute('aria-invalid', !!textValue);
    };

    const checkPhone = () => {
      const value = normalize(phone.value).trim();
      const digits = value.replace(/\D/g, '');
      const valid = /^[+\d\s\-()]+$/.test(value) && digits.length >= 8 && digits.length <= 15;

      setError('phone', valid ? '' : text.errPhone);
      return valid;
    };

    const checkMessage = () => {
      const valid = message.value.trim().length > 0;

      setError('message', valid ? '' : text.errMessage);
      return valid;
    };

    const checkFile = () => {
      const picked = file.files[0];

      setError('image', '');

      if (!picked) {
        fileName.textContent = text.noFile;
        return true;
      }

      if (!picked.type.startsWith('image/')) {
        setError('image', text.errType);
        file.value = '';
        fileName.textContent = text.noFile;
        return false;
      }

      if (picked.size > MAX_SIZE) {
        setError('image', text.errSize);
        file.value = '';
        fileName.textContent = text.noFile;
        return false;
      }

      fileName.textContent = picked.name;
      return true;
    };

    const resetForm = () => {
      form.reset();
      fileName.textContent = text.noFile;
      ['phone', 'message', 'image', 'form'].forEach((name) => setError(name, ''));
      form.hidden = false;
      success.hidden = true;
      drawer.querySelector('.co-drawer__intro').hidden = false;
    };

    const showSuccess = () => {
      form.hidden = true;
      drawer.querySelector('.co-drawer__intro').hidden = true;
      success.hidden = false;
    };

    /* Open / close
       The pop-up adds one history entry when it opens, so the phone's Back button
       closes the pop-up instead of leaving the page. */
    const HISTORY_KEY = 'coDrawer';
    let pushedHistory = false;

    const showDrawer = () => {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('co-lock');
      /* On phones, focus the dialog itself so the keyboard does not pop up by surprise */
      setTimeout(() => {
        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        const target = !form.hidden && finePointer ? phone : panel;
        target.focus({ preventScroll: true });
      }, 300);
    };

    const hideDrawer = () => {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('co-lock');

      if (!success.hidden) setTimeout(resetForm, 350);

      openButton.focus();
    };

    const open = () => {
      if (drawer.classList.contains('is-open')) return;

      try {
        const state = Object.assign({}, history.state);
        state[HISTORY_KEY] = owner || true;
        history.pushState(state, '');
        pushedHistory = true;
      } catch (e) {
        pushedHistory = false;
      }

      showDrawer();
    };

    const close = () => {
      if (!drawer.classList.contains('is-open')) return;

      /* Closing with X / overlay / Escape: remove our history entry; the popstate handler hides the pop-up */
      if (pushedHistory && history.state && history.state[HISTORY_KEY]) {
        history.back();
        return;
      }

      pushedHistory = false;
      hideDrawer();
    };

    /* Back button (or history.back above) */
    window.addEventListener('popstate', () => {
      if (!drawer.classList.contains('is-open')) return;

      pushedHistory = false;
      hideDrawer();
    });

    openButton.addEventListener('click', open);

    drawer.querySelectorAll('[data-co-close]').forEach((el) => el.addEventListener('click', close));

    document.addEventListener('keydown', (event) => {
      if (!drawer.classList.contains('is-open')) return;

      if (event.key === 'Escape') {
        close();
        return;
      }

      if (event.key !== 'Tab') return;

      const items = Array.from(panel.querySelectorAll('button, input:not(.co-trap), textarea, a[href]'))
        .filter((el) => !el.disabled && el.offsetParent !== null);

      if (!items.length) return;

      const first = items[0];
      const last = items[items.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    /* Live checks */
    file.addEventListener('change', checkFile);
    phone.addEventListener('blur', () => { if (phone.value) checkPhone(); });

    /* Submit */
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setError('form', '');

      /* Honeypot: a bot filled the hidden field, pretend it worked */
      if (form.elements.website.value) {
        showSuccess();
        return;
      }

      const okPhone = checkPhone();
      const okMessage = checkMessage();
      const okFile = checkFile();

      if (!okPhone || !okMessage || !okFile) {
        (!okPhone ? phone : !okMessage ? message : file).focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = text.sending;

      try {
        const phoneValue = normalize(phone.value).trim();
        const messageValue = message.value.trim();

        if (text.webhook) {
          const data = new FormData();

          data.append('phone', phoneValue);
          data.append('message', messageValue);
          if (file.files[0]) data.append('image', file.files[0]);
          data.append('language', document.documentElement.lang || '');
          data.append('page', window.location.href);
          data.append('store', text.store);
          data.append('submitted_at', new Date().toISOString());

          /* no-cors: the request is sent even if the receiving service has no CORS headers */
          await fetch(text.webhook, { method: 'POST', body: data, mode: 'no-cors' });
        } else if (text.whatsapp) {
          const body = messageValue + '\n\n' + phoneValue;
          window.open('https://wa.me/' + text.whatsapp + '?text=' + encodeURIComponent(body), '_blank', 'noopener');
        } else {
          throw new Error('No destination set');
        }

        showSuccess();
      } catch (error) {
        setError('form', text.errSend);
      } finally {
        submit.disabled = false;
        submit.textContent = text.submit;
      }
    });
  })();
</script>

{% stylesheet %}
/* =========================
   SECTION
   Same outer width as before: full-width band, content centered up to 1400px.
   --co-section-* : moves the WHOLE section
   --co-content-* : moves the content INSIDE the section
========================= */

.custom-order {
  width: 100vw;
  max-width: 100vw;
  margin-inline: calc(50% - 50vw);
  margin-top: var(--co-section-desktop, 0px);
  padding: var(--co-content-desktop, 0px) 0 0;
  box-sizing: border-box;
  overflow-x: clip;
  background: var(--hilya-beige);
}

/* hero: الارتفاع بيتحسب من شكل الصورة، فبتكبر وتصغر مع الشاشة بنفس النسبة */
.custom-order__inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  min-height: clamp(500px, 25vw, 640px);
  padding: 32px 28px;
  overflow: hidden;
  background: var(--hilya-beige);
  box-sizing: border-box;
  max-width: 1920px;
  margin-inline: auto;
}

.custom-order__media {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.custom-order__media img,
.custom-order__placeholder {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: var(--co-pos-x, 50%) var(--co-pos-y, 50%);
}

.custom-order__media picture {
  position: absolute;
  inset: 0;
  display: block;
}


/* =========================
   CENTER GLASS PANEL
========================= */

.custom-order__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: min(100%, 540px);
  padding: 30px 40px 32px;
  box-sizing: border-box;
  border: 1px solid rgb(var(--hilya-rose-rgb) / 35%);
  border-radius: 12px;
  background: rgba(247, 244, 238, var(--co-card-opacity, 0.5));
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.06);
  color: #111;
  text-align: center;
  /* soft light halo keeps the dark text readable on a see-through panel */
  text-shadow: 0 0 14px rgba(255, 252, 247, 0.7), 0 0 4px rgba(255, 252, 247, 0.5);
}

/* rose gold line around the card: it draws itself once when the card appears */
@property --co-draw {
  syntax: '<angle>';
  inherits: false;
  initial-value: 360deg;
}

.custom-order__content::before {
  content: "";
  position: absolute;
  inset: -1px;
  padding: 1px;
  border-radius: inherit;
  background: conic-gradient(from 0deg, var(--hilya-rose-light) var(--co-draw), transparent var(--co-draw));
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  mask-composite: exclude;
  pointer-events: none;
}

/* drawing-table marks: corner brackets and a small tick in the middle of each side */
.custom-order__marks {
  position: absolute;
  inset: -10px;
  color: var(--hilya-rose-light);
  pointer-events: none;
  background:
    linear-gradient(currentColor, currentColor) left top / 16px 1px no-repeat,
    linear-gradient(currentColor, currentColor) left top / 1px 16px no-repeat,
    linear-gradient(currentColor, currentColor) right top / 16px 1px no-repeat,
    linear-gradient(currentColor, currentColor) right top / 1px 16px no-repeat,
    linear-gradient(currentColor, currentColor) left bottom / 16px 1px no-repeat,
    linear-gradient(currentColor, currentColor) left bottom / 1px 16px no-repeat,
    linear-gradient(currentColor, currentColor) right bottom / 16px 1px no-repeat,
    linear-gradient(currentColor, currentColor) right bottom / 1px 16px no-repeat,
    linear-gradient(currentColor, currentColor) center top / 1px 6px no-repeat,
    linear-gradient(currentColor, currentColor) center bottom / 1px 6px no-repeat,
    linear-gradient(currentColor, currentColor) left center / 6px 1px no-repeat,
    linear-gradient(currentColor, currentColor) right center / 6px 1px no-repeat;
}

.custom-order .custom-order__eyebrow {
  margin: 0 0 14px;
  color: var(--hilya-rose-deep);
}

.custom-order__heading {
  margin: 0 0 12px;
  color: #111;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: clamp(30px, 3vw, 42px);
  font-style: italic;
  font-weight: 500;
  line-height: 1.15;
  letter-spacing: -.01em;
}

/* thin rose gold line under the title, like the other sections */
.custom-order__heading::after {
  content: "";
  display: block;
  width: 2.4rem;
  height: 1px;
  margin: 14px auto 0;
  background: var(--hilya-rose);
}

/* the word that types itself (script font in English) */
.custom-order__typed-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
  min-height: 1.5em;
  margin: 4px 0 10px;
  color: var(--hilya-rose-deep);
  font-family: "Hilya Script", cursive;
  font-size: clamp(30px, 2.6vw, 38px);
  line-height: 1.5;
  text-shadow: none;
}

.custom-order__caret {
  display: none;
  width: 1.5px;
  height: .9em;
  background: var(--hilya-rose);
}

.custom-order__typed-line.is-typing .custom-order__caret {
  display: block;
  animation: co-caret 1s steps(1) infinite;
}

@keyframes co-caret {
  50% { opacity: 0; }
}

.custom-order__text {
  max-width: 420px;
  margin: 0 0 22px;
  color: #111;
  font-size: 15px;
  line-height: 1.7;
}

/* أزرار الروز جولد: زرار القسم، زرار اختيار الصورة، زرار الإرسال */
.custom-order__button,
.co-file__button,
.co-submit {
  border: 1px solid var(--hilya-rose-deep);
  background: var(--hilya-rose-deep);
  color: #fff;
  cursor: pointer;
  transition: background-color .3s ease, color .3s ease;
}

.custom-order__button:hover,
.co-submit:hover,
.co-file:hover .co-file__button,
.co-file__input:focus-visible + .co-file__button {
  background: transparent;
  color: var(--hilya-rose-deep);
}

.custom-order__button {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 16px 30px;
  font-family: inherit;
  font-size: 14px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: .03em;
  text-shadow: none;
  border-radius: var(--hilya-radius);
  box-shadow: var(--hilya-button-depth);
}

.custom-order__button:focus-visible {
  outline: 2px solid var(--hilya-rose-deep);
  outline-offset: 3px;
}

.custom-order__arrow {
  flex-shrink: 0;
  transition: transform .3s ease;
}

.custom-order__button:hover .custom-order__arrow {
  transform: translateX(4px);
}

/* on hover a small pencil draws a thin line under the word */
.custom-order__button-label {
  position: relative;
  display: inline-block;
}

.custom-order__line {
  position: absolute;
  inset-inline: 0;
  bottom: -5px;
  height: 1px;
  background: var(--hilya-rose-deep);
  transform: scaleX(0);
  transform-origin: 0 50%;
  transition: transform .7s cubic-bezier(.22, .8, .3, 1);
}

[dir="rtl"] .custom-order__line {
  transform-origin: 100% 50%;
}

.custom-order__pencil {
  position: absolute;
  bottom: -5px;
  inset-inline-start: -3px;
  width: 16px;
  height: 16px;
  fill: none;
  stroke: var(--hilya-rose-deep);
  stroke-width: 1.4;
  stroke-linecap: round;
  stroke-linejoin: round;
  opacity: 0;
  transition: inset-inline-start .7s cubic-bezier(.22, .8, .3, 1), opacity .3s ease;
}

[dir="rtl"] .custom-order__pencil {
  transform: scaleX(-1);
}

@media (hover: hover) and (pointer: fine) {
  .custom-order__button:hover .custom-order__line {
    transform: scaleX(1);
  }

  .custom-order__button:hover .custom-order__pencil {
    inset-inline-start: calc(100% - 3px);
    opacity: 1;
  }
}


/* =========================
   THREE STEPS (on the picture, under the panel)
   round medallions joined by a thin rose gold thread
========================= */

.custom-order__steps {
  --co-step-gap: 44px;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--co-step-gap);
  margin: 0;
  padding: 0;
  list-style: none;
}

.custom-order__step {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 110px;
  height: 110px;
  padding: 12px;
  box-sizing: border-box;
  border: 1px solid rgb(var(--hilya-rose-rgb) / 55%);
  border-radius: 50%;
  background: rgba(247, 244, 238, calc(var(--co-card-opacity, .5) * .85));
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1), inset 0 0 0 3px rgb(255 255 255 / 18%);
  text-align: center;
  text-shadow: 0 0 12px rgba(255, 252, 247, 0.7), 0 0 4px rgba(255, 252, 247, 0.5);
  transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
}

.custom-order__step:hover {
  transform: translateY(-3px);
  border-color: var(--hilya-rose);
  box-shadow: 0 14px 32px rgb(var(--hilya-rose-rgb) / 28%), inset 0 0 0 3px rgb(255 255 255 / 18%);
}

/* the number sits on the top edge of the medallion */
.custom-order__step-no {
  position: absolute;
  top: -10px;
  inset-inline-start: 50%;
  display: grid;
  min-width: 26px;
  height: 20px;
  padding: 0 7px;
  place-items: center;
  box-sizing: border-box;
  border-radius: 999px;
  background: var(--hilya-rose-deep);
  color: #fff;
  font-size: 10px;
  line-height: 1;
  letter-spacing: .08em;
  text-shadow: none;
  transform: translateX(-50%);
}

[dir="rtl"] .custom-order__step-no {
  transform: translateX(50%);
  letter-spacing: 0;
  font-size: 12px;
}

.custom-order__step svg {
  flex-shrink: 0;
  width: 26px;
  height: 26px;
  fill: none;
  stroke: var(--hilya-rose-deep);
  stroke-width: 1.2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.custom-order__step-label {
  max-width: 88px;
  color: #111;
  font-size: 11.5px;
  line-height: 1.3;
  letter-spacing: .02em;
}

/* the thread to the next step, with a small bead where it arrives */
.custom-order__step:not(:last-child)::after {
  content: "";
  position: absolute;
  top: 50%;
  inset-inline-start: 100%;
  width: var(--co-step-gap);
  height: 1px;
  background: var(--hilya-rose-light);
  transform-origin: 0 50%;
}

.custom-order__step:not(:last-child)::before {
  content: "";
  position: absolute;
  top: 50%;
  inset-inline-start: calc(100% + var(--co-step-gap) - 3.5px);
  width: 7px;
  height: 7px;
  margin-top: -3px;
  border-radius: 50%;
  background: var(--hilya-rose);
}

[dir="rtl"] .custom-order__step:not(:last-child)::after {
  transform-origin: 100% 50%;
}

/* the last step is the finished piece: two small sparkles glint on it now and then */
.custom-order__step:last-child::before,
.custom-order__step:last-child::after {
  content: "";
  position: absolute;
  width: 14px;
  height: 14px;
  background: var(--hilya-rose-light);
  clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
  filter: drop-shadow(0 0 4px rgb(var(--hilya-rose-rgb) / 70%));
  opacity: 0;
  pointer-events: none;
}

.custom-order__step:last-child::after {
  top: 14px;
  inset-inline-end: 12px;
}

.custom-order__step:last-child::before {
  top: 34px;
  inset-inline-end: 4px;
  width: 9px;
  height: 9px;
}


/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {

  .custom-order__inner {
    min-height: 460px;
    padding: 28px 24px;
  }

  .custom-order__content {
    width: min(100%, 480px);
    padding: 24px 30px 26px;
  }

  .custom-order__text {
    font-size: 14px;
  }

  .custom-order__step {
    width: 96px;
    height: 96px;
  }

  .custom-order__steps {
    --co-step-gap: 36px;
  }
}


/* MOBILE */

@media (max-width: 749px) {

  /* the picture now runs edge to edge on phones */
  .custom-order {
    margin-top: var(--co-section-mobile, 0px);
    padding: var(--co-content-mobile, 0px) 0 0;
    background: var(--hilya-cream);
  }

  /* على الموبايل ارتفاع ثابت أطول بدل ما يتحسب من الصورة */
  .custom-order__inner {
    aspect-ratio: 1 / 1.08;
    min-height: min-content;
    gap: 14px;
    padding: 22px 14px;
  }

  .custom-order__media img,
  .custom-order__placeholder {
    object-position: var(--co-mobile-pos-x, 50%) var(--co-mobile-pos-y, 50%);
  }

  .custom-order__content {
    width: 100%;
    padding: 20px 18px 22px;
    border-radius: 14px;
  }

  .custom-order .custom-order__eyebrow {
    margin-bottom: 8px;
  }

  .custom-order__marks {
    inset: -6px;
  }

  .custom-order__typed-line {
    margin: 2px 0 6px;
    font-size: 28px;
  }

  .custom-order__heading {
    margin-bottom: 8px;
    font-size: 25px;
    line-height: 1.2;
  }

  .custom-order__text {
    margin-bottom: 16px;
    font-size: 13px;
    line-height: 1.6;
  }

  .custom-order__button {
    padding: 12px 22px;
    font-size: 13px;
  }

  .custom-order__steps {
    --co-step-gap: clamp(16px, 5vw, 26px);
    width: 100%;
  }

  .custom-order__step {
    flex: 0 0 auto;
    width: clamp(76px, 24vw, 100px);
    height: auto;
    aspect-ratio: 1;
    gap: 5px;
    padding: 8px;
  }

  .custom-order__step svg {
    width: 22px;
    height: 22px;
  }

  .custom-order__step-label {
    max-width: 72px;
    font-size: 10px;
    line-height: 1.25;
  }
}


/* =========================
   POP-UP (center of the screen)
   z-index is above the sticky header (99999) and the mobile menu (100000).
========================= */

html.co-lock {
  overflow: hidden;
}

.co-drawer {
  position: fixed;
  inset: 0;
  z-index: 2147483000;
  display: grid;
  place-items: center;
  padding: 16px;
  box-sizing: border-box;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity .3s ease, visibility 0s linear .3s;
}

.co-drawer.is-open {
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
  transition-delay: 0s;
}

.co-drawer__overlay {
  position: absolute;
  inset: 0;
  background: rgba(17, 17, 17, 0.5);
  -webkit-backdrop-filter: blur(3px);
  backdrop-filter: blur(3px);
}

.co-drawer__panel {
  position: relative;
  width: min(100%, 460px);
  max-height: calc(100vh - 32px);
  max-height: calc(100dvh - 32px);
  overflow-x: hidden;
  overflow-y: auto;
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 20px;
  background: rgba(251, 248, 242, 0.3);
  -webkit-backdrop-filter: blur(18px) saturate(1.1);
  backdrop-filter: blur(18px) saturate(1.1);
  color: #111;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
  transform: translateY(14px) scale(.97);
  transition: transform .3s ease;
}

.co-drawer.is-open .co-drawer__panel {
  transform: none;
}

.co-drawer__panel:focus {
  outline: none;
}

.co-drawer__close {
  position: absolute;
  top: 14px;
  inset-inline-end: 14px;
  z-index: 1;
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(17, 17, 17, 0.07);
  color: #111;
  cursor: pointer;
  transition: background-color .2s ease;
}

.co-drawer__close:hover {
  background: rgba(17, 17, 17, 0.14);
}

.co-drawer__close:focus-visible {
  outline: 2px solid #111;
  outline-offset: 2px;
}

.co-drawer__body {
  padding: 46px 32px 32px;
}

.co-drawer__title {
  margin: 0 0 10px;
  padding-inline-end: 24px;
  color: #111;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: 32px;
  font-weight: 400;
  font-style: italic;
  line-height: 1.1;
}

.co-drawer__intro {
  margin: 0 0 24px;
  color: #444;
  font-size: 13px;
  line-height: 1.7;
}


/* FORM */

.co-field {
  margin-bottom: 18px;
}

.co-label {
  display: block;
  margin-bottom: 8px;
  color: #111;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 10px;
  line-height: 1.3;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.co-input {
  display: block;
  width: 100%;
  padding: 14px;
  border: 1px solid rgba(0, 0, 0, 0.2);
  border-radius: 10px;
  background: #fff;
  color: #111;
  font-family: inherit;
  font-size: 16px; /* 16px stops the zoom on iPhone */
  line-height: 1.4;
  box-sizing: border-box;
}

.co-input:focus {
  outline: none;
  border-color: var(--hilya-rose-deep);
  box-shadow: 0 0 0 3px rgb(var(--hilya-rose-rgb) / 18%);
}

.co-input[aria-invalid],
.co-file[aria-invalid] {
  border-color: #b3261e;
}

.co-input--message {
  min-height: 130px;
  resize: vertical;
}

[dir="rtl"] .co-input--phone {
  text-align: right;
}

.co-error {
  margin: 6px 0 0;
  color: #b3261e;
  font-size: 12px;
  line-height: 1.4;
}

.co-error--form {
  margin: 0 0 14px;
}

/* Spam trap: kept inside the panel so it never creates a sideways scroll */
.co-trap {
  position: absolute;
  top: 0;
  left: 0;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}


/* FILE PICKER */

.co-file {
  display: flex;
  align-items: center;
  gap: 12px;
  /* the label spans the whole row, so only the button itself should be clickable */
  pointer-events: none;
}

.co-file__input {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
}

.co-file__button {
  pointer-events: auto;
  flex-shrink: 0;
  padding: 11px 16px;
  border-radius: 8px;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 10px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;
}


.co-file__name {
  min-width: 0;
  overflow: hidden;
  color: #3a3a3a;
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}


/* SUBMIT / SUCCESS */

.co-submit {
  display: block;
  width: 100%;
  padding: 16px;
  border-radius: 10px;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 11px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: .18em;
  text-transform: uppercase;
}


.co-submit:disabled {
  opacity: .6;
  cursor: not-allowed;
}

.co-success {
  padding-top: 6px;
  text-align: center;
}

.co-success__title {
  margin: 0 0 10px;
  color: #111;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: 28px;
  font-weight: 400;
  font-style: italic;
}

.co-success__text {
  margin: 0 0 26px;
  color: #444;
  font-size: 13px;
  line-height: 1.7;
}

@media (max-width: 749px) {
  .co-drawer {
    padding: 12px;
  }

  .co-drawer__panel {
    border-radius: 18px;
  }

  .co-drawer__body {
    padding: 44px 22px 26px;
  }

  .co-drawer__title {
    font-size: 28px;
  }
}


/* =========================
   REVEAL ON SCROLL
========================= */

@keyframes co-reveal {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
}

@keyframes co-media-reveal {
  from {
    opacity: 0;
    transform: scale(1.05);
  }
}

.custom-order.has-reveal .custom-order__media:not(.is-revealed),
.custom-order.has-reveal .custom-order__content:not(.is-revealed),
.custom-order.has-reveal .custom-order__step:not(.is-revealed) {
  opacity: 0;
}

.custom-order.has-reveal .custom-order__media.is-revealed {
  animation: co-media-reveal 2.4s cubic-bezier(.22, .8, .3, 1) backwards;
  animation-delay: var(--reveal-delay, 0s);
}

.custom-order.has-reveal .custom-order__content.is-revealed,
.custom-order.has-reveal .custom-order__step.is-revealed {
  animation: co-reveal 2s cubic-bezier(.22, .8, .3, 1) backwards;
  animation-delay: var(--reveal-delay, 0s);
}

.custom-order.has-reveal .is-revealed.hilya-instant {
  animation: none;
}

/* each step draws its own icon, then its thread to the next step, like a piece being made */
.custom-order.has-reveal .custom-order__step path {
  stroke-dasharray: 1;
  stroke-dashoffset: 1.02;
  transition: stroke-dashoffset 1.1s ease calc(var(--reveal-delay, 0s) + .3s);
}

.custom-order.has-reveal .custom-order__step.is-revealed path {
  stroke-dashoffset: 0;
}

.custom-order.has-reveal .custom-order__step:not(:last-child)::after {
  transform: scaleX(0);
  transition: transform .7s cubic-bezier(.22, .8, .3, 1) calc(var(--reveal-delay, 0s) + .8s);
}

.custom-order.has-reveal .custom-order__step:not(:last-child)::before {
  opacity: 0;
  transition: opacity .4s ease calc(var(--reveal-delay, 0s) + 1.4s);
}

.custom-order.has-reveal .custom-order__step.is-revealed:not(:last-child)::after {
  transform: scaleX(1);
}

.custom-order.has-reveal .custom-order__step.is-revealed:not(:last-child)::before {
  opacity: 1;
}

.custom-order.has-reveal .custom-order__step.hilya-instant path,
.custom-order.has-reveal .custom-order__step.hilya-instant::before,
.custom-order.has-reveal .custom-order__step.hilya-instant::after {
  transition: none;
}

/* one slow glint (about 2.5s), then rest, then again: a cycle of 8.5s */
@keyframes co-sparkle {
  0%   { opacity: 0; transform: scale(0) rotate(0deg); }
  14%  { opacity: 1; transform: scale(1.25) rotate(45deg); }
  30%  { opacity: 0; transform: scale(.2) rotate(90deg); }
  100% { opacity: 0; transform: scale(.2) rotate(90deg); }
}

.custom-order.has-reveal .custom-order__step.is-revealed:last-child::after {
  animation: co-sparkle 8.5s ease infinite calc(var(--reveal-delay, 0s) + 1.6s);
}

.custom-order.has-reveal .custom-order__step.is-revealed:last-child::before {
  animation: co-sparkle 8.5s ease infinite calc(var(--reveal-delay, 0s) + 2.1s);
}

.custom-order.has-reveal .custom-order__step.hilya-instant:last-child::before,
.custom-order.has-reveal .custom-order__step.hilya-instant:last-child::after {
  animation: none;
}

/* the drawing marks fade in after the frame is drawn */
.custom-order.has-reveal .custom-order__marks {
  opacity: 0;
  transition: opacity 1.2s ease calc(var(--reveal-delay, 0s) + 1.8s);
}

.custom-order.has-reveal .custom-order__content.is-revealed .custom-order__marks {
  opacity: .85;
}

.custom-order.has-reveal .custom-order__content.hilya-instant .custom-order__marks {
  transition: none;
}

/* the frame and the small line under the title draw themselves after the card shows */
@keyframes co-draw {
  from { --co-draw: 0deg; }
}

.custom-order.has-reveal .custom-order__content.is-revealed::before {
  animation: co-draw 2.2s cubic-bezier(.22, .8, .3, 1) backwards;
  animation-delay: calc(var(--reveal-delay, 0s) + .5s);
}

.custom-order.has-reveal .custom-order__heading::after {
  transform: scaleX(0);
  transition: transform 1.6s cubic-bezier(.22, .8, .3, 1) calc(var(--reveal-delay, 0s) + .9s);
}

.custom-order.has-reveal .custom-order__content.is-revealed .custom-order__heading::after {
  transform: scaleX(1);
}

.custom-order.has-reveal .custom-order__content.hilya-instant .custom-order__heading::after {
  transition: none;
}

/* =========================
   ARABIC / RTL
========================= */


[dir="rtl"] .custom-order__heading {
  line-height: 1.4;
  font-style: normal;
  font-weight: 400;
}

[dir="rtl"] .custom-order__text {
  font-size: 16px;
  line-height: 1.9;
}

[dir="rtl"] .custom-order__typed-line {
  min-height: 1.6em;
  font-family: inherit;
  font-size: 24px;
  font-weight: 500;
  line-height: 1.6;
}

/* no blinking line in Arabic: it looks like the letter alef */
[dir="rtl"] .custom-order__typed-line.is-typing .custom-order__caret {
  display: none;
}

[dir="rtl"] .custom-order__button {
  font-size: 15px;
  letter-spacing: 0;
}

[dir="rtl"] .custom-order__step-label {
  font-size: 12.5px;
  letter-spacing: 0;
}

[dir="rtl"] .custom-order__arrow {
  transform: scaleX(-1);
}

[dir="rtl"] .custom-order__button:hover .custom-order__arrow {
  transform: scaleX(-1) translateX(4px);
}

@media (max-width: 749px) {

  [dir="rtl"] .custom-order__heading {
    font-size: 25px;
    line-height: 1.3;
  }

  [dir="rtl"] .custom-order__text {
    font-size: 13px;
    line-height: 1.7;
  }

  [dir="rtl"] .custom-order__typed-line {
    font-size: 20px;
  }

  [dir="rtl"] .custom-order__button {
    font-size: 14px;
  }

  [dir="rtl"] .custom-order__step-label {
    font-size: 12px;
  }
}

/* pop-up */

[dir="rtl"] .co-submit {
  font-size: 13px;
  letter-spacing: 0;
}

[dir="rtl"] .co-label,
[dir="rtl"] .co-file__button {
  font-size: 13px;
  letter-spacing: 0;
}

[dir="rtl"] .co-drawer__title,
[dir="rtl"] .co-success__title {
  font-style: normal;
  line-height: 1.4;
}

[dir="rtl"] .co-drawer__intro,
[dir="rtl"] .co-success__text {
  font-size: 15px;
}

@media (prefers-reduced-motion: reduce) {
  .co-drawer,
  .co-drawer__panel,
  .custom-order__step,
  .custom-order__arrow {
    transition: none;
  }

  .custom-order__heading::after {
    transition: none;
  }
}

{% endstylesheet %}

