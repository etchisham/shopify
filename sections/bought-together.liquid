{% liquid
  assign section_file = 'bought-together'

  assign tag_prefix = section.settings.tag_prefix | default: 'collection-' | downcase | replace: ' ', '-'
  assign prefix_length = tag_prefix | size
  assign group_handle = ''
  for tag in product.tags
    if group_handle == blank
      assign tag_handle = tag | handleize
      assign tag_start = tag_handle | slice: 0, prefix_length
      if tag_start == tag_prefix
        assign group_handle = tag_handle
      endif
    endif
  endfor

  assign related_products = product.metafields.custom.frequently_bought_together.value
  assign use_tag = false
  if related_products == blank
    if group_handle != blank
      assign use_tag = true
    else
      assign related_products = section.settings.products
    endif
  endif

  assign locale_root = request.locale.iso_code | split: '-' | first
  assign heading = section.settings.heading_en
  if locale_root == 'ar'
    assign heading = section.settings.heading_ar | default: heading
  endif
  if heading == blank
    assign heading = 'products.bundle.heading' | t
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign current_minimum = current_variant.quantity_rule.min | default: 1
  assign bundle_total = 0
  assign bundle_count = 0
  if current_variant.available and product.requires_selling_plan == false
    assign bundle_total = current_variant.price | times: current_minimum
    assign bundle_count = 1
  endif

  # count related products (without the current one) to place the current one in the middle
  assign related_count = 0
  unless use_tag
    assign counted_ids = ',' | append: product.id | append: ','
    for related in related_products limit: 12
      if related_count >= 4
        break
      endif
      assign counted_token = ',' | append: related.id | append: ','
      unless counted_ids contains counted_token
        assign counted_ids = counted_ids | append: counted_token
        assign related_count = related_count | plus: 1
      endunless
    endfor
  endunless
  assign middle_index = related_count | divided_by: 2

  assign show_section = false
  if use_tag or related_count > 0
    assign show_section = true
  endif
%}

{% if request.page_type == 'collection' %}

  {%- comment -%} الوضع التاني: بيرجّع الكروت بس لما يتطلب بالـ fetch (من غير wrapper) {%- endcomment -%}
  {%- for related in collection.products limit: 12 -%}
    {% render 'bundle-product', product: related, section_id: '__SID__' %}
  {%- endfor -%}

{% elsif show_section %}

  <section class="bought-together section-spacing" data-bought-together data-section-id="{{ section.id }}" data-current-product-id="{{ product.id }}" {% if use_tag %}data-tag-url="{{ routes.all_products_collection_url }}/{{ group_handle }}?section_id={{ section_file }}" hidden{% endif %} data-money-format="{{ shop.money_format | escape }}" data-currency="{{ cart.currency.iso_code | default: shop.currency }}" data-button-label="{{ 'products.bundle.add_selected' | t: count: '__count__' | escape }}" data-empty-label="{{ 'products.bundle.select_products' | t | escape }}" aria-labelledby="BundleHeading-{{ section.id }}">
    <h2 id="BundleHeading-{{ section.id }}">{{ heading | escape }}</h2>
    <form action="{{ routes.cart_add_url }}" method="post" data-bought-together-form>
      <div class="bought-together__cards" data-bundle-cards>
        {% unless use_tag %}
          {% assign seen_ids = ',' | append: product.id | append: ',' %}
          {% assign shown = 0 %}
          {% for related in related_products limit: 12 %}
            {% if shown >= 4 %}{% break %}{% endif %}
            {% assign related_token = ',' | append: related.id | append: ',' %}
            {% unless seen_ids contains related_token %}
              {% assign seen_ids = seen_ids | append: related_token %}
              {% if shown == middle_index %}
                {% render 'bundle-product', product: product, section_id: section.id, current: true %}
              {% endif %}
              {% assign shown = shown | plus: 1 %}
              {% render 'bundle-product', product: related, section_id: section.id %}
              {% if related.available and related.requires_selling_plan == false and related.metafields.custom.personalization_required.value != true %}
                {% assign selected = related.selected_or_first_available_variant %}
                {% assign minimum_quantity = selected.quantity_rule.min | default: 1 %}
                {% assign line_total = selected.price | times: minimum_quantity %}
                {% assign bundle_total = bundle_total | plus: line_total %}
                {% assign bundle_count = bundle_count | plus: 1 %}
              {% endif %}
            {% endunless %}
          {% endfor %}
        {% else %}
          {%- comment -%} وضع التاج: المنتج الحالي يتحط هنا، والـ JS بيوزّع المنتجات المرتبطة حواليه {%- endcomment -%}
          {% render 'bundle-product', product: product, section_id: section.id, current: true %}
        {% endunless %}
      </div>
      <div class="bought-together__summary">
        <p>{{ 'products.bundle.total' | t }}: <strong><bdi data-bundle-total>{{ bundle_total | money }}</bdi></strong></p>
        <button class="button button--full" type="submit" name="add" data-bundle-add disabled>
          <span class="button-spinner" aria-hidden="true"></span>
          <span data-add-label>{% if bundle_count > 0 %}{{ 'products.bundle.add_selected' | t: count: bundle_count }}{% else %}{{ 'products.bundle.select_products' | t }}{% endif %}</span>
          <span data-loading-label hidden>{{ 'products.bundle.adding' | t }}</span>
        </button>
        <noscript><p>{{ 'products.bundle.no_javascript' | t }}</p></noscript>
      </div>
    </form>

    {% if use_tag %}
      <script>
        (function () {
          var root = document.currentScript.parentElement;
          if (!root || !root.dataset.tagUrl) return;

          fetch(root.dataset.tagUrl, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.text() : ''; })
            .then(function (html) {
              if (!html) return;

              /* خلي ids الكروت تطابق id السكشن الحقيقي */
              html = html.split('__SID__').join(root.dataset.sectionId);

              var doc = new DOMParser().parseFromString(html, 'text/html');
              var current = root.dataset.currentProductId;

              /* كل كارت هو <article data-bundle-item> مباشرة، واستبعد المنتج الحالي */
              var items = Array.prototype.filter.call(
                doc.querySelectorAll('[data-bundle-item]'),
                function (el) { return el.dataset.productId !== current; }
              ).slice(0, 4);

              /* مفيش منتج تاني بنفس التاج: السكشن يفضل مخفي */
              if (!items.length) return;

              var cards = root.querySelector('[data-bundle-cards]');
              var currentCard = cards.querySelector('[data-bundle-current]');
              var middle = Math.floor(items.length / 2);

              /* نص المنتجات قبل المنتج الحالي والباقي بعده */
              items.forEach(function (el, i) {
                if (i < middle && currentCard) cards.insertBefore(el, currentCard);
                else cards.appendChild(el);
              });

              root.hidden = false;
              root.dispatchEvent(new CustomEvent('bundle:cards-updated', { bubbles: true }));
            })
            .catch(function () {});
        })();
      </script>
    {% endif %}
  </section>

{% elsif request.design_mode %}
  <section class="bought-together section-spacing"><h2>{{ heading | escape }}</h2><p>{{ 'products.bundle.editor_setup' | t }}</p></section>
{% endif %}

{% stylesheet %}
  [data-bought-together][hidden] { display: none !important; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:bought_together.name",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading_en", "label": "t:labels.heading_en" },
    { "type": "text", "id": "heading_ar", "label": "t:labels.heading_ar" },
    { "type": "text", "id": "tag_prefix", "label": "Tag prefix", "default": "collection-" },
    { "type": "product_list", "id": "products", "label": "t:bought_together.products", "limit": 4, "info": "t:bought_together.products_info" }
  ],
  "presets": [{ "name": "t:bought_together.name" }]
}
{% endschema %}
