{% liquid
  assign section_file = 'bought-together'

  assign is_cards_request = false
  if request.page_type == 'collection'
    assign is_cards_request = true
  endif

  assign locale_root = request.locale.iso_code | split: '-' | first
  assign heading = section.settings.heading_en
  if locale_root == 'ar'
    assign heading = section.settings.heading_ar | default: heading
  endif
  if heading == blank
    assign heading = 'products.bundle.heading' | t
  endif

  assign add_label = 'products.product.add_to_cart' | t
  assign sold_out_label = 'products.product.sold_out' | t

  comment
    Find the first tag of the current product that starts with the prefix (collection-...)
  endcomment
  assign tag_prefix = section.settings.tag_prefix | default: 'collection-' | downcase | replace: ' ', '-'
  assign prefix_length = tag_prefix | size
  assign group_handle = ''
  for tag in product.tags
    if group_handle == blank
      assign tag_handle = tag | handleize
      assign tag_start = tag_handle | slice: 0, prefix_length
      if tag_start == tag_prefix
        assign group_handle = tag_handle
      endif
    endif
  endfor

  comment
    Priority: metafield, then same tag, then the products picked in the section settings
  endcomment
  assign related_products = product.metafields.custom.frequently_bought_together.value
  assign use_tag = false
  if related_products == blank
    if group_handle != blank
      assign use_tag = true
    else
      assign related_products = section.settings.products
    endif
  endif

  assign card_source = related_products
  if is_cards_request
    assign card_source = collection.products
  endif
%}

{%- capture cards_html -%}
  {%- unless use_tag and is_cards_request == false -%}
    {%- assign seen_ids = ',' | append: product.id | append: ',' -%}
    {%- assign shown = 0 -%}

    {%- for item in card_source limit: 13 -%}
      {%- if shown >= 12 -%}{%- break -%}{%- endif -%}

      {%- assign item_token = ',' | append: item.id | append: ',' -%}
      {%- if seen_ids contains item_token -%}{%- continue -%}{%- endif -%}
      {%- assign seen_ids = seen_ids | append: item_token -%}
      {%- assign shown = shown | plus: 1 -%}

      {%- liquid
        assign rating = item.metafields.reviews.rating.value
        assign rating_count = item.metafields.reviews.rating_count.value | default: 0
        assign rating_value = rating.rating | default: rating
        assign rating_maximum = rating.scale_max | default: 5
        assign rating_display = rating_value | round: 1 | append: '' | remove: '.0'
        assign review_word = 'review'
        if rating_count != 1
          assign review_word = 'reviews'
        endif

      -%}

      <article class="explore-collection__item" data-explore-item data-product-id="{{ item.id }}">

        <div class="explore-collection__media">

          <a
            href="{{ item.url }}"
            class="explore-collection__image-link"
            aria-label="{{ item.title | escape }}"
          >
            {%- if item.featured_image != blank -%}
              {{
                item.featured_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '360, 540, 720, 900',
                  sizes: '(min-width: 990px) 25vw, 70vw',
                  alt: item.featured_image.alt | default: item.title
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </a>

          <div class="explore-collection__quick-wrap">

            {%- if item.available -%}

              <a class="explore-collection__quick" href="{{ item.url }}" data-quick-view>
                <svg class="explore-collection__quick-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 7H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
                <span class="explore-collection__quick-text">+ {{ add_label }}</span>
              </a>

            {%- else -%}

              <span class="explore-collection__quick is-disabled is-sold-out">
                <span class="explore-collection__quick-text">{{ sold_out_label }}</span>
              </span>

            {%- endif -%}

          </div>

        </div>

        <div class="explore-collection__info">

          <h3 class="explore-collection__product-title">
            <a href="{{ item.url }}">{{ item.title | escape }}</a>
          </h3>

          {%- if settings.card_show_rating and rating_value != blank and rating_count > 0 -%}
            <div
              class="explore-collection__rating"
              role="img"
              aria-label="{{ rating_display }} / {{ rating_maximum }} ({{ rating_count }} {{ review_word }})"
            >
              <span class="explore-collection__rating-star" aria-hidden="true">★</span>
              <span class="explore-collection__rating-value">{{ rating_display }}</span>
              <span class="explore-collection__rating-count">({{ rating_count }} {{ review_word }})</span>
            </div>
          {%- endif -%}

          <div class="explore-collection__price" data-card-price>
            {% render 'price', product: item %}
          </div>

        </div>

      </article>
    {%- endfor -%}
  {%- endunless -%}
{%- endcapture -%}

{%- assign has_cards = false -%}
{%- if cards_html contains 'data-explore-item' -%}
  {%- assign has_cards = true -%}
{%- endif -%}

{%- assign show_section = false -%}
{%- if use_tag or has_cards -%}
  {%- assign show_section = true -%}
{%- endif -%}


{% if is_cards_request %}

  {%- comment -%} Cards only: this is what the fetch below receives from /collections/all/<tag> {%- endcomment -%}
  {{ cards_html }}

{% elsif show_section %}

  <section
    class="explore-collection"
    data-explore-collection
    data-current-product-id="{{ product.id }}"
    {% if use_tag %}data-tag-url="{{ routes.all_products_collection_url }}/{{ group_handle }}?section_id={{ section_file }}" hidden{% endif %}
    aria-labelledby="ExploreHeading-{{ section.id }}"
  >
    <div class="explore-collection__inner">

      <div class="explore-collection__header">
        <h2 class="explore-collection__title" id="ExploreHeading-{{ section.id }}">{{ heading | escape }}</h2>
      </div>

      <div class="explore-collection__carousel">

        <button
          type="button"
          class="explore-collection__arrow explore-collection__arrow--prev"
          data-explore-prev
          aria-label="Previous products"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        </button>

        <button
          type="button"
          class="explore-collection__arrow explore-collection__arrow--next"
          data-explore-next
          aria-label="Next products"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>

        <div class="explore-collection__track" data-explore-track>
          {{ cards_html }}
        </div>

      </div>

    </div>

    <script>
      (function () {
        var root = document.currentScript.parentElement;
        var track = root.querySelector('[data-explore-track]');
        var previous = root.querySelector('[data-explore-prev]');
        var next = root.querySelector('[data-explore-next]');

        if (!track) return;

        function isRtl() {
          return window.getComputedStyle(track).direction === 'rtl';
        }

        function updateArrows() {
          var max = track.scrollWidth - track.clientWidth;
          var fromLeft = isRtl() ? max + track.scrollLeft : track.scrollLeft;
          var fromRight = max - fromLeft;

          if (previous) previous.setAttribute('data-hidden', fromLeft <= 1 ? 'true' : 'false');
          if (next) next.setAttribute('data-hidden', fromRight <= 1 ? 'true' : 'false');
        }

        if (previous) {
          previous.addEventListener('click', function () {
            track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' });
          });
        }

        if (next) {
          next.addEventListener('click', function () {
            track.scrollBy({ left: track.clientWidth, behavior: 'smooth' });
          });
        }

        track.addEventListener('scroll', updateArrows, { passive: true });
        window.addEventListener('resize', updateArrows);
        window.addEventListener('load', updateArrows);
        updateArrows();

        /* Narrow screens: touch already swipes the row; this lets a mouse drag it too */
        var dragQuery = window.matchMedia('(max-width: 749px)');
        var drag = null;
        var suppressClick = false;

        track.addEventListener('pointerdown', function (event) {
          if (event.pointerType !== 'mouse' || event.button !== 0 || !dragQuery.matches) return;
          drag = { x: event.clientX, left: track.scrollLeft, moved: false };
        });

        window.addEventListener('pointermove', function (event) {
          if (!drag) return;
          var dx = event.clientX - drag.x;
          if (!drag.moved && Math.abs(dx) < 5) return;

          if (!drag.moved) {
            drag.moved = true;
            track.style.scrollSnapType = 'none';
            track.style.scrollBehavior = 'auto';
            track.classList.add('is-dragging');
          }

          track.scrollLeft = drag.left - dx;
        });

        function endDrag() {
          if (!drag) return;

          if (drag.moved) {
            suppressClick = true;
            setTimeout(function () { suppressClick = false; }, 60);
            track.style.scrollSnapType = '';
            track.style.scrollBehavior = '';
            track.classList.remove('is-dragging');
          }

          drag = null;
        }

        window.addEventListener('pointerup', endDrag);
        window.addEventListener('pointercancel', endDrag);

        /* After a drag, do not open the product under the mouse */
        track.addEventListener('click', function (event) {
          if (!suppressClick) return;
          event.preventDefault();
          event.stopPropagation();
        }, true);

        /* Tag mode: bring the products that have the same tag, then show the section */
        var tagUrl = root.getAttribute('data-tag-url');

        if (tagUrl) {
          fetch(tagUrl, { credentials: 'same-origin' })
            .then(function (response) { return response.ok ? response.text() : ''; })
            .then(function (html) {
              if (!html) return;

              var doc = new DOMParser().parseFromString(html, 'text/html');
              var currentId = root.getAttribute('data-current-product-id');

              var items = Array.prototype.filter.call(
                doc.querySelectorAll('[data-explore-item]'),
                function (el) { return el.getAttribute('data-product-id') !== currentId; }
              ).slice(0, 12);

              /* No other product with the same tag: the section stays hidden */
              if (!items.length) return;

              items.forEach(function (el) { track.appendChild(el); });

              root.hidden = false;
              requestAnimationFrame(updateArrows);
            })
            .catch(function () {});
        }
      })();
    </script>
  </section>

{% elsif request.design_mode %}

  <section class="explore-collection">
    <div class="explore-collection__inner">
      <div class="explore-collection__header">
        <h2 class="explore-collection__title">{{ heading | escape }}</h2>
      </div>
      <p style="text-align:center">{{ 'products.bundle.editor_setup' | t }}</p>
    </div>
  </section>

{% endif %}

{% stylesheet %}

[data-explore-collection][hidden] {
  display: none !important;
}

.explore-collection,
.explore-collection *,
.explore-collection *::before,
.explore-collection *::after {
  box-sizing: border-box;
}

/* Let the section use the full screen width (some themes wrap sections in a narrow container) */
.shopify-section:has(> .explore-collection) {
  width: 100% !important;
  max-width: none !important;
  margin-inline: 0 !important;
}

.explore-collection {
  /* Same value as .product-recommendations so both sections sit the same distance from the section above */
  --section-gap: 2.5rem;

  width: 100%;
  max-width: 100%;
  padding: var(--section-gap) 0 1.5rem;
  overflow-x: clip;
}

.explore-collection__inner {
  width: 100%;
  max-width: 98rem;
  margin: 0 auto;
  padding: 0 clamp(1rem, 4vw, 4rem);
}

.explore-collection__header {
  display: flex;
  justify-content: center;
  margin-bottom: 1.75rem;
  text-align: center;
}

.explore-collection__title {
  margin: 0;
  color: #222;
  font-family: sans-serif;
  font-size: clamp(1.35rem, 2vw, 1.75rem);
  font-weight: 400;
  letter-spacing: -0.015em;
  line-height: 1.2;
}


/* =========================================
   CAROUSEL
   --per-view : cards visible at once
   --gap      : space between cards
   --ratio-w / --ratio-h : image shape (3 / 4 = portrait, 2 / 3 = taller)
========================================= */

.explore-collection__carousel {
  --per-view: 4;
  --gap: 1.5rem;
  --ratio-w: var(--card-ratio-w, 3);
  --ratio-h: var(--card-ratio-h, 4);

  position: relative;
  container-type: inline-size;
}

.explore-collection__track {
  display: flex;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  gap: var(--gap);
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  scroll-behavior: smooth;
}

.explore-collection__track::-webkit-scrollbar {
  display: none;
}

/* Few products: keep them in the middle under the heading.
   The auto margins turn into 0 when the row is full, so scrolling still works. */
.explore-collection__track > :first-child {
  margin-inline-start: auto;
}

.explore-collection__track > :last-child {
  margin-inline-end: auto;
}

.explore-collection__item {
  min-width: 0;
  flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  scroll-snap-align: start;
}


/* =========================================
   ARROWS (centered on the image)
========================================= */

.explore-collection__arrow {
  position: absolute;
  top: calc(
    (100cqw - (var(--per-view) - 1) * var(--gap)) / var(--per-view)
    * var(--ratio-h) / var(--ratio-w) / 2
  );
  z-index: 3;
  display: grid;
  width: 3.25rem;
  height: 3.25rem;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 0.9rem;
  background: #fff;
  color: #222;
  cursor: pointer;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.16);
  opacity: 0;
  pointer-events: none;
  transform: translateY(-50%);
  transition:
    opacity 200ms ease,
    background-color 160ms ease,
    color 160ms ease;
}

.explore-collection__arrow--prev {
  left: -1.625rem;
}

.explore-collection__arrow--next {
  right: -1.625rem;
}

.explore-collection__arrow[data-hidden="true"] {
  visibility: hidden;
}

@media (hover: hover) and (pointer: fine) {
  .explore-collection__carousel:hover .explore-collection__arrow {
    opacity: 1;
    pointer-events: auto;
  }

  .explore-collection__carousel:has(:focus-visible) .explore-collection__arrow {
    opacity: 1;
    pointer-events: auto;
  }
}

.explore-collection__arrow:hover {
  background: #222;
  color: #fff;
}


/* =========================================
   IMAGE
========================================= */

.explore-collection__media {
  position: relative;
  overflow: hidden;
  border-radius: var(--product-card-radius, 0);
  background: #f5f5f1;
}

.explore-collection__image-link {
  display: block;
  width: 100%;
  aspect-ratio: var(--ratio-w) / var(--ratio-h);
  text-decoration: none;
}

.explore-collection__image-link img,
.explore-collection__image-link svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.explore-collection__image-link img {
  transition: transform 400ms ease;
}

.explore-collection__image-link:hover img {
  transform: scale(1.025);
}


/* =========================================
   ADD TO CART (appears on hover)
========================================= */

.explore-collection__quick-wrap {
  position: absolute;
  inset-inline: 0.75rem;
  bottom: 0.75rem;
  z-index: 2;
  opacity: 0;
  pointer-events: none;
  transform: translateY(0.5rem);
  transition:
    opacity 220ms ease,
    transform 220ms ease;
}

.explore-collection__media:hover .explore-collection__quick-wrap {
  opacity: 1;
  pointer-events: auto;
  transform: none;
}

/* Keyboard focus only (a mouse click must not keep the button visible) */
.explore-collection__media:has(:focus-visible) .explore-collection__quick-wrap {
  opacity: 1;
  pointer-events: auto;
  transform: none;
}

.explore-collection__form {
  margin: 0;
}

.explore-collection__quick {
  display: flex;
  width: 100%;
  min-height: 3.1rem;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 1rem;
  border: 0;
  border-radius: 0.85rem;
  background: var(--color-background, #fffcf7);
  color: #222;
  font: inherit;
  font-size: 0.9rem;
  line-height: 1.2;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.08);
  transition:
    background-color 160ms ease,
    color 160ms ease;
}

.explore-collection__quick:hover {
  background: #222;
  color: var(--color-background, #fffcf7);
}

/* The icon is only used on mobile */
.explore-collection__quick-icon {
  display: none;
}

.explore-collection__quick.is-disabled,
.explore-collection__quick:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.explore-collection__quick.is-disabled:hover,
.explore-collection__quick:disabled:hover {
  background: var(--color-background, #fffcf7);
  color: #222;
}

/* Touch screens have no hover: keep the button visible and hide the arrows (swipe instead) */
@media (hover: none) {
  .explore-collection__arrow {
    display: none;
  }

  .explore-collection__quick-wrap {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .explore-collection__quick {
    min-height: 2.6rem;
    font-size: 0.82rem;
  }
}


/* =========================================
   INFO
========================================= */

.explore-collection__info {
  display: grid;
  justify-items: center;
  gap: 5px;
  padding-top: 12px;
  text-align: center;
}

.explore-collection__product-title {
  min-width: 0;
  width: 100%;
  margin: 0;
  overflow: hidden;
  color: var(--color-foreground, #222);
  font-family: var(--font-body-family);
  font-size: clamp(0.78rem, 0.82vw, 0.92rem);
  font-weight: 400;
  letter-spacing: 0.02em;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.explore-collection__product-title a {
  color: inherit;
  text-decoration: none;
}


/* Price (same sizes as the product card on every page) */

.explore-collection__price {
  display: flex;
  justify-content: center;
  width: 100%;
  text-align: center;
}

.explore-collection__price .price {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  width: 100%;
  font-size: 0.8rem;
  line-height: 1.25;
  text-align: center;
}

.explore-collection__price .price__current {
  color: var(--color-foreground, #222);
  font-size: 0.88rem;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.explore-collection__price .price__compare {
  color: var(--color-muted, #777);
  font-size: 0.74rem;
  text-decoration: line-through;
}


/* Rating */

.explore-collection__rating {
  display: flex;
  min-height: 1.35rem;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.3rem;
  line-height: 1;
}

.explore-collection__rating-star {
  color: #f5b301;
  font-size: 1.05rem;
  line-height: 1;
}

.explore-collection__rating-value {
  font-size: 0.875rem;
  font-weight: 600;
}

.explore-collection__rating-count {
  color: var(--color-muted, #777);
  font-size: 0.8rem;
  white-space: nowrap;
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 989px) {
  .explore-collection__carousel {
    --per-view: 3;
  }
}


/* =========================================
   MOBILE (Artsy style)
   Full-width swipe row + small cart icon on the right of the image
========================================= */

@media (max-width: 749px) {

  .explore-collection {
    --section-gap: 1.75rem;

    /* Break out of the page side padding: the row runs from screen edge to screen edge */
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding-bottom: 1rem;
  }

  .explore-collection__inner {
    padding-inline: 0;
  }

  .explore-collection__header {
    margin-bottom: 1.2rem;
    padding-inline: 1rem;
  }

  .explore-collection__title {
    font-size: 1.3rem;
  }

  /* Card size: about 1.7 cards visible (same image shape as every other card) */
  .explore-collection__carousel {
    --per-view: 1.7;
    --gap: 0.75rem;
  }

  /* No arrows on mobile: just swipe */
  .explore-collection__arrow {
    display: none;
  }

  .explore-collection__track {
    padding-inline: 1rem;
    scroll-padding-inline: 1rem;
    cursor: grab;
  }

  .explore-collection__track.is-dragging {
    cursor: grabbing;
  }

  .explore-collection__track img,
  .explore-collection__track a {
    -webkit-user-drag: none;
    user-select: none;
  }

  /* Cart icon on the right of the image (same color as the page, no border) */
  .explore-collection__quick-wrap {
    inset-inline-start: auto;
    inset-inline-end: 0.6rem;
    bottom: 0.6rem;
  }

  .explore-collection__quick {
    width: 2.4rem;
    height: 2.4rem;
    min-height: 0;
    padding: 0;
    border: 0;
    border-radius: 0.35rem;
    box-shadow: 0 1px 8px rgb(0 0 0 / 14%);
  }

  .explore-collection__quick-icon {
    display: block;
    width: 1.3rem;
    height: 1.3rem;
  }

  /* The words stay for screen readers only */
  .explore-collection__quick-text {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Sold out keeps a small text label (an icon alone would not say it) */
  .explore-collection__quick.is-sold-out {
    width: auto;
    height: auto;
    min-height: 2rem;
    padding: 0.3rem 0.7rem;
    font-size: 0.72rem;
  }

  .explore-collection__quick.is-sold-out .explore-collection__quick-icon {
    display: none;
  }

  .explore-collection__quick.is-sold-out .explore-collection__quick-text {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip-path: none;
  }
}

@media (max-width: 27rem) {
  .explore-collection__info {
    padding-top: 9px;
    gap: 4px;
  }

  .explore-collection__product-title {
    font-size: 0.78rem;
  }

  .explore-collection__price .price__current {
    font-size: 0.82rem;
  }

  .explore-collection__price .price__compare {
    font-size: 0.68rem;
  }

  .explore-collection__rating-star {
    font-size: 0.92rem;
  }

  .explore-collection__rating-count {
    font-size: 0.72rem;
  }
}

@media (prefers-reduced-motion: reduce) {
