{
  "name": "t:bought_together.name",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading_en", "label": "t:labels.heading_en" },
    { "type": "text", "id": "heading_ar", "label": "t:labels.heading_ar" },
    { "type": "text", "id": "subheading_en", "label": "Subheading (English)", "info": "Leave empty to use the default text." },
    { "type": "text", "id": "subheading_ar", "label": "Subheading (Arabic)", "info": "اتركه فاضي لاستخدام النص الافتراضي." },
    { "type": "text", "id": "tag_prefix", "label": "Tag prefix", "default": "collection-" },
    { "type": "product_list", "id": "products", "label": "t:bought_together.products", "limit": 4, "info": "t:bought_together.products_info" },
    { "type": "header", "content": "Collection bar (price, saving and button)" },
    { "type": "text", "id": "bundle_eyebrow_en", "label": "Small title (English)", "info": "Leave empty to use the default text." },
    { "type": "text", "id": "bundle_eyebrow_ar", "label": "Small title (Arabic)" },
    { "type": "text", "id": "bundle_button_en", "label": "Button text (English)", "info": "Leave empty to use the default text." },
    { "type": "text", "id": "bundle_button_ar", "label": "Button text (Arabic)" },
    { "type": "text", "id": "bundle_note_en", "label": "Note under the button (English)", "info": "Leave empty to use the default text." },
    { "type": "text", "id": "bundle_note_ar", "label": "Note under the button (Arabic)" }
  ],
  "presets": [{ "name": "t:bought_together.name" }]
}
{% endschema %}
