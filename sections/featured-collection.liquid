{% assign featured_collection = section.settings.collection %}

<section class="featured-collection section-spacing">
  <div class="section-header featured-collection__header">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.heading | default: featured_collection.title | escape }}</h2>
    </div>
    {% if featured_collection != blank %}
      <a class="text-link" href="{{ featured_collection.url }}">{{ 'collections.view_all' | t }}</a>
    {% endif %}
  </div>

  {% if featured_collection != blank and featured_collection.products_count > 0 %}
    <div class="featured-collection__grid" style="--product-columns: {{ section.settings.columns }};">
      {% for product in featured_collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product, show_vendor: section.settings.show_product_vendor, sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw' %}
      {% endfor %}
    </div>
  {% else %}
    <div class="featured-collection__empty">
      <p>{{ 'collections.choose_collection' | t }}</p>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .featured-collection__header {
    align-items: end;
    grid-template-columns: 1fr auto;
  }

  .featured-collection__header h2 {
    margin-block-start: var(--space-2);
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--grid-gap);
  }

  .featured-collection__empty {
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-surface);
    padding: var(--space-7);
    text-align: center;
  }

  @media (min-width: 64rem) {
    .featured-collection__grid {
      grid-template-columns: repeat(var(--product-columns), minmax(0, 1fr));
    }
  }

  @media (max-width: 35rem) {
    .featured-collection__header {
      align-items: start;
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Start here" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Featured products" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "t:labels.products_to_show", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "t:labels.columns", "default": 4 },
    { "type": "checkbox", "id": "show_product_vendor", "label": "t:labels.show_product_vendor", "default": false }
  ],
  "presets": [{ "name": "t:general.featured_collection" }]
}
{% endschema %}
