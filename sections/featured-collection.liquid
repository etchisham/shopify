{% assign featured_collection = section.settings.collection %}

{%- liquid
  assign fc_locale = request.locale.iso_code | split: '-' | first
  assign fc_eyebrow = section.settings.eyebrow
  assign fc_heading = section.settings.heading

  if fc_locale == 'ar'
    if section.settings.eyebrow_ar != blank
      assign fc_eyebrow = section.settings.eyebrow_ar
    endif
    if section.settings.heading_ar != blank
      assign fc_heading = section.settings.heading_ar
    endif
  endif
-%}

<section class="featured-collection">
  <div class="featured-collection__header">
    <div class="featured-collection__heading">
      {% if fc_eyebrow != blank %}
        <p class="featured-collection__eyebrow">
          {{ fc_eyebrow | escape }}
        </p>
      {% endif %}

      <h2 class="featured-collection__title">
        {{ fc_heading | default: featured_collection.title | escape }}
      </h2>
    </div>

    {% if featured_collection != blank %}
      <a class="featured-collection__view-all" href="{{ featured_collection.url }}">
        {{ 'collections.view_all' | t }}
        <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>

  {% if featured_collection != blank and featured_collection.products_count > 0 %}

    <div
      class="featured-collection__slider"
      style="--product-columns: {{ section.settings.columns }};"
      >

      <button type="button" class="featured-collection__nav featured-collection__nav--prev" aria-label="Previous products">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      </button>

      <div class="featured-collection__grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <div class="featured-collection__product">
            {% render 'product-card',
              product: product,
              sizes: '(min-width: 990px) 20vw, 50vw'
            %}
          </div>
        {% endfor %}
      </div>

      <button type="button" class="featured-collection__nav featured-collection__nav--next" aria-label="Next products">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>

    </div>

  {% else %}

    <div class="featured-collection__empty">
      <p>{{ 'collections.choose_collection' | t }}</p>
    </div>

  {% endif %}
</section>

<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    const grid = section && section.querySelector('.featured-collection__grid');

    if (!grid) return;

    const prev = section.querySelector('.featured-collection__nav--prev');
    const next = section.querySelector('.featured-collection__nav--next');

    const update = () => {
      const max = grid.scrollWidth - grid.clientWidth;
      const rtl = getComputedStyle(grid).direction === 'rtl';
      const fromLeft = rtl ? max + grid.scrollLeft : grid.scrollLeft;
      const fromRight = max - fromLeft;

      if (prev) prev.setAttribute('data-hidden', fromLeft <= 1 ? 'true' : 'false');
      if (next) next.setAttribute('data-hidden', fromRight <= 1 ? 'true' : 'false');
    };

    if (prev) prev.addEventListener('click', () => grid.scrollBy({ left: -grid.clientWidth, behavior: 'smooth' }));
    if (next) next.addEventListener('click', () => grid.scrollBy({ left: grid.clientWidth, behavior: 'smooth' }));

    grid.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    window.addEventListener('load', update);
    update();
  })();
</script>

{% stylesheet %}

/* SECTION */

.featured-collection {
  width: 100vw;
  max-width: 100vw;
  margin-inline: calc(50% - 50vw);
  padding: 30px max(24px, calc((100vw - 1400px) / 2)) 0;
  box-sizing: border-box;
}

/* HEADER */

.featured-collection__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 30px;
}

.featured-collection__heading {
  min-width: 0;
}

/* EYEBROW */

.featured-collection__eyebrow {
  margin: 0 0 10px;
  color: #C8B28A;
  font-size: 10px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: .16em;
  text-transform: uppercase;
}

/* MAIN HEADING */

.featured-collection__heading .featured-collection__title {
  margin: 0 !important;
  font-family: "Cormorant Garamond", "Times New Roman", serif !important;
  font-size: 42px !important;
  font-weight: 400 !important;
  font-style: normal !important;
  line-height: 1.05 !important;
  letter-spacing: -0.025em !important;
  text-transform: none !important;
}

/* VIEW ALL */

.featured-collection__view-all {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  flex-shrink: 0;
  color: inherit;
  text-decoration: none;
  font-size: 10px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.featured-collection__view-all span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  top: 0;
  font-size: 13px;
  line-height: 1;
  transition: transform .3s ease;
}

.featured-collection__view-all:hover span {
  transform: translateX(4px);
}

/* SLIDER */

.featured-collection__slider {
  --per-view: var(--product-columns, 5);
  --gap: 18px;
  --ratio-w: var(--card-ratio-w, 3);
  --ratio-h: var(--card-ratio-h, 4);

  position: relative;
  container-type: inline-size;
}

.featured-collection__grid {
  display: flex;
  flex-wrap: nowrap;
  gap: var(--gap);
  width: 100%;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  box-sizing: border-box;
}

.featured-collection__grid::-webkit-scrollbar {
  display: none;
}

.featured-collection__product {
  flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  min-width: 0;
  scroll-snap-align: start;
}

.featured-collection__empty {
  padding: 48px 20px;
  text-align: center;
}

/* ARROWS (desktop: same as "You May Also Like") */

.featured-collection__nav {
  position: absolute;

  /* نص ارتفاع الصورة بالظبط */
  top: calc(
    (100cqw - (var(--per-view) - 1) * var(--gap)) / var(--per-view)
    * var(--ratio-h) / var(--ratio-w) / 2
  );

  z-index: 3;
  display: grid;
  width: 3.25rem;
  height: 3.25rem;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 0.9rem;
  background: #fff;
  color: #222;
  cursor: pointer;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.16);
  opacity: 0;
  pointer-events: none;
  transform: translateY(-50%);
  transition:
    opacity 200ms ease,
    background-color 160ms ease,
    color 160ms ease;
  -webkit-tap-highlight-color: transparent;
}

.featured-collection__nav--prev { left: -1.625rem; }
.featured-collection__nav--next { right: -1.625rem; }

.featured-collection__nav[data-hidden="true"] {
  visibility: hidden;
}

.featured-collection__nav svg {
  display: block;
}

@media (hover: hover) and (pointer: fine) {
  .featured-collection__slider:hover .featured-collection__nav,
  .featured-collection__slider:has(:focus-visible) .featured-collection__nav {
    opacity: 1;
    pointer-events: auto;
  }

  .featured-collection__nav:hover {
    background: #222;
    color: #fff;
  }
}

/* شاشات اللمس الكبيرة (تابلت): سحب بس من غير أسهم */
@media (hover: none) and (min-width: 750px) {
  .featured-collection__nav {
    display: none;
  }
}

/* LARGE DESKTOP */

@media (min-width: 1500px) {
  .featured-collection {
    padding-left: max(32px, calc((100vw - 1500px) / 2));
    padding-right: max(32px, calc((100vw - 1500px) / 2));
  }
}

/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {
  .featured-collection {
    padding-left: 28px;
    padding-right: 28px;
  }

  .featured-collection__slider {
    --per-view: 3.3;
    --gap: 14px;
  }
}

/* MOBILE */

/* MOBILE */

@media (max-width: 749px) {

  .featured-collection {
    padding: 30px 0 0;
    overflow-x: clip;
  }

  .featured-collection__header {
    /* حجم العنوان بيصغر مع عرض الشاشة، والـ eyebrow بياخد نسبة منه */
    --fs: clamp(17px, 5.6vw, 22px);

    align-items: flex-start;
    gap: 12px;
    margin-bottom: 24px;
    padding-inline: 1rem;
  }

  .featured-collection__eyebrow {
    margin-bottom: 7px;
    font-size: calc(var(--fs) * 0.4);
  }

  .featured-collection__heading .featured-collection__title {
    font-size: var(--fs) !important;
    font-weight: 300 !important;
    letter-spacing: -0.035em !important;
    line-height: 1.08 !important;
    white-space: nowrap;
  }

  .featured-collection__view-all {
    gap: 4px;
    font-size: 9px;
  }

  .featured-collection__view-all span {
    font-size: 12px;
    top: -2px;
  }

  /* الصف: حوالي 2.2 كارت ظاهرين والباقي بيدخل من حرف الشاشة */
  .featured-collection__slider {
    --per-view: 2.2;
    --gap: 0.75rem;
  }

  .featured-collection__grid {
    padding-inline: 1rem;
    scroll-padding-inline: 1rem;
  }

  /* أسهم الموبايل: دايرة صغيرة */
  .featured-collection__nav {
    top: 38%; /* زوّده أو قلّله حسب طول الصورة */
    width: 30px;
    height: 30px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    background: #F7F4EE; /* نفس لون خلفية الصفحة */
    opacity: 1;
    pointer-events: auto;
  }

  .featured-collection__nav svg {
    width: 14px;
    height: 14px;
  }

  .featured-collection__nav--prev { left: 8px; }
  .featured-collection__nav--next { right: 8px; }
}

/* ARABIC / RTL */

[dir="rtl"] .featured-collection__view-all span {
  transform: scaleX(-1);
}

[dir="rtl"] .featured-collection__view-all:hover span {
  transform: scaleX(-1) translateX(4px);
}

[dir="rtl"] .featured-collection__heading .featured-collection__title {
  line-height: 1.35 !important;
}

[dir="rtl"] .featured-collection__eyebrow {
  font-size: 13px;
  line-height: 1.3;
}

[dir="rtl"] .featured-collection__view-all {
  font-size: 13px;
}

@media (max-width: 749px) {
  [dir="rtl"] .featured-collection__eyebrow {
    font-size: calc(var(--fs) * 0.55);
  }

  [dir="rtl"] .featured-collection__view-all {
    font-size: 12px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "eyebrow_ar",
      "label": "Eyebrow - Arabic",
      "info": "Shown on the Arabic site. Leave blank to use the English text.",
      "default": "الأكثر مبيعًا"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The Pieces Everyone Loves"
    },
    {
      "type": "text",
      "id": "heading_ar",
      "label": "Heading - Arabic",
      "default": "القطع التي يحبها الجميع"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 20,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 10
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ]
}
{% endschema %}