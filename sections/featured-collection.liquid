{% assign featured_collection = section.settings.collection %}

{%- liquid
  assign fc_locale = request.locale.iso_code | split: '-' | first
  assign fc_eyebrow = section.settings.eyebrow
  assign fc_heading = section.settings.heading

  if fc_locale == 'ar'
    if section.settings.eyebrow_ar != blank
      assign fc_eyebrow = section.settings.eyebrow_ar
    endif
    if section.settings.heading_ar != blank
      assign fc_heading = section.settings.heading_ar
    endif
  endif
-%}

<section
  class="featured-collection"
  style="--fc-section-desktop: {{ section.settings.section_space_desktop }}px; --fc-section-mobile: {{ section.settings.section_space_mobile }}px; --fc-content-desktop: {{ section.settings.content_space_desktop }}px; --fc-content-mobile: {{ section.settings.content_space_mobile }}px;"
>
    <div class="featured-collection__header">
    <div class="featured-collection__heading">
      {% if fc_eyebrow != blank %}
        <p class="featured-collection__eyebrow">
          {{ fc_eyebrow | escape }}
        </p>
      {% endif %}

      <h2 class="featured-collection__title">
        {{ fc_heading | default: featured_collection.title | escape }}
      </h2>
    </div>

    {% if featured_collection != blank %}
      <a class="featured-collection__view-all" href="{{ featured_collection.url }}">
        {{ 'collections.view_all' | t }}
        <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>

  {% if featured_collection != blank and featured_collection.products_count > 0 %}

    <div
      class="featured-collection__slider"
      style="--product-columns: {{ section.settings.columns }};"
      >

      <button type="button" class="featured-collection__nav featured-collection__nav--prev" aria-label="Previous products">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      </button>

      <div class="featured-collection__grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <div class="featured-collection__product">
            {% render 'product-card',
              product: product,
              sizes: '(min-width: 990px) 20vw, 50vw'
            %}
          </div>
        {% endfor %}
      </div>

      <button type="button" class="featured-collection__nav featured-collection__nav--next" aria-label="Next products">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>

    </div>

  {% else %}

    <div class="featured-collection__empty">
      <p>{{ 'collections.choose_collection' | t }}</p>
    </div>

  {% endif %}
</section>

<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    const grid = section && section.querySelector('.featured-collection__grid');

    if (!grid) return;

    const prev = section.querySelector('.featured-collection__nav--prev');
    const next = section.querySelector('.featured-collection__nav--next');

    const update = () => {
      const max = grid.scrollWidth - grid.clientWidth;
      const rtl = getComputedStyle(grid).direction === 'rtl';
      const fromLeft = rtl ? max + grid.scrollLeft : grid.scrollLeft;
      const fromRight = max - fromLeft;

      if (prev) prev.setAttribute('data-hidden', fromLeft <= 1 ? 'true' : 'false');
      if (next) next.setAttribute('data-hidden', fromRight <= 1 ? 'true' : 'false');
    };

    if (prev) prev.addEventListener('click', () => grid.scrollBy({ left: -grid.clientWidth, behavior: 'smooth' }));
    if (next) next.addEventListener('click', () => grid.scrollBy({ left: grid.clientWidth, behavior: 'smooth' }));

    grid.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    window.addEventListener('load', update);
    update();

        /* موبايل: يبدأ والكارت اللي في النص متوسّط */
    let touched = false;
    grid.addEventListener('pointerdown', () => { touched = true; }, { once: true });

    const centerMiddle = () => {
      if (touched || !window.matchMedia('(max-width: 749px)').matches) return;

      const cards = grid.querySelectorAll('.featured-collection__product');
      if (cards.length < 3) return;

      const mid = cards[Math.floor((cards.length - 1) / 2)];
      const g = grid.getBoundingClientRect();
      const c = mid.getBoundingClientRect();

      grid.scrollBy({
        left: (c.left + c.width / 2) - (g.left + g.width / 2),
        behavior: 'auto'
      });
      update();
    };

    centerMiddle();
    window.addEventListener('load', centerMiddle);
  })();
</script>

{% stylesheet %}

/* SECTION
   --fc-section-top : moves the WHOLE section
   --fc-content-top : moves the content INSIDE the section (section stays fixed) */

.featured-collection {
  width: 100vw;
  max-width: 100vw;
  margin-inline: calc(50% - 50vw);
  --fc-section-top: var(--fc-section-desktop, 0px);
  --fc-content-top: var(--fc-content-desktop, 0px);
  margin-top: var(--fc-section-top);
  padding: calc(30px + var(--fc-content-top)) max(24px, calc((100vw - 1400px) / 2)) 30px;
  box-sizing: border-box;
}

/* HEADER */

.featured-collection__header {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: end;
  gap: 24px;
  margin: 0 auto 28px;
  text-align: center;
}

.featured-collection__heading {
  grid-column: 2;
  min-width: 0;
  grid-row: 1;
}

/* EYEBROW */

.featured-collection__eyebrow {
  margin: 0 0 9px;
  color: #C8B28A;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 9px;
  line-height: 1.2;
  font-weight: 500;
  letter-spacing: 0.28em;
  text-transform: uppercase;
}

/* MAIN HEADING */

.featured-collection__heading .featured-collection__title {
  margin: 0 !important;
  color: #151515 !important;
  font-family: "Cormorant Garamond", "Bodoni Moda", "Didot", serif !important;
  font-size: 28px !important;
  line-height: 1.1 !important;
  font-weight: 500 !important;
  font-style: italic !important;
  letter-spacing: 0.01em !important;
  text-transform: none !important;
}

/* VIEW ALL */

.featured-collection__view-all {
  grid-column: 3;
  grid-row: 1;
  justify-self: end;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 6px;
  color: #151515;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 10px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: .2em;
  text-transform: uppercase;
  text-decoration: none;
  white-space: nowrap;
  transition: border-color .3s ease;
}

.featured-collection__view-all span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  line-height: 1;
  transition: transform .3s ease;
}

.featured-collection__view-all:hover {
  border-color: #C8B28A;
}

.featured-collection__view-all:hover span {
  transform: translateX(5px);
}

/* SLIDER */

.featured-collection__slider {
  --per-view: var(--product-columns, 5);
  --gap: 18px;
  --ratio-w: var(--card-ratio-w, 3);
  --ratio-h: var(--card-ratio-h, 4);

  position: relative;
  container-type: inline-size;
}

.featured-collection__grid {
  display: flex;
  flex-wrap: nowrap;
  gap: var(--gap);
  width: 100%;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  box-sizing: border-box;
}

.featured-collection__grid::-webkit-scrollbar {
  display: none;
}

.featured-collection__product {
  flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  min-width: 0;
  scroll-snap-align: start;
}

.featured-collection__empty {
  padding: 48px 20px;
  text-align: center;
}

/* ARROWS (desktop: same as "You May Also Like") */

.featured-collection__nav {
  position: absolute;

  /* نص ارتفاع الصورة بالظبط */
  top: calc(
    (100cqw - (var(--per-view) - 1) * var(--gap)) / var(--per-view)
    * var(--ratio-h) / var(--ratio-w) / 2
  );

  z-index: 3;
  display: grid;
  width: 3.25rem;
  height: 3.25rem;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 0.9rem;
  background: #fff;
  color: #222;
  cursor: pointer;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.16);
  opacity: 0;
  pointer-events: none;
  transform: translateY(-50%);
  transition:
    opacity 200ms ease,
    background-color 160ms ease,
    color 160ms ease;
  -webkit-tap-highlight-color: transparent;
}

.featured-collection__nav--prev { left: -1.625rem; }
.featured-collection__nav--next { right: -1.625rem; }

.featured-collection__nav[data-hidden="true"] {
  visibility: hidden;
}

.featured-collection__nav svg {
  display: block;
}

@media (hover: hover) and (pointer: fine) {
  .featured-collection__slider:hover .featured-collection__nav,
  .featured-collection__slider:has(:focus-visible) .featured-collection__nav {
    opacity: 1;
    pointer-events: auto;
  }

  .featured-collection__nav:hover {
    background: #222;
    color: #fff;
  }
}

/* شاشات اللمس الكبيرة (تابلت): سحب بس من غير أسهم */
@media (hover: none) and (min-width: 750px) {
  .featured-collection__nav {
    display: none;
  }
}

/* LARGE DESKTOP */

@media (min-width: 1500px) {
  .featured-collection {
    padding-left: max(32px, calc((100vw - 1500px) / 2));
    padding-right: max(32px, calc((100vw - 1500px) / 2));
  }
}

/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {
  .featured-collection {
    padding-left: 28px;
    padding-right: 28px;
  }

  .featured-collection__slider {
    --per-view: 3.3;
    --gap: 14px;
  }

  .featured-collection__header {
    gap: 16px;
    margin-bottom: 20px;
  }
}


/* MOBILE */

@media (max-width: 749px) {

  .featured-collection {
    --fc-section-top: var(--fc-section-mobile, 0px);
    --fc-content-top: var(--fc-content-mobile, 0px);
    margin-top: var(--fc-section-top);
    padding: calc(30px + var(--fc-content-top)) 0 30px;
    overflow-x: clip;
  }

  .featured-collection__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    padding-inline: 1rem;
  }

  .featured-collection__heading {
    grid-column: auto;
    grid-row: auto;
  }

  .featured-collection__eyebrow {
    font-size: 10px;
    letter-spacing: 0.16em;
  }

  .featured-collection__heading .featured-collection__title {
    margin-top: 7px !important;
    font-size: 15px !important;
  }

  .featured-collection__footer {
    margin-top: 26px;
    padding-bottom: 10px;
  }

    .featured-collection__product {
    scroll-snap-align: center;
  }

  .featured-collection__view-all {
    grid-column: auto;
    grid-row: auto;
    justify-self: auto;
    align-self: center;
    width: fit-content;
    margin: 0 auto;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 8px 15px;
    border: 1px solid #C8B28A;
    border-radius: 999px;
    background: #C8B28A;
    color: #ffffff;
    font-size: 11px;
    line-height: 1;
    letter-spacing: .2em;
    -webkit-tap-highlight-color: transparent;
  }

  .featured-collection__view-all span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1em;
    font-size: 15px;
    line-height: 1;
    position: relative;
    top: -1px;
  }

  .featured-collection__view-all:active {
    background: #F3EDE0;
  }

  [dir="rtl"] .featured-collection__view-all {
    align-self: flex-start; /* في العربي start هي اليمين */
  }

  .featured-collection__slider {
    --per-view: 2.2;
    --gap: 0.75rem;
  }

  .featured-collection__grid {
    padding-inline: 1rem;
    scroll-padding-inline: 1rem;
  }

  /* أسهم الموبايل: دايرة صغيرة */
  .featured-collection__nav {
    top: 38%; /* زوّده أو قلّله حسب طول الصورة */
    width: 30px;
    height: 30px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    background: #F7F4EE;
    opacity: 1;
    pointer-events: auto;
  }

  .featured-collection__nav svg {
    width: 14px;
    height: 14px;
  }

  .featured-collection__nav--prev { left: 8px; }
  .featured-collection__nav--next { right: 8px; }
}

/* ARABIC / RTL */

[dir="rtl"] .featured-collection__heading .featured-collection__title {
  line-height: 1.4 !important;
}

[dir="rtl"] .featured-collection__eyebrow {
  font-size: 13px;
}

[dir="rtl"] .featured-collection__view-all {
  font-size: 13px;
  letter-spacing: 0;
}

[dir="rtl"] .featured-collection__view-all span {
  transform: scaleX(-1);
}

[dir="rtl"] .featured-collection__view-all:hover span {
  transform: scaleX(-1) translateX(5px);
}

@media (max-width: 749px) {
  [dir="rtl"] .featured-collection__view-all {
    padding: 8px 15px;
    font-size: 13px;
    letter-spacing: 0;
    line-height: 1.2;
  }

  [dir="rtl"] .featured-collection__view-all span {
    top: -2px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "eyebrow_ar",
      "label": "Eyebrow - Arabic",
      "info": "Shown on the Arabic site. Leave blank to use the English text.",
      "default": "الأكثر مبيعًا"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The Pieces Everyone Loves"
    },
    {
      "type": "text",
      "id": "heading_ar",
      "label": "Heading - Arabic",
      "default": "القطع التي يحبها الجميع"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 20,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 10
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns",
      "default": 5
    },
    {
      "type": "header",
      "content": "Section position (moves the whole section)"
    },
    {
      "type": "range",
      "id": "section_space_desktop",
      "label": "Section position - Desktop",
      "min": -60,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_space_mobile",
      "label": "Section position - Mobile",
      "min": -60,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content spacing (moves content inside section)"
    },
    {
      "type": "range",
      "id": "content_space_desktop",
      "label": "Content spacing - Desktop",
      "min": -10,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_space_mobile",
      "label": "Content spacing - Mobile",
      "min": -10,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ]
}
{% endschema %}
