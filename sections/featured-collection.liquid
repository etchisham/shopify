{%- assign featured_collection = section.settings.collection | default: product.collections.first -%}
<section class="fl-section full-width">
  <div class="fl-container--wide">
    <div class="fl-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="fl-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if featured_collection != blank -%}<a class="fl-link" href="{{ featured_collection.url }}">View all</a>{%- endif -%}
    </div>
    {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
      <div class="fl-product-grid">
        {%- for card_product in featured_collection.products limit: section.settings.products_to_show -%}
          {% render 'fl-product-card', card_product: card_product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="fl-product-grid">
        {%- for index in (1..4) -%}
          <article class="fl-product-card">
            <div class="fl-product-card__media">{{ 'product-' | append: index | placeholder_svg_tag }}</div>
            <span class="fl-product-card__maker">Select a collection</span>
            <h3 class="fl-product-card__title">Product title</h3>
            <div class="fl-price"><span class="fl-price__current">$0</span></div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The most considered" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best-loved objects" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products", "min": 4, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
