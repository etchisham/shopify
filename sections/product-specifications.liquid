{%- liquid
  assign fact_count = 0
  if product.metafields.custom.dimensions != blank
    assign fact_count = fact_count | plus: 1
  endif
  if product.metafields.custom.weight != blank
    assign fact_count = fact_count | plus: 1
  endif
  if product.metafields.custom.materials != blank
    assign fact_count = fact_count | plus: 1
  endif
  if product.metafields.custom.origin != blank
    assign fact_count = fact_count | plus: 1
  endif
  if product.metafields.custom.production_method != blank
    assign fact_count = fact_count | plus: 1
  endif
  if product.metafields.custom.assembly_level != blank
    assign fact_count = fact_count | plus: 1
  endif
-%}
{%- if fact_count > 0 or section.blocks.size > 0 or request.design_mode -%}
  <section class="fl-section fl-section--surface full-width">
    <div class="fl-product-facts fl-container">
      <div>
        <span class="fl-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="fl-section__intro">{{ section.settings.text }}</p>
      </div>
      <div>
        {%- if fact_count > 0 -%}
          <dl class="fl-fact-grid">
            {%- if product.metafields.custom.dimensions != blank -%}<div class="fl-fact"><dt>Dimensions</dt><dd>{{ product.metafields.custom.dimensions | metafield_tag }}</dd></div>{%- endif -%}
            {%- if product.metafields.custom.weight != blank -%}<div class="fl-fact"><dt>Weight</dt><dd>{{ product.metafields.custom.weight | metafield_tag }}</dd></div>{%- endif -%}
            {%- if product.metafields.custom.materials != blank -%}<div class="fl-fact"><dt>Materials</dt><dd>{{ product.metafields.custom.materials | metafield_tag }}</dd></div>{%- endif -%}
            {%- if product.metafields.custom.origin != blank -%}<div class="fl-fact"><dt>Origin</dt><dd>{{ product.metafields.custom.origin | metafield_tag }}</dd></div>{%- endif -%}
            {%- if product.metafields.custom.production_method != blank -%}<div class="fl-fact"><dt>Method</dt><dd>{{ product.metafields.custom.production_method | metafield_tag }}</dd></div>{%- endif -%}
            {%- if product.metafields.custom.assembly_level != blank -%}<div class="fl-fact"><dt>Assembly</dt><dd>{{ product.metafields.custom.assembly_level | metafield_tag }}</dd></div>{%- endif -%}
          </dl>
        {%- elsif request.design_mode -%}
          <p>Add product metafields under the <code>custom</code> namespace to show the fact grid.</p>
        {%- endif -%}

        {%- if product.metafields.custom.whats_included != blank -%}
          <details class="fl-accordion"><summary>What is included</summary><div class="fl-accordion__body">{{ product.metafields.custom.whats_included | metafield_tag }}</div></details>
        {%- endif -%}
        {%- if product.metafields.custom.natural_variation != blank -%}
          <details class="fl-accordion"><summary>Natural variation</summary><div class="fl-accordion__body">{{ product.metafields.custom.natural_variation | metafield_tag }}</div></details>
        {%- endif -%}
        {%- for block in section.blocks -%}
          <details class="fl-accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}</summary><div class="fl-accordion__body fl-richtext">{{ block.settings.content }}</div></details>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product specifications",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Know before it arrives" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every useful detail" },
    { "type": "textarea", "id": "text", "label": "Supporting text", "default": "Dimensions, materials, origin, care, and limitations come from product metafields." }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Additional detail",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Installation and care" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add precise, product-specific instructions here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Product specifications" }]
}
{% endschema %}
