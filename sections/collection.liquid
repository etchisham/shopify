{% render 'catalog-styles' %}

<section class="catalog-page collection full-width section-spacing">
  <div class="catalog-page__inner">

    <!-- ================================
         COLLECTION HEADER
    ================================= -->

    <header class="catalog-page__header">

      <h1 class="catalog-page__title">

        {% if collection.handle == 'all' %}

          {{ 'navigation.all_products' | t }}

        {% else %}

          {{ collection.title | escape }}

        {% endif %}

      </h1>


      {% if section.settings.show_collection_description and collection.description != blank %}

        <div class="catalog-page__description rte">
          {{ collection.description }}
        </div>

      {% endif %}

    </header>


    {% paginate collection.products by section.settings.products_per_page %}


      <!-- ================================
           FILTERS + SORT
      ================================= -->

      <div class="catalog-page__toolbar">

        {% render 'facets-toolbar',
  sort_options: collection.sort_options,
  sort_by: collection.sort_by,
  default_sort_by: collection.default_sort_by,
  results_count: collection.products_count
%}

      </div>


      <!-- ================================
           PRODUCTS
      ================================= -->

      {% if collection.products_count > 0 %}

        <div class="catalog-grid">

          {% for product in collection.products %}

            {% render 'catalog-product-item', product: product %}

          {% endfor %}

        </div>


        <!-- ================================
             PAGINATION
        ================================= -->

        {% render 'hilya-pagination', paginate: paginate %}


      {% else %}


        <!-- ================================
             EMPTY COLLECTION
        ================================= -->

        <div class="catalog-page__empty">

          <p>
            {{ 'collections.empty' | t }}
          </p>

        </div>


      {% endif %}


    {% endpaginate %}

  </div>
</section>

<script>
(function () {
  var grid = document.querySelector('.catalog-grid');
  if (!grid || !('IntersectionObserver' in window)) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  grid.classList.add('has-reveal');

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;

      var card = entry.target;
      var columns = getComputedStyle(grid).gridTemplateColumns.split(' ').length;

      var position = 0;
      for (var s = card.previousElementSibling; s; s = s.previousElementSibling) {
        if (!s.classList.contains('is-filtered-out')) position++;
      }

      card.style.setProperty('--reveal-delay', ((position % columns) * 0.18) + 's');
      card.classList.add('is-revealed');
      observer.unobserve(card);
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  function watch(node) {
    if (node.nodeType === 1 &&
        node.classList.contains('catalog-product-item') &&
        !node.classList.contains('is-revealed')) {
      observer.observe(node);
    }
  }

  Array.prototype.forEach.call(grid.children, watch);

  new MutationObserver(function (mutations) {
    mutations.forEach(function (m) {
      Array.prototype.forEach.call(m.addedNodes, watch);
    });
  }).observe(grid, { childList: true });
})();
</script>





{% schema %}

{
  "name": "t:general.collection",

  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },

  "settings": [

    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "t:labels.show_collection_description",
      "default": false
    },

    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 4,
      "label": "t:labels.products_to_show",
      "default": 24
    }

  ]
}

{% endschema %}
