<section class="catalog-page collection full-width section-spacing">
  <div class="catalog-page__inner">

    <!-- ================================
         COLLECTION HEADER
    ================================= -->

    <header class="catalog-page__header">

      <p class="catalog-page__eyebrow">
        COLLECTION
      </p>


      <h1 class="catalog-page__title">

        {% if collection.handle == 'all' %}

          All Products

        {% else %}

          {{ collection.title | escape }}

        {% endif %}

      </h1>


      {% if section.settings.show_collection_description and collection.description != blank %}

        <div class="catalog-page__description rte">

          {{ collection.description }}

        </div>

      {% endif %}

    </header>


    {% paginate collection.products by section.settings.products_per_page %}


      <!-- ================================
           FILTERS + SORT
      ================================= -->

      <div class="catalog-page__toolbar">

        {% render 'facets-toolbar',
          filters: collection.filters,
          sort_options: collection.sort_options,
          sort_by: collection.sort_by,
          default_sort_by: collection.default_sort_by,
          results_url: collection.url,
          clear_url: collection.url,
          results_count: collection.products_count,
          section_id: section.id
        %}

      </div>


      <!-- ================================
           PRODUCTS
      ================================= -->

      {% if collection.products_count > 0 %}

        <div class="catalog-grid">


          {% for product in collection.products %}


            {% liquid
  assign product_colors = ''
  assign product_available = product.available

  for option in product.options_with_values
    if option.name == 'Color'
      for value in option.values
        assign product_colors = product_colors | append: value.name | append: '|'
      endfor
    endif
  endfor
%}


            <div
              class="catalog-product-item"
              data-product-item
              data-product-type="{{ product.type | escape }}"
              data-product-price="{{ product.price | divided_by: 100.0 }}"
              data-product-available="{{ product_available }}"
              data-product-colors="{{ product_colors | escape }}"
            >


              <!-- ================================
                   VARIANT DATA
              ================================= -->

              <script
                type="application/json"
                data-variant-data
              >

                [

                  {% for variant in product.variants %}

                    {

                      "id":
                        {{ variant.id | json }},

                      "color":
                        {{ variant.option1 | json }},

                      "price":
                        {{ variant.price
                          | divided_by: 100.0
                          | json }},

                      "available":
                        {{ variant.available | json }},

                      "url":
                        {{ variant.url | json }},


                      "image":

                      {% if variant.featured_image %}

                        {

                          "src":
                            {{ variant.featured_image
                              | image_url: width: 1200
                              | json }},

                          "alt":
                            {{ variant.featured_image.alt
                              | default: product.title
                              | json }}

                        }

                      {% else %}

                        null

                      {% endif %},


                      "images": [

                        {% assign variant_color =
                          variant.option1
                          | downcase
                          | strip
                        %}


                        {% assign matched_image_count = 0 %}


                        {% for image in product.images %}

                          {% assign image_alt =
                            image.alt
                            | default: ''
                            | downcase
                          %}


                          {% if image_alt contains variant_color %}


                            {% if matched_image_count > 0 %},{% endif %}


                            {

                              "src":
                                {{ image
                                  | image_url: width: 1200
                                  | json }},

                              "alt":
                                {{ image.alt
                                  | default: product.title
                                  | json }}

                            }


                            {% assign matched_image_count =
                              matched_image_count
                              | plus: 1
                            %}


                          {% endif %}

                        {% endfor %}

                      ]

                    }

                    {% unless forloop.last %},{% endunless %}

                  {% endfor %}

                ]

              </script>


              <!-- ================================
                   PRODUCT CARD
              ================================= -->

              {% render 'product-card',
                product: product,
                heading_level: 'h2',
                sizes: '(min-width: 1024px) 25vw, (min-width: 750px) 33vw, 50vw'
              %}


            </div>


          {% endfor %}


        </div>


        <!-- ================================
             PAGINATION
        ================================= -->

        {% if paginate.pages > 1 %}

          <nav
            class="catalog-page__pagination"
            aria-label="Pagination"
          >

            {{ paginate | default_pagination }}

          </nav>

        {% endif %}


      {% else %}


        <!-- ================================
             EMPTY COLLECTION
        ================================= -->

        <div class="catalog-page__empty">

          <p>
            {{ 'collections.empty' | t }}
          </p>

        </div>


      {% endif %}


    {% endpaginate %}


  </div>
</section>


{% stylesheet %}

/* =========================================
   COLLECTION
========================================= */

.catalog-page__inner {
  width: 100%;
  padding-inline: clamp(1rem, 5vw, 5.5rem);
}


/* =========================================
   COLLECTION HEADER
========================================= */

.catalog-page__header {
  width: 100%;
  margin-inline: auto;
  margin-block-end: clamp(2.25rem, 4vw, 3.5rem);
  text-align: center;
}

.catalog-page__eyebrow {
  margin: 0 0 .8rem;
  color: var(--color-muted);
  font-size: .62rem;
  font-weight: 500;
  line-height: 1;
  letter-spacing: .24em;
  text-transform: uppercase;
}

.catalog-page__title {
  margin: 0;
  color: var(--color-foreground);
  font-size: clamp(1.9rem, 3.5vw, 3.2rem);
  font-weight: 400;
  line-height: 1.08;
  letter-spacing: .035em;
  text-transform: uppercase;
}

.catalog-page__description {
  max-width: 36rem;
  margin: 1rem auto 0;
  color: var(--color-muted);
  font-size: .85rem;
  line-height: 1.7;
}


/* =========================================
   TOOLBAR
========================================= */

.catalog-page__toolbar {
  width: 100%;
  margin-block-end: clamp(1.5rem, 2.5vw, 2.25rem);
}


/* =========================================
   PRODUCT GRID
========================================= */

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: clamp(.7rem, 1.5vw, 1.5rem);
  row-gap: clamp(2.5rem, 4vw, 4.25rem);
}

.catalog-product-item.is-filtered-out {
  display: none;
}


/* =========================================
   PAGINATION
========================================= */

.catalog-page__pagination {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: .3rem;
  margin-block-start: 4.5rem;
  text-align: center;
}

.catalog-page__pagination > * {
  display: inline-grid;
  min-width: 2.5rem;
  min-height: 2.5rem;
  place-items: center;
  padding: .5rem;
  color: var(--color-foreground);
  border-radius: 50%;
  font-size: .75rem;
  line-height: 1;
  text-decoration: none;
}

.catalog-page__pagination > *:hover {
  background: rgb(0 0 0 / 5%);
}


/* =========================================
   EMPTY
========================================= */

.catalog-page__empty {
  max-width: 36rem;
  margin: 3rem auto;
  padding: 3rem 1.5rem;
  border: 1px solid rgb(0 0 0 / 8%);
  text-align: center;
  color: var(--color-muted);
}


/* =========================================
   TABLET
========================================= */

@media (min-width: 46.875rem) {

  .catalog-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

}


/* =========================================
   DESKTOP
========================================= */

@media (min-width: 40.001rem) {

  /*
    Main layout:

    LEFT  = Filters
    RIGHT = Products
  */

  .catalog-page__inner {
    display: grid;

    grid-template-columns:
      minmax(13rem, 15rem)
      minmax(0, 1fr);

    column-gap:
      clamp(
        2rem,
        4vw,
        4.5rem
      );

    align-items: start;
  }


  /* Header stays full width */

  .catalog-page__header {
    grid-column: 1 / -1;
    grid-row: 1;
  }


  /*
    Remove toolbar wrapper from layout.
    Its children become direct grid items.
  */

  .catalog-page__toolbar {
    display: contents;
    margin: 0;
  }


  /*
    Remove the extra filters wrapper
    from the grid on desktop.
  */

  .hilya-filters {
    display: contents;
  }


  /*
    PRODUCTS TOP BAR
  */

  .hilya-filters__top {
    grid-column: 2;
    grid-row: 2;

    display: grid;

    grid-template-columns:
      1fr auto;

    align-items: center;

    min-height: 3.75rem;

    margin-bottom: 1.25rem;

    border-bottom:
      1px solid
      rgb(0 0 0 / 8%);
  }


  /*
    FILTER BUTTON IS NOT NEEDED
    ON DESKTOP
  */

  .hilya-filters__button {
    display: none;
  }


  /*
    PRODUCT COUNT
  */

  .hilya-filters__results {
    grid-column: 1;

    justify-self: start;

    color: var(--color-muted);

    font-size: .65rem;

    letter-spacing: .12em;

    text-transform: uppercase;
  }


  /*
    SORT
  */

  .hilya-filters__sort {
    grid-column: 2;

    justify-self: end;
  }


  /*
    ACTIVE FILTERS
  */

  .hilya-filters__active {
    grid-column: 2;
    grid-row: 2;

    align-self: end;

    justify-content: flex-start;

    margin-bottom: 1.25rem;

    padding: 0 0 1rem;
  }


  /*
    SIDEBAR FILTERS

    The drawer becomes a normal
    left-side sidebar on desktop.
  */

  .hilya-filter-drawer {
    position: sticky;

    top: 100px;

    grid-column: 1;

    grid-row: 2 / span 3;

    width: 100%;

    max-height:
      calc(
        100vh - 120px
      );

    overflow-y: auto;

    background:
      transparent;

    transform: none;

    box-shadow: none;

    visibility: visible;

    opacity: 1;
  }


  .hilya-filter-drawer__header {
    padding:
      0 0 1rem;

    border-bottom:
      1px solid
      rgb(0 0 0 / 8%);
  }


  .hilya-filter-drawer__eyebrow {
    font-size: .55rem;
  }


  .hilya-filter-drawer__header h2 {
    font-size: .9rem;

    letter-spacing: .12em;
  }


  /*
    CLOSE BUTTON HIDDEN
  */

  .hilya-filter-drawer__close {
    display: none;
  }


  /*
    FILTER GROUPS
  */

  .hilya-filter-group {
    border-bottom:
      1px solid
      rgb(0 0 0 / 8%);
  }


  .hilya-filter-group summary {
    padding:
      1.15rem 0;

    font-size: .67rem;
  }


  .hilya-filter-group__content {
    padding:
      0 0 1rem;
  }


  /*
    FILTER OPTIONS
  */

  .hilya-filter-option {
    min-height: 2.15rem;

    font-size: .75rem;
  }


  /*
    PRICE
  */

  .hilya-price-fields {
    grid-template-columns:
      1fr;

    gap: .9rem;
  }


  /*
    REMOVE APPLY/CLEAR BUTTON AREA
    FROM THE SIDEBAR.

    CLEAR ALL is handled above
    with active filters.
  */

  .hilya-filter-actions {
    display: none;
  }


  /*
    PRODUCTS
  */

  .catalog-grid {
    grid-column: 2;
    grid-row: 3;

    width: 100%;

    align-self: start;
  }


  /*
    PAGINATION
  */

  .catalog-page__pagination {
    grid-column: 2;
    grid-row: 4;
  }


  /*
    EMPTY
  */

  .catalog-page__empty {
    grid-column: 2;
    grid-row: 3;
  }


  /*
    HIDE MOBILE OVERLAY
  */

  .hilya-filter-overlay {
    display: none;
  }

}


/* =========================================
   LARGE DESKTOP
========================================= */

@media (min-width: 64rem) {

  .catalog-grid {
    grid-template-columns:
      repeat(
        4,
        minmax(0, 1fr)
      );
  }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 40rem) {

  .catalog-page__inner {
    padding-inline: 1rem;
  }

  .catalog-page__header {
    margin-block-end: 2.25rem;
  }

  .catalog-page__eyebrow {
    margin-bottom: .7rem;
    font-size: .58rem;
    letter-spacing: .22em;
  }

  .catalog-page__title {
    font-size:
      clamp(
        1.75rem,
        8vw,
        2.25rem
      );

    letter-spacing: .025em;
  }

  .catalog-page__description {
    margin-top: .9rem;
    font-size: .78rem;
  }

  .catalog-page__toolbar {
    margin-block-end: 1.35rem;
  }

  .catalog-grid {
    column-gap: .7rem;
    row-gap: 2.75rem;
  }

  .catalog-page__pagination {
    margin-block-start: 3.5rem;
  }

}


/* =========================================
   VERY SMALL MOBILE
========================================= */

@media (max-width: 27rem) {

  .catalog-page__inner {
    padding-inline: .8rem;
  }

  .catalog-grid {
    column-gap: .6rem;
  }

}


/* =========================================
   REDUCED MOTION
========================================= */

@media (prefers-reduced-motion: reduce) {

  .catalog-page__pagination > * {
    transition: none;
  }

}

{% endstylesheet %}


{% schema %}

{

  "name":
    "t:general.collection",


  "disabled_on": {

    "groups":
      [
        "header",
        "footer"
      ]

  },


  "settings": [

    {

      "type":
        "checkbox",

      "id":
        "show_collection_description",

      "label":
        "t:labels.show_collection_description",

      "default":
        false

    },


    {

      "type":
        "range",

      "id":
        "products_per_page",

      "min":
        12,

      "max":
        48,

      "step":
        4,

      "label":
        "t:labels.products_to_show",

      "default":
        24

    }

  ]

}

{% endschema %}