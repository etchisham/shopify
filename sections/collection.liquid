<section class="catalog-page collection full-width section-spacing">
  <div class="catalog-page__inner">

    <!-- ================================
         COLLECTION HEADER
    ================================= -->

    <header class="catalog-page__header">

      <h1 class="catalog-page__title">

        {% if collection.handle == 'all' %}

          All Products

        {% else %}

          {{ collection.title | escape }}

        {% endif %}

      </h1>


      {% if section.settings.show_collection_description and collection.description != blank %}

        <div class="catalog-page__description rte">
          {{ collection.description }}
        </div>

      {% endif %}

    </header>


    {% paginate collection.products by section.settings.products_per_page %}


      <!-- ================================
           FILTERS + SORT
      ================================= -->

      <div class="catalog-page__toolbar">

        {% render 'facets-toolbar',
          filters: collection.filters,
          sort_options: collection.sort_options,
          sort_by: collection.sort_by,
          default_sort_by: collection.default_sort_by,
          results_url: collection.url,
          clear_url: collection.url,
          results_count: collection.products_count,
          section_id: section.id
        %}

      </div>


      <!-- ================================
           PRODUCTS
      ================================= -->

      {% if collection.products_count > 0 %}

        <div class="catalog-grid">

          {% for product in collection.products %}

            {% liquid
              assign product_colors = ''
              assign product_available = product.available

              for option in product.options_with_values
                if option.name == 'Color'
                  for value in option.values
                    assign product_colors = product_colors | append: value.name | append: '|'
                  endfor
                endif
              endfor
            %}


            <div
              class="catalog-product-item"
              data-product-item
              data-product-type="{{ product.type | escape }}"
              data-product-price="{{ product.price | divided_by: 100.0 }}"
              data-product-available="{{ product_available }}"
              data-product-colors="{{ product_colors | escape }}"
            >


              <!-- ================================
                   VARIANT DATA
              ================================= -->

              <script
                type="application/json"
                data-variant-data
              >
                [
                  {% for variant in product.variants %}
                    {
                      "id":
                        {{ variant.id | json }},

                      "color":
                        {{ variant.option1 | json }},

                      "price":
                        {{ variant.price
                          | divided_by: 100.0
                          | json }},

                      "available":
                        {{ variant.available | json }},

                      "url":
                        {{ variant.url | json }},

                      "image":
                      {% if variant.featured_image %}
                        {
                          "src":
                            {{ variant.featured_image
                              | image_url: width: 1200
                              | json }},

                          "alt":
                            {{ variant.featured_image.alt
                              | default: product.title
                              | json }}
                        }
                      {% else %}
                        null
                      {% endif %},

                      "images": [

                        {% assign variant_color =
                          variant.option1
                          | downcase
                          | strip
                        %}

                        {% assign matched_image_count = 0 %}

                        {% for image in product.images %}

                          {% assign image_alt =
                            image.alt
                            | default: ''
                            | downcase
                          %}

                          {% if image_alt contains variant_color %}

                            {% if matched_image_count > 0 %},{% endif %}

                            {
                              "src":
                                {{ image
                                  | image_url: width: 1200
                                  | json }},

                              "alt":
                                {{ image.alt
                                  | default: product.title
                                  | json }}
                            }

                            {% assign matched_image_count =
                              matched_image_count
                              | plus: 1
                            %}

                          {% endif %}

                        {% endfor %}

                      ]
                    }

                    {% unless forloop.last %},{% endunless %}

                  {% endfor %}
                ]
              </script>


              <!-- ================================
                   PRODUCT CARD
              ================================= -->

              {% render 'product-card',
                product: product,
                heading_level: 'h2',
                sizes: '(min-width: 1024px) 25vw, (min-width: 750px) 33vw, 50vw'
              %}

            </div>

          {% endfor %}

        </div>


        <!-- ================================
             PAGINATION
        ================================= -->

        {% if paginate.pages > 1 %}

          <nav
            class="catalog-page__pagination"
            aria-label="Pagination"
          >
            {{ paginate | default_pagination }}
          </nav>

        {% endif %}


      {% else %}


        <!-- ================================
             EMPTY COLLECTION
        ================================= -->

        <div class="catalog-page__empty">

          <p>
            {{ 'collections.empty' | t }}
          </p>

        </div>


      {% endif %}


    {% endpaginate %}

  </div>
</section>


{% stylesheet %}

/* =========================================
   COLLECTION PAGE
========================================= */

.catalog-page__inner {
  width: 100%;
  padding-inline: clamp(1rem, 5vw, 5.5rem);
}


/* =========================================
   COLLECTION HEADER
========================================= */

.catalog-page__header {
  width: 100%;
  margin-inline: auto;
  margin-block-end: .9rem;
  text-align: center;
}

.catalog-page__title {
  margin: 0;
  color: var(--color-foreground);
  font-family: var(--font-heading-family, Georgia, serif);
  font-size: clamp(1.55rem, 2.15vw, 1.95rem);
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: .015em;
  text-transform: none;
}

.catalog-page__title::after {
  content: "";
  display: block;
  width: 2.1rem;
  height: 1px;
  margin: .65rem auto 0;
  background: #b18a51;
}


.catalog-page__description {
  max-width: 36rem;
  margin: .65rem auto 0;
  color: var(--color-muted);
  font-size: .78rem;
  line-height: 1.7;
}


/* =========================================
   TOOLBAR
========================================= */

.catalog-page__toolbar {
  width: 100%;
  margin: 0;
}


/* =========================================
   PRODUCT GRID
========================================= */

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: clamp(.7rem, 1.5vw, 1.5rem);
  row-gap: clamp(2.5rem, 4vw, 4.25rem);
  grid-area: products;
  align-self: start;
}

.catalog-product-item.is-filtered-out {
  display: none;
}


/* =========================================
   PAGINATION
========================================= */

.catalog-page__pagination {
  grid-area: pagination;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: .3rem;
  margin-block-start: 4.5rem;
  text-align: center;
}

.catalog-page__pagination > * {
  display: inline-grid;
  min-width: 2.5rem;
  min-height: 2.5rem;
  place-items: center;
  padding: .5rem;
  color: var(--color-foreground);
  border-radius: 50%;
  font-size: .75rem;
  line-height: 1;
  text-decoration: none;
}

.catalog-page__pagination > *:hover {
  background: rgb(0 0 0 / 5%);
}


/* =========================================
   EMPTY COLLECTION
========================================= */

.catalog-page__empty {
  max-width: 36rem;
  margin: 3rem auto;
  padding: 3rem 1.5rem;
  border: 1px solid rgb(0 0 0 / 8%);
  text-align: center;
  color: var(--color-muted);
}


/* =========================================
   DESKTOP
========================================= */

@media (min-width: 40.001rem) {

  .catalog-page__inner {
    display: grid;
    grid-template-columns:
      minmax(10rem, 11.25rem)
      minmax(0, 1fr);

    grid-template-areas:
      "header header"
      "sidebar toolbar"
      "sidebar products"
      "sidebar pagination";

    column-gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .catalog-page__header {
    grid-area: header;
  }

  .catalog-page__toolbar {
    display: contents;
  }

  .hilya-filters {
    display: contents;
  }

  .catalog-page__pagination {
    margin-block-start: 4rem;
  }

}


/* =========================================
   3 COLUMNS
========================================= */

@media (min-width: 46.875rem) {

  .catalog-grid {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

}


/* =========================================
   4 COLUMNS
========================================= */

@media (min-width: 64rem) {

  .catalog-grid {
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
  }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 40rem) {

  .catalog-page {
    margin-top: -2rem;
  }
  .catalog-page__inner {
    padding-inline: 1rem;
  }

  .catalog-page__header {
    margin-block-end: .55rem;
  }

  .catalog-page__title {
    font-size: clamp(1.4rem, 7vw, 1.85rem);
    letter-spacing: .045em;
  }

  .catalog-page__description {
    margin-top: .6rem;
    font-size: .74rem;
  }

  .catalog-page__toolbar {
    margin-block-end: .65rem;
  }

  .catalog-grid {
    column-gap: .7rem;
    row-gap: 2.75rem;
  }

  .catalog-page__pagination {
    margin-block-start: 3.5rem;
  }

}


/* =========================================
   SMALL MOBILE
========================================= */

@media (max-width: 27rem) {

  .catalog-page__inner {
    padding-inline: .8rem;
  }

  .catalog-grid {
    column-gap: .6rem;
  }

}


/* =========================================
   REDUCED MOTION
========================================= */

@media (prefers-reduced-motion: reduce) {

  .catalog-page__pagination > * {
    transition: none;
  }

}

{% endstylesheet %}


{% schema %}

{
  "name": "t:general.collection",

  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },

  "settings": [

    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "t:labels.show_collection_description",
      "default": false
    },

    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 4,
      "label": "t:labels.products_to_show",
      "default": 24
    }

  ]
}

{% endschema %}
