{% render 'catalog-styles' %}

<section class="catalog-page collection full-width section-spacing">
  <div class="catalog-page__inner">

    <!-- ================================
         COLLECTION HEADER
    ================================= -->

    <header class="catalog-page__header">

      <h1 class="catalog-page__title">

        {% if collection.handle == 'all' %}

          All Products

        {% else %}

          {{ collection.title | escape }}

        {% endif %}

      </h1>


      {% if section.settings.show_collection_description and collection.description != blank %}

        <div class="catalog-page__description rte">
          {{ collection.description }}
        </div>

      {% endif %}

    </header>


    {% paginate collection.products by section.settings.products_per_page %}


      <!-- ================================
           FILTERS + SORT
      ================================= -->

      <div class="catalog-page__toolbar">

        {% render 'facets-toolbar',
          filters: collection.filters,
          sort_options: collection.sort_options,
          sort_by: collection.sort_by,
          default_sort_by: collection.default_sort_by,
          results_url: collection.url,
          clear_url: collection.url,
          results_count: collection.products_count,
          section_id: section.id
        %}

      </div>


      <!-- ================================
           PRODUCTS
      ================================= -->

      {% if collection.products_count > 0 %}

        <div class="catalog-grid">

          {% for product in collection.products %}

            {% liquid
              assign product_colors = ''
              assign product_available = product.available

              for option in product.options_with_values
                if option.name == 'Color'
                  for value in option.values
                    assign product_colors = product_colors | append: value.name | append: '|'
                  endfor
                endif
              endfor
            %}


            <div
              class="catalog-product-item"
              data-product-item
              data-product-type="{{ product.type | escape }}"
              data-product-price="{{ product.price | divided_by: 100.0 }}"
              data-product-available="{{ product_available }}"
              data-product-colors="{{ product_colors | escape }}"
            >


              <!-- ================================
                   VARIANT DATA
              ================================= -->

              <script
                type="application/json"
                data-variant-data
              >
                [
                  {% for variant in product.variants %}
                    {
                      "id":
                        {{ variant.id | json }},

                      "color":
                        {{ variant.option1 | json }},

                      "price":
                        {{ variant.price
                          | divided_by: 100.0
                          | json }},
                      "compare_at_price":
                         {% if variant.compare_at_price %}
                           {{ variant.compare_at_price
                            | divided_by: 100.0
                            | json }}
                            {% else %}
                            null
                          {% endif %},    

                      "available":
                        {{ variant.available | json }},

                      "url":
                        {{ variant.url | json }},

                      "image":
                      {% if variant.featured_image %}
                        {
                          "src":
                            {{ variant.featured_image
                              | image_url: width: 1200
                              | json }},

                          "alt":
                            {{ variant.featured_image.alt
                              | default: product.title
                              | json }}
                        }
                      {% else %}
                        null
                      {% endif %},

                      "images": [

                        {% assign variant_color =
                          variant.option1
                          | downcase
                          | strip
                        %}

                        {% assign matched_image_count = 0 %}

                        {% for image in product.images %}

                          {% assign image_alt =
                            image.alt
                            | default: ''
                            | downcase
                          %}

                          {% if image_alt contains variant_color %}

                            {% if matched_image_count > 0 %},{% endif %}

                            {
                              "src":
                                {{ image
                                  | image_url: width: 1200
                                  | json }},

                              "alt":
                                {{ image.alt
                                  | default: product.title
                                  | json }}
                            }

                            {% assign matched_image_count =
                              matched_image_count
                              | plus: 1
                            %}

                          {% endif %}

                        {% endfor %}

                      ]
                    }

                    {% unless forloop.last %},{% endunless %}

                  {% endfor %}
                ]
              </script>


              <!-- ================================
                   PRODUCT CARD
              ================================= -->

              {% render 'product-card',
                product: product,
                heading_level: 'h2',
                sizes: '(min-width: 1024px) 25vw, (min-width: 750px) 33vw, 50vw'
              %}

            </div>

          {% endfor %}

        </div>


        <!-- ================================
             PAGINATION
        ================================= -->

        {% if paginate.pages > 1 %}

          {% assign current_title = paginate.current_page | append: '' %}

          <nav
            class="catalog-page__pagination"
            aria-label="Pagination"
          >

            <ul class="hilya-pagination">

              <!-- PREVIOUS -->

              <li>
                {% if paginate.previous.is_link %}
                  <a
                    class="hilya-pagination__item hilya-pagination__item--arrow"
                    href="{{ paginate.previous.url }}"
                    aria-label="Previous page"
                  >
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
                  </a>
                {% else %}
                  <span
                    class="hilya-pagination__item hilya-pagination__item--arrow is-disabled"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
                  </span>
                {% endif %}
              </li>


              <!-- PAGE NUMBERS -->

              {% for part in paginate.parts %}

                {% assign part_title = part.title | append: '' %}

                <li>
                  {% if part.is_link %}

                    <a
                      class="hilya-pagination__item"
                      href="{{ part.url }}"
                      aria-label="Page {{ part.title }}"
                    >
                      {{ part.title }}
                    </a>

                  {% elsif part_title == current_title %}

                    <span
                      class="hilya-pagination__item is-current"
                      aria-current="page"
                    >
                      {{ part.title }}
                    </span>

                  {% else %}

                    <span class="hilya-pagination__item is-ellipsis">…</span>

                  {% endif %}
                </li>

              {% endfor %}


              <!-- NEXT -->

              <li>
                {% if paginate.next.is_link %}
                  <a
                    class="hilya-pagination__item hilya-pagination__item--arrow"
                    href="{{ paginate.next.url }}"
                    aria-label="Next page"
                  >
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                {% else %}
                  <span
                    class="hilya-pagination__item hilya-pagination__item--arrow is-disabled"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                {% endif %}
              </li>

            </ul>

          </nav>

        {% endif %}


      {% else %}


        <!-- ================================
             EMPTY COLLECTION
        ================================= -->

        <div class="catalog-page__empty">

          <p>
            {{ 'collections.empty' | t }}
          </p>

        </div>


      {% endif %}


    {% endpaginate %}

  </div>
</section>





{% schema %}

{
  "name": "t:general.collection",

  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },

  "settings": [

    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "t:labels.show_collection_description",
      "default": false
    },

    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 4,
      "label": "t:labels.products_to_show",
      "default": 24
    }

  ]
}

{% endschema %}
