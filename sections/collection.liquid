<section class="catalog-page collection full-width section-spacing">
  <div class="catalog-page__inner">
    <header class="catalog-page__header">
      <p class="eyebrow">{{ 'general.collection' | t }}</p>
      <h1>{{ collection.title | escape }}</h1>
      {% if section.settings.show_collection_description and collection.description != blank %}
        <div class="catalog-page__description rte muted">{{ collection.description }}</div>
      {% endif %}
    </header>

    {% paginate collection.products by section.settings.products_per_page %}
      {% render 'facets-toolbar',
        filters: collection.filters,
        sort_options: collection.sort_options,
        sort_by: collection.sort_by,
        default_sort_by: collection.default_sort_by,
        results_url: collection.url,
        clear_url: collection.url,
        results_count: collection.products_count,
        section_id: section.id
      %}

      {% if collection.products_count > 0 %}
        <div class="catalog-grid">
          {% for product in collection.products %}
            {% render 'product-card', product: product, heading_level: 'h2', sizes: '(min-width: 1024px) 25vw, (min-width: 750px) 33vw, 50vw' %}
          {% endfor %}
        </div>
        <div class="catalog-page__pagination">{{ paginate | default_pagination }}</div>
      {% else %}
        <p class="catalog-page__empty">{{ 'collections.empty' | t }}</p>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% stylesheet %}
  .catalog-page__inner {
    width: 100%;
    padding-inline: clamp(1rem, 5.2vw, 6.25rem);
  }

  .catalog-page__header {
    max-width: 52rem;
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
  }

  .catalog-page__header h1 {
    margin-block-start: var(--space-2);
  }

  .catalog-page__description {
    max-width: 48rem;
  }

  .catalog-page__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
    margin-block-start: var(--space-7);
    text-align: center;
  }

  .catalog-page__pagination > * {
    display: inline-grid;
    min-width: 2.75rem;
    min-height: 2.75rem;
    place-items: center;
    border-radius: 999px;
    padding: 0.55rem;
  }

  .catalog-page__empty {
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-large);
    padding: var(--space-7);
    text-align: center;
  }

  @media (max-width: 40rem) {
    .catalog-page__inner {
      padding-inline: 1rem;
    }

    .catalog-page__header {
      margin-block-end: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "checkbox", "id": "show_collection_description", "label": "t:labels.show_collection_description", "default": true },
    { "type": "range", "id": "products_per_page", "min": 12, "max": 48, "step": 4, "label": "t:labels.products_to_show", "default": 24 }
  ]
}
{% endschema %}
