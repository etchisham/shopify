{%- assign current_year = 'now' | date: '%Y' -%}
{%- assign language_label = 'general.language' | t -%}

<footer class="hilya-footer">

  <div class="hilya-footer__inner">

    <div class="hilya-footer__brand">

      <a href="{{ routes.root_url }}" class="hilya-footer__logo">
        {{ 'general.brand_name' | t }}
      </a>

      <p>{{ 'footer.tagline' | t }}</p>

    </div>


    <div class="hilya-footer__column">

      <h3>{{ 'navigation.shop' | t }}</h3>

      {% if section.settings.all_products_link != blank %}
        <a href="{{ section.settings.all_products_link }}">{{ 'navigation.all_products' | t }}</a>
      {% endif %}

      {% if section.settings.new_arrivals_link != blank %}
        <a href="{{ section.settings.new_arrivals_link }}">{{ 'navigation.new_arrivals' | t }}</a>
      {% endif %}

      {% if section.settings.best_sellers_link != blank %}
        <a href="{{ section.settings.best_sellers_link }}">{{ 'navigation.best_sellers' | t }}</a>
      {% endif %}

      {% if section.settings.sale_link != blank %}
        <a href="{{ section.settings.sale_link }}">{{ 'navigation.sale' | t }}</a>
      {% endif %}

    </div>


    <div class="hilya-footer__column">

      <h3>{{ 'navigation.categories' | t }}</h3>

      <a href="{{ routes.collections_url }}/collections">{{ 'navigation.collections' | t }}</a>

      {% if section.settings.necklaces_link != blank %}
        <a href="{{ section.settings.necklaces_link }}">{{ 'navigation.necklaces' | t }}</a>
      {% endif %}

      {% if section.settings.rings_link != blank %}
        <a href="{{ section.settings.rings_link }}">{{ 'navigation.rings' | t }}</a>
      {% endif %}

      {% if section.settings.pendants_link != blank %}
        <a href="{{ section.settings.pendants_link }}">{{ 'navigation.pendants' | t }}</a>
      {% endif %}

      {% if section.settings.bracelets_link != blank %}
        <a href="{{ section.settings.bracelets_link }}">{{ 'navigation.bracelets' | t }}</a>
      {% endif %}

      {% if section.settings.keychains_link != blank %}
        <a href="{{ section.settings.keychains_link }}">{{ 'navigation.keychains' | t }}</a>
      {% endif %}

    </div>


    <div class="hilya-footer__column">

      <h3>{{ 'navigation.about' | t }}</h3>

      {% if section.settings.our_story_link != blank %}
        <a href="{{ section.settings.our_story_link }}">{{ 'navigation.our_story' | t }}</a>
      {% endif %}

      {% if section.settings.contact_link != blank %}
        <a href="{{ section.settings.contact_link }}">{{ 'navigation.contact_us' | t }}</a>
      {% endif %}

      {% if section.settings.shipping_link != blank %}
        <a href="{{ section.settings.shipping_link }}">{{ 'navigation.shipping' | t }}</a>
      {% endif %}

      {% if section.settings.returns_link != blank %}
        <a href="{{ section.settings.returns_link }}">{{ 'navigation.returns' | t }}</a>
      {% endif %}

    </div>


    <div class="hilya-footer__newsletter">

      <h3>{{ 'footer.join_newsletter' | t }}</h3>

      <p>{{ 'footer.newsletter_tagline' | t }}</p>

      {% form 'customer', class: 'hilya-newsletter-form' %}

        {%- if form.posted_successfully? -%}
          {%- assign newsletter_status = 'success' -%}
        {%- elsif form.errors -%}
          {%- assign newsletter_status = 'error' -%}
        {%- endif -%}

        <input type="hidden" name="contact[tags]" value="newsletter">

        <input
          type="email"
          name="contact[email]"
          aria-label="{{ 'newsletter.label' | t | escape }}"
          placeholder="{{ 'footer.email_placeholder' | t | escape }}"
          autocomplete="email"
          required
        >

        <button type="submit" aria-label="{{ 'newsletter.button' | t | escape }}">→</button>

      {% endform %}

      {%- if newsletter_status == 'success' -%}
        <p class="hilya-newsletter-message" role="status">{{ 'newsletter.success' | t }}</p>
      {%- elsif newsletter_status == 'error' -%}
        <p class="hilya-newsletter-message hilya-newsletter-message--error" role="alert">{{ 'newsletter.error' | t }}</p>
      {%- endif -%}

    </div>

  </div>


  <div class="hilya-footer__bottom">

    <p>{{ 'footer.copyright' | t: year: current_year }}</p>

    <div class="hilya-footer__social">

      {%- if localization.available_languages.size > 1 -%}
        {% form 'localization',
          id: 'FooterLanguage',
          class: 'hilya-footer-language',
          aria-label: language_label
        %}
          {%- for language in localization.available_languages -%}
            {%- unless language.iso_code == localization.language.iso_code -%}
              <button
                type="submit"
                class="hilya-footer-language__button"
                name="language_code"
                value="{{ language.iso_code }}"
                lang="{{ language.iso_code }}"
              >
                {{ language.endonym_name | escape }}
              </button>
            {%- endunless -%}
          {%- endfor -%}
        {% endform %}
      {%- endif -%}

      {% if section.settings.instagram_url != blank %}
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1"></circle>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.facebook_url != blank %}
        <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 8h3V4h-3c-3.3 0-5 2-5 5v3H6v4h3v4h4v-4h3l1-4h-4V9c0-.7.3-1 1-1z"></path>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.whatsapp_number != blank %}
        <a
          href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}"
          target="_blank"
          rel="noopener"
          aria-label="WhatsApp"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 11.5a8 8 0 0 1-11.9 7L4 20l1.5-4A8 8 0 1 1 20 11.5z"></path>
            <path d="M9 8.5c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4-.1.6l-.5.6c.5 1 1.3 1.7 2.3 2.2l.6-.5c.2-.2.4-.2.6-.1l1.5.7c.3.1.4.3.3.6-.2.8-.8 1.4-1.6 1.5-1.1.1-2.8-.7-4.2-1.9-1.4-1.2-2.4-2.8-2.5-3.9-.1-.7.2-1.1.6-1.4z"></path>
          </svg>
        </a>
      {% endif %}

    </div>

  </div>

</footer>

<script>
  (() => {
    /* when the footer comes into view, its pieces rise one after the other */
    const footer = document.currentScript.previousElementSibling;

    if (
      !footer ||
      !('IntersectionObserver' in window) ||
      (window.Shopify && window.Shopify.designMode) ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) return;

    const items = Array.from(footer.querySelectorAll(
      '.hilya-footer__brand, .hilya-footer__column, .hilya-footer__newsletter, .hilya-footer__bottom'
    ));

    items.forEach((el, index) => {
      el.classList.add('hilya-footer__item');
      el.style.setProperty('--reveal-delay', (index * 0.18) + 's');
    });
    footer.classList.add('has-reveal');

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        entry.target.classList.add('is-revealed');
        io.unobserve(entry.target);
      });
    }, { threshold: 0.1 });

    items.forEach((el) => io.observe(el));
  })();
</script>


{% stylesheet %}

/* =========================================================
   FOOTER
   Colors come from the shared Hilya variables (snippet hilya-style).
   ========================================================= */

.hilya-footer {
  /* full width of the screen, whatever the page container is */
  width: 100vw;
  max-width: 100vw;
  margin-inline: calc(50% - 50vw);
  padding: 42px max(24px, calc((100vw - 1400px) / 2)) 18px;

  /* keeps pieces that are still rising from stretching the page */
  overflow: clip;

  box-sizing: border-box;

  background: var(--hilya-ink);
  color: #fff;
}

.hilya-footer__inner {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr 0.8fr 0.8fr 1.5fr;
  gap: 50px;
  padding-bottom: 32px;
}


/* Brand */

.hilya-footer__logo {
  display: block;
  color: #fff;
  text-decoration: none;
  font-family: 'Cormorant Garamond', 'Times New Roman', serif;
  font-size: 34px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.04em;
}

.hilya-footer__brand p {
  margin: 8px 0 0;
  color: rgb(255 255 255 / 65%);
  font-family: Arial, sans-serif;
  font-size: 12px;
  letter-spacing: 0.14em;
  line-height: 1.5;
}


/* Columns */

.hilya-footer__column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
}

.hilya-footer h3 {
  margin: 0 0 10px;
  color: #fff;
  font-family: Arial, sans-serif;
  font-size: 14px;
  font-weight: 500;
  line-height: 1.4;
}

.hilya-footer__column a {
  color: rgb(255 255 255 / 65%);
  text-decoration: none;
  font-family: Arial, sans-serif;
  font-size: 13px;
  line-height: 1.7;
}

/* the soft rose gold (it is only used for small text on dark, never behind white text) */
.hilya-footer__column a:hover {
  color: var(--hilya-rose-light);
}


/* Newsletter */

.hilya-footer__newsletter p {
  max-width: 260px;
  margin: 0 0 13px;
  color: rgb(255 255 255 / 65%);
  font-family: Arial, sans-serif;
  font-size: 12px;
  line-height: 1.6;
}

.hilya-newsletter-form {
  display: flex;
  width: 100%;
  max-width: 280px;
  height: 36px;
  overflow: hidden;
  border-radius: 8px;
}

/* the field and the button sit side by side (they never overlap, so no white edge shows around the button).
   min-height 0: a taller minimum from the theme would push the text down inside the 36px box */
.hilya-newsletter-form input {
  flex: 1;
  min-width: 0;
  height: 100%;
  min-height: 0;
  padding-block: 0;
  padding-inline: 12px;
  border: 0;
  border-radius: 0;
  outline: 0;
  background: #fff;
  color: var(--hilya-ink);
  font-family: Arial, sans-serif;
  font-size: 13px;
  line-height: normal;
  box-sizing: border-box;
}

.hilya-newsletter-form button {
  display: grid;
  flex: 0 0 40px;
  place-items: center;
  height: 100%;
  min-height: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: var(--hilya-rose-deep);
  color: #fff;
  cursor: pointer;
  font-size: 15px;
  line-height: 1;
  transition: background-color 0.2s ease;
}

.hilya-newsletter-form button:hover {
  background: var(--hilya-rose);
}

.hilya-newsletter-form button:focus-visible {
  outline: 2px solid #fff;
  outline-offset: -3px;
}

.hilya-footer__newsletter .hilya-newsletter-message {
  max-width: 280px;
  margin: 10px 0 0;
  color: rgb(255 255 255 / 80%);
  font-size: 11px;
  line-height: 1.5;
}

/* the error stays a soft red on purpose */
.hilya-footer__newsletter .hilya-newsletter-message--error {
  color: #ffb4a8;
}


/* Bottom row */

.hilya-footer__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding-top: 17px;
  border-top: 1px solid rgb(255 255 255 / 12%);
}

.hilya-footer__bottom p {
  margin: 0;
  color: rgb(255 255 255 / 55%);
  font-family: Arial, sans-serif;
  font-size: 12px;
}

.hilya-footer__social {
  display: flex;
  align-items: center;
  gap: 16px;
}

.hilya-footer__social a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  color: #fff;
  text-decoration: none;
}

.hilya-footer__social a:hover {
  color: var(--hilya-rose-light);
}

.hilya-footer__social svg {
  width: 15px;
  height: 15px;
  fill: none;
  stroke: currentcolor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* icons are matched by name, not by position: the language button sits in the same row */
.hilya-footer__social a[aria-label='Facebook'] svg {
  fill: currentcolor;
  stroke: none;
}


/* Language switcher */

.hilya-footer-language {
  display: flex;
  align-items: center;
  margin: 0;
}

.hilya-footer-language__button {
  padding: 5px 13px;
  border: 1px solid rgb(255 255 255 / 35%);
  border-radius: 999px;
  background: transparent;
  color: var(--hilya-beige);
  cursor: pointer;
  font: inherit;
  font-size: 12px;
  line-height: 1.2;
  transition: border-color 0.2s ease;
}

.hilya-footer-language__button:hover {
  border-color: var(--hilya-rose-light);
}

.hilya-footer-language__button:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 2px;
}


/* Rising pieces (the script above adds .has-reveal, .hilya-footer__item and .is-revealed) */

@media (prefers-reduced-motion: no-preference) {
  .hilya-footer.has-reveal .hilya-footer__item {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 1.4s cubic-bezier(0.22, 0.61, 0.36, 1) var(--reveal-delay, 0s),
      transform 1.4s cubic-bezier(0.22, 0.61, 0.36, 1) var(--reveal-delay, 0s);
  }

  .hilya-footer.has-reveal .hilya-footer__item.is-revealed {
    opacity: 1;
    transform: none;
  }
}


/* Tablet */

@media (min-width: 750px) and (max-width: 1100px) {
  .hilya-footer {
    padding: 40px 28px 18px;
  }

  .hilya-footer__inner {
    grid-template-columns: 1.25fr 0.8fr 0.8fr 0.8fr 1.2fr;
    gap: 28px;
    padding-bottom: 30px;
  }

  .hilya-footer__newsletter p {
    max-width: 230px;
  }

  .hilya-newsletter-form {
    max-width: 260px;
  }
}


/* Mobile */

@media (max-width: 749px) {
  .hilya-footer {
    padding: 38px 22px 18px;
  }

  .hilya-footer__inner {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px 28px;
  }

  .hilya-footer__brand,
  .hilya-footer__newsletter {
    grid-column: 1 / -1;
  }

  .hilya-footer__bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .hilya-footer__social {
    gap: 18px;
  }
}


/* Arabic: letters must stay joined, so no letter spacing */

[dir='rtl'] .hilya-footer__logo {
  font-size: 30px;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.4;
}

[dir='rtl'] .hilya-footer__brand p {
  letter-spacing: 0;
}

[dir='rtl'] .hilya-newsletter-form button {
  transform: scaleX(-1);
}

{% endstylesheet %}


