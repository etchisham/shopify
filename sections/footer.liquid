<footer class="hilya-footer">

  <div class="hilya-footer__inner">

    <!-- BRAND -->

    <div class="hilya-footer__brand">

      <a href="{{ routes.root_url }}" class="hilya-footer__logo">
        Hilya
      </a>

      <p>
        JEWELRY & ACCESSORIES
      </p>

    </div>


    <!-- SHOP -->

    <div class="hilya-footer__column">

      <h3>Shop</h3>

      <a href="{{ routes.all_products_collection_url }}">
        All Products
      </a>

      <a href="{{ routes.root_url }}#new-arrivals">
        New Arrivals
      </a>

      <a href="{{ routes.root_url }}#best-sellers">
        Best Sellers
      </a>

      <a href="/pages/sale">
        Sale
      </a>

    </div>


    <!-- CATEGORIES -->

    <div class="hilya-footer__column">

      <h3>Categories</h3>

      <a href="/collections/necklaces">Necklaces</a>
      <a href="/collections/rings">Rings</a>
      <a href="/collections/pendants">Pendants</a>
      <a href="/collections/bracelets">Bracelets</a>
      <a href="/collections/keychains">Keychains</a>

    </div>


    <!-- ABOUT -->

    <div class="hilya-footer__column">

      <h3>About</h3>

      <a href="/pages/about">Our Story</a>
      <a href="/pages/contact">Contact Us</a>
      <a href="/pages/shipping">Shipping</a>
      <a href="/pages/returns">Returns</a>

    </div>


    <!-- NEWSLETTER -->

    <div class="hilya-footer__newsletter">

      <h3>Join Our Newsletter</h3>

      <p>
        Be the first to know about new collections
        and exclusive offers.
      </p>

      {% form 'customer', class: 'hilya-newsletter-form' %}

        <input
          type="email"
          name="contact[email]"
          placeholder="Your email address"
          autocomplete="email"
          required
        >

        <button type="submit" aria-label="Subscribe">
          →
        </button>

      {% endform %}

    </div>

  </div>


  <!-- BOTTOM -->

  <div class="hilya-footer__bottom">

    <p>
      © {{ 'now' | date: '%Y' }} Hilya. All rights reserved.
    </p>

    <div class="hilya-footer__social">

      <a
        href="{{ section.settings.instagram_url }}"
        target="_blank"
        rel="noopener"
        aria-label="Instagram"
      >
        Instagram
      </a>

      {% if section.settings.facebook_url != blank %}
        <a
          href="{{ section.settings.facebook_url }}"
          target="_blank"
          rel="noopener"
          aria-label="Facebook"
        >
          Facebook
        </a>
      {% endif %}

    </div>

  </div>

</footer>


{% stylesheet %}

.hilya-footer {
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
  background: #181818;
  color: #ffffff;
  padding: 42px max(24px, calc((100vw - 1400px) / 2)) 18px;
  box-sizing: border-box;
}

.hilya-footer__inner {
  display: grid;
  grid-template-columns: 1.4fr .8fr .8fr .8fr 1.5fr;
  gap: 50px;
  padding-bottom: 32px;
}


/* BRAND */

.hilya-footer__logo {
  display: block;
  color: #ffffff;
  text-decoration: none;
  font-family: "Cormorant Garamond", "Times New Roman", serif;
  font-size: 34px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: -.04em;
}

.hilya-footer__brand p {
  margin: 8px 0 0;
  color: #aaa;
  font-family: Arial, sans-serif;
  font-size: 7px;
  letter-spacing: .18em;
}


/* COLUMNS */

.hilya-footer__column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 7px;
}

.hilya-footer h3 {
  margin: 0 0 9px;
  color: #ffffff;
  font-family: Arial, sans-serif;
  font-size: 8px;
  line-height: 1;
  font-weight: 500;
}

.hilya-footer__column a {
  color: #aaa;
  text-decoration: none;
  font-family: Arial, sans-serif;
  font-size: 8px;
  line-height: 1.25;
}

.hilya-footer__column a:hover {
  color: #ffffff;
}


/* NEWSLETTER */

.hilya-footer__newsletter p {
  max-width: 230px;
  margin: 0 0 13px;
  color: #aaa;
  font-family: Arial, sans-serif;
  font-size: 8px;
  line-height: 1.5;
}

.hilya-newsletter-form {
  position: relative;
  display: flex;
  width: 100%;
  max-width: 280px;
  height: 30px;
}

.hilya-newsletter-form input {
  width: 100%;
  height: 100%;
  padding: 0 38px 0 12px;
  border: 0;
  outline: none;
  background: #ffffff;
  color: #111;
  font-family: Arial, sans-serif;
  font-size: 8px;
  box-sizing: border-box;
}

.hilya-newsletter-form button {
  position: absolute;
  top: 0;
  right: 0;
  width: 34px;
  height: 30px;
  border: 0;
  background: #ffffff;
  color: #111;
  font-size: 15px;
  cursor: pointer;
}


/* BOTTOM */

.hilya-footer__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding-top: 17px;
  border-top: 1px solid #333;
}

.hilya-footer__bottom p {
  margin: 0;
  color: #999;
  font-family: Arial, sans-serif;
  font-size: 7px;
}

.hilya-footer__social {
  display: flex;
  gap: 15px;
}

.hilya-footer__social a {
  color: #ffffff;
  text-decoration: none;
  font-family: Arial, sans-serif;
  font-size: 7px;
}


/* TABLET */

@media (min-width: 750px) and (max-width: 1100px) {

  .hilya-footer {
    padding-left: 28px;
    padding-right: 28px;
  }

  .hilya-footer__inner {
    grid-template-columns: 1.3fr .8fr .8fr .8fr 1.2fr;
    gap: 25px;
  }

}


/* MOBILE */

@media (max-width: 749px) {

  .hilya-footer {
    width: 100%;
    max-width: none;
    margin-left: 0;
    padding: 38px 22px 18px;
  }

  .hilya-footer__inner {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px 28px;
  }

  .hilya-footer__brand {
    grid-column: 1 / -1;
  }

  .hilya-footer__newsletter {
    grid-column: 1 / -1;
  }

  .hilya-footer__logo {
    font-size: 34px;
  }

  .hilya-footer__bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Hilya Footer",
  "settings": [
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook link"
    }
  ],
  "presets": [
    {
      "name": "Hilya Footer"
    }
  ]
}
{% endschema %}