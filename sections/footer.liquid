{% liquid
  assign footer_logo = section.settings.logo | default: settings.logo

  assign quick_links_heading = section.settings.secondary_menu_heading
  if quick_links_heading == blank
    assign quick_links_heading = 'footer.quick_links' | t
  endif

  assign newsletter_heading = section.settings.newsletter_heading
  if newsletter_heading == blank
    assign newsletter_heading = 'footer.newsletter_heading' | t
  endif

  assign newsletter_text = section.settings.newsletter_text
  if newsletter_text == blank
    assign newsletter_text = 'footer.newsletter_text' | t
  endif

  assign email_placeholder = section.settings.email_placeholder
  if email_placeholder == blank
    assign email_placeholder = 'newsletter.placeholder' | t
  endif

  assign subscribe_label = section.settings.subscribe_label
  if subscribe_label == blank
    assign subscribe_label = 'newsletter.button' | t
  endif

  assign privacy_text = section.settings.privacy_text
  if privacy_text == blank
    assign privacy_text = 'footer.privacy_notice' | t
  endif

  assign privacy_url = section.settings.privacy_link
  if privacy_url == blank and shop.privacy_policy != blank
    assign privacy_url = shop.privacy_policy.url
  endif

  assign copyright_text = section.settings.copyright_text | default: shop.name
  assign social_blocks = section.blocks | where: 'type', 'social'
  assign newsletter_form_id = 'FooterNewsletter-' | append: section.id

  assign has_social_links = false
  if section.settings.facebook_url != blank or section.settings.instagram_url != blank or section.settings.youtube_url != blank or section.settings.tiktok_url != blank
    assign has_social_links = true
  endif
%}

<footer
  class="site-footer full-width"
  style="
    --footer-background: {{ section.settings.background_color }};
    --footer-color: {{ section.settings.text_color }};
    --footer-muted: {{ section.settings.muted_color }};
    --footer-border: {{ section.settings.border_color }};
    --footer-field-background: {{ section.settings.field_background_color }};
    --footer-field-color: {{ section.settings.field_text_color }};
    --footer-button-background: {{ section.settings.button_background_color }};
    --footer-button-color: {{ section.settings.button_text_color }};
    --footer-desktop-padding: {{ section.settings.desktop_padding }}px;
    --footer-top-padding: {{ section.settings.top_padding }}px;
    --footer-heading-size: {{ section.settings.heading_font_size }}px;
    --footer-text-size: {{ section.settings.text_font_size }}px;
    --footer-logo-width: {{ section.settings.logo_width }}px;
  "
>
  <div class="site-footer__main">
    <div class="site-footer__grid">
      <details class="site-footer__menu" data-footer-menu>
        <summary class="site-footer__menu-summary">
          <span class="site-footer__logo">
            {% if footer_logo != blank %}
              {{ footer_logo | image_url: width: section.settings.logo_width | image_tag: widths: '80, 120, 160, 220, 300', width: section.settings.logo_width, alt: shop.name, loading: 'lazy' }}
            {% else %}
              {{ shop.name | escape }}
            {% endif %}
          </span>
          <span class="site-footer__chevron">{% render 'icon', name: 'chevron' %}</span>
        </summary>
        <div class="site-footer__menu-content">
          {% if section.settings.primary_menu != blank %}
            <nav aria-label="{{ shop.name | escape }}">
              <ul role="list">
                {% for link in section.settings.primary_menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {% endfor %}
              </ul>
            </nav>
          {% endif %}
        </div>
      </details>

      <details class="site-footer__menu" data-footer-menu>
        <summary class="site-footer__menu-summary">
          <span>{{ quick_links_heading | escape }}</span>
          <span class="site-footer__chevron">{% render 'icon', name: 'chevron' %}</span>
        </summary>
        <div class="site-footer__menu-content">
          {% if section.settings.secondary_menu != blank %}
            <nav aria-label="{{ quick_links_heading | escape }}">
              <ul role="list">
                {% for link in section.settings.secondary_menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {% endfor %}
              </ul>
            </nav>
          {% endif %}
        </div>
      </details>

      {% if section.settings.show_newsletter %}
        <section class="site-footer__newsletter" aria-labelledby="FooterNewsletterHeading-{{ section.id }}">
          <h2 id="FooterNewsletterHeading-{{ section.id }}">{{ newsletter_heading | escape }}</h2>
          <p>{{ newsletter_text | escape }}</p>

          {% form 'customer', id: newsletter_form_id, class: 'site-footer__newsletter-form', data-newsletter-form: '' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="site-footer__newsletter-fields">
              <label class="visually-hidden" for="FooterNewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
              <input
                id="FooterNewsletterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ email_placeholder | escape }}"
                autocomplete="email"
                autocapitalize="off"
                autocorrect="off"
                aria-required="true"
                required
              >
              <button type="submit" data-newsletter-button>
                <span class="button-spinner" aria-hidden="true"></span>
                <span data-newsletter-label>{{ subscribe_label | escape }}</span>
                <span data-newsletter-loading hidden>{{ 'newsletter.loading' | t }}</span>
              </button>
            </div>

            {% if form.posted_successfully? %}
              <p class="site-footer__message site-footer__message--success" role="status" data-newsletter-result="success">{{ 'newsletter.success' | t }}</p>
            {% elsif form.errors %}
              <p class="site-footer__message site-footer__message--error" role="alert" data-newsletter-result="error">{{ 'newsletter.error' | t }}</p>
            {% endif %}
            <p class="site-footer__message site-footer__message--error" role="alert" data-newsletter-error hidden></p>
            <p class="site-footer__message" data-newsletter-verification hidden>{{ 'newsletter.verification' | t }}</p>
            <button type="button" data-newsletter-cancel hidden>{{ 'newsletter.cancel' | t }}</button>
            <span data-newsletter-success-message hidden>{{ 'newsletter.success' | t }}</span>
            <span data-newsletter-error-message hidden>{{ 'newsletter.request_error' | t }}</span>
          {% endform %}

          {% if privacy_text != blank %}
            {% if privacy_url != blank %}
              <a class="site-footer__privacy" href="{{ privacy_url }}">{{ privacy_text | escape }}</a>
            {% else %}
              <p class="site-footer__privacy">{{ privacy_text | escape }}</p>
            {% endif %}
          {% endif %}
        </section>
      {% endif %}
    </div>
  </div>

  <div class="site-footer__bottom">
    <p class="site-footer__copyright">&copy; {{ 'now' | date: '%Y' }} - {{ copyright_text | escape }}</p>

    {% if social_blocks.size > 0 %}
      <ul class="site-footer__socials" role="list" aria-label="{{ 'footer.follow_us' | t | escape }}">
        {% for block in social_blocks %}
          {% if block.settings.url != blank %}
            {% liquid
              assign platform_label = block.settings.platform | capitalize
              case block.settings.platform
                when 'youtube'
                  assign platform_label = 'YouTube'
                when 'tiktok'
                  assign platform_label = 'TikTok'
                when 'whatsapp'
                  assign platform_label = 'WhatsApp'
                when 'linkedin'
                  assign platform_label = 'LinkedIn'
              endcase
            %}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ platform_label | escape }}"><span aria-hidden="true">{% render 'icon', name: block.settings.platform %}</span><span class="visually-hidden">{{ 'accessibility.opens_in_new_tab' | t }}</span></a></li>
          {% endif %}
        {% endfor %}
      </ul>
    {% elsif has_social_links %}
      <ul class="site-footer__socials" role="list" aria-label="{{ 'footer.follow_us' | t | escape }}">
        {% if section.settings.facebook_url != blank %}
          <li><a href="{{ section.settings.facebook_url }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a></li>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <li><a href="{{ section.settings.instagram_url }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>
        {% endif %}
        {% if section.settings.youtube_url != blank %}
          <li><a href="{{ section.settings.youtube_url }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a></li>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
          <li><a href="{{ section.settings.tiktok_url }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a></li>
        {% endif %}
      </ul>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    border-block-start: 1px solid var(--footer-border);
    background: var(--footer-background);
    color: var(--footer-color);
    font-family: Arial, Helvetica, sans-serif;
    font-size: var(--footer-text-size);
    letter-spacing: 0.015em;
    line-height: 1.35;
  }

  [dir='rtl'] .site-footer {
    font-family: Tahoma, Arial, sans-serif;
    letter-spacing: 0;
  }

  .site-footer__main {
    padding: var(--footer-top-padding) var(--footer-desktop-padding) 6.2rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3.75rem;
  }

  .site-footer__menu,
  .site-footer__menu-summary {
    border: 0;
  }

  .site-footer__menu-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: inherit;
    cursor: default;
    font-size: var(--footer-heading-size);
    font-weight: 700;
    list-style: none;
    margin-block-end: 1.35rem;
    text-transform: uppercase;
  }

  .site-footer__menu-summary::-webkit-details-marker {
    display: none;
  }

  .site-footer__logo {
    display: inline-block;
    width: min(var(--footer-logo-width), 100%);
    font-size: var(--footer-heading-size);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  [dir='rtl'] .site-footer__logo {
    direction: ltr;
    unicode-bidi: isolate;
  }

  .site-footer__logo img {
    width: 100%;
    max-height: 2rem;
    object-fit: contain;
    object-position: left center;
  }

  [dir='rtl'] .site-footer__logo img {
    object-position: right center;
  }

  .site-footer__chevron {
    display: none;
  }

  .site-footer__menu-content {
    display: block;
  }

  .site-footer__menu ul,
  .site-footer__socials {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__menu li + li {
    margin-block-start: 0.7rem;
  }

  .site-footer__menu a {
    color: inherit;
    font-size: var(--footer-text-size);
    font-weight: 400;
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-footer__menu a:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .site-footer__newsletter h2 {
    margin: 0 0 1.35rem;
    color: inherit;
    font-family: inherit;
    font-size: var(--footer-heading-size);
    font-weight: 700;
    letter-spacing: 0.015em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .site-footer__newsletter > p {
    margin: 0 0 1.7rem;
    color: inherit;
    font-size: var(--footer-text-size);
    text-transform: uppercase;
  }

  .site-footer__newsletter-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11.6rem;
    gap: 0.95rem;
  }

  .site-footer__newsletter-fields input,
  .site-footer__newsletter-fields button {
    width: 100%;
    min-height: 3.5rem;
    border: 0;
    border-radius: 0;
    font: inherit;
  }

  .site-footer__newsletter-fields input {
    background: var(--footer-field-background);
    color: var(--footer-field-color);
    padding: 0.8rem 1.3rem;
  }

  .site-footer__newsletter-fields input::placeholder {
    color: color-mix(in srgb, var(--footer-field-color) 68%, transparent);
    opacity: 1;
  }

  .site-footer__newsletter-fields button {
    background: var(--footer-button-background);
    color: var(--footer-button-color);
    cursor: pointer;
    font-weight: 400;
    padding: 0.8rem 1rem;
    text-transform: uppercase;
  }

  .site-footer__newsletter-fields button:hover {
    filter: brightness(0.92);
  }

  .site-footer__privacy {
    display: block;
    margin: 1.25rem 0 0;
    color: var(--footer-muted);
    font-size: calc(var(--footer-text-size) - 1px);
    font-style: italic;
    letter-spacing: 0.045em;
    line-height: 1.45;
    text-decoration: none;
    text-transform: uppercase;
  }

  [dir='rtl'] .site-footer__privacy {
    letter-spacing: 0;
  }

  .site-footer__message {
    margin-block: 0.8rem 0;
    font-size: 0.875rem;
  }

  .site-footer__message--success {
    color: #8ee5ac;
  }

  .site-footer__message--error {
    color: #ffb4ab;
  }

  .site-footer__bottom {
    display: flex;
    min-height: 7.6rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-block-start: 1px solid var(--footer-border);
    padding-inline: var(--footer-desktop-padding);
  }

  .site-footer__copyright {
    margin: 0;
    font-size: var(--footer-text-size);
    font-weight: 400;
    text-transform: uppercase;
  }

  .site-footer__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    min-width: 0;
    align-items: center;
    gap: 2.15rem;
  }

  .site-footer__socials a {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    color: inherit;
  }

  .site-footer__socials span[aria-hidden] { display: contents; }

  .site-footer [hidden] { display: none; }
  .site-footer__newsletter-fields button { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; }
  .site-footer__newsletter-form[aria-busy='true'] [data-newsletter-label] { display: none; }
  .site-footer__newsletter-frame { width: 100%; height: 24rem; margin-block-start: 1rem; border: 1px solid var(--footer-border); background: white; }
  [data-newsletter-cancel] { margin-block-start: 0.75rem; color: inherit; background: transparent; border: 1px solid currentcolor; padding: 0.6rem 1rem; cursor: pointer; }

  .site-footer__socials svg {
    width: 1.15rem;
    max-height: 1.15rem;
    fill: currentcolor;
    stroke: none;
  }

  .site-footer__socials [aria-label='Instagram'] svg {
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
  }

  .site-footer__socials .icon-fill {
    fill: currentcolor;
    stroke: none;
  }

  @media (min-width: 46.875rem) and (max-width: 68.75rem) {
    .site-footer__newsletter-fields { grid-template-columns: 1fr; }
    .site-footer__newsletter-fields button { width: 11.6rem; }
  }

  @media (max-width: 46.8125rem) {
    .site-footer__main {
      padding: 1.7rem 1.625rem 3.55rem;
    }

    .site-footer__grid {
      display: block;
    }

    .site-footer__menu {
      border-block-end: 1px solid var(--footer-border);
    }

    .site-footer__menu-summary {
      min-height: 3.15rem;
      cursor: pointer;
      margin: 0;
    }

    .site-footer__logo {
      width: min(var(--footer-logo-width), 45vw);
    }

    .site-footer__chevron {
      display: inline-grid;
      place-items: center;
      transition: transform 160ms ease;
    }

    .site-footer__chevron svg {
      width: 1.15rem;
      fill: none;
      stroke: currentcolor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.8;
    }

    .site-footer__menu[open] .site-footer__chevron {
      transform: rotate(180deg);
    }

    .site-footer__menu-content {
      display: none;
      padding-block: 0.4rem 1.25rem;
    }

    .site-footer__menu[open] .site-footer__menu-content {
      display: block;
    }

    .site-footer__newsletter {
      margin-block-start: 2.35rem;
    }

    .site-footer__newsletter h2 {
      margin-block-end: 1.35rem;
    }

    .site-footer__newsletter > p {
      margin-block-end: 1.7rem;
      line-height: 1.45;
    }

    .site-footer__newsletter-fields {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .site-footer__newsletter-fields input {
      min-height: 2.9rem;
      padding-inline: 1.35rem;
    }

    .site-footer__newsletter-fields button {
      width: 8.7rem;
      min-height: 3rem;
    }

    .site-footer__privacy {
      margin-block-start: 1.25rem;
      line-height: 1.5;
    }

    .site-footer__bottom {
      min-height: 8.2rem;
      flex-direction: column;
      justify-content: flex-start;
      gap: 1.85rem;
      padding: 1.8rem 1.625rem 1.55rem;
      text-align: center;
    }

    .site-footer__socials {
      order: -1;
      justify-content: center;
      gap: 1.8rem;
    }
  }

  @media (min-width: 46.875rem) {
    .site-footer__menu-content {
      display: block !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "t:labels.footer_logo" },
    { "type": "range", "id": "logo_width", "label": "t:labels.footer_logo_width", "min": 60, "max": 220, "step": 4, "unit": "px", "default": 100 },
    { "type": "link_list", "id": "primary_menu", "label": "t:labels.primary_menu", "default": "footer" },
    { "type": "link_list", "id": "secondary_menu", "label": "t:labels.secondary_menu", "default": "main-menu" },
    { "type": "text", "id": "secondary_menu_heading", "label": "t:labels.secondary_menu_heading" },
    { "type": "header", "content": "t:labels.newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "t:labels.show_newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "t:labels.newsletter_heading" },
    { "type": "textarea", "id": "newsletter_text", "label": "t:labels.newsletter_text" },
    { "type": "text", "id": "email_placeholder", "label": "t:labels.email_placeholder" },
    { "type": "text", "id": "subscribe_label", "label": "t:labels.subscribe_label" },
    { "type": "textarea", "id": "privacy_text", "label": "t:labels.privacy_text" },
    { "type": "url", "id": "privacy_link", "label": "t:labels.privacy_link" },
    { "type": "text", "id": "copyright_text", "label": "t:labels.copyright_text" },
    { "type": "header", "content": "t:labels.social_links" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "header", "content": "t:labels.footer_style" },
    { "type": "color", "id": "background_color", "label": "t:labels.background", "default": "#1C1C1C" },
    { "type": "color", "id": "text_color", "label": "t:labels.foreground", "default": "#FFFFFF" },
    { "type": "color", "id": "muted_color", "label": "t:labels.muted", "default": "#B8B8B8" },
    { "type": "color", "id": "border_color", "label": "t:labels.border", "default": "#333333" },
    { "type": "color", "id": "field_background_color", "label": "t:labels.field_background", "default": "#FFFFFF" },
    { "type": "color", "id": "field_text_color", "label": "t:labels.field_text", "default": "#444444" },
    { "type": "color", "id": "button_background_color", "label": "t:labels.button_background", "default": "#F7F7F7" },
    { "type": "color", "id": "button_text_color", "label": "t:labels.button_text", "default": "#000000" },
    { "type": "range", "id": "heading_font_size", "label": "t:labels.heading_font_size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "text_font_size", "label": "t:labels.text_font_size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "desktop_padding", "label": "t:labels.desktop_horizontal_padding", "min": 24, "max": 100, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "top_padding", "label": "t:labels.footer_top_padding", "min": 56, "max": 140, "step": 2, "unit": "px", "default": 96 }
  ],
  "max_blocks": 8,
  "blocks": [{
    "type": "social", "name": "t:footer_social.name",
    "settings": [
      { "type": "select", "id": "platform", "label": "t:footer_social.platform", "default": "instagram", "options": [
        { "value": "facebook", "label": "Facebook" }, { "value": "instagram", "label": "Instagram" },
        { "value": "youtube", "label": "YouTube" }, { "value": "tiktok", "label": "TikTok" },
        { "value": "pinterest", "label": "Pinterest" }, { "value": "linkedin", "label": "LinkedIn" },
        { "value": "x", "label": "X" }, { "value": "whatsapp", "label": "WhatsApp" }
      ] },
      { "type": "url", "id": "url", "label": "t:footer_social.url" }
    ]
  }],
  "presets": [{ "name": "t:general.footer" }]
}
{% endschema %}
