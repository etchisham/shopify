{%- if section.settings.text != blank -%}
  <div class="fl-announcement" role="region" aria-label="Store announcement">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
      {{ section.settings.text }}
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Message", "default": "Clear delivery, returns, and human support" },
    { "type": "url", "id": "link", "label": "Optional link" }
  ]
}
{% endschema %}
