<section class="new-arrivals-banner">

  <div class="new-arrivals-banner__inner">

    <div class="new-arrivals-banner__media">

      {% if section.settings.image != blank %}

        {{ section.settings.image
          | image_url: width: 2400
          | image_tag:
            widths: '640, 960, 1280, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            alt: ''
        }}

      {% endif %}

      <div class="new-arrivals-banner__overlay"></div>

      <div class="new-arrivals-banner__content">

        <p class="new-arrivals-banner__eyebrow">
          {{ 'home.new_arrivals_eyebrow' | t }}
        </p>

        <h2 class="new-arrivals-banner__heading">
          {{ 'home.new_arrivals_heading_1' | t }}<br>
          {{ 'home.new_arrivals_heading_2' | t }}
        </h2>

        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="new-arrivals-banner__button"
        >
          <span>{{ 'home.new_arrivals_button' | t }}</span>
          <span class="new-arrivals-banner__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"></path></svg>
          </span>
        </a>

      </div>

    </div>

  </div>

</section>


{% stylesheet %}

/* =========================
   NEW ARRIVALS SECTION
========================= */

.new-arrivals-banner {
  width: 100vw;
  max-width: 100vw;

  margin-inline: calc(50% - 50vw);

  padding: 30px max(24px, calc((100vw - 1400px) / 2)) 25px;

  box-sizing: border-box;
}


/* =========================
   BANNER
========================= */

.new-arrivals-banner__inner {
  width: 100%;
  max-width: 100%;
}

.new-arrivals-banner__media {
  position: relative;

  width: 100%;
  height: 270px;

  overflow: hidden;
  isolation: isolate;

  background: #eee;
}


/* =========================
   IMAGE
========================= */

.new-arrivals-banner__media img {
  position: absolute;

  inset: 0;

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
}


/* =========================
   OVERLAY
========================= */

.new-arrivals-banner__overlay {
  position: absolute;

  inset: 0;

  z-index: 1;

  background: rgba(0, 0, 0, 0.25);
}


/* =========================
   CONTENT
========================= */

.new-arrivals-banner__content {
  position: absolute;

  inset: 0;

  z-index: 2;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  padding: 25px 30px;

  box-sizing: border-box;

  text-align: center;

  color: #fff;
}


/* =========================
   EYEBROW
========================= */

.new-arrivals-banner__eyebrow {
  margin: 0 0 12px;

  color: #fff;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 9px;

  line-height: 1;

  font-weight: 500;

  letter-spacing: .28em;

  text-transform: uppercase;
}


/* =========================
   HEADING
========================= */

.new-arrivals-banner__heading {
  margin: 0;

  color: #fff;

  font-family:
    "Cormorant Garamond",
    "Bodoni Moda",
    "Didot",
    "Times New Roman",
    serif;

  font-size: clamp(34px, 4vw, 56px);

  line-height: .95;

  font-weight: 400;

  font-style: italic;

  letter-spacing: -.01em;
}


/* =========================
   BUTTON
========================= */

.new-arrivals-banner__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 5px;

  margin-top: 20px;

  padding: 11px 17px;

  color: #fff;

  border: 1px solid rgba(255,255,255,.75);

  text-decoration: none;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 9px;

  line-height: 1;

  font-weight: 500;

  letter-spacing: .14em;

  text-transform: uppercase;

  transition:
    background .3s ease,
    color .3s ease,
    border-color .3s ease;
}

.new-arrivals-banner__button:hover {
  background: #fff;
  color: #111;
  border-color: #fff;
}

.new-arrivals-banner__arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  position: relative;
  top: 0;

  line-height: 1;

  transition: transform .3s ease;
}

.new-arrivals-banner__button:hover
.new-arrivals-banner__arrow {
  transform: translateX(3px);
}


/* =========================
   ARABIC / RTL
========================= */

[dir="rtl"] .new-arrivals-banner__arrow {
  transform: scaleX(-1);
}

[dir="rtl"] .new-arrivals-banner__button:hover
.new-arrivals-banner__arrow {
  transform: scaleX(-1) translateX(3px);
}

[dir="rtl"] .new-arrivals-banner__heading {
  line-height: 1.3;
}

[dir="rtl"] .new-arrivals-banner__eyebrow {
  font-size: 13px;
  line-height: 1.3;
}

[dir="rtl"] .new-arrivals-banner__button {
  font-size: 13px;
}

@media (max-width: 749px) {
  [dir="rtl"] .new-arrivals-banner__heading {
    font-size: clamp(24px, 6.8vw, 30px);
    line-height: 1.2;
  }

  [dir="rtl"] .new-arrivals-banner__eyebrow {
    margin-bottom: 8px;
    font-size: 11px;
    letter-spacing: 0;
  }

  [dir="rtl"] .new-arrivals-banner__button {
    margin-top: 14px;
    padding: 8px 14px;
    font-size: 11px;
    letter-spacing: 0;
  }
}

/* =========================
   LARGE DESKTOP
   SAME AS BEST SELLERS
========================= */

@media (min-width: 1500px) {

  .new-arrivals-banner {
    padding-left:
      max(32px, calc((100vw - 1500px) / 2));

    padding-right:
      max(32px, calc((100vw - 1500px) / 2));
  }

}


/* =========================
   TABLET
   SAME AS BEST SELLERS
========================= */

@media (min-width: 750px) and (max-width: 1100px) {

  .new-arrivals-banner {
    padding-left: 28px;

    padding-right: 28px;
  }

  .new-arrivals-banner__media {
    height: 250px;
  }

}


/* =========================
   MOBILE
========================= */

@media (max-width: 749px) {

  .new-arrivals-banner {
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding: 20px 1rem 30px;
    overflow-x: clip;
  }

    .new-arrivals-banner__media {
    height: 165px;
  }

  .new-arrivals-banner__content {
    padding: 14px 18px;
  }

  .new-arrivals-banner__eyebrow {
    margin-bottom: 8px;
    font-size: 8px;
    letter-spacing: .22em;
  }

  .new-arrivals-banner__heading {
    font-size: clamp(26px, 7.5vw, 34px);
  }

  .new-arrivals-banner__button {
    gap: 4px;
    margin-top: 14px;
    padding: 9px 13px;
    font-size: 8px;
  }

.new-arrivals-banner__arrow {
  top: 0;
}

}

{% endstylesheet %}


{% schema %}
{
  "name": "New Arrivals",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}