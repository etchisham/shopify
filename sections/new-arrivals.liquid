<section class="new-arrivals-banner">

  <div class="new-arrivals-banner__image">
    {% if section.settings.image != blank %}
      {{ section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '640, 960, 1280, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'lazy'
      }}
    {% endif %}
  </div>

  <div class="new-arrivals-banner__overlay"></div>

  <div class="new-arrivals-banner__content">

    <p class="new-arrivals-banner__eyebrow">
      NEW ARRIVALS
    </p>

    <h2 class="new-arrivals-banner__heading">
      Fresh Pieces,<br>
      Four New Moments
    </h2>

    <a
      href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
      class="new-arrivals-banner__button"
    >
      <span>EXPLORE NEW ARRIVALS</span>
      <span class="new-arrivals-banner__arrow">→</span>
    </a>

  </div>

</section>

{% stylesheet %}

/* =========================
   NEW ARRIVALS
========================= */

.new-arrivals-banner {
  position: relative;
  width: calc(100% - 48px);
  max-width: 1400px;
  height: 270px;
  margin: 25px auto 35px;
  overflow: hidden;
  isolation: isolate;
  background: #eee;
}


/* =========================
   IMAGE
========================= */

.new-arrivals-banner__image {
  position: absolute;
  inset: 0;
  z-index: -2;
}

.new-arrivals-banner__image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}


/* =========================
   OVERLAY
========================= */

.new-arrivals-banner__overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: rgba(0, 0, 0, 0.25);
}


/* =========================
   CONTENT
========================= */

.new-arrivals-banner__content {
  position: relative;
  z-index: 1;

  width: 100%;
  height: 100%;
  padding: 25px 30px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;
  text-align: center;
  color: #fff;
}


/* =========================
   EYEBROW
========================= */

.new-arrivals-banner__eyebrow {
  margin: 0 0 12px;

  font-family: Arial, Helvetica, sans-serif;
  font-size: 9px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 0.28em;
  text-transform: uppercase;

  color: #fff;
}


/* =========================
   HEADING
========================= */

.new-arrivals-banner__heading {
  margin: 0;

  font-family:
    "Cormorant Garamond",
    "Bodoni Moda",
    "Didot",
    serif;

  font-size: clamp(34px, 4vw, 56px);
  line-height: 0.95;
  font-weight: 400;
  font-style: italic;
  letter-spacing: -0.01em;

  color: #fff;
}


/* =========================
   BUTTON
========================= */

.new-arrivals-banner__button {
  display: inline-flex;
  align-items: center;
  gap: 12px;

  margin-top: 20px;
  padding: 11px 17px;

  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.75);

  text-decoration: none;

  font-family: Arial, Helvetica, sans-serif;
  font-size: 9px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;

  transition:
    background 0.3s ease,
    color 0.3s ease,
    border-color 0.3s ease;
}

.new-arrivals-banner__button:hover {
  background: #fff;
  color: #111;
  border-color: #fff;
}

.new-arrivals-banner__arrow {
  font-size: 15px;
  line-height: 1;

  transition: transform 0.3s ease;
}

.new-arrivals-banner__button:hover .new-arrivals-banner__arrow {
  transform: translateX(4px);
}


/* =========================
   LARGE DESKTOP
========================= */

@media (min-width: 1500px) {

  .new-arrivals-banner {
    max-width: 1500px;
  }

}


/* =========================
   TABLET
========================= */

@media (min-width: 750px) and (max-width: 1100px) {

  .new-arrivals-banner {
    width: calc(100% - 56px);
    height: 250px;
  }

}


/* =========================
   MOBILE
========================= */

@media (max-width: 749px) {

  .new-arrivals-banner {
    width: calc(100% - 10px);
    height: 210px;
    margin: 20px auto 30px;
  }

  .new-arrivals-banner__content {
    padding: 20px 18px;
  }

  .new-arrivals-banner__eyebrow {
    font-size: 8px;
    letter-spacing: 0.22em;
    margin-bottom: 10px;
  }

  .new-arrivals-banner__heading {
    font-size: clamp(30px, 9vw, 44px);
  }

  .new-arrivals-banner__button {
    margin-top: 17px;
    padding: 10px 14px;
    font-size: 8px;
  }

  .new-arrivals-banner__arrow {
    font-size: 14px;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "New Arrivals",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}