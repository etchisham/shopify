{%- liquid
  assign returns_heading = section.settings.heading | default: page.title
  assign policy_url = section.settings.policy_link
  if policy_url == blank
    assign policy_url = settings.return_policy_url
  endif
-%}

<section class="fl-support-page full-width">
  <header class="fl-page-hero fl-page-hero--returns">
    <div class="fl-container">
      <nav class="fl-breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="{{ routes.root_url }}">{{ 'support.general.home' | t }}</a></li>
          <li aria-current="page">{{ page.title }}</li>
        </ol>
      </nav>

      <div class="fl-page-hero__grid">
        <div>
          {%- if section.settings.eyebrow != blank -%}<span class="fl-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h1>{{ returns_heading }}</h1>
        </div>
        <div>
          {%- if section.settings.intro != blank -%}<div class="fl-page-hero__intro fl-richtext">{{ section.settings.intro }}</div>{%- endif -%}
          {%- if policy_url != blank -%}<a class="fl-link fl-page-hero__link" href="{{ policy_url }}">{{ section.settings.policy_link_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </header>

  <div class="fl-section fl-section--surface">
    <div class="fl-container">
      <div class="fl-section__head">
        <div>
          <span class="fl-eyebrow">{{ section.settings.process_eyebrow }}</span>
          <h2>{{ section.settings.process_heading }}</h2>
        </div>
        {%- if section.settings.process_text != blank -%}<p class="fl-section__intro">{{ section.settings.process_text }}</p>{%- endif -%}
      </div>

      <ol class="fl-return-steps">
        {%- assign step_number = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_number = step_number | plus: 1 -%}
            <li class="fl-return-step" {{ block.shopify_attributes }}>
              <span class="fl-return-step__number" aria-hidden="true">{{ step_number | prepend: '0' }}</span>
              <h3>{{ block.settings.heading }}</h3>
              <p>{{ block.settings.text }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </div>

  <div class="fl-section">
    <div class="fl-returns-layout fl-container">
      <div class="fl-returns-policy">
        <span class="fl-eyebrow">{{ section.settings.policy_eyebrow }}</span>
        <h2>{{ section.settings.policy_heading }}</h2>
        <div class="fl-policy-note fl-richtext">
          {%- if page.content != blank -%}
            {{ page.content }}
          {%- else -%}
            {{ section.settings.policy_summary }}
          {%- endif -%}
        </div>

        <div class="fl-policy-facts">
          {%- for block in section.blocks -%}
            {%- if block.type == 'policy_fact' -%}
              <article class="fl-policy-fact" {{ block.shopify_attributes }}>
                <h3>{{ block.settings.heading }}</h3>
                <p>{{ block.settings.text }}</p>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if policy_url != blank -%}<a class="fl-link" href="{{ policy_url }}">{{ section.settings.policy_link_label }}</a>{%- endif -%}
      </div>

      <div class="fl-form-panel" id="ReturnRequest">
        <span class="fl-eyebrow">{{ section.settings.form_eyebrow }}</span>
        <h2>{{ section.settings.form_heading }}</h2>
        {%- if section.settings.form_intro != blank -%}<div class="fl-form-intro fl-richtext">{{ section.settings.form_intro }}</div>{%- endif -%}

        {% form 'contact', id: 'FormeluneReturnForm', class: 'fl-support-form' %}
          <input type="hidden" name="contact[tags]" value="return-request">
          <input type="hidden" name="contact[Request type]" value="Return request">

          {%- if form.posted_successfully? -%}
            <div class="fl-alert fl-alert--success" role="status" tabindex="-1">
              <strong>{{ 'support.returns.success_heading' | t }}</strong>
              <p>{{ 'support.returns.success_text' | t }}</p>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="fl-alert fl-alert--error" role="alert" tabindex="-1">
              <strong>{{ 'support.general.error_heading' | t }}</strong>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <p class="fl-form-note">{{ 'support.general.required_note' | t }}</p>
          <div class="fl-form-grid">
            <div class="fl-field">
              <label for="ReturnName-{{ section.id }}">{{ 'support.form.name' | t }} <span aria-hidden="true">*</span></label>
              <input id="ReturnName-{{ section.id }}" class="fl-input" type="text" name="contact[name]" autocomplete="name" required value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}">
            </div>
            <div class="fl-field">
              <label for="ReturnEmail-{{ section.id }}">{{ 'support.form.email' | t }} <span aria-hidden="true">*</span></label>
              <input id="ReturnEmail-{{ section.id }}" class="fl-input" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}">
            </div>
            <div class="fl-field">
              <label for="ReturnOrder-{{ section.id }}">{{ 'support.form.order_number' | t }} <span aria-hidden="true">*</span></label>
              <input id="ReturnOrder-{{ section.id }}" class="fl-input" type="text" name="contact[Order number]" autocomplete="off" required>
            </div>
            <div class="fl-field">
              <label for="ReturnItems-{{ section.id }}">{{ 'support.returns.items' | t }} <span aria-hidden="true">*</span></label>
              <input id="ReturnItems-{{ section.id }}" class="fl-input" type="text" name="contact[Items]" required placeholder="{{ 'support.returns.items_placeholder' | t }}">
            </div>
            <div class="fl-field">
              <label for="ReturnReason-{{ section.id }}">{{ 'support.returns.reason' | t }} <span aria-hidden="true">*</span></label>
              <select id="ReturnReason-{{ section.id }}" class="fl-input" name="contact[Reason]" required>
                <option value="" selected disabled>{{ 'support.returns.choose_reason' | t }}</option>
                <option value="Changed mind">{{ 'support.returns.reason_mind' | t }}</option>
                <option value="Size or scale">{{ 'support.returns.reason_size' | t }}</option>
                <option value="Not as expected">{{ 'support.returns.reason_expected' | t }}</option>
                <option value="Arrived damaged">{{ 'support.returns.reason_damage' | t }}</option>
                <option value="Incorrect item">{{ 'support.returns.reason_incorrect' | t }}</option>
                <option value="Other">{{ 'support.form.topic_other' | t }}</option>
              </select>
            </div>
            <div class="fl-field">
              <label for="ReturnResolution-{{ section.id }}">{{ 'support.returns.resolution' | t }} <span aria-hidden="true">*</span></label>
              <select id="ReturnResolution-{{ section.id }}" class="fl-input" name="contact[Preferred resolution]" required>
                <option value="" selected disabled>{{ 'support.returns.choose_resolution' | t }}</option>
                <option value="Refund">{{ 'support.returns.resolution_refund' | t }}</option>
                <option value="Replacement">{{ 'support.returns.resolution_replacement' | t }}</option>
                <option value="Exchange">{{ 'support.returns.resolution_exchange' | t }}</option>
                <option value="Advice">{{ 'support.returns.resolution_advice' | t }}</option>
              </select>
            </div>
            <div class="fl-field fl-form-field--full">
              <label for="ReturnMessage-{{ section.id }}">{{ 'support.returns.details' | t }} <span aria-hidden="true">*</span></label>
              <textarea id="ReturnMessage-{{ section.id }}" class="fl-input fl-textarea" name="contact[body]" rows="6" required placeholder="{{ 'support.returns.details_placeholder' | t }}">{{ form.body }}</textarea>
            </div>
          </div>
          <button class="fl-button fl-form-submit" type="submit">{{ 'support.returns.submit' | t }}</button>
          <p class="fl-form-privacy">{{ section.settings.form_note }}</p>
        {% endform %}
      </div>
    </div>
  </div>

  {%- assign faq_count = 0 -%}
  {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}{%- assign faq_count = faq_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
  {%- if faq_count > 0 -%}
    <div class="fl-section fl-section--surface">
      <div class="fl-support-faq fl-container">
        <div>
          <span class="fl-eyebrow">{{ section.settings.faq_eyebrow }}</span>
          <h2>{{ section.settings.faq_heading }}</h2>
        </div>
        <div>
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              <details class="fl-accordion" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question }}</summary>
                <div class="fl-accordion__body fl-richtext">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Main returns",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A clear way back" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Returns, made straightforward." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Check the terms, send your request, and wait for return instructions before shipping anything back.</p>" },
    { "type": "text", "id": "policy_link_label", "label": "Policy link label", "default": "Read the full return policy" },
    { "type": "url", "id": "policy_link", "label": "Return policy link", "info": "Falls back to the link in Theme settings." },
    { "type": "text", "id": "process_eyebrow", "label": "Process eyebrow", "default": "The process" },
    { "type": "text", "id": "process_heading", "label": "Process heading", "default": "Four steps. No guesswork." },
    { "type": "text", "id": "process_text", "label": "Process text", "default": "A request starts a review; it does not confirm return approval." },
    { "type": "text", "id": "policy_eyebrow", "label": "Policy eyebrow", "default": "Before you begin" },
    { "type": "text", "id": "policy_heading", "label": "Policy heading", "default": "Check eligibility first" },
    { "type": "richtext", "id": "policy_summary", "label": "Policy summary", "default": "<p>Return timing, condition requirements, fees, and exclusions follow the published policy. Add the exact terms to this Shopify page before launch.</p>" },
    { "type": "text", "id": "form_eyebrow", "label": "Form eyebrow", "default": "Start a request" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Tell us what needs attention" },
    { "type": "richtext", "id": "form_intro", "label": "Form introduction", "default": "<p>Keep the item and original packaging until the team replies. If something arrived damaged, we may ask for clear photos.</p>" },
    { "type": "textarea", "id": "form_note", "label": "Form note", "default": "Submitting this form requests a review. Eligibility and resolution remain subject to the published policy." },
    { "type": "text", "id": "faq_eyebrow", "label": "FAQ eyebrow", "default": "Useful details" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Before you send it back" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Check the policy" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Confirm timing, condition requirements, fees, and exclusions." }
      ]
    },
    {
      "type": "policy_fact",
      "name": "Policy fact",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Keep packaging" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Keep the item and its original packaging until your request is reviewed." }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Should I ship the item now?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>No. Submit a request and wait for instructions so your return is sent to the correct location with the right reference.</p>" }
      ]
    }
  ]
}
{% endschema %}
